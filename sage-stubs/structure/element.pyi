from collections.abc import Callable, Iterator, Sequence
from typing import Literal, Protocol, Self, TypeVar, overload

from cypari2.gen import Gen
from sage.categories.groups import Groups
from sage.categories.rings import Rings
from sage.modules.free_module import FreeModule_generic
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.integer import Integer
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.rational import Rational
from sage.structure.coerce import CoercionModel
from sage.structure.element_wrapper import ElementWrapper as ElementWrapper
from sage.structure.parent import ElementConstructorInput, MembershipInput, Parent

coercion_model: CoercionModel

class Element(Protocol):
    def __init__(self: Self, parent: Parent[Self]) -> None: ...
    def _set_parent(self, parent: Parent) -> None: ...
    def parent(self: Self) -> Parent[Self]: ...
    def base_ring(self) -> Rings.ParentMethods[RingElement]: ...
    def __dir__(self) -> list[str]: ...
    def _repr_(self) -> str: ...
    def __copy__(self) -> Element: ...
    def __pos__(self) -> Element: ...
    def _coeff_repr(self, no_space: bool = ...) -> str: ...
    def _latex_coeff_repr(self) -> str: ...
    def _is_atomic(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def __neg__(self) -> Element: ...
    def __eq__(self, other: MembershipInput) -> bool: ...
    def __ne__(self, other: MembershipInput) -> bool: ...
    def __hash__(self) -> int: ...
    def _cache_key(self) -> tuple[Parent, str]: ...

class ModuleElement(Element, Protocol):
    def order(self) -> Integer: ...
    def additive_order(self) -> Integer: ...

class ModuleElementWithMutability(ModuleElement, Protocol):
    def __init__(self, parent: Parent, is_immutable: bool = ...) -> None: ...
    def set_immutable(self) -> None: ...
    def is_mutable(self) -> bool: ...
    def is_immutable(self) -> bool: ...

class MonoidElement(Element, Protocol):
    def __bool__(self) -> bool: ...

class MultiplicativeGroupElement(MonoidElement, Protocol):
    def parent(self: Self) -> Groups.ParentMethods[Self]: ...

class AdditiveGroupElement(ModuleElement, Protocol):
    ...

class RingElement(ModuleElement, Protocol):
    def __neg__(self) -> RingElement: ...
    def parent(self: Self) -> Rings.ParentMethods[Self]: ...
    def is_unit(self) -> bool: ...
    def __mul__(self, other: ElementConstructorInput) -> Element: ...
    def __rmul__(self, other: ElementConstructorInput) -> Element: ...
    def __abs__(self) -> Self: ...
    def __lt__(self, other: MembershipInput) -> bool: ...
    def __le__(self, other: MembershipInput) -> bool: ...
    def __gt__(self, other: MembershipInput) -> bool: ...
    def __ge__(self, other: MembershipInput) -> bool: ...
    def is_one(self) -> bool: ...
    def is_nilpotent(self) -> bool: ...
    def is_prime(self) -> bool: ...

class AlgebraElement(RingElement, Protocol):
    ...

class CommutativeRingElement(RingElement, Protocol):
    ...

class CommutativeAlgebraElement(CommutativeRingElement, Protocol):
    ...

class Expression(CommutativeRingElement, Protocol):
    ...

class IntegralDomainElement(CommutativeRingElement, Protocol):
    def is_nilpotent(self) -> bool: ...

class DedekindDomainElement(IntegralDomainElement, Protocol): ...

class PrincipalIdealDomainElement(DedekindDomainElement, Protocol): ...

class EuclideanDomainElement(PrincipalIdealDomainElement, Protocol): ...

class FieldElement(CommutativeRingElement, Protocol):
    def is_unit(self) -> bool: ...
    def divides(self, other: FieldElement) -> bool: ...

class InfinityElement(RingElement, Protocol):
    ...

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)
_NewScalar = TypeVar("_NewScalar", bound=RingElement)
type _List[T] = list[T]

class Vector(ModuleElement, Protocol[_Scalar]):
    def __iter__(self) -> Iterator[_Scalar]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int | Integer) -> _Scalar: ...
    def __neg__(self) -> Vector[_Scalar]: ...
    def __add__(self, other: Vector[_Scalar]) -> Vector[_Scalar]: ...
    def __sub__(self, other: Vector[_Scalar]) -> Vector[_Scalar]: ...
    @overload
    def __mul__(self, other: Matrix[_Scalar]) -> Vector[_Scalar]: ...
    @overload
    def __mul__(self, other: Vector[_Scalar]) -> _Scalar: ...
    @overload
    def __mul__(self, other: int | _Scalar) -> Vector[_Scalar]: ...
    def __rmul__(self, other: int | _Scalar) -> Vector[_Scalar]: ...
    def set_immutable(self) -> None: ...
    def __setitem__(self, i: int | Integer, value: ElementConstructorInput) -> None: ...
    def list(self) -> _List[_Scalar]: ...
    def denominator(self) -> Integer: ...

class Matrix(ModuleElement, Protocol[_Scalar]):
    def nrows(self) -> int: ...
    def ncols(self) -> int: ...
    def dimensions(self) -> tuple[int, int]: ...
    def rank(self) -> int: ...
    def det(self) -> _Scalar: ...
    def determinant(self) -> _Scalar: ...
    def transpose(self) -> Matrix[_Scalar]: ...
    def inverse(self) -> Matrix[_Scalar]: ...
    def is_square(self) -> bool: ...
    def is_symmetric(self) -> bool: ...
    def is_one(self) -> bool: ...
    def is_invertible(self) -> bool: ...
    def set_immutable(self) -> None: ...
    def is_immutable(self) -> bool: ...
    def __copy__(self) -> Matrix[_Scalar]: ...
    def change_ring(self, ring: Rings.ParentMethods[_NewScalar]) -> Matrix[_NewScalar]: ...
    def list(self) -> _List[_Scalar]: ...
    def diagonal(self) -> _List[_Scalar]: ...
    def rows(self) -> _List[Vector[_Scalar]]: ...
    def columns(self) -> _List[FreeModuleElement[_Scalar]]: ...
    def row(self, i: int | Integer) -> Vector[_Scalar]: ...
    def column(self, j: int | Integer) -> FreeModuleElement[_Scalar]: ...
    def __iter__(self) -> Iterator[Vector[_Scalar]]: ...
    def stack(self, other: Matrix[_Scalar] | Vector[_Scalar]) -> Matrix[_Scalar]: ...
    def matrix_from_columns(self, columns: Sequence[int]) -> Matrix[_Scalar]: ...
    def matrix_from_rows(self, rows: Sequence[int | Integer]) -> Matrix[_Scalar]: ...
    def matrix_from_rows_and_columns(
        self,
        rows: Sequence[int | Integer],
        columns: Sequence[int | Integer],
    ) -> Matrix[_Scalar]: ...
    def augment(self, other: Matrix[_Scalar] | Vector[_Scalar]) -> Matrix[_Scalar]: ...
    def tensor_product(self, other: Matrix[_Scalar]) -> Matrix[_Scalar]: ...
    def right_kernel(self) -> FreeModule_generic[_Scalar]: ...
    def left_kernel(self) -> FreeModule_generic[_Scalar]: ...
    def right_kernel_matrix(
        self,
        algorithm: str = ...,
        basis: str = ...,
    ) -> Matrix[_Scalar]: ...
    def left_kernel_matrix(
        self,
        algorithm: str = ...,
        basis: str = ...,
    ) -> Matrix[_Scalar]: ...
    def row_space(self) -> FreeModule_generic[_Scalar]: ...
    def trace(self) -> _Scalar: ...
    def minimal_polynomial(self, var: str = ...) -> Polynomial: ...
    def __truediv__(self, other: int | _Scalar) -> Matrix[Rational]: ...
    def __pari__(self) -> Gen: ...
    def row_module(self, base_ring: Parent | None = ...) -> FreeModule_generic[_Scalar]: ...
    def LLL_gram(self) -> Matrix[Integer]: ...
    def smith_form(self) -> tuple[Matrix[_Scalar], Matrix[_Scalar], Matrix[_Scalar]]: ...
    def characteristic_polynomial(self, var: str = ...) -> Polynomial: ...
    def eigenvalues(self) -> Sequence[RingElement]: ...
    @overload
    def hermite_form(
        self,
        include_zero_rows: bool = ...,
        transformation: Literal[False] = ...,
    ) -> Matrix[_Scalar]: ...
    @overload
    def hermite_form(
        self,
        include_zero_rows: bool,
        transformation: Literal[True],
    ) -> tuple[Matrix[_Scalar], Matrix[_Scalar]]: ...
    def echelon_form(self, algorithm: str = ...) -> Matrix[_Scalar]: ...
    def subdivide(
        self,
        row_lines: Sequence[int] | None = ...,
        col_lines: Sequence[int] | None = ...,
    ) -> None: ...
    def subdivisions(self) -> tuple[_List[int], _List[int]]: ...
    def elementary_divisors(self) -> _List[Integer]: ...
    @overload
    def solve_left(self, other: Matrix[_Scalar]) -> Matrix[_Scalar]: ...
    @overload
    def solve_left(self, other: Vector[_Scalar]) -> Vector[_Scalar]: ...
    @overload
    def solve_right(self, other: Matrix[_Scalar]) -> Matrix[_Scalar]: ...
    @overload
    def solve_right(self, other: Vector[_Scalar]) -> Vector[_Scalar]: ...
    def apply_map(self, function: Callable[[_Scalar], _NewScalar]) -> Matrix[_NewScalar]: ...
    def denominator(self) -> Integer: ...
    def __neg__(self) -> Matrix[_Scalar]: ...
    def __add__(self, other: Matrix[_Scalar]) -> Matrix[_Scalar]: ...
    def __sub__(self, other: Matrix[_Scalar]) -> Matrix[_Scalar]: ...
    @overload
    def __mul__(self, other: Matrix[_Scalar]) -> Matrix[_Scalar]: ...
    @overload
    def __mul__(self, other: Vector[_Scalar]) -> Vector[_Scalar]: ...
    @overload
    def __mul__(self, other: int | _Scalar) -> Matrix[_Scalar]: ...
    def __rmul__(self, other: int | _Scalar) -> Matrix[_Scalar]: ...
    @overload
    def __pow__(
        self,
        n: int | Integer,
        ignored: None = ...,
    ) -> Matrix[RingElement]: ...
    @overload
    def __pow__(
        self,
        n: Expression,
        ignored: None = ...,
    ) -> Matrix[Expression]: ...
    def __getitem__(self, key: tuple[int | Integer, int | Integer]) -> _Scalar: ...
    def __setitem__(
        self,
        key: tuple[int | Integer, int | Integer],
        value: ElementConstructorInput,
    ) -> None: ...

def parent(x: object) -> Parent: ...
def get_coercion_model() -> CoercionModel: ...
