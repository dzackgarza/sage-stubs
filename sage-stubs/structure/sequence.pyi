from typing import TYPE_CHECKING, TypeVar, Any, SupportsIndex
from collections.abc import Callable, Iterable, MutableSequence

if TYPE_CHECKING:
    from sage.structure.sage_object import SageObject
    from sage.structure.parent import Parent
    from sage.categories.category import Category

_T = TypeVar("_T")

def Sequence(
    x: Any,
    universe: Parent | Category | None = None,
    check: bool = True,
    immutable: bool = False,
    cr: bool = False,
    cr_str: bool | None = None,
    use_sage_types: bool = False,
) -> Sequence_generic: ...

class Sequence_generic(MutableSequence[Any]):
    def __init__(
        self,
        x: Any,
        universe: Parent | Category | None = None,
        check: bool = True,
        immutable: bool = False,
        cr: bool = False,
        cr_str: bool | None = None,
        use_sage_types: bool = False,
    ) -> None: ...
    def reverse(self) -> None: ...
    def __setitem__(self, n: SupportsIndex | slice, value: Any) -> None: ...
    def __getitem__(self, n: SupportsIndex) -> Any: ...
    @overload
    def __getitem__(self, n: slice) -> Sequence_generic: ...
    def __getslice__(self, i: int, j: int) -> Sequence_generic: ...
    def __setslice__(self, i: int, j: int, value: Any) -> None: ...
    def append(self, x: Any) -> None: ...
    def extend(self, iterable: Iterable[Any]) -> None: ...
    def insert(self, index: SupportsIndex, object: Any) -> None: ...
    def pop(self, index: SupportsIndex = -1) -> Any: ...
    def remove(self, value: Any) -> None: ...
    def sort(self, key: Callable[[Any], Any] | None = None, reverse: bool = False) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __hash__(self) -> int: ...  # type: ignore[override]
    def _repr_(self) -> str: ...
    def _repr_pretty_(self, p: Any, cycle: bool) -> None: ...
    def _latex_(self) -> str: ...
    def universe(self) -> Parent | Category: ...
    def _require_mutable(self) -> None: ...
    def set_immutable(self) -> None: ...
    def is_immutable(self) -> bool: ...
    def is_mutable(self) -> bool: ...
    def __reduce__(self) -> tuple[type, tuple[Any, ...]]: ...
    def __copy__(self) -> Sequence_generic: ...
    def __getattr__(self, name: str) -> Any: ...

seq = Sequence
