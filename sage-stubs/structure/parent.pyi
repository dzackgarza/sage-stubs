from collections.abc import Callable, Hashable, Iterable, MutableMapping, Sequence
from typing import Generic, TypeVar, overload

from sage.categories.category import Category
from sage.categories.homset import Homset
from sage.categories.map import Map
from sage.categories.morphism import Morphism, SetMorphism
from sage.categories.rings import Rings
from sage.categories.sets_cat import Sets
from sage.rings.ring import Ring
from sage.structure.element import Element, RingElement
from sage.structure.sage_object import SageCoercionAtom

from .category_object import CategoryObject

type ParentCallAtom = Element | SageCoercionAtom
type ParentCallInput = ParentCallAtom | Sequence[ParentCallAtom]
type ElementConstructorInput = ParentCallInput
type MembershipInput = ElementConstructorInput
type SetObjectInput = (
    CategoryObject | Iterable[Element | Hashable | list[Hashable]] | None
)
type AlgebraPrintOption = (
    str
    | bool
    | tuple[str, str]
    | list[str]
    | dict[Hashable, str]
    | Sequence[str]
    | Callable[[Element], Hashable]
    | None
)
_E = TypeVar("_E", default=Element, covariant=True)
_CodomainElement = TypeVar("_CodomainElement")
_SourceElement = TypeVar("_SourceElement")

class Parent(CategoryObject, Generic[_E]):
    element_class: type[_E]

    def __init__(
        self,
        base: Parent[ElementConstructorInput] | Category | None = ...,
        *,
        category: Category | None = ...,
        names: str | tuple[str, ...] | None = ...,
        normalize: bool = ...,
        facade: Parent[ElementConstructorInput]
        | tuple[Parent[ElementConstructorInput], ...]
        | bool
        | None = ...,
    ) -> None: ...
    @overload
    def Hom(
        self, codomain: Parent[_CodomainElement], category: Sets
    ) -> Homset[SetMorphism[_E, _CodomainElement], _E, _CodomainElement]: ...
    @overload
    def Hom(
        self, codomain: Parent[_CodomainElement], category: Category | None = ...
    ) -> Homset[Map[Parent, _CodomainElement], Parent, _CodomainElement]: ...
    def _refine_category_(self, category: Category | Sequence[Category]) -> None: ...
    def _init_category_(self, category: Category) -> None: ...
    def _unset_category(self) -> None: ...
    def category(self) -> Category: ...
    def _repr_option(self, key: str) -> bool: ...
    def _test_not_implemented_methods(
        self, **options: bool | int | str | None
    ) -> None: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def _first_ngens(self, n: int) -> tuple[Parent, ...]: ...
    def inject_variables(
        self, scope: MutableMapping[str, _E] | None = ..., verbose: bool = ...
    ) -> None: ...
    def __call__(
        self,
        x: ElementConstructorInput = ...,
        *args: ElementConstructorInput,
        **kwds: ElementConstructorInput,
    ) -> Parent: ...
    def structure_morphism(self) -> Morphism: ...
    def zero(self) -> Element: ...
    def base(self) -> Parent[ElementConstructorInput] | None: ...
    def base_ring(self) -> Rings.ParentMethods[RingElement] | None: ...
    def algebra(
        self,
        base_ring: Ring | None = ...,
        category: Category | None = ...,
        **kwds: AlgebraPrintOption,
    ) -> Parent: ...
    def _unset_coercions_used(self) -> None: ...
    def _unset_embedding(self) -> None: ...
    def _is_coercion_cached(self, domain: Parent) -> bool: ...
    def _is_conversion_cached(self, domain: Parent) -> bool: ...
    def _remove_from_coerce_cache(self, domain: Parent) -> None: ...
    def register_coercion(self, morphism: Map | Parent | type[Element]) -> None: ...
    def register_conversion(self, morphism: Map | Parent | type[Element]) -> None: ...
    def register_embedding(self, embedding: Map | Parent) -> None: ...
    def coerce_embedding(self) -> Map | None: ...
    def _generic_coerce_map(self, source: Parent) -> Map: ...
    def _generic_convert_map(
        self, source: Parent, category: Category | None = ...
    ) -> Map: ...
    def _convert_method_map(
        self, source: Parent, method_name: str | None = ...
    ) -> Map | None: ...
    def convert_method_map(self, source: Parent, method_name: str) -> Map | None: ...
    def has_coerce_map_from(self, source: Parent[_SourceElement]) -> bool: ...
    def coerce_map_from(
        self, source: Parent[_SourceElement]
    ) -> Morphism[_SourceElement, Parent] | None: ...
    def discover_coerce_map_from(self, source: Parent) -> Map | None: ...
    def convert_map_from(self, source: Parent) -> Map | None: ...
    def discover_convert_map_from(self, source: Parent) -> Map | None: ...
    def is_exact(self) -> bool: ...
    def _is_numerical(self) -> bool: ...
    def _is_real_numerical(self) -> bool: ...
    def __contains__(self, x: object) -> bool: ...

class Set_generic(Parent):
    def object(self) -> Set_generic | SetObjectInput: ...
    def __bool__(self) -> bool: ...
