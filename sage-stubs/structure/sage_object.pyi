from collections.abc import Callable, Hashable
from os import PathLike
from types import TracebackType
from typing import Self

from sage.categories.category import Category
from sage.interfaces.expect import Expect, ExpectElement
from sage.libs.pari.gen import gen
from sage.misc.sage_unittest import InstanceTester
from sage.typeset.ascii_art import AsciiArt
from sage.typeset.unicode_art import UnicodeArt

type _CacheKey = Hashable | tuple[Hashable, ...]
type _TesterOption = bool | int | str | None
type _UnpickleName = tuple[str, str]
type _UnpickleOverride = tuple[Callable[..., object], _UnpickleName | None]
type _UnpickleFailure = tuple[type[BaseException], BaseException, TracebackType]

class SageObject:
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _test_new(self, **options: _TesterOption) -> None: ...
    def rename(self, x: str | None = ...) -> None: ...
    def reset_name(self) -> None: ...
    def get_custom_name(self) -> str | None: ...
    def _ascii_art_(self) -> AsciiArt: ...
    def _unicode_art_(self) -> UnicodeArt: ...
    def _cache_key(self) -> _CacheKey: ...
    def save(self, filename: str | None = ..., compress: bool = ...) -> None: ...
    def dump(self, filename: str, compress: bool = ...) -> None: ...
    def dumps(self, compress: bool = ...) -> bytes: ...
    def category(self) -> Category: ...
    def _test_category(self, **options: _TesterOption) -> None: ...
    def parent(self) -> SageObject | type[Self]: ...
    def _tester(self, **options: _TesterOption) -> InstanceTester: ...
    def _test_not_implemented_methods(self, **options: _TesterOption) -> None: ...
    def _test_pickling(self, **options: _TesterOption) -> None: ...
    def _sage_(self) -> Self: ...
    def _interface_(self, interface: Expect) -> ExpectElement: ...
    def _interface_init_(self, interface: Expect | None = ...) -> str: ...
    def _interface_is_cached_(self) -> bool: ...
    def _gap_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _gap_init_(self) -> str: ...
    def _libgap_(self) -> ExpectElement: ...
    def _gp_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _gp_init_(self) -> str: ...
    def _kash_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _kash_init_(self) -> str: ...
    def _axiom_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _axiom_init_(self) -> str: ...
    def _fricas_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _fricas_init_(self) -> str: ...
    def _giac_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _giac_init_(self) -> str: ...
    def _maxima_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _maxima_init_(self) -> str: ...
    def _maxima_lib_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _maxima_lib_init_(self) -> str: ...
    def _magma_init_(self, interface: Expect) -> str: ...
    def _macaulay2_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _macaulay2_init_(self, interface: Expect | None = ...) -> str: ...
    def _maple_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _maple_init_(self) -> str: ...
    def _mathematica_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _mathematica_init_(self) -> str: ...
    def _mathics_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _octave_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _octave_init_(self) -> str: ...
    def _polymake_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _polymake_init_(self) -> str: ...
    def _r_init_(self) -> str: ...
    def _singular_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _singular_init_(self) -> str: ...
    def __pari__(self) -> gen: ...
    def _pari_init_(self) -> str: ...
    def _regina_(self, interface: Expect | None = ...) -> ExpectElement: ...
    def _regina_init_(self) -> str: ...

type SageCoercionAtom = SageObject | int | float | complex | str | bool

unpickle_override: dict[_UnpickleName, _UnpickleOverride]

def loads(data: bytes, compress: bool = ..., **kwargs: object) -> object: ...
def dumps(obj: object, compress: bool = ..., **kwargs: object) -> bytes: ...
def save(
    obj: object,
    filename: str | PathLike[str] | None = ...,
    compress: bool = ...,
    **kwargs: object,
) -> None: ...
def load(
    *filenames: str | PathLike[str],
    compress: bool = ...,
    verbose: bool = ...,
    **kwargs: object,
) -> object | list[object | None] | None: ...
def unpickle_all(
    target: str | PathLike[str],
    debug: bool = ...,
    run_test_suite: bool = ...,
) -> list[_UnpickleFailure] | None: ...
def unpickle_global(module: str, name: str) -> type | Callable[..., object]: ...
