from collections.abc import Iterable, Sequence
from typing import Self

from sage.categories.category import Category
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject

type NameSpec = str | Sequence[str] | None

def normalize_names(ngens: int | Integer, names: NameSpec) -> tuple[str, ...]: ...
def certify_names(names: NameSpec) -> bool: ...

class CategoryObject(SageObject):
    def __init__(
        self, category: Category | None = ..., base: Parent | None = ...
    ) -> None: ...
    def _is_category_initialized(self) -> bool: ...
    def category(self) -> Category: ...
    def categories(self) -> list[Category]: ...
    def _init_category_(self, category: Category) -> None: ...
    def _refine_category_(self, category: Category) -> None: ...
    def base(self) -> Parent | None: ...
    def base_ring(self) -> Parent | None: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def variable_name(self) -> str: ...
    def gens_dict(self, *, copy: bool = ...) -> dict[str, Element]: ...
    def gens_dict_recursive(self) -> dict[str, Element]: ...
    def objgens(self) -> tuple[Self, tuple[Element, ...]]: ...
    def objgen(self) -> tuple[Self, Element]: ...
    def _first_ngens(self, n: int) -> tuple[Element, ...]: ...
    def _defining_names(self) -> Iterable[Element]: ...
    def latex_variable_names(self) -> tuple[str, ...]: ...
    def latex_name(self) -> str: ...
