from collections.abc import Callable, Hashable, Iterable, Iterator
from typing import Self

from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent

class AbstractFamily[K: Hashable, V: Element](Parent):
    def hidden_keys(self) -> list[K]: ...
    def keys(self) -> Iterable[K]: ...
    def values(self) -> Iterable[V]: ...
    def items(self) -> Iterable[tuple[K, V]]: ...
    def zip[K2: Hashable, V2: Element, V3: Element](
        self,
        f: Callable[[V, V2], V3],
        other: AbstractFamily[K2, V2],
        name: str | None = None,
    ) -> AbstractFamily[tuple[K, K2], V3]: ...
    def map[V2: Element](
        self,
        f: Callable[[V], V2],
        name: str | None = None,
    ) -> AbstractFamily[K, V2]: ...
    def inverse_family(self) -> AbstractFamily[V, K]: ...

class Family[K: Hashable, V: Element](AbstractFamily[K, V]):
    def __new__(
        cls,
        indices: Iterable[K] | Parent,
        function: Callable[[K], V] | None = None,
        hidden_keys: list[K] | None = None,
        hidden_function: Callable[[K], V] | None = None,
        lazy: bool = False,
        name: str | None = None,
    ) -> Self: ...

class FiniteFamily[K: Hashable, V: Element](AbstractFamily[K, V]):
    def __init__(
        self,
        dictionary: dict[K, V],
        keys: Iterable[K] | None = None,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def keys(self) -> Iterable[K]: ...
    def values(self) -> Iterable[V]: ...
    def has_key(self, k: K) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def _repr_(self) -> str: ...
    def __contains__(self, x: object) -> bool: ...
    def __len__(self) -> int: ...
    def cardinality(self) -> int: ...
    def __iter__(self) -> Iterator[V]: ...
    def __getitem__(self, i: K) -> V: ...
    def __getstate__(self) -> dict[str, object]: ...
    def __setstate__(self, state: dict[str, object]) -> None: ...

class FiniteFamilyWithHiddenKeys[K: Hashable, V: Element](FiniteFamily[K, V]):
    def __init__(
        self,
        dictionary: dict[K, V],
        hidden_keys: list[K],
        hidden_function: Callable[[K], V],
        keys: Iterable[K] | None = None,
    ) -> None: ...
    def __getitem__(self, i: K) -> V: ...
    def hidden_keys(self) -> list[K]: ...
    def __getstate__(self) -> dict[str, object]: ...
    def __setstate__(self, d: dict[str, object]) -> None: ...

class LazyFamily[K: Hashable, V: Element](AbstractFamily[K, V]):
    def __init__(
        self,
        set: Parent,
        function: Callable[[K], V],
        name: str | None = None,
    ) -> None: ...
    def __bool__(self) -> bool: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def _repr_(self) -> str: ...
    def keys(self) -> Iterable[K]: ...
    def cardinality(self) -> int | Integer: ...
    def __iter__(self) -> Iterator[V]: ...
    def __contains__(self, x: object) -> bool: ...
    def __getitem__(self, i: K) -> V: ...
    def __getstate__(self) -> dict[str, object]: ...
    def __setstate__(self, d: dict[str, object]) -> None: ...

class TrivialFamily[V: Element](AbstractFamily[int, V]):
    def __init__(self, enumeration: Iterable[V]) -> None: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def _repr_(self) -> str: ...
    def keys(self) -> Iterable[int]: ...
    def cardinality(self) -> int: ...
    def __iter__(self) -> Iterator[V]: ...
    def __contains__(self, x: object) -> bool: ...
    def __getitem__(self, i: int) -> V: ...
    def __getstate__(self) -> dict[str, object]: ...
    def __setstate__(self, state: dict[str, object]) -> None: ...
    def map[V2: Element](
        self,
        f: Callable[[V], V2],
        name: str | None = None,
    ) -> AbstractFamily[int, V2]: ...

class EnumeratedFamily[V: Element](LazyFamily[int, V]):
    def __init__(self, enumset: Parent) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __contains__(self, x: object) -> bool: ...
    def cardinality(self) -> int | Integer: ...
    def __iter__(self) -> Iterator[V]: ...
    def __getitem__(self, i: int) -> V: ...
    def __getstate__(self) -> dict[str, object]: ...
    def __setstate__(self, state: dict[str, object]) -> None: ...
