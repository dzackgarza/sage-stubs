from collections.abc import Callable, Iterator

from sage.combinat.binary_tree import BinaryTree, LabelledBinaryTree
from sage.combinat.core import Core
from sage.combinat.k_tableau import StrongTableau, WeakTableau_abstract
from sage.combinat.partition import Partition
from sage.combinat.posets.posets import FinitePoset
from sage.combinat.shifted_primed_tableau import ShiftedPrimedTableau
from sage.combinat.skew_partition import SkewPartition
from sage.combinat.skew_tableau import SkewTableau
from sage.combinat.words.abstract_word import Word_class
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation

class GrowthDiagram(SageObject):
    def __init__(
        self,
        rule: Rule,
        filling: dict[tuple[int, int], object] | list[list[int]] | list[int] | None = ...,
        shape: list[int] | tuple[list[int], list[int]] | SkewPartition | None = ...,
        labels: list[object] | None = ...,
    ) -> None: ...
    class options:
        NAME: str
        module: str
        convention: str
        x_unit: str
        y_unit: str
    def filling(self) -> dict[tuple[int, int], object]: ...
    def conjugate(self) -> GrowthDiagram: ...
    def rotate(self) -> GrowthDiagram: ...
    def half_perimeter(self) -> int: ...
    def shape(self) -> SkewPartition: ...
    def out_labels(self) -> list[object]: ...
    def in_labels(self) -> list[object]: ...
    def P_symbol(self) -> (
        SkewTableau | ShiftedPrimedTableau | StrongTableau | WeakTableau_abstract | LabelledBinaryTree
    ): ...
    def Q_symbol(self) -> (
        SkewTableau | ShiftedPrimedTableau | StrongTableau | WeakTableau_abstract | LabelledBinaryTree
    ): ...
    def P_chain(self) -> list[object]: ...
    def Q_chain(self) -> list[object]: ...
    def is_rectangular(self) -> bool: ...
    def to_word(self) -> list[int]: ...
    def to_biword(self) -> tuple[list[int], list[int]]: ...
    def __iter__(self) -> Iterator[list[int | None]]: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

class Rule(UniqueRepresentation):
    has_multiple_edges: bool
    zero_edge: int | None
    r: int
    def normalize_vertex(self, v: object) -> Partition | Core | Word_class | BinaryTree: ...
    def latex_vertex(self, v: object) -> str: ...
    def __call__(self, *args: object, **kwds: object) -> GrowthDiagram: ...
    def P_graph(self, n: int) -> FinitePoset: ...
    def Q_graph(self, n: int) -> FinitePoset: ...

class RuleShiftedShapes(Rule):
    zero: Partition
    has_multiple_edges: bool
    def normalize_vertex(self, v: object) -> Partition: ...
    def vertices(self, n: int) -> Parent | list[Partition]: ...
    def rank(self, v: Partition) -> int: ...
    def is_Q_edge(self, v: Partition, w: Partition) -> list[int]: ...
    def is_P_edge(self, v: Partition, w: Partition) -> list[int]: ...
    def P_symbol(self, P_chain: list[Partition]) -> ShiftedPrimedTableau: ...
    def Q_symbol(self, Q_chain: list[Partition]) -> ShiftedPrimedTableau: ...
    def forward_rule(
        self, y: Partition, e: int, t: int, f: int, x: Partition, content: int
    ) -> tuple[int, Partition, int]: ...
    def backward_rule(
        self, y: Partition, g: int, z: Partition, h: int, x: Partition
    ) -> tuple[int, Partition, int, int]: ...

class RuleLLMS(Rule):
    zero_edge: None
    has_multiple_edges: bool
    def __init__(self, k: int) -> None: ...
    def normalize_vertex(self, v: object) -> Core: ...
    def rank(self, v: Core) -> int: ...
    def vertices(self, n: int) -> Parent: ...
    def is_Q_edge(self, v: Core, w: Core) -> list[None]: ...
    def is_P_edge(self, v: Core, w: Core) -> list[int]: ...
    def P_symbol(self, P_chain: list[Core]) -> StrongTableau: ...
    def Q_symbol(self, Q_chain: list[Core]) -> WeakTableau_abstract: ...
    def forward_rule(
        self, y: Core, e: None, t: None, f: None, x: Core, content: int
    ) -> tuple[int, Core, int]: ...

class RuleBinaryWord(Rule):
    zero: Word_class
    def normalize_vertex(self, v: object) -> Word_class: ...
    def vertices(self, n: int) -> list[Word_class]: ...
    def rank(self, v: Word_class) -> int: ...
    def is_Q_edge(self, v: Word_class, w: Word_class) -> bool: ...
    def is_P_edge(self, v: Word_class, w: Word_class) -> bool: ...
    def forward_rule(
        self, y: Word_class, t: Word_class, x: Word_class, content: int
    ) -> Word_class: ...
    def backward_rule(
        self, y: Word_class, z: Word_class, x: Word_class
    ) -> tuple[Word_class, int]: ...

class RuleSylvester(Rule):
    zero: BinaryTree
    def normalize_vertex(self, v: object) -> BinaryTree: ...
    def vertices(self, n: int) -> Parent: ...
    def rank(self, v: BinaryTree) -> int: ...
    def is_Q_edge(self, v: BinaryTree, w: BinaryTree) -> bool: ...
    def is_P_edge(self, v: BinaryTree, w: BinaryTree) -> bool: ...
    def P_symbol(self, P_chain: list[BinaryTree]) -> LabelledBinaryTree: ...
    def Q_symbol(self, Q_chain: list[BinaryTree]) -> LabelledBinaryTree: ...
    def forward_rule(
        self, y: BinaryTree, t: BinaryTree, x: BinaryTree, content: int
    ) -> BinaryTree: ...
    def backward_rule(
        self, y: BinaryTree, z: BinaryTree, x: BinaryTree
    ) -> tuple[BinaryTree, int]: ...

class RuleYoungFibonacci(Rule):
    zero: Word_class
    def normalize_vertex(self, v: object) -> Word_class: ...
    def vertices(self, n: int) -> list[Word_class]: ...
    def rank(self, v: Word_class) -> int: ...
    def is_P_edge(self, v: Word_class, w: Word_class) -> bool: ...
    is_Q_edge: Callable[[Word_class, Word_class], bool]
    def forward_rule(
        self, y: Word_class, t: Word_class, x: Word_class, content: int
    ) -> Word_class: ...
    def backward_rule(
        self, y: Word_class, z: Word_class, x: Word_class
    ) -> tuple[Word_class, int]: ...

class RulePartitions(Rule):
    zero: Partition
    def vertices(self, n: int) -> Parent: ...
    def normalize_vertex(self, v: object) -> Partition: ...
    def rank(self, v: Partition) -> int: ...
    def P_symbol(self, P_chain: list[Partition]) -> SkewTableau: ...
    def Q_symbol(self, Q_chain: list[Partition]) -> SkewTableau: ...

class RuleRSK(RulePartitions):
    def forward_rule(
        self, y: Partition, t: Partition, x: Partition, content: int
    ) -> list[int]: ...
    def backward_rule(
        self, y: Partition, z: Partition, x: Partition
    ) -> tuple[Partition, int]: ...

class RuleBurge(RulePartitions):
    def forward_rule(
        self, y: Partition, t: Partition, x: Partition, content: int
    ) -> Partition: ...
    def backward_rule(
        self, y: Partition, z: Partition, x: Partition
    ) -> tuple[Partition, int]: ...

class RuleDomino(Rule):
    r: int
    zero: Partition
    def normalize_vertex(self, v: object) -> Partition: ...
    def latex_vertex(self, v: object) -> str: ...
    def vertices(self, n: int) -> list[Partition]: ...
    def rank(self, v: Partition) -> int: ...
    def is_P_edge(self, v: Partition, w: Partition) -> bool: ...
    is_Q_edge: Callable[[Partition, Partition], bool]
    def P_symbol(self, P_chain: list[Partition]) -> SkewTableau: ...
    Q_symbol: Callable[[list[Partition]], SkewTableau]
    def forward_rule(
        self, y: Partition, t: Partition, x: Partition, content: int
    ) -> Partition | list[int]: ...

class Rules:
    ShiftedShapes: type[RuleShiftedShapes]
    LLMS: type[RuleLLMS]
    BinaryWord: type[RuleBinaryWord]
    Sylvester: type[RuleSylvester]
    YoungFibonacci: type[RuleYoungFibonacci]
    RSK: type[RuleRSK]
    Burge: type[RuleBurge]
    Domino: type[RuleDomino]
