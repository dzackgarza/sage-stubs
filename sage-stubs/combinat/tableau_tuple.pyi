from collections.abc import Callable, Iterator
from typing import Self

from sage.combinat.combinat import CombinatorialElement
from sage.combinat.partition_tuple import PartitionTuple
from sage.combinat.permutation import Permutation
from sage.combinat.tableau import Tableau
from sage.combinat.tableau_residues import ResidueSequence
from sage.combinat.words.abstract_word import Word_class
from sage.groups.perm_gps.permgroup import PermutationGroup_generic
from sage.structure.element import Element as SageElement
from sage.structure.global_options import GlobalOptions
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class TableauTuple(CombinatorialElement):
    Element: type[Tableau]
    def __classcall_private__(self, t: list[list[list[int]]] | TableauTuple) -> TableauTuple: ...
    def __init__(self, parent: TableauTuples, t: list[list[list[int]]], check: bool = ...) -> None: ...
    def components(self) -> list[Tableau]: ...
    def to_list(self) -> list[list[list[int]]]: ...
    def __call__(self, *cell: int) -> int: ...
    def level(self) -> int: ...
    def shape(self) -> PartitionTuple: ...
    def size(self) -> int: ...
    def conjugate(self) -> Self: ...
    def pp(self) -> None: ...
    def to_word_by_row(self) -> Word_class: ...
    to_word: Callable[[], Word_class]
    def to_word_by_column(self) -> Word_class: ...
    def to_permutation(self) -> Permutation: ...
    def entries(self) -> list[int]: ...
    def entry(self, l: int, r: int, c: int) -> int: ...
    def is_row_strict(self) -> bool: ...
    def first_row_descent(self) -> tuple[int, int, int] | None: ...
    def is_column_strict(self) -> bool: ...
    def first_column_descent(self) -> tuple[int, int, int] | None: ...
    def is_standard(self) -> bool: ...
    def reduced_row_word(self) -> list[int]: ...
    def reduced_column_word(self) -> list[int]: ...
    def cells_containing(self, m: int) -> list[tuple[int, int, int]]: ...
    def up(self, n: int | None = ...) -> None: ...
    def row_stabilizer(self) -> PermutationGroup_generic: ...
    def column_stabilizer(self) -> PermutationGroup_generic: ...
    def charge(self) -> int: ...
    def cocharge(self) -> int: ...
    def add_entry(self, cell: tuple[int, int], m: int) -> Self: ...
    def restrict(self, m: int | None = ...) -> Self: ...
    def symmetric_group_action_on_entries(self, w: Permutation) -> Self: ...
    def content(self, k: int, multicharge: list[int]) -> int: ...
    def residue(self, k: int, e: int, multicharge: list[int]) -> SageElement: ...

class RowStandardTableauTuple(TableauTuple):
    def __classcall_private__(self, t: list[list[list[int]]] | TableauTuple) -> RowStandardTableauTuple: ...
    def __init__(
        self, parent: RowStandardTableauTuples, t: list[list[list[int]]], check: bool = ...
    ) -> None: ...
    def inverse(self, k: int) -> tuple[int, int, int]: ...
    def residue_sequence(self, e: int, multicharge: list[int]) -> ResidueSequence: ...
    def degree(self, e: int, multicharge: list[int]) -> int: ...
    def codegree(self, e: int, multicharge: list[int]) -> int: ...

class StandardTableauTuple(RowStandardTableauTuple):
    def __classcall_private__(self, t: list[list[list[int]]] | TableauTuple) -> StandardTableauTuple: ...
    def __init__(
        self, parent: StandardTableauTuples, t: list[list[list[int]]], check: bool = ...
    ) -> None: ...
    def dominates(self, t: StandardTableauTuple) -> bool: ...
    def to_chain(self) -> list[PartitionTuple]: ...
    def restrict(self, m: int | None = ...) -> StandardTableauTuple: ...

class TableauTuples(UniqueRepresentation, Parent):
    Element: type[TableauTuple]
    level_one_parent_class: type
    options: GlobalOptions
    @classmethod
    def __classcall_private__(cls, level: int | None = ..., size: int | None = ...) -> TableauTuples: ...
    def __contains__(self, t: object) -> bool: ...
    def level(self) -> int | None: ...
    def size(self) -> int | None: ...
    def list(self) -> list[TableauTuple]: ...

class TableauTuples_all(TableauTuples):
    def __init__(self) -> None: ...
    def an_element(self) -> TableauTuple: ...

class TableauTuples_level(TableauTuples):
    def __init__(self, level: int) -> None: ...
    def __contains__(self, t: object) -> bool: ...
    def an_element(self) -> TableauTuple: ...

class TableauTuples_size(TableauTuples):
    def __init__(self, size: int) -> None: ...
    def __contains__(self, t: object) -> bool: ...
