import builtins

class _SageObject: ...

class AmbientSpace:
    def __init__(
        self,
        root_system: builtins.object,
        base_ring: builtins.object,
        index_set: builtins.object = ...,
    ) -> None: ...
    @classmethod
    def smallest_base_ring(cls, cartan_type: builtins.object = ...) -> _SageObject: ...
    def dimension(self) -> _SageObject: ...
    def simple_root(self, i: builtins.int) -> _SageObject: ...
    def positive_roots(self) -> _SageObject: ...
    def positive_even_roots(self) -> _SageObject: ...
    def positive_odd_roots(self) -> _SageObject: ...
    def highest_root(self) -> _SageObject: ...
    def negative_roots(self) -> _SageObject: ...
    def negative_even_roots(self) -> _SageObject: ...
    def negative_odd_roots(self) -> _SageObject: ...
    def fundamental_weight(self, i: builtins.int) -> _SageObject: ...
    def simple_coroot(self, i: builtins.int) -> _SageObject: ...

    class Element:
        def inner_product(self, lambdacheck: builtins.object) -> _SageObject: ...
        scalar: _SageObject
        dot_product: _SageObject

        def associated_coroot(self) -> _SageObject: ...
        def has_descent(
            self, i: builtins.int, positive: builtins.bool = ...
        ) -> builtins.bool: ...
        def is_dominant_weight(self) -> builtins.bool: ...

class CartanType:
    letter: str
    n: builtins.int
    m: builtins.int

    def __init__(self, m: builtins.int, n: builtins.int) -> None: ...
    def index_set(self) -> _SageObject: ...
    AmbientSpace: _SageObject

    def is_irreducible(self) -> bool: ...
    def is_affine(self) -> bool: ...
    def is_finite(self) -> bool: ...
    def dual(self) -> _SageObject: ...
    def type(self) -> _SageObject: ...
    def root_system(self) -> _SageObject: ...
    def symmetrizer(self) -> _SageObject: ...
    def dynkin_diagram(self) -> _SageObject: ...
    def cartan_matrix(self) -> _SageObject: ...
    def relabel(self, relabelling: builtins.object) -> _SageObject: ...
    def ascii_art(
        self, label: builtins.str = ..., node: builtins.object = ...
    ) -> _SageObject: ...
