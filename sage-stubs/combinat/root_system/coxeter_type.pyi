from __future__ import annotations

from collections.abc import Sequence
from typing import Self

from sage.combinat.root_system.cartan_type import CartanType_abstract
from sage.graphs.graph import Graph
from sage.matrix.matrix0 import Matrix
from sage.rings.ring import Ring
from sage.structure.element import RingElement
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation

type CoxeterIndex = int | str
type CoxeterTypeData = (
    str
    | Sequence[CoxeterIndex]
    | Sequence[Sequence[CoxeterIndex]]
    | CartanType_abstract
    | CoxeterType
)

class CoxeterType(SageObject):
    @staticmethod
    def __classcall_private__(
        cls: type[Self],
        *x: CoxeterTypeData,
    ) -> Self: ...
    @classmethod
    def samples(
        cls,
        finite: bool | None = None,
        affine: bool | None = None,
        crystallographic: bool | None = None,
    ) -> list[Self]: ...
    @classmethod
    def _samples(cls) -> list[Self]: ...
    def rank(self) -> int: ...
    def index_set(self) -> tuple[CoxeterIndex, ...]: ...
    def coxeter_matrix(self) -> Matrix: ...
    def coxeter_graph(self) -> Graph: ...
    def is_finite(self) -> bool: ...
    def is_affine(self) -> bool: ...
    def is_crystallographic(self) -> bool: ...
    def is_simply_laced(self) -> bool: ...
    def bilinear_form(self, R: Ring | None = None) -> Matrix: ...

class CoxeterTypeFromCartanType(CoxeterType, UniqueRepresentation):
    @staticmethod
    def __classcall_private__(
        cls: type[Self],
        cartan_type: CartanType_abstract,
    ) -> Self: ...
    def __init__(self, cartan_type: CartanType_abstract) -> None: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def type(self) -> str: ...
    def rank(self) -> int: ...
    def index_set(self) -> tuple[CoxeterIndex, ...]: ...
    def coxeter_matrix(self) -> Matrix: ...
    def coxeter_graph(self) -> Graph: ...
    def is_finite(self) -> bool: ...
    def is_affine(self) -> bool: ...
    def is_crystallographic(self) -> bool: ...
    def is_simply_laced(self) -> bool: ...
    def is_reducible(self) -> bool: ...
    def is_irreducible(self) -> bool: ...
    def component_types(self) -> tuple[CoxeterTypeFromCartanType, ...]: ...
    def relabel(
        self,
        relabelling: Sequence[CoxeterIndex] | dict[CoxeterIndex, CoxeterIndex],
    ) -> CoxeterTypeFromCartanType: ...
