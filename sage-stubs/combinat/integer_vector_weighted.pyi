from __future__ import annotations

from collections.abc import Iterable, Iterator, Sequence
from typing import overload

from sage.combinat.integer_vector import IntegerVector
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.sets.disjoint_union_enumerated_sets import DisjointUnionEnumeratedSets
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

type Weight = int | Integer
type WeightSequence = Sequence[Weight] | Iterable[Weight]
type WeightedVectorInput = IntegerVector | Sequence[Weight]

class WeightedIntegerVectors(
    Parent[IntegerVector],
    UniqueRepresentation,
):
    @staticmethod
    @overload
    def __classcall_private__(
        cls: type[WeightedIntegerVectors],
        n: Weight,
        weight: WeightSequence,
    ) -> WeightedIntegerVectors: ...
    @staticmethod
    @overload
    def __classcall_private__(
        cls: type[WeightedIntegerVectors],
        n: WeightSequence,
        weight: None = None,
    ) -> WeightedIntegerVectors_all: ...
    def __init__(
        self,
        n: Weight,
        weight: tuple[Weight, ...],
    ) -> None: ...
    Element: type[IntegerVector]
    element_class: type[IntegerVector]
    def _element_constructor_(self, lst: WeightedVectorInput) -> IntegerVector: ...
    def _repr_(self) -> str: ...
    def __contains__(self, x: object) -> bool: ...
    def _recfun(
        self,
        n: Weight,
        weights: Sequence[Weight],
    ) -> Iterator[list[int]]: ...
    def __iter__(self) -> Iterator[IntegerVector]: ...
    def cardinality(self) -> Integer: ...
    def first(self) -> IntegerVector: ...
    def last(self) -> IntegerVector: ...
    def random_element(self) -> IntegerVector: ...
    def list(self) -> list[IntegerVector]: ...

class WeightedIntegerVectors_all(
    DisjointUnionEnumeratedSets,
):
    def __init__(self, weight: tuple[Weight, ...]) -> None: ...
    def _repr_(self) -> str: ...
    def __contains__(self, x: object) -> bool: ...
    @overload
    def subset(self, size: None = None) -> WeightedIntegerVectors_all: ...
    @overload
    def subset(self, size: Weight) -> WeightedIntegerVectors: ...
    def graded_component(self, size: Weight) -> WeightedIntegerVectors: ...
    def grading(self, x: Sequence[Weight]) -> Integer: ...
    def cardinality(self) -> PlusInfinity: ...
    def first(self) -> IntegerVector: ...
    def __iter__(self) -> Iterator[IntegerVector]: ...

def iterator_fast(
    n: Weight,
    weights: Sequence[Weight],
) -> Iterator[list[Integer]]: ...
