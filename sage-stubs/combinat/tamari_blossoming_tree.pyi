from collections.abc import Iterator
from typing import Self

from sage.combinat.binary_tree import BinaryTree
from sage.combinat.interval_posets import TamariIntervalPoset
from sage.combinat.ordered_tree import LabelledOrderedTree, OrderedTree
from sage.plot.graphics import Graphics
from sage.rings.integer import Integer
from sage.sets.disjoint_union_enumerated_sets import DisjointUnionEnumeratedSets
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation
from sage.typeset.ascii_art import AsciiArt
from sage.typeset.unicode_art import UnicodeArt

class TamariBlossomingTree(Element, UniqueRepresentation):
    @staticmethod
    def __classcall_private__(
        cls: type[TamariBlossomingTree],
        tree: OrderedTree | object,
    ) -> TamariBlossomingTree: ...
    def __init__(
        self,
        parent: TamariBlossomingTrees_all,
        tree: OrderedTree,
    ) -> None: ...
    def parent(self) -> TamariBlossomingTrees_all: ...
    def _repr_(self) -> str: ...
    def _ascii_art_(self) -> AsciiArt: ...
    def _unicode_art_(self) -> UnicodeArt: ...
    def _latex_(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def size(self) -> Integer: ...
    def to_plane_tree(self) -> OrderedTree: ...
    def to_tamari(self) -> tuple[BinaryTree, BinaryTree]: ...
    @staticmethod
    def from_tamari(
        ltree: BinaryTree | object,
        htree: BinaryTree | object,
    ) -> TamariBlossomingTree: ...
    def to_TIP(self) -> TamariIntervalPoset: ...
    @staticmethod
    def from_TIP(
        tip: TamariIntervalPoset,
    ) -> TamariBlossomingTree: ...
    @staticmethod
    def binary_tree_plot(
        btree: BinaryTree | object,
    ) -> Graphics: ...
    def tamari_dual(self) -> Self: ...
    def plot_meandric(
        self,
        semicircle: bool = ...,
        arrow: bool = ...,
    ) -> Graphics: ...
    @staticmethod
    def from_plane_tree(
        tree: OrderedTree | object,
    ) -> TamariBlossomingTree: ...
    @staticmethod
    def _from_plane_tree(
        tree: OrderedTree | object,
        skip_check: bool = ...,
        random_bud: bool = ...,
    ) -> TamariBlossomingTree: ...
    def reflection(self) -> Self: ...
    def plot_blossoming(
        self,
        aspect: float = ...,
        layout: str = ...,
    ) -> Graphics: ...
    @staticmethod
    def _binary_tree_arcs(
        btree: BinaryTree,
    ) -> list[tuple[int, int]]: ...
    @staticmethod
    def binary_tree_smooth_drawing(
        btree: BinaryTree | object,
        color: str = ...,
    ) -> Graphics: ...
    def smooth_drawing(self) -> Graphics: ...
    def is_synchronized(self) -> bool: ...
    def is_modern(self) -> bool: ...

class TamariBlossomingTrees(
    UniqueRepresentation,
    Parent[TamariBlossomingTree],
):
    Element: type[TamariBlossomingTree]
    element_class: type[TamariBlossomingTree]

    @staticmethod
    def __classcall_private__(
        cls: type[TamariBlossomingTrees],
        size: int | Integer | None = ...,
    ) -> TamariBlossomingTrees_all | TamariBlossomingTrees_size: ...

class TamariBlossomingTrees_all(
    DisjointUnionEnumeratedSets,
    TamariBlossomingTrees,
):
    Element: type[TamariBlossomingTree]
    element_class: type[TamariBlossomingTree]

    def __init__(self) -> None: ...
    def _repr_(self) -> str: ...
    def __contains__(self, elem: object) -> bool: ...

class TamariBlossomingTrees_size(TamariBlossomingTrees):
    element_class: type[TamariBlossomingTree]

    def __init__(self, size: int | Integer) -> None: ...
    def _repr_(self) -> str: ...
    @property
    def _parent_for(self) -> TamariBlossomingTrees_all: ...
    def _element_constructor_(
        self,
        tree: TamariBlossomingTree | OrderedTree | object,
    ) -> TamariBlossomingTree: ...
    def __contains__(self, elem: object) -> bool: ...
    def cardinality(self) -> Integer: ...
    def random_element(self) -> TamariBlossomingTree: ...
    def __iter__(self) -> Iterator[TamariBlossomingTree]: ...
    def random_synchronized_element(self) -> TamariBlossomingTree: ...
    def random_modern_element(self) -> TamariBlossomingTree: ...

class SynchronizedBlossomingTreeFactory(
    SageObject,
    UniqueRepresentation,
):
    def __init__(self, size: int) -> None: ...
    def _repr_(self) -> str: ...
    def random_element(self) -> TamariBlossomingTree: ...

class ModernBlossomingTreeFactory(
    SageObject,
    UniqueRepresentation,
):
    def __init__(self, size: int) -> None: ...
    def _repr_(self) -> str: ...
    def random_element(self) -> TamariBlossomingTree: ...
