from typing import TYPE_CHECKING, Any

from sage.combinat.skew_tableau import SkewTableau
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation
from sage.rings.integer import Integer
from sage.combinat.combinat import CombinatorialElement

from collections.abc import Iterator
class RibbonTableau(SkewTableau):
    

    def __init__(self, parent: Any, rt: list[Any] | tuple[Any, ...]) -> None: ...
    def length(self) -> int: ...
    def to_word(self) -> Any: ...

class RibbonTableaux(UniqueRepresentation, Parent):
    

    def __init__(self) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, rt: list[Any] | tuple[Any, ...]) -> RibbonTableau: ...
    def from_expr(self, l: list[Any]) -> RibbonTableau: ...
    Element: type[RibbonTableau]

class RibbonTableaux_shape_weight_length(RibbonTableaux):
    

    def __init__(self, shape: Any, weight: tuple[Any, ...], length: int) -> None: ...
    def __iter__(self) -> Iterator[RibbonTableau]: ...
    def _repr_(self) -> str: ...
    def __contains__(self, x: object) -> bool: ...
    def cardinality(self) -> Integer: ...

def insertion_tableau(skp: Any, perm: list[Any], evaluation: int, tableau: list[Any], length: int) -> list[Any]: ...

def count_rec(nexts: list[Any], current: list[Any], part: Any, weight: list[Any], length: int) -> list[int]: ...

def list_rec(nexts: list[Any], current: list[Any], part: Any, weight: list[Any], length: int) -> list[Any]: ...

def spin_rec(t: Any, nexts: list[Any], current: list[Any], part: Any, weight: list[Any], length: int) -> list[Any]: ...

def spin_polynomial_square(part: Any, weight: list[Any], length: int) -> Any: ...

def spin_polynomial(part: Any, weight: list[Any], length: int) -> Any: ...

def cospin_polynomial(part: Any, weight: list[Any], length: int) -> Any: ...

def graph_implementation_rec(skp: Any, weight: list[Any], length: int, function: Any) -> Any: ...

class MultiSkewTableau(CombinatorialElement):
    

    def __init__(self, x: list[Any]) -> None: ...
    def size(self) -> int: ...
    def weight(self) -> list[int]: ...
    def shape(self) -> list[Any]: ...
    def inversion_pairs(self) -> list[Any]: ...
    def inversions(self) -> int: ...
    def _inversion_pairs_from_position(self, k: int, ij: tuple[int, int]) -> list[Any]: ...

class MultiSkewTableaux(UniqueRepresentation, Parent):
    

    def __init__(self, category: Any = None) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, rt: list[Any]) -> MultiSkewTableau: ...
    Element: type[MultiSkewTableau]

class SemistandardMultiSkewTableaux(MultiSkewTableaux):
    

    def __init__(self, shape: tuple[Any, ...], weight: Any) -> None: ...
    def _repr_(self) -> str: ...
    def __contains__(self, x: object) -> bool: ...
    def __iter__(self) -> Iterator[MultiSkewTableau]: ...
