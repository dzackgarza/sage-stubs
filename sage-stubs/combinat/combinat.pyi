class CombinatorialObject[T](SageObject):
    _list: list[T]
    def __init__(self, l: Iterable[T], copy: bool = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __lt__(self, other: object) -> bool: ...
    def __le__(self, other: object) -> bool: ...
    def __gt__(self, other: object) -> bool: ...
    def __ge__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __add__(self, other: object) -> Self: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: int | slice) -> T | list[T]: ...
    def __iter__(self) -> Iterator[T]: ...
    def __contains__(self, item: object) -> bool: ...
    def index(self, key: object) -> int: ...

class CombinatorialElement(Element):
    def __init__(self, parent: Parent, *args: object, **kwds: object) -> None: ...

