import builtins
from collections.abc import (
    Hashable,
)

from sage.structure.element import Element

class _SageObject: ...

class SuffixTrie:
    def __init__(self, word: builtins.object) -> None: ...
    def process_letter(self, letter: builtins.object) -> _SageObject: ...
    def node_to_word(self, state: builtins.int = ...) -> _SageObject: ...
    def word(self) -> _SageObject: ...
    def __eq__(self, other: object) -> bool: ...
    def transition_function(
        self, node: builtins.object, word: builtins.object
    ) -> _SageObject: ...
    def states(self) -> _SageObject: ...
    def suffix_link(self, state: builtins.object) -> _SageObject: ...
    def active_state(self) -> _SageObject: ...
    def final_states(self) -> _SageObject: ...
    def has_suffix(self, word: builtins.object) -> bool: ...
    def to_digraph(self) -> _SageObject: ...
    def plot(
        self,
        layout: builtins.str = ...,
        tree_root: builtins.int = ...,
        tree_orientation: builtins.str = ...,
        vertex_colors: builtins.object = ...,
        edge_labels: builtins.bool = ...,
        *args: builtins.object,
        **kwds: builtins.object,
    ) -> _SageObject: ...
    def show(self, *args: builtins.object, **kwds: builtins.object) -> _SageObject: ...

class ImplicitSuffixTree:
    def __init__(self, word: builtins.object) -> None: ...
    def word(self) -> _SageObject: ...
    def transition_function_dictionary(self) -> dict[Hashable, Element]: ...
    def to_digraph(self, word_labels: builtins.bool = ...) -> _SageObject: ...
    def plot(
        self,
        word_labels: builtins.bool = ...,
        layout: builtins.str = ...,
        tree_root: builtins.int = ...,
        tree_orientation: builtins.str = ...,
        vertex_colors: builtins.object = ...,
        edge_labels: builtins.bool = ...,
        *args: builtins.object,
        **kwds: builtins.object,
    ) -> _SageObject: ...
    def show(
        self,
        word_labels: builtins.object = ...,
        *args: builtins.object,
        **kwds: builtins.object,
    ) -> _SageObject: ...
    def __eq__(self, other: object) -> bool: ...
    def transition_function(
        self, word: builtins.object, node: builtins.int = ...
    ) -> _SageObject: ...
    def states(self) -> list[Element]: ...
    def suffix_link(self, state: builtins.object) -> _SageObject: ...
    def active_state(self) -> _SageObject: ...
    def process_letter(self, letter: builtins.object) -> _SageObject: ...
    def to_explicit_suffix_tree(self) -> _SageObject: ...
    def edge_iterator(self) -> _SageObject: ...
    def number_of_factors(self, n: builtins.int = ...) -> _SageObject: ...
    def factor_iterator(self, n: builtins.int = ...) -> _SageObject: ...
    def LZ_decomposition(self) -> _SageObject: ...
    def suffix_walk(self, edge: builtins.object, l: builtins.object) -> _SageObject: ...
    def leftmost_covering_set(self) -> _SageObject: ...
    def uncompactify(self) -> _SageObject: ...
    def trie_type_dict(self) -> _SageObject: ...

class DecoratedSuffixTree:
    def __init__(self, w: builtins.object) -> None: ...
    def square_vocabulary(self, output: builtins.str = ...) -> _SageObject: ...
