from collections.abc import Iterable, Iterator, Sequence
from typing import overload

from sage.combinat.words.abstract_word import Word_class
from sage.rings.integer import Integer

class FiniteWord_class(Word_class):
    def __str__(self) -> str: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[object]: ...
    @overload
    def __getitem__(self, key: int | Integer) -> object: ...
    @overload
    def __getitem__(self, key: slice) -> FiniteWord_class: ...
    def concatenate(self, other: Word_class) -> Word_class: ...
    __mul__ = concatenate
    __add__ = concatenate
    def reversal(self) -> FiniteWord_class: ...
    def shuffle(
        self,
        other: FiniteWord_class,
        overlap: int | Integer = ...,
    ) -> Iterable[FiniteWord_class]: ...
    def lex_less(self, other: Word_class) -> bool: ...
    def is_empty(self) -> bool: ...
    def number_of_factors(
        self,
        n: int | Integer | None = ...,
    ) -> Integer | dict[int, Integer]: ...
    def lempel_ziv_complexity(self) -> int: ...
    def is_lyndon(self) -> bool: ...
    def lyndon_factorization(self) -> tuple[FiniteWord_class, ...]: ...
    def degree(
        self,
        weights: Sequence[int | Integer] | dict[object, int | Integer] | None = ...,
    ) -> int | Integer: ...
    def deg_lex_less(
        self,
        other: FiniteWord_class,
        weights: Sequence[int | Integer] | dict[object, int | Integer] | None = ...,
    ) -> bool: ...
    def inv_lex_less(self, other: FiniteWord_class) -> bool: ...
    def rev_lex_less(self, other: FiniteWord_class) -> bool: ...
