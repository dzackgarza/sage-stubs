from sage.structure.sage_object import SageObject
from sage.structure.parent import Parent
from typing import overload, TYPE_CHECKING
from collections.abc import Iterator

SelfWord = "Word_class"

class Word_class(SageObject):
    def parent(self) -> Parent: ...
    def string_rep(self) -> str: ...
    def length(self) -> int: ...
    def is_finite(self) -> bool: ...
    def longest_common_prefix(self, other: Word_class, length: int | None = None) -> SelfWord: ...
    def longest_periodic_prefix(self, period: int = 0) -> SelfWord: ...
    def is_empty(self) -> bool: ...
    def to_integer_word(self) -> SelfWord: ...
    def lex_less(self, other: Word_class) -> bool: ...
    def lex_greater(self, other: Word_class) -> bool: ...
    def apply_morphism(self, morphism: object) -> SelfWord: ...
    def delta(self) -> SelfWord: ...
    def iterated_right_palindromic_closure(self, f: object, algorithm: str = "") -> SelfWord: ...
    def prefixes_iterator(self, max_length: int | None = None) -> Iterator[SelfWord]: ...
    def palindrome_prefixes_iterator(self, max_length: int | None = None) -> Iterator[SelfWord]: ...
    def partial_sums(self, start: int | None = None, mod: int | None = None) -> SelfWord: ...
    def finite_differences(self, mod: int | None = None) -> SelfWord: ...
    def sum_digits(self, base: int = 10, mod: int | None = None) -> SelfWord: ...
    def first_occurrence(self, other: Word_class, start: int = 0) -> int | None: ...
    def factor_occurrences_iterator(self, fact: Word_class) -> Iterator[int]: ...
    def return_words_iterator(self, fact: Word_class) -> Iterator[SelfWord]: ...
    def complete_return_words_iterator(self, fact: Word_class) -> Iterator[SelfWord]: ...
