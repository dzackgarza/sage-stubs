import builtins
from collections.abc import (
    Iterator as _Iterator,
)

from sage.structure.element import Element

class _SageObject: ...

class PuzzlePiece:
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> builtins.int: ...
    def border(self) -> tuple[Element, ...]: ...
    def color(self) -> str: ...
    def edge_color(self, edge: builtins.object) -> str: ...
    def edge_label(self, edge: builtins.object) -> str: ...

class NablaPiece:
    def __init__(
        self,
        north: builtins.object,
        south_east: builtins.object,
        south_west: builtins.object,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> builtins.int: ...
    def clockwise_rotation(self) -> NablaPiece: ...
    def half_turn_rotation(self) -> DeltaPiece: ...
    def edges(self) -> tuple[str, str, str]: ...

class DeltaPiece:
    def __init__(
        self,
        south: builtins.object,
        north_west: builtins.object,
        north_east: builtins.object,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> builtins.int: ...
    def clockwise_rotation(self) -> DeltaPiece: ...
    def half_turn_rotation(self) -> NablaPiece: ...
    def edges(self) -> tuple[str, str, str]: ...

class RhombusPiece:
    def __init__(
        self, north_piece: builtins.object, south_piece: builtins.object
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> builtins.int: ...
    def __iter__(self) -> _Iterator[_SageObject]: ...
    def north_piece(self) -> DeltaPiece: ...
    def south_piece(self) -> NablaPiece: ...
    def edges(self) -> tuple[str, str, str, str]: ...

class PuzzlePieces:
    def __init__(self, forbidden_border_labels: builtins.object = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> builtins.int: ...
    def add_piece(
        self, piece: builtins.object, rotations: builtins.int = ...
    ) -> _SageObject: ...
    def add_forbidden_label(self, label: builtins.str) -> _SageObject: ...
    def add_T_piece(
        self, label1: builtins.object, label2: builtins.object
    ) -> _SageObject: ...
    def delta_pieces(self) -> _SageObject: ...
    def nabla_pieces(self) -> _SageObject: ...
    def rhombus_pieces(self) -> set[Element]: ...
    def boundary_deltas(self) -> tuple[Element, ...]: ...

def H_grassmannian_pieces(self) -> _SageObject: ...
def HT_grassmannian_pieces(self) -> _SageObject: ...
def K_grassmannian_pieces(self) -> _SageObject: ...
def H_two_step_pieces(self) -> _SageObject: ...
def HT_two_step_pieces(self) -> _SageObject: ...
def BK_pieces(self) -> _SageObject: ...

class PuzzleFilling:
    def __init__(
        self, north_west_labels: builtins.object, north_east_labels: builtins.object
    ) -> None: ...
    def __getitem__(self, key: builtins.object) -> _SageObject: ...
    def kink_coordinates(self) -> tuple[Element, ...]: ...
    def is_in_south_edge(self) -> bool: ...
    def north_west_label_of_kink(self) -> _SageObject: ...
    def north_east_label_of_kink(self) -> _SageObject: ...
    def is_completed(self) -> bool: ...
    def south_labels(self) -> tuple[Element, ...]: ...
    def add_piece(self, piece: builtins.object) -> _SageObject: ...
    def add_pieces(self, pieces: builtins.object) -> _SageObject: ...
    def copy(self) -> _SageObject: ...
    def contribution(self) -> _SageObject: ...
    def __iter__(self) -> _Iterator[_SageObject]: ...
    def plot(
        self, labels: builtins.bool = ..., style: builtins.str = ...
    ) -> _SageObject: ...

class KnutsonTaoPuzzleSolver:
    def __init__(self, puzzle_pieces: builtins.object) -> None: ...
    @staticmethod
    def __classcall_private__(
        cls: builtins.object,
        puzzle_pieces: builtins.object,
        max_letter: builtins.object = ...,
    ) -> _SageObject: ...
    def __call__(
        self, lamda: builtins.object, mu: builtins.object, algorithm: builtins.str = ...
    ) -> _SageObject: ...
    solutions: _SageObject

    def puzzle_pieces(self) -> _SageObject: ...
    def plot(self, puzzles: builtins.object) -> _SageObject: ...
    def structure_constants(
        self, lamda: builtins.object, mu: builtins.object, nu: builtins.object = ...
    ) -> _SageObject: ...
