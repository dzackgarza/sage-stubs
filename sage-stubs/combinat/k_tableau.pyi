        cls: type[WeakTableau_core], t: list[list[int]] | WeakTableau_core, k: int
    ) -> WeakTableau_core: ...
    def __init__(self, parent: WeakTableaux_core, t: list[list[int]]) -> None: ...
    def shape_core(self) -> Partition: ...
    def shape_bounded(self) -> Partition | tuple[Partition, Partition]: ...
    def check(self) -> None: ...
    def to_bounded_tableau(self) -> WeakTableau_bounded: ...
    def to_factorized_permutation_tableau(self) -> WeakTableau_factorized_permutation: ...
    def residues_of_entries(self, v: int) -> list[int]: ...
    def dictionary_of_coordinates_at_residues(self, v: int) -> dict[int, list[tuple[int, int]]]: ...
    def list_of_standard_cells(self) -> list[tuple[int, int]]: ...
    def k_charge(self, algorithm: str = ...) -> int: ...
    def k_charge_I(self) -> int: ...
    def k_charge_J(self) -> int: ...

class WeakTableaux_core(WeakTableaux_abstract):
    @staticmethod
    def __classcall_private__(
