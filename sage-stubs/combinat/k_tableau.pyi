def WeakTableau(
    t: list[list[int]] | WeakTableau_core | WeakTableau_bounded | WeakTableau_factorized_permutation,
    k: int,
    inner_shape: list[int] = ...,
    representation: str = ...,
) -> WeakTableau_core | WeakTableau_bounded | WeakTableau_factorized_permutation: ...

def WeakTableaux(
    k: int,
    shape: list[int] | tuple[list[int], list[int]],
    weight: list[int] | tuple[int, ...],
    representation: str = ...,
) -> WeakTableaux_core | WeakTableaux_bounded | WeakTableaux_factorized_permutation: ...

class WeakTableau_abstract(ClonableList[list[int]]):
    def shape(self) -> Partition | tuple[Partition, Partition]: ...
    def weight(self) -> tuple[int, ...]: ...
    def size(self) -> int: ...
    def intermediate_shapes(self) -> list[Partition]: ...
    def pp(self) -> None: ...
    def __hash__(self) -> int: ...
    def representation(
        self, representation: str = ...
    ) -> WeakTableau_core | WeakTableau_bounded | WeakTableau_factorized_permutation: ...

class WeakTableaux_abstract(UniqueRepresentation, Parent):
    def shape(self) -> Partition | tuple[Partition, Partition]: ...
    def size(self) -> int: ...
    def representation(
        self, representation: str = ...
    ) -> WeakTableaux_core | WeakTableaux_bounded | WeakTableaux_factorized_permutation: ...

class WeakTableau_core(WeakTableau_abstract):
    @staticmethod
