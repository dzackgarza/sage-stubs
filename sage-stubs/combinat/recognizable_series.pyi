        alphabet: builtins.object = ...,
        indices: builtins.object = ...,
        category: builtins.object = ...,
        minimize_results: builtins.bool = ...,
    ) -> _SageObject: ...
    def __init__(
        self,
        coefficient_ring: builtins.object,
        indices: builtins.object,
        category: builtins.object,
        minimize_results: builtins.object,
    ) -> None: ...
    def __reduce__(self) -> builtins.str | builtins.tuple[builtins.object, ...]: ...
    def alphabet(self) -> _SageObject: ...
    def indices(self) -> _SageObject: ...
    def coefficient_ring(self) -> _SageObject: ...
    @property
    def minimize_results(self) -> _SageObject: ...
    def some_elements(self, **kwds: builtins.object) -> _SageObject: ...
    def one(self) -> _SageObject: ...
    def one_hadamard(self) -> _SageObject: ...
