import builtins
from collections.abc import (
    Iterator,
)

from sage.combinat.posets.lattices import FiniteLatticePoset
from sage.rings.integer import Integer

class _SageObject: ...

def bubble_cardinality(self, n: builtins.int) -> Integer: ...
def bubble_set(self, n: builtins.int) -> Iterator[tuple[int, ...]]: ...
def bubble_coverings(
    self, n: builtins.int, mot: builtins.object, transpose: builtins.bool = ...
) -> Iterator[tuple[int, ...]]: ...
def BubblePoset(self, n: builtins.int) -> FiniteLatticePoset: ...
def ShufflePoset(self, n: builtins.int) -> FiniteLatticePoset: ...
def noncrossing_bipartite_complex(self, n: builtins.int) -> _SageObject: ...
