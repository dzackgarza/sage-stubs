import builtins
from typing import Self

class _SageObject: ...

class PosetElement:
    def __init__(
        self, poset: builtins.object, element: builtins.object, vertex: builtins.object
    ) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: builtins.object) -> builtins.bool: ...
    def __le__(self, other: builtins.object) -> builtins.bool: ...
    def __gt__(self, other: builtins.object) -> builtins.bool: ...
    def __ge__(self, other: builtins.object) -> builtins.bool: ...

class MeetSemilatticeElement:
    def __mul__(self, other: builtins.object) -> Self: ...

class JoinSemilatticeElement:
    def __add__(self, other: builtins.object) -> Self: ...

class LatticePosetElement: ...
