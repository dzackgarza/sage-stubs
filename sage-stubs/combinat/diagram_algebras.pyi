class PottsRepresentation(CombinatorialFreeModule):
    def __init__(self, PA: PartitionAlgebra, y: Element | None) -> None: ...
    def __getitem__(self, ind: tuple[int, ...]) -> Element: ...
    def partition_algebra(self) -> PartitionAlgebra: ...
    def number_of_factors(self) -> int: ...
    def number_of_colors(self) -> int: ...
    def magnetic_field_direction(self) -> Element | None: ...
    def symmetric_group(self) -> SymmetricGroup: ...
    def representation_matrix(self, elt: Permutation) -> Matrix: ...
    class Element(CombinatorialFreeModule.Element): ...

