        q: Element | int,
        base_ring: Ring | None = ...,
        prefix: str = ...,
    ) -> TemperleyLiebAlgebra: ...
    def __init__(
        self, k: int | Rational, q: Element | int, base_ring: Ring, prefix: str
    ) -> None: ...
    def cell_poset(self) -> FinitePoset: ...
    def cell_module_indices(self, la: int) -> HalfTemperleyLiebDiagrams: ...
    def cellular_involution(self, x: Element) -> Element: ...

class PlanarAlgebra(SubPartitionAlgebra, UnitDiagramMixin):
