class AbstractPartitionDiagram(AbstractSetPartition):
    def __init__(
        self, parent: AbstractPartitionDiagrams, d: AbstractSetPartition | list[list[int]], check: bool = ...
    ) -> None: ...
    def check(self) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __lt__(self, other: object) -> bool: ...
    def base_diagram(self) -> AbstractSetPartition: ...
    diagram: Callable[[], AbstractSetPartition]
    def set_partition(self) -> SetPartition: ...
    def compose(self, other: AbstractPartitionDiagram, check: bool = ...) -> Self: ...
    def propagating_number(self) -> int: ...
    def count_blocks_of_size(self, n: int) -> int: ...
    def order(self) -> int | Rational: ...
    def is_planar(self) -> bool: ...
    def dual(self) -> Self: ...

class IdealDiagram(AbstractPartitionDiagram):
    @staticmethod
    def __classcall_private__(
        cls: type[IdealDiagram], diag: AbstractSetPartition | list[list[int]]
    ) -> IdealDiagram: ...
    def check(self) -> None: ...

class PlanarDiagram(AbstractPartitionDiagram):
    @staticmethod
    def __classcall_private__(
        cls: type[PlanarDiagram], diag: AbstractSetPartition | list[list[int]]
    ) -> PlanarDiagram: ...
    def check(self) -> None: ...

class TemperleyLiebDiagram(AbstractPartitionDiagram):
    @staticmethod
    def __classcall_private__(
        cls: type[TemperleyLiebDiagram], diag: AbstractSetPartition | list[list[int]]
    ) -> TemperleyLiebDiagram: ...
    def check(self) -> None: ...

class PartitionDiagram(AbstractPartitionDiagram):
    @staticmethod
    def __classcall_private__(
        cls: type[PartitionDiagram], diag: AbstractSetPartition | list[list[int]]
    ) -> PartitionDiagram: ...

class BrauerDiagram(AbstractPartitionDiagram):
    @staticmethod
    def __classcall_private__(
        cls: type[BrauerDiagram], diag: AbstractSetPartition | list[list[int]]
    ) -> BrauerDiagram: ...
    def check(self) -> None: ...
    class options:
        NAME: str
        module: str
        option_class: type
        display: str
    def involution_permutation_triple(
        self, curt: bool = ...
    ) -> tuple[list[tuple[int, ...]], list[tuple[int, ...]], list[int] | list[tuple[int, int]]]: ...
    def bijection_on_free_nodes(
        self, two_line: bool = ...
    ) -> list[tuple[int, int]] | tuple[list[int], list[int]]: ...
    def perm(self) -> list[int]: ...
    def is_elementary_symmetric(self) -> bool: ...

class AbstractPartitionDiagrams(Parent, UniqueRepresentation):
    Element: type[AbstractPartitionDiagram]
    def __init__(self, order: int | Rational, category: Category | None = ...) -> None: ...
    def __iter__(self) -> Iterator[AbstractPartitionDiagram]: ...
    def __contains__(self, obj: object) -> bool: ...

class PartitionDiagrams(AbstractPartitionDiagrams):
    Element: type[PartitionDiagram]
    def cardinality(self) -> int: ...

class BrauerDiagrams(AbstractPartitionDiagrams):
    Element: type[BrauerDiagram]
    options: GlobalOptions
    def __contains__(self, obj: object) -> bool: ...
    def cardinality(self) -> int: ...
    def symmetric_diagrams(
        self, l: int | None = ..., perm: Permutation | None = ...
    ) -> list[BrauerDiagram]: ...
    def from_involution_permutation_triple(
        self, D1_D2_pi: tuple[list[list[int]], list[list[int]], Permutation]
    ) -> BrauerDiagram: ...

class TemperleyLiebDiagrams(AbstractPartitionDiagrams):
    Element: type[TemperleyLiebDiagram]
    def cardinality(self) -> int: ...
    def __contains__(self, obj: object) -> bool: ...

class PlanarDiagrams(AbstractPartitionDiagrams):
    Element: type[PlanarDiagram]
    def cardinality(self) -> int: ...
    def __contains__(self, obj: object) -> bool: ...

class IdealDiagrams(AbstractPartitionDiagrams):
    Element: type[IdealDiagram]
    def __contains__(self, obj: object) -> bool: ...

class DiagramAlgebra(CombinatorialFreeModule):
    def __init__(
        self,
        k: int | Rational,
        q: Element | int,
        base_ring: Ring,
        prefix: str,
        diagrams: AbstractPartitionDiagrams,
        category: Category | None = ...,
    ) -> None: ...
    def __getitem__(self, d: AbstractSetPartition) -> Element: ...
    def order(self) -> int | Rational: ...
    def set_partitions(self) -> Iterator[AbstractSetPartition]: ...
    class Element(CombinatorialFreeModule.Element):
        def diagram(self) -> AbstractSetPartition: ...
        def diagrams(self) -> list[AbstractSetPartition]: ...

class UnitDiagramMixin:
    def one_basis(self) -> AbstractSetPartition: ...

class DiagramBasis(DiagramAlgebra):
    def product_on_basis(self, d1: AbstractSetPartition, d2: AbstractSetPartition) -> Element: ...

class PartitionAlgebra(DiagramBasis, UnitDiagramMixin):
    @staticmethod
    def __classcall_private__(
        cls: type[PartitionAlgebra],
        k: int | Rational,
        q: Element | int,
        base_ring: Ring | None = ...,
        prefix: str = ...,
    ) -> PartitionAlgebra: ...
    def __init__(
        self, k: int | Rational, q: Element | int, base_ring: Ring, prefix: str
    ) -> None: ...
    def orbit_basis(self) -> OrbitBasis: ...
    def a(self, i: int) -> Element: ...
    generator_a: Callable[[int], Element]
    def e(self, i: int) -> Element: ...
    generator_e: Callable[[int], Element]
    def s(self, i: int) -> Element: ...
    generator_s: Callable[[int], Element]
    def sigma(self, i: int) -> Element: ...
    def jucys_murphy_element(self, i: int) -> Element: ...
    L: Callable[[int], Element]
    def potts_representation(self, y: Element | None = ...) -> PottsRepresentation: ...
    class Element(DiagramBasis.Element):
        def to_orbit_basis(self) -> OrbitBasis.Element: ...
        def dual(self) -> Self: ...

class OrbitBasis(DiagramAlgebra):
    @staticmethod
    def __classcall_private__(cls: type[OrbitBasis], *args: object) -> OrbitBasis: ...
    def __init__(self, alg: PartitionAlgebra) -> None: ...
    def one(self) -> Element: ...
    def diagram_basis(self) -> PartitionAlgebra: ...
    def product_on_basis(self, d1: AbstractSetPartition, d2: AbstractSetPartition) -> Element: ...
    class Element(DiagramBasis.Element):
        def to_diagram_basis(self) -> DiagramAlgebra.Element: ...

class SubPartitionAlgebra(DiagramBasis):
    def __init__(
        self,
        k: int | Rational,
        q: Element | int,
        base_ring: Ring,
        prefix: str,
        diagrams: AbstractPartitionDiagrams,
        category: Category | None = ...,
    ) -> None: ...
    def ambient(self) -> PartitionAlgebra: ...
    def lift(self) -> ModuleMorphism: ...
    def retract(self, x: PartitionAlgebra.Element) -> Element: ...
    class Element(DiagramBasis.Element):
        def to_orbit_basis(self) -> OrbitBasis.Element: ...

class BrauerAlgebra(SubPartitionAlgebra, UnitDiagramMixin):
    @staticmethod
    def __classcall_private__(
        cls: type[BrauerAlgebra],
        k: int | Rational,
        q: Element | int,
        base_ring: Ring | None = ...,
        prefix: str = ...,
    ) -> BrauerAlgebra: ...
    def __init__(
        self, k: int | Rational, q: Element | int, base_ring: Ring, prefix: str
    ) -> None: ...
    options: GlobalOptions
    def jucys_murphy(self, j: int) -> Element: ...

class HalfTemperleyLiebDiagrams(UniqueRepresentation, Parent):
    def __init__(self, order: int | Rational, defects: int) -> None: ...
    def __iter__(self) -> Iterator[Element]: ...
    def __contains__(self, obj: object) -> bool: ...
    def cardinality(self) -> int: ...
    class Element(AbstractPartitionDiagram):
        def defects(self) -> int: ...
        def check(self) -> None: ...

class TemperleyLiebAlgebra(SubPartitionAlgebra, UnitDiagramMixin):
