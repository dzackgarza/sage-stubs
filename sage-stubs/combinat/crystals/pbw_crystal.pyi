from collections.abc import Iterable
from typing import Self

from sage.combinat.crystals.pbw_datum import (
    CartanIndex,
    CartanTypeInput,
    LongWord,
    LusztigDatum,
    PBWData,
    PBWDatum,
)
from sage.combinat.root_system.cartan_type import CartanType_abstract
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class PBWCrystalElement(Element):
    _pbw_datum: PBWDatum

    def __init__(
        self,
        parent: PBWCrystal,
        lusztig_datum: Iterable[int | Integer],
        long_word: Iterable[CartanIndex] | None = ...,
    ) -> None: ...
    def parent(self) -> PBWCrystal: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def lusztig_datum(
        self,
        word: Iterable[CartanIndex] | None = ...,
    ) -> LusztigDatum: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def _richcmp_(
        self,
        other: PBWCrystalElement,
        op: int,
    ) -> bool: ...
    def __hash__(self) -> int: ...
    def e(self, i: CartanIndex) -> Self | None: ...
    def f(self, i: CartanIndex) -> Self: ...
    def epsilon(self, i: CartanIndex) -> int | Integer: ...
    def phi(self, i: CartanIndex) -> int | Integer: ...
    def weight(self) -> Element: ...
    def star(self) -> Self: ...

class PBWCrystal(
    Parent[PBWCrystalElement],
    UniqueRepresentation,
):
    Element: type[PBWCrystalElement]
    element_class: type[PBWCrystalElement]
    module_generators: tuple[PBWCrystalElement, ...]
    _pbw_datum_parent: PBWData
    _default_word: LongWord

    @staticmethod
    def __classcall__(
        cls: type[PBWCrystal],
        cartan_type: CartanTypeInput,
    ) -> PBWCrystal: ...
    def __init__(self, cartan_type: CartanType_abstract) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(
        self,
        lusztig_datum: Iterable[int | Integer],
        long_word: Iterable[CartanIndex] | None = ...,
    ) -> PBWCrystalElement: ...
    def default_long_word(self) -> list[CartanIndex]: ...
    def _check_is_long_word(
        self,
        word: Iterable[CartanIndex],
    ) -> None: ...
    def set_default_long_word(
        self,
        word: Iterable[CartanIndex],
    ) -> None: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def index_set(self) -> tuple[CartanIndex, ...]: ...
    def weight_lattice_realization(self) -> Parent: ...
    def highest_weight_vector(self) -> PBWCrystalElement: ...
    def __contains__(self, x: object) -> bool: ...
