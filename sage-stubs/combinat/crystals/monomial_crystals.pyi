from collections.abc import Hashable, Iterable, Mapping, Sequence
from typing import Literal, Self

from sage.combinat.root_system.cartan_type import CartanType_abstract
from sage.matrix.matrix import Matrix
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

type CartanIndex = Hashable
type CartanTypeInput = CartanType_abstract | Sequence[object] | str
type MonomialIndex = tuple[CartanIndex, int | Integer]
type MonomialDataInput = Mapping[MonomialIndex, int | Integer]
type MonomialData = dict[MonomialIndex, Integer]
type MonomialVariables = Literal["Y", "A"]
type Cardinality = int | Integer | PlusInfinity

class NakajimaMonomial(Element):
    _Y: MonomialData
    _A: MonomialData

    def __init__(
        self,
        parent: InfinityCrystalOfNakajimaMonomials,
        Y: MonomialData,
        A: MonomialData,
    ) -> None: ...
    def parent(self) -> InfinityCrystalOfNakajimaMonomials: ...
    def _repr_(self) -> str: ...
    def _repr_Y(self) -> str: ...
    def _repr_A(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: object) -> bool: ...
    def _latex_(self) -> str: ...
    def _latex_Y(self) -> str: ...
    def _latex_A(self) -> str: ...
    def _classical_weight(self) -> Element: ...
    def weight_in_root_lattice(self) -> Element: ...
    def weight(self) -> Element: ...
    def epsilon(self, i: CartanIndex) -> int | Integer: ...
    def phi(self, i: CartanIndex) -> int | Integer: ...
    def _ke(self, i: CartanIndex) -> int | Integer: ...
    def _kf(self, i: CartanIndex) -> int | Integer: ...
    def e(self, i: CartanIndex) -> Self | None: ...
    def f(self, i: CartanIndex) -> Self: ...

class InfinityCrystalOfNakajimaMonomials(
    UniqueRepresentation,
    Parent[NakajimaMonomial],
):
    Element: type[NakajimaMonomial]
    element_class: type[NakajimaMonomial]
    module_generators: tuple[NakajimaMonomial, ...]

    @staticmethod
    def _normalize_c(
        c: Matrix[Integer]
        | Iterable[Iterable[int | Integer]]
        | None,
        n: int,
    ) -> Matrix[Integer]: ...
    @staticmethod
    def __classcall_private__(
        cls: type[InfinityCrystalOfNakajimaMonomials],
        ct: CartanTypeInput,
        c: Matrix[Integer]
        | Iterable[Iterable[int | Integer]]
        | None = ...,
    ) -> InfinityCrystalOfNakajimaMonomials: ...
    def __init__(
        self,
        ct: CartanType_abstract,
        c: Matrix[Integer],
        category: object | None = ...,
    ) -> None: ...
    def _element_constructor_(
        self,
        Y: MonomialDataInput | NakajimaMonomial | None = ...,
        A: MonomialDataInput | None = ...,
    ) -> NakajimaMonomial: ...
    def _repr_(self) -> str: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def index_set(self) -> tuple[CartanIndex, ...]: ...
    def weight_lattice_realization(self) -> Parent: ...
    def highest_weight_vector(self) -> NakajimaMonomial: ...
    def c(self) -> Matrix[Integer]: ...
    def cardinality(self) -> PlusInfinity: ...
    def set_variables(self, letter: MonomialVariables) -> None: ...
    def get_variables(self) -> MonomialVariables: ...

class CrystalOfNakajimaMonomialsElement(NakajimaMonomial):
    def parent(self) -> CrystalOfNakajimaMonomials: ...
    def f(self, i: CartanIndex) -> Self | None: ...
    def weight(self) -> Element: ...

class CrystalOfNakajimaMonomials(
    InfinityCrystalOfNakajimaMonomials,
):
    Element: type[CrystalOfNakajimaMonomialsElement]
    element_class: type[CrystalOfNakajimaMonomialsElement]
    module_generators: tuple[CrystalOfNakajimaMonomialsElement, ...]
    hw: Element

    @staticmethod
    def __classcall_private__(
        cls: type[CrystalOfNakajimaMonomials],
        cartan_type: CartanTypeInput | Element,
        La: Element | None = ...,
        c: Matrix[Integer]
        | Iterable[Iterable[int | Integer]]
        | None = ...,
    ) -> CrystalOfNakajimaMonomials: ...
    def __init__(
        self,
        ct: CartanType_abstract,
        La: Element,
        c: Matrix[Integer],
    ) -> None: ...
    def _element_constructor_(
        self,
        Y: MonomialDataInput
        | CrystalOfNakajimaMonomialsElement
        | None = ...,
        A: MonomialDataInput | None = ...,
    ) -> CrystalOfNakajimaMonomialsElement: ...
    def highest_weight_vector(
        self,
    ) -> CrystalOfNakajimaMonomialsElement: ...
    def _repr_(self) -> str: ...
    def cardinality(self) -> Cardinality: ...
