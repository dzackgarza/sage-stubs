from collections.abc import Iterator, Sequence
from typing import Self

from sage.combinat.crystals.direct_sum import CrystalIndex
from sage.combinat.root_system.cartan_type import CartanType_abstract
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

type CartanTypeInput = CartanType_abstract | Sequence[object] | str
type WeightElement = Element
type CrystalStatistic = int | Integer | float

class AbstractSingleCrystalElement(Element):
    def __lt__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def e(self, i: CrystalIndex) -> None: ...
    def f(self, i: CrystalIndex) -> None: ...

class TCrystal(
    UniqueRepresentation,
    Parent[TCrystal.Element],
):
    module_generators: tuple[TCrystal.Element, ...]

    class Element(AbstractSingleCrystalElement):
        def parent(self) -> TCrystal: ...
        def _repr_(self) -> str: ...
        def _latex_(self) -> str: ...
        def epsilon(self, i: CrystalIndex) -> float: ...
        def phi(self, i: CrystalIndex) -> float: ...
        def weight(self) -> WeightElement: ...

    Element: type[Element]
    element_class: type[Element]

    @staticmethod
    def __classcall_private__(
        cls: type[TCrystal],
        cartan_type: CartanTypeInput | WeightElement,
        weight: WeightElement | None = ...,
    ) -> TCrystal: ...
    def __init__(
        self,
        cartan_type: CartanType_abstract,
        weight: WeightElement,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, weight: WeightElement) -> Element: ...
    def cardinality(self) -> Integer: ...
    def weight_lattice_realization(self) -> Parent: ...
    def highest_weight_vector(self) -> Element: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def index_set(self) -> tuple[CrystalIndex, ...]: ...

class RCrystal(
    UniqueRepresentation,
    Parent[RCrystal.Element],
):
    module_generators: tuple[RCrystal.Element, ...]

    class Element(AbstractSingleCrystalElement):
        def parent(self) -> RCrystal: ...
        def _repr_(self) -> str: ...
        def _latex_(self) -> str: ...
        def epsilon(self, i: CrystalIndex) -> Integer: ...
        def phi(self, i: CrystalIndex) -> Integer: ...
        def weight(self) -> WeightElement: ...

    Element: type[Element]
    element_class: type[Element]

    @staticmethod
    def __classcall_private__(
        cls: type[RCrystal],
        cartan_type: CartanTypeInput | WeightElement,
        weight: WeightElement | None = ...,
        dual: bool = ...,
    ) -> RCrystal: ...
    def __init__(
        self,
        cartan_type: CartanType_abstract,
        weight: WeightElement,
        dual: bool,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, weight: WeightElement) -> Element: ...
    def cardinality(self) -> Integer: ...
    def weight_lattice_realization(self) -> Parent: ...
    def highest_weight_vector(self) -> Element: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def index_set(self) -> tuple[CrystalIndex, ...]: ...

class ElementaryCrystal(
    UniqueRepresentation,
    Parent[ElementaryCrystal.Element],
):
    module_generators: tuple[ElementaryCrystal.Element, ...]

    class Element(Element):
        _m: Integer

        def __init__(
            self,
            parent: ElementaryCrystal,
            m: int | Integer,
        ) -> None: ...
        def parent(self) -> ElementaryCrystal: ...
        def __hash__(self) -> int: ...
        def _repr_(self) -> str: ...
        def __lt__(self, other: object) -> bool: ...
        def __eq__(self, other: object) -> bool: ...
        def __ne__(self, other: object) -> bool: ...
        def _latex_(self) -> str: ...
        def e(self, i: CrystalIndex) -> Self | None: ...
        def f(self, i: CrystalIndex) -> Self | None: ...
        def epsilon(self, i: CrystalIndex) -> CrystalStatistic: ...
        def phi(self, i: CrystalIndex) -> CrystalStatistic: ...
        def weight(self) -> WeightElement: ...

    Element: type[Element]
    element_class: type[Element]

    @staticmethod
    def __classcall_private__(
        cls: type[ElementaryCrystal],
        cartan_type: CartanTypeInput,
        i: CrystalIndex,
    ) -> ElementaryCrystal: ...
    def __init__(
        self,
        cartan_type: CartanType_abstract,
        i: CrystalIndex,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, m: int | Integer) -> Element: ...
    def weight_lattice_realization(self) -> Parent: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def index_set(self) -> tuple[CrystalIndex, ...]: ...
    def cardinality(self) -> PlusInfinity: ...
    def __iter__(self) -> Iterator[Element]: ...

class ComponentCrystal(
    UniqueRepresentation,
    Parent[ComponentCrystal.Element],
):
    module_generators: tuple[ComponentCrystal.Element, ...]

    class Element(AbstractSingleCrystalElement):
        def parent(self) -> ComponentCrystal: ...
        def _repr_(self) -> str: ...
        def _latex_(self) -> str: ...
        def epsilon(self, i: CrystalIndex) -> int: ...
        def phi(self, i: CrystalIndex) -> int: ...
        def weight(self) -> WeightElement: ...

    Element: type[Element]
    element_class: type[Element]

    @staticmethod
    def __classcall_private__(
        cls: type[ComponentCrystal],
        cartan_type: CartanTypeInput | Parent,
        P: Parent | None = ...,
    ) -> ComponentCrystal: ...
    def __init__(
        self,
        cartan_type: CartanType_abstract,
        P: Parent,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, weight: WeightElement) -> Element: ...
    def cardinality(self) -> Integer: ...
    def weight_lattice_realization(self) -> Parent: ...
    def highest_weight_vector(self) -> Element: ...
    def cartan_type(self) -> CartanType_abstract: ...
    def index_set(self) -> tuple[CrystalIndex, ...]: ...
