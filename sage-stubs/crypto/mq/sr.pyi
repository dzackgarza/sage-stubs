from typing import Self

from sage.crypto.mq.mpolynomialsystemgenerator import MPolynomialSystemGenerator
from sage.crypto.sbox import SBox
from sage.matrix.matrix0 import Matrix
from sage.rings.finite_rings.finite_field_base import FiniteField
from sage.rings.polynomial.multi_polynomial_ring_base import MPolynomialRing_base
from sage.rings.polynomial.multi_polynomial_sequence import PolynomialSequence_generic
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.polynomial.term_order import TermOrder
from sage.structure.element import Element, Vector

def SR(
    n: int = ...,
    r: int = ...,
    c: int = ...,
    e: int = ...,
    star: bool = ...,
    **kwargs: object,
) -> SR_gf2 | SR_gf2n: ...

class SR_generic(MPolynomialSystemGenerator):
    def __init__(
        self,
        n: int = ...,
        r: int = ...,
        c: int = ...,
        e: int = ...,
        star: bool = ...,
        **kwargs: object,
    ) -> None: ...
    def new_generator(self, **kwds: object) -> SR_gf2 | SR_gf2n: ...
    def __getattr__(self, attr: str) -> MPolynomialRing_base | int: ...
    def base_ring(self) -> FiniteField: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def sub_bytes(self, d: Matrix) -> Matrix: ...
    def sub_byte(self, b: Element) -> Element: ...
    def sbox_constant(self) -> Element: ...
    def sbox(self, inversion_only: bool = ...) -> SBox: ...
    def shift_rows(self, d: Matrix) -> Matrix: ...
    def mix_columns(self, d: Matrix) -> Matrix: ...
    def add_round_key(self, d: Matrix, key: Matrix) -> Matrix: ...
    def state_array(self, d: Matrix | None = ...) -> Matrix: ...
    def is_state_array(self, d: Matrix) -> bool: ...
    def random_state_array(self, *args: object, **kwds: object) -> Matrix: ...
    def random_vector(self, *args: object, **kwds: object) -> Matrix: ...
    def random_element(self, elem_type: str = ..., *args: object) -> Matrix: ...
    def key_schedule(self, kj: Matrix, i: int) -> Matrix: ...
    def __call__(self, P: Matrix | Vector | list[Element] | None, K: Matrix | Vector | list[Element] | None) -> Matrix: ...
    def hex_str(self, M: Matrix, typ: str = ...) -> str: ...
    def hex_str_matrix(self, M: Matrix) -> str: ...
    def hex_str_vector(self, M: Matrix) -> str: ...
    def varformatstr(self, name: str, n: int = ..., rc: tuple[int, int] | None = ..., e: int | None = ...) -> str: ...
    def varstr(self, name: str, nr: int, rc: tuple[int, int], e: int) -> str: ...
    def varstrs(
        self, name: str, nr: int, rc: tuple[int, int] | None = ..., e: int | None = ...
    ) -> tuple[str, ...]: ...
    def vars(
        self, name: str, nr: int, rc: tuple[int, int] | None = ..., e: int | None = ...
    ) -> tuple[Element, ...]: ...
    def variable_dict(self) -> dict[str, Element]: ...
    def block_order(self) -> TermOrder: ...
    def ring(
        self, order: TermOrder | str | None = ..., reverse_variables: bool | None = ...
    ) -> MPolynomialRing_base: ...
    def round_polynomials(
        self, i: int, plaintext: Matrix | None = ..., ciphertext: Matrix | None = ...
    ) -> tuple[Polynomial, ...]: ...
    def key_schedule_polynomials(self, i: int) -> tuple[Polynomial, ...]: ...
    def polynomial_system(
        self,
        P: Matrix | Vector | list[Element] | None = ...,
        K: Matrix | Vector | list[Element] | None = ...,
        C: Matrix | None = ...,
    ) -> tuple[PolynomialSequence_generic, Matrix]: ...

class SR_gf2n(SR_generic):
    def vector(self, d: Matrix | None = ...) -> Matrix: ...
    def is_vector(self, d: Matrix) -> bool: ...
    def phi(self, l: Matrix | list[Element]) -> Matrix | tuple[Element, ...]: ...
    def antiphi(self, l: Matrix | list[Element]) -> Matrix | tuple[Element, ...]: ...
    def shift_rows_matrix(self) -> Matrix: ...
    def lin_matrix(self, length: int | None = ...) -> Matrix: ...
    def mix_columns_matrix(self) -> Matrix: ...
    def inversion_polynomials(
        self, xi: Matrix, wi: Matrix, length: int
    ) -> list[Polynomial]: ...
    def field_polynomials(
        self, name: str, i: int, l: int | None = ...
    ) -> list[Polynomial]: ...

class SR_gf2(SR_generic):
    def __init__(
        self,
        n: int = ...,
        r: int = ...,
        c: int = ...,
        e: int = ...,
        star: bool = ...,
        **kwargs: object,
    ) -> None: ...
    def vector(self, d: Matrix | None = ...) -> Matrix: ...
    def is_vector(self, d: Matrix) -> bool: ...
    def phi(
        self, l: Matrix | list[Element], diffusion_matrix: bool = ...
    ) -> Matrix | list[Element] | tuple[Element, ...]: ...
    def antiphi(self, l: Matrix | list[Element]) -> Matrix | tuple[Element, ...]: ...
    def shift_rows_matrix(self) -> Matrix: ...
    def mix_columns_matrix(self) -> Matrix: ...
    def lin_matrix(self, length: int | None = ...) -> Matrix: ...
    def inversion_polynomials_single_sbox(
        self,
        x: list[Element] | None = ...,
        w: list[Element] | None = ...,
        biaffine_only: bool | None = ...,
        correct_only: bool | None = ...,
    ) -> list[Polynomial]: ...
    def inversion_polynomials(
        self, xi: Matrix, wi: Matrix, length: int
    ) -> list[Polynomial]: ...
    def field_polynomials(
        self, name: str, i: int, l: int | None = ...
    ) -> list[Polynomial]: ...

class SR_gf2_2(SR_gf2):
    def inversion_polynomials_single_sbox(
        self,
        x: list[Element] | None = ...,
        w: list[Element] | None = ...,
        biaffine_only: bool | None = ...,
        correct_only: bool | None = ...,
        groebner: bool = ...,
    ) -> list[Polynomial]: ...

class AllowZeroInversionsContext:
    def __init__(self, sr: SR_generic) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self, typ: type[BaseException] | None, value: BaseException | None, tb: object
    ) -> bool | None: ...

def check_consistency(max_n: int = ..., **kwargs: object) -> dict[str, bool]: ...
