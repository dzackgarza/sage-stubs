from collections.abc import Callable, Iterator, Sequence
from typing import Literal, Protocol, Self, overload

from sage.modules.free_module import FreeModule_submodule_field
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.finite_rings.integer_mod import IntegerMod_abstract
from sage.rings.integer import Integer
from sage.rings.polynomial.pbori.pbori import BooleanPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.sage_object import SageObject


class BooleanValue(Protocol):
    def __bool__(self) -> bool: ...


type BooleanFunctionInput = (
    BooleanFunction
    | BooleanPolynomial
    | Polynomial
    | str
    | int
    | Integer
    | Sequence[BooleanValue]
)
type BooleanDirection = (
    int
    | Integer
    | Sequence[bool | int | Integer]
    | FreeModuleElement[IntegerMod_abstract]
)
type BooleanFunctionUnpickler = Callable[
    [Sequence[bool | int]],
    BooleanFunction,
]


class BooleanFunction(SageObject):
    def __new__(
        cls,
        x: BooleanFunctionInput,
    ) -> BooleanFunction: ...
    def _repr_(self) -> str: ...
    def __invert__(self) -> Self: ...
    def __add__(self, other: BooleanFunction) -> Self: ...
    def __mul__(self, other: BooleanFunction) -> Self: ...
    def __or__(self, other: BooleanFunction) -> BooleanFunction: ...
    def algebraic_normal_form(self) -> BooleanPolynomial: ...
    def nvariables(self) -> Integer: ...

    @overload
    def truth_table(
        self,
        format: Literal["bin"] = ...,
    ) -> tuple[bool, ...]: ...
    @overload
    def truth_table(
        self,
        format: Literal["int"],
    ) -> tuple[int, ...]: ...
    @overload
    def truth_table(
        self,
        format: Literal["hex"],
    ) -> str: ...
    @overload
    def truth_table(
        self,
        format: str = ...,
    ) -> tuple[bool, ...] | tuple[int, ...] | str: ...

    def __len__(self) -> int: ...
    def __richcmp__(self, other: object, op: int) -> bool: ...
    def __call__(
        self,
        x: int | Integer | Sequence[BooleanValue],
    ) -> bool: ...
    def __iter__(self) -> BooleanFunctionIterator: ...
    def _walsh_hadamard_transform_cached(self) -> tuple[int, ...]: ...
    def walsh_hadamard_transform(self) -> tuple[int, ...]: ...
    def absolute_walsh_spectrum(self) -> dict[int, int]: ...
    def is_balanced(self) -> bool: ...
    def is_symmetric(self) -> bool: ...
    def nonlinearity(self) -> int | Integer: ...
    def is_bent(self) -> bool: ...
    def correlation_immunity(self) -> int | Integer: ...
    def resiliency_order(self) -> int | Integer: ...
    def autocorrelation(self) -> tuple[int, ...]: ...
    def absolute_autocorrelation(self) -> dict[int, int]: ...
    def absolute_indicator(self) -> int: ...
    def sum_of_square_indicator(self) -> int: ...

    @overload
    def annihilator(
        self,
        d: int | Integer,
        dim: Literal[False] = ...,
    ) -> BooleanPolynomial | None: ...
    @overload
    def annihilator(
        self,
        d: int | Integer,
        dim: Literal[True],
    ) -> tuple[BooleanPolynomial | None, int]: ...
    @overload
    def annihilator(
        self,
        d: int | Integer,
        dim: bool = ...,
    ) -> BooleanPolynomial | None | tuple[BooleanPolynomial | None, int]: ...

    @overload
    def algebraic_immunity(
        self,
        annihilator: Literal[False] = ...,
    ) -> int: ...
    @overload
    def algebraic_immunity(
        self,
        annihilator: Literal[True],
    ) -> tuple[int, BooleanPolynomial]: ...
    @overload
    def algebraic_immunity(
        self,
        annihilator: bool = ...,
    ) -> int | tuple[int, BooleanPolynomial]: ...

    def algebraic_degree(self) -> int | Integer: ...
    def is_plateaued(self) -> bool: ...
    def is_linear_structure(self, val: BooleanDirection) -> bool: ...
    def has_linear_structure(self) -> bool: ...
    def linear_structures(
        self,
    ) -> FreeModule_submodule_field[IntegerMod_abstract]: ...
    def derivative(self, u: BooleanDirection) -> BooleanFunction: ...
    def __setitem__(
        self,
        i: int | Integer,
        y: BooleanValue,
    ) -> None: ...
    def __getitem__(self, i: int | Integer) -> bool: ...
    def __reduce__(
        self,
    ) -> tuple[
        BooleanFunctionUnpickler,
        tuple[list[bool]],
    ]: ...


class BooleanFunctionIterator(Iterator[bool]):
    def __init__(self, f: BooleanFunction) -> None: ...
    def __iter__(self) -> Self: ...
    def __next__(self) -> bool: ...


def unpickle_BooleanFunction(
    bool_list: Sequence[bool | int],
) -> BooleanFunction: ...


def random_boolean_function(n: int | Integer) -> BooleanFunction: ...
