import builtins
from typing import Self

from sage.structure.element import Element

class _SageObject: ...

class KeyExchangeBase:
    @abstractmethod
    def alice_secret_key(self) -> _SageObject: ...
    @abstractmethod
    def alice_public_key(self, alice_secret_key: builtins.object) -> _SageObject: ...
    @abstractmethod
    def bob_secret_key(self) -> _SageObject: ...
    @abstractmethod
    def bob_public_key(self, bob_secret_key: builtins.object) -> _SageObject: ...
    @abstractmethod
    def alice_compute_shared_secret(
        self, alice_secret_key: builtins.object, bob_public_key: builtins.object
    ) -> _SageObject: ...
    @abstractmethod
    def bob_compute_shared_secret(
        self, bob_secret_key: builtins.object, alice_public_key: builtins.object
    ) -> _SageObject: ...
    @abstractmethod
    def parameters(self) -> tuple[Element, ...]: ...
    def alice_key_pair(self) -> _SageObject: ...
    def bob_key_pair(self) -> _SageObject: ...
    def do_key_exchange(self) -> _SageObject: ...
    @classmethod
    def named_parameter_set(cls, name: builtins.str) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class CommutativeKeyExchangeBase:
    @abstractmethod
    def secret_key(self) -> _SageObject: ...
    @abstractmethod
    def public_key(self, secret_key: builtins.object) -> _SageObject: ...
    @abstractmethod
    def compute_shared_secret(
        self, secret_key: builtins.object, public_key: builtins.object
    ) -> _SageObject: ...
    def alice_secret_key(self) -> _SageObject: ...
    def alice_public_key(self, alice_secret_key: builtins.object) -> _SageObject: ...
    def bob_secret_key(self) -> _SageObject: ...
    def bob_public_key(self, bob_secret_key: builtins.object) -> _SageObject: ...
    def alice_compute_shared_secret(
        self, alice_sk: builtins.object, bob_pk: builtins.object
    ) -> _SageObject: ...
    def bob_compute_shared_secret(
        self, bob_sk: builtins.object, alice_pk: builtins.object
    ) -> _SageObject: ...
