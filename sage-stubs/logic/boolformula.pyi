from collections.abc import Mapping
from typing import Literal, Self

from sage.logic.logictable import Truthtable
from sage.logic.logicparser import (
    BooleanBranch,
    BooleanOperator,
    BooleanParseTree,
)

type OptimizerFormula = (
    tuple[Literal["prop"], str]
    | tuple[Literal["not"], OptimizerFormula]
    | tuple[Literal["and", "or"], OptimizerFormula, OptimizerFormula]
)

latex_operators: list[tuple[str, str]]


class BooleanFormula:
    def __init__(
        self,
        exp: str,
        tree: BooleanParseTree,
        vo: list[str],
    ) -> None: ...
    def __repr__(self) -> str: ...
    def _latex_(self) -> str: ...
    def polish_notation(self) -> str: ...
    def tree(self) -> BooleanParseTree: ...
    def full_tree(self) -> BooleanParseTree: ...
    def __or__(self, other: BooleanFormula) -> Self: ...
    def __and__(self, other: BooleanFormula) -> Self: ...
    def __xor__(self, other: BooleanFormula) -> Self: ...
    def __pow__(self, other: BooleanFormula) -> Self: ...
    def __invert__(self) -> Self: ...
    def ifthen(self, other: BooleanFormula) -> Self: ...
    def iff(self, other: BooleanFormula) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    def truthtable(
        self,
        start: int = ...,
        end: int = ...,
    ) -> Truthtable: ...
    def evaluate(
        self,
        var_values: Mapping[str, bool],
    ) -> bool: ...
    def is_satisfiable(self) -> bool: ...
    def is_tautology(self) -> bool: ...
    def is_contradiction(self) -> bool: ...
    def is_consequence(
        self,
        *hypotheses: BooleanFormula,
    ) -> bool: ...
    def implies(self, other: BooleanFormula) -> bool: ...
    def equivalent(self, other: BooleanFormula) -> bool: ...
    def convert_cnf_table(self) -> None: ...
    convert_cnf = convert_cnf_table
    def convert_cnf_recur(self) -> None: ...
    def satformat(self) -> str: ...
    def convert_opt(self, tree: BooleanBranch) -> OptimizerFormula: ...
    def add_statement(
        self,
        other: BooleanFormula,
        op: BooleanOperator,
    ) -> Self: ...
    def get_bit(self, x: int, c: int) -> bool: ...
    def reduce_op(self, tree: BooleanBranch) -> BooleanParseTree: ...
    def dist_not(self, tree: BooleanBranch) -> BooleanParseTree: ...
    def dist_ors(self, tree: BooleanBranch) -> BooleanParseTree: ...
    def to_infix(self, tree: BooleanBranch) -> BooleanParseTree: ...
    def convert_expression(self) -> None: ...
    def get_next_op(self, expression: str) -> str: ...
    def length(self) -> int: ...
    __len__ = length


def is_consequence(
    conclusion: BooleanFormula,
    *hypotheses: BooleanFormula,
) -> bool: ...
