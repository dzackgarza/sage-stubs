from collections.abc import Callable, Sequence
from typing import Literal, TypeVar

from sage.logic.boolformula import BooleanFormula

type BooleanOperator = Literal["~", "&", "|", "^", "->", "<->"]
type BooleanParseTree = str | list[BooleanParseTree | None]
type BooleanBranch = list[BooleanParseTree | None]
type BooleanTokenList = list[str]

_Result = TypeVar("_Result")


def parse(s: str) -> tuple[BooleanParseTree, list[str]]: ...
def polish_parse(s: str) -> BooleanParseTree: ...
def get_trees(
    *statements: str | BooleanFormula,
) -> list[BooleanParseTree]: ...
def recover_formula(prefix_tree: BooleanParseTree) -> str: ...
def recover_formula_internal(prefix_tree: BooleanBranch) -> str: ...
def prefix_to_infix(prefix_tree: BooleanParseTree) -> BooleanParseTree: ...
def to_infix_internal(prefix_tree: BooleanBranch) -> BooleanParseTree: ...
def tokenize(s: str) -> tuple[BooleanTokenList, list[str]]: ...
def tree_parse(
    toks: BooleanTokenList,
    polish: bool = ...,
) -> BooleanParseTree: ...
def parse_ltor(
    toks: Sequence[str | BooleanParseTree],
    n: int = ...,
    polish: bool = ...,
) -> BooleanParseTree: ...
def apply_func(
    tree: BooleanParseTree,
    func: Callable[[BooleanBranch], _Result],
) -> _Result: ...
