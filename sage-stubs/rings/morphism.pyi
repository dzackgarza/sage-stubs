from sage.categories.homset import Homset
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.ideal import Ideal_generic
from sage.rings.integer import Integer
from sage.rings.polynomial.term_order import TermOrder
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent

class RingMap(Morphism):
    def _repr_type(self) -> str: ...

class RingMap_lift(RingMap):
    S: Parent
    to_S: Map

    def __init__(self, R: Parent, S: Parent) -> None: ...
    def __hash__(self) -> int: ...

class RingHomomorphism(RingMap):
    _lift: Morphism
    _cached_methods: dict[str, object]

    def __init__(self, parent: Homset) -> None: ...
    def pushforward(self, I: Element) -> Ideal_generic: ...
    def inverse_image(self, I: Ideal_generic | Element) -> Ideal_generic | Element: ...
    def kernel(self) -> Ideal_generic: ...
    def lift(self, x: Element | None = None) -> Element: ...
    def inverse(self) -> RingHomomorphism: ...
    def is_surjective(self) -> bool: ...
    def is_invertible(self) -> bool: ...

class RingHomomorphism_im_gens(RingHomomorphism):
    _im_gens: object
    _base_map: object

    def __init__(
        self,
        parent: Homset,
        im_gens: list[Element] | tuple[Element, ...],
        check: bool = True,
        base_map: RingHomomorphism | None = None,
    ) -> None: ...
    def im_gens(self) -> list[Element]: ...
    def base_map(self) -> RingHomomorphism | None: ...
    def __hash__(self) -> int: ...

class RingHomomorphism_from_base(RingHomomorphism):
    _underlying: object

    def __init__(self, parent: Homset, underlying: RingHomomorphism) -> None: ...
    def underlying_map(self) -> RingHomomorphism: ...
    def inverse(self) -> RingHomomorphism: ...

class RingHomomorphism_from_fraction_field(RingHomomorphism):
    _morphism: object

    def __init__(self, parent: Homset, morphism: RingHomomorphism) -> None: ...
    def inverse(self) -> RingHomomorphism: ...

class RingHomomorphism_cover(RingHomomorphism):
    def __init__(self, parent: Homset) -> None: ...
    def kernel(self) -> Ideal_generic: ...
    def __hash__(self) -> int: ...

class RingHomomorphism_from_quotient(RingHomomorphism):
    phi: object

    def __init__(self, parent: Homset, phi: RingHomomorphism) -> None: ...
    def morphism_from_cover(self) -> RingHomomorphism: ...
    def __hash__(self) -> int: ...

class FrobeniusEndomorphism_generic(RingHomomorphism):
    _p: Integer
    _q: Integer
    _power: int

    def __init__(self, domain: Ring | Homset, n: int = 1) -> None: ...
    def power(self) -> int: ...
    def __hash__(self) -> int: ...
    @staticmethod
    def term_order(A: Ring) -> TermOrder: ...
    @staticmethod
    def relations(A: Ring, R_gens_A: list[Element]) -> list[Element]: ...
