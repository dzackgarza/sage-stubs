from collections.abc import Callable, Iterator
from typing import Self

from sage.combinat.sf.sfa import SymmetricFunctionAlgebra_generic_Element
from sage.data_structures.stream import Stream
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.lazy_series_ring import LazySeriesRing
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.power_series_ring_element import PowerSeries
from sage.rings.ring import Ring
from sage.structure.element import Element

class LazyModuleElement(Element):
    def __init__(self, parent: LazySeriesRing, coeff_stream: Stream) -> None: ...
    def __getitem__(self, n: int) -> Element: ...
    def coefficients(self, n: int | None = None) -> Iterator[Element]: ...
    def map_coefficients(self, f: Callable[[Element], Element]) -> Self: ...
    def truncate(self, d: int) -> Self: ...
    def restrict(self, min_degree: int | None = None, max_degree: int | None = None) -> Self: ...
    def shift(self, n: int) -> Self: ...
    def prec(self) -> int | PlusInfinity: ...
    def lift_to_precision(self, absprec: int | None = None) -> Self: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def is_nonzero(self, proof: bool = False) -> bool: ...
    def is_trivial_zero(self) -> bool: ...
    def define(self, s: object) -> None: ...
    def change_ring(self, ring: Ring) -> Self: ...
    def exp(self) -> Self: ...
    def log(self) -> Self: ...
    def sin(self) -> Self: ...
    def cos(self) -> Self: ...
    def tan(self) -> Self: ...
    def cot(self) -> Self: ...
    def csc(self) -> Self: ...
    def sec(self) -> Self: ...
    def arcsin(self) -> Self: ...
    def arccos(self) -> Self: ...
    def arctan(self) -> Self: ...
    def arccot(self) -> Self: ...
    def sinh(self) -> Self: ...
    def cosh(self) -> Self: ...
    def tanh(self) -> Self: ...
    def coth(self) -> Self: ...
    def sech(self) -> Self: ...
    def csch(self) -> Self: ...
    def arcsinh(self) -> Self: ...
    def arctanh(self) -> Self: ...
    def hypergeometric(self, a: object, b: object) -> Self: ...
    def q_pochhammer(self, q: Element | None = None) -> Self: ...
    def euler(self) -> Self: ...
    def jacobi_theta(self, w: Element, a: object = 0, b: object = 0) -> Self: ...
    def polylog(self, s: object) -> Self: ...
    def dilog(self) -> Self: ...
    def __pow__(self, n: object) -> Self: ...
    def sqrt(self) -> Self: ...
    def nth_root(self, n: int) -> Self: ...

class LazyCauchyProductSeries(LazyModuleElement):
    def valuation(self) -> Integer: ...
    def __pow__(self, n: object) -> Self: ...
    def __invert__(self) -> Self: ...
    def exp(self) -> Self: ...
    def log(self) -> Self: ...

class LazyLaurentSeries(LazyCauchyProductSeries):
    def is_square(self, root: bool = False) -> bool: ...
    def is_unit(self) -> bool: ...
    def __call__(self, g: object) -> Element: ...
    compose = __call__
    def revert(self) -> Self: ...
    compositional_inverse = revert
    def derivative(self, *args: object) -> Self: ...
    def integral(self, variable: object = None, *, constants: object = None) -> Self: ...
    def approximate_series(self, prec: int, name: str | None = None) -> PowerSeries: ...
    def polynomial(self, degree: int | None = None, name: str | None = None) -> Polynomial: ...

class LazyPowerSeries(LazyCauchyProductSeries):
    def is_unit(self) -> bool: ...
    def exponential(self) -> Self: ...
    def compute_coefficients(self, i: int) -> Element: ...
    def __call__(self, *g: object) -> Element: ...
    compose = __call__
    def revert(self) -> Self: ...
    compositional_inverse = revert
    def hadamard_product(self, other: LazyPowerSeries) -> Self: ...
    def egf_to_ogf(self) -> Self: ...
    def ogf_to_egf(self) -> Self: ...
    def derivative(self, *args: object) -> Self: ...
    def adams_operator(self, p: object) -> Self: ...
    def integral(self, variable: object = None, *, constants: object = None) -> Self: ...
    def polynomial(self, degree: int | None = None, names: object = None) -> Polynomial: ...
    def add_bigoh(self, prec: int) -> PowerSeries: ...
    O = add_bigoh

class LazyPowerSeries_gcd_mixin:
    def gcd(self, other: LazyPowerSeries) -> LazyPowerSeries: ...
    def xgcd(self, f: LazyPowerSeries) -> tuple[LazyPowerSeries, LazyPowerSeries, LazyPowerSeries]: ...

class LazyCompletionGradedAlgebraElement(LazyCauchyProductSeries): ...

class LazySymmetricFunction(LazyCompletionGradedAlgebraElement):
    def is_unit(self) -> bool: ...
    def __call__(self, *args: object) -> Self: ...
    def revert(self) -> Self: ...
    compositional_inverse = revert
    def legendre_transform(self) -> Self: ...
    def derivative_with_respect_to_p1(self, n: int = 1) -> Self: ...
    def suspension(self) -> Self: ...
    def functorial_composition(self, *args: object) -> Self: ...
    def arithmetic_product(self, *args: object) -> Self: ...
    def symmetric_function(self, degree: int | None = None) -> SymmetricFunctionAlgebra_generic_Element: ...

class LazyDirichletSeries(LazyModuleElement):
    def is_unit(self) -> bool: ...
    def valuation(self) -> int: ...
    def __invert__(self) -> Self: ...
    def __call__(self, p: object) -> Element: ...

class LazyPseudoDifferentialOperator(LazyModuleElement):
    def valuation(self) -> Integer: ...
    def __invert__(self) -> Self: ...
    def is_unit(self) -> bool: ...
    def __pow__(self, n: object) -> Self: ...
    def nth_root(self, n: int) -> Self: ...
    def star(self) -> Self: ...
