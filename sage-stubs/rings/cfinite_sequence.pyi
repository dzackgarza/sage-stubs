from collections.abc import Iterator

from sage.rings.fraction_field import FractionField_generic
from sage.rings.fraction_field_element import FractionFieldElement
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.polynomial.polynomial_ring import PolynomialRing_generic
from sage.rings.ring import CommutativeRing
from sage.structure.element import Element, FieldElement
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation
from sage.symbolic.expression import Expression

def CFiniteSequences(base_ring: CommutativeRing, names: str | tuple[str, ...] | None = None, category: object = None) -> CFiniteSequences_generic: ...

class CFiniteSequence(FieldElement):
    def __init__(self, parent: CFiniteSequences_generic, ogf: FractionFieldElement) -> None: ...
    def __hash__(self) -> int: ...
    def coefficients(self) -> Iterator[Element]: ...
    def __eq__(self, other: object) -> bool: ...
    def __getitem__(self, key: int) -> Element: ...
    def ogf(self) -> FractionFieldElement: ...
    def numerator(self) -> Polynomial: ...
    def denominator(self) -> Polynomial: ...
    def recurrence_repr(self) -> str: ...
    def series(self, n: int) -> list[Element]: ...
    def closed_form(self, n: str = "n") -> Expression: ...

class CFiniteSequences_generic(Parent, UniqueRepresentation):
    def __init__(self, polynomial_ring: PolynomialRing_generic, category: object) -> None: ...
    def ngens(self) -> int: ...
    def gen(self, i: int = 0) -> CFiniteSequence: ...
    def gens(self) -> tuple[CFiniteSequence, ...]: ...
    def an_element(self) -> CFiniteSequence: ...
    def __contains__(self, x: object) -> bool: ...
    def fraction_field(self) -> FractionField_generic: ...
    def polynomial_ring(self) -> PolynomialRing_generic: ...
    def from_recurrence(self, coefficients: list[Element], values: list[Element]) -> CFiniteSequence: ...
    def guess(self, sequence: list[Element] | tuple[Element, ...], algorithm: str = "sage") -> CFiniteSequence: ...
