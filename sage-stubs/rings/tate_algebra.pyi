from sage.categories.rings import Rings
from sage.monoids.monoid import Monoid_class
from sage.rings.polynomial.term_order import TermOrder
from sage.rings.rational import Rational
from sage.rings.ring import Ring
from sage.structure.element import Element, RingElement
from sage.structure.factory import (
    FactoryArgument,
    FactoryCacheKey,
    FactoryVersion,
    UniqueFactory,
)
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class TateAlgebraFactory(UniqueFactory):
    def create_key(self, *args: FactoryArgument, **kwds: FactoryArgument) -> FactoryCacheKey: ...
    def create_object(self, version: FactoryVersion, key: FactoryCacheKey, **extra_args: FactoryArgument) -> TateAlgebra_generic: ...

class TateTermMonoid(Monoid_class, UniqueRepresentation):
    def __init__(self, A: TateAlgebra_generic) -> None: ...
    def prime(self) -> Element: ...
    def algebra_of_series(self) -> TateAlgebra_generic: ...
    def base_ring(self) -> Rings.ParentMethods[RingElement] | None: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def log_radii(self) -> list[Rational]: ...
    def term_order(self) -> TermOrder: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple[Element, ...]: ...
    def gen(self, n: int = 0) -> Element: ...
    def some_elements(self) -> list[Element]: ...

class TateAlgebra_generic(Parent):
    def __init__(self, field: Ring, prec: object, log_radii: object, names: str | tuple[str, ...], order: object, integral: bool = False) -> None: ...
    def prime(self) -> Element: ...
    def gen(self, n: int = 0) -> Element: ...
    def gens(self) -> tuple[Element, ...]: ...
    def ngens(self) -> int: ...
    def some_elements(self) -> list[Element]: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def log_radii(self) -> list[Rational]: ...
    def integer_ring(self) -> TateAlgebra_generic: ...
    def monoid_of_terms(self) -> TateTermMonoid: ...
    def term_order(self) -> TermOrder: ...
    def precision_cap(self) -> int: ...
    def absolute_e(self) -> Element: ...
    def characteristic(self) -> int: ...
    def random_element(self, degree: int = 2, terms: int = 5, integral: bool = False, prec: int | None = None) -> Element: ...
    def is_integral_domain(self, proof: bool = True) -> bool: ...
