from sage.modules.module import Module
from sage.rings.morphism import RingHomomorphism
from sage.rings.ring import Ring
from sage.sets.family import Family
from sage.structure.element import Element, ModuleElement
from sage.structure.unique_representation import UniqueRepresentation

class RingDerivationModule(Module, UniqueRepresentation):
    def __init__(self, domain: Ring, codomain: Ring, twist: RingHomomorphism | None = None) -> None: ...
    def __hash__(self) -> int: ...
    def domain(self) -> Ring: ...
    def codomain(self) -> Ring: ...
    def defining_morphism(self) -> RingHomomorphism: ...
    def twisting_morphism(self) -> RingHomomorphism: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple[RingDerivation, ...]: ...
    def gen(self, n: int = 0) -> RingDerivation: ...
    def basis(self) -> Family: ...
    def dual_basis(self) -> Family: ...
    def ring_of_constants(self) -> Ring: ...
    def random_element(self, *args: object, **kwds: object) -> RingDerivation: ...
    def some_elements(self) -> list[RingDerivation]: ...

class RingDerivation(ModuleElement):
    def __call__(self, x: Element) -> Element: ...
    def domain(self) -> Ring: ...
    def codomain(self) -> Ring: ...

class RingDerivationWithoutTwist(RingDerivation):
    def list(self) -> list[Element]: ...
    def monomial_coefficients(self, copy: object = None) -> dict[object, Element]: ...
    def is_zero(self) -> bool: ...
    def pth_power(self) -> RingDerivationWithoutTwist: ...
    def precompose(self, morphism: RingHomomorphism) -> RingDerivationWithoutTwist: ...
    def postcompose(self, morphism: RingHomomorphism) -> RingDerivationWithoutTwist: ...
    def extend_to_fraction_field(self) -> RingDerivationWithoutTwist: ...

class RingDerivationWithoutTwist_zero(RingDerivationWithoutTwist):
    def __init__(self, parent: RingDerivationModule, arg: object = None) -> None: ...
    def __hash__(self) -> int: ...
    def is_zero(self) -> bool: ...
    def list(self) -> list[Element]: ...

class RingDerivationWithoutTwist_wrapper(RingDerivationWithoutTwist):
    def __init__(self, parent: RingDerivationModule, arg: object = None) -> None: ...
    def __hash__(self) -> int: ...
    def list(self) -> list[Element]: ...

class RingDerivationWithoutTwist_function(RingDerivationWithoutTwist):
    def __init__(self, parent: RingDerivationModule, arg: object = None) -> None: ...
    def __hash__(self) -> int: ...
    def is_zero(self) -> bool: ...
    def list(self) -> list[Element]: ...

class RingDerivationWithoutTwist_fraction_field(RingDerivationWithoutTwist_wrapper):
    def __hash__(self) -> int: ...

class RingDerivationWithoutTwist_quotient(RingDerivationWithoutTwist_wrapper):
    def __hash__(self) -> int: ...

class RingDerivationWithTwist_generic(RingDerivation):
    def __init__(self, parent: RingDerivationModule, scalar: Element | int = 0) -> None: ...
    def __hash__(self) -> int: ...
    def list(self) -> list[Element]: ...
    def precompose(self, morphism: RingHomomorphism) -> RingDerivationWithTwist_generic: ...
    def postcompose(self, morphism: RingHomomorphism) -> RingDerivationWithTwist_generic: ...
    def extend_to_fraction_field(self) -> RingDerivationWithTwist_generic: ...
