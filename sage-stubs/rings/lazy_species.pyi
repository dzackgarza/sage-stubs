from collections.abc import Iterator
from typing import Self

from sage.misc.inherit_comparison import InheritComparisonClasscallMetaclass
from sage.rings.lazy_series import LazyCompletionGradedAlgebraElement
from sage.rings.lazy_series_ring import LazyCompletionGradedAlgebra, LazyPowerSeriesRing
from sage.rings.power_series_ring_element import PowerSeries
from sage.structure.element import Element
from sage.structure.unique_representation import UniqueRepresentation

class LazyCombinatorialSpeciesElement(LazyCompletionGradedAlgebraElement):
    def isotype_generating_series(self) -> PowerSeries: ...
    def generating_series(self) -> PowerSeries: ...
    def cycle_index_series(self) -> PowerSeries: ...
    def restrict(self, min_degree: int | None = None, max_degree: int | None = None) -> RestrictedSpeciesElement: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def isotypes(self, *shape: object) -> Iterator[object]: ...
    def polynomial(self, degree: int | None = None, names: object = None) -> Element: ...
    def __call__(self, *args: LazyCombinatorialSpeciesElement) -> LazyCombinatorialSpeciesElement: ...
    def revert(self) -> Self: ...
    def combinatorial_logarithm(self) -> Self: ...
    def functorial_composition(self, *args: LazyCombinatorialSpeciesElement, algorithm: str = "subgroups") -> FunctorialCompositionSpeciesElement: ...
    def arithmetic_product(self, other: LazyCombinatorialSpeciesElement) -> ArithmeticProductSpeciesElement: ...
    def hadamard_product(self, other: LazyCombinatorialSpeciesElement) -> HadamardProductSpeciesElement: ...

class LazyCombinatorialSpeciesElementGeneratingSeriesMixin:
    def isotype_generating_series(self) -> PowerSeries: ...
    def generating_series(self) -> PowerSeries: ...

class SumSpeciesElement(LazyCombinatorialSpeciesElement):
    def __init__(self, left: LazyCombinatorialSpeciesElement, right: LazyCombinatorialSpeciesElement) -> None: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...

class ProductSpeciesElement(LazyCombinatorialSpeciesElement):
    def __init__(self, left: LazyCombinatorialSpeciesElement, right: LazyCombinatorialSpeciesElement) -> None: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...

class CompositionSpeciesElement(LazyCombinatorialSpeciesElementGeneratingSeriesMixin, LazyCombinatorialSpeciesElement):
    def __init__(self, left: LazyCombinatorialSpeciesElement, *args: LazyCombinatorialSpeciesElement) -> None: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def cycle_index_series(self) -> PowerSeries: ...

class FunctorialCompositionSpeciesElement(LazyCombinatorialSpeciesElement):
    def __init__(self, left: LazyCombinatorialSpeciesElement, *args: LazyCombinatorialSpeciesElement, algorithm: str) -> None: ...
    def generating_series(self) -> PowerSeries: ...

class ArithmeticProductSpeciesElement(LazyCombinatorialSpeciesElement):
    def __init__(self, F: LazyCombinatorialSpeciesElement, G: LazyCombinatorialSpeciesElement) -> None: ...

class HadamardProductSpeciesElement(LazyCombinatorialSpeciesElement):
    def __init__(self, left: LazyCombinatorialSpeciesElement, other: LazyCombinatorialSpeciesElement) -> None: ...

class LazyCombinatorialSpecies(LazyCompletionGradedAlgebra):
    def __init__(self, base_ring: object, names: str | tuple[str, ...], sparse: bool) -> None: ...

class LazyCombinatorialSpeciesUnivariate(LazyCombinatorialSpecies):
    def Sets(self) -> SetSpecies: ...
    def Cycles(self) -> CycleSpecies: ...
    def Polygons(self) -> PolygonSpecies: ...
    def OrientedSets(self) -> OrientedSetSpecies: ...
    def Chains(self) -> ChainSpecies: ...
    def Graphs(self) -> GraphSpecies: ...
    def SetPartitions(self) -> SetPartitionSpecies: ...

class LazyCombinatorialSpeciesMultivariate(LazyCombinatorialSpecies): ...

class SetSpecies(LazyCombinatorialSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...
    def cycle_index_series(self) -> PowerSeries: ...

class CycleSpecies(LazyCombinatorialSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...

class PolygonSpecies(LazyCombinatorialSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...

class OrientedSetSpecies(LazyCombinatorialSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...

class ChainSpecies(LazyCombinatorialSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...
    def cycle_index_series(self) -> PowerSeries: ...

class GraphSpecies(LazyCombinatorialSpeciesElementGeneratingSeriesMixin, LazyCombinatorialSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...
    def isotypes(self, *shape: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def cycle_index_series(self) -> PowerSeries: ...

class SetPartitionSpecies(CompositionSpeciesElement, UniqueRepresentation, metaclass=InheritComparisonClasscallMetaclass):
    def __copy__(self) -> Self: ...
    def __init__(self, parent: LazyCombinatorialSpeciesUnivariate) -> None: ...
    def isotypes(self, *shape: object) -> Iterator[object]: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...

class RestrictedSpeciesElement(LazyCombinatorialSpeciesElement):
    def __init__(self, F: LazyCombinatorialSpeciesElement, min_degree: int, max_degree: int) -> None: ...
    def isotypes(self, *shape: object) -> Iterator[object]: ...
    def structures(self, *labels: object) -> Iterator[object]: ...
    def generating_series(self) -> PowerSeries: ...
    def isotype_generating_series(self) -> PowerSeries: ...
    def cycle_index_series(self) -> PowerSeries: ...
