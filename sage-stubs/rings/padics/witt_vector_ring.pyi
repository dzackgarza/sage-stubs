        self,
        coefficient_ring: ElementConstructorInput,
        prec: int | Integer,
        prime: int | Integer,
        algorithm: str,
    ) -> None: ...
    def __iter__(self) -> Iterator[WittVectorRing]: ...
    def cardinality(self) -> int | Integer: ...
    def characteristic(self) -> int | Integer: ...
    def coefficient_ring(self) -> Ring: ...
    def frobenius_morphism(
        self, truncate: Polynomial | MPolynomial = ...
    ) -> Morphism: ...
    def frobenius_polynomials(
        self, variables: Polynomial | MPolynomial = ...
    ) -> WittVectorRing: ...
    def gen(self, n: int | Integer = ...) -> WittVectorRing: ...
    def gens(self) -> tuple[WittVectorRing, ...]: ...
    def is_exact(self) -> bool: ...
    def is_field(self, proof: bool = ...) -> bool: ...
    def is_finite(self) -> bool: ...
    def is_integral_domain(self, proof: bool = ...) -> bool: ...
    def is_integrally_closed(self) -> bool: ...
    def is_prime_field(self) -> bool: ...
    def ngens(self) -> int | Integer: ...
    def precision(self) -> WittVectorRing: ...
    def prime(self) -> WittVectorRing: ...
    def prod_polynomials(
        self, variables: Polynomial | MPolynomial = ...
    ) -> WittVectorRing: ...
    def random_element(
        self, *args: ElementConstructorInput, **kwds: ElementConstructorInput
    ) -> WittVectorRing: ...
    def sum_polynomials(
        self, variables: Polynomial | MPolynomial = ...
    ) -> WittVectorRing: ...
    def teichmuller_lift(
        self, x: WittVectorRing | ElementConstructorInput
    ) -> WittVectorRing: ...
    def verschiebung(
        self, extend: Polynomial | MPolynomial = ...
    ) -> WittVectorRing: ...
    def _coerce_map_from_(self, S: Ring | Parent) -> bool: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...

