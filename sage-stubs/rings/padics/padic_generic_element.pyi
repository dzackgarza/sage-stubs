    ) -> Self: ...
    def exp(
        self, aprec: ElementConstructorInput | None = ..., algorithm: str | None = ...
    ) -> Self: ...
    def gamma(self, algorithm: str | None = ...) -> Self: ...
    def gcd(self, other: pAdicGenericElement | ElementConstructorInput) -> Self: ...
    def is_prime(self) -> bool: ...
    def is_square(self) -> bool | tuple[bool, Self]: ...
    def is_squarefree(self) -> bool: ...
    def log(
        self,
        p_branch: ElementConstructorInput | None = ...,
        pi_branch: ElementConstructorInput | None = ...,
        aprec: ElementConstructorInput | None = ...,
        change_frac: ElementConstructorInput = ...,
        algorithm: str | None = ...,
    ) -> Self: ...
    def minimal_polynomial(
        self, name: str | None = ..., base: ElementConstructorInput | None = ...
    ) -> Polynomial: ...
    def multiplicative_order(
        self, prec: int | Integer | None = ...
    ) -> Integer | PlusInfinity: ...
    def norm(
        self, base: ElementConstructorInput | None = ...
    ) -> NumberFieldElement | Rational: ...
    def nth_root(self, n: int | Integer, all: bool = ...) -> Self | list[Self]: ...
    def ordp(
        self, p: int | Integer | FunctionFieldPlace | NumberFieldIdeal | None = ...
    ) -> Integer | PlusInfinity: ...
    def polylog(
        self, n: int | Integer, p_branch: ElementConstructorInput = ...
    ) -> Self: ...
    def rational_reconstruction(self) -> Rational: ...
    def square_root(
        self, extend: bool = ..., all: bool = ..., algorithm: str | None = ...
    ) -> Self | list[Self]: ...
    def str(self, mode: str | None = ...) -> str: ...
