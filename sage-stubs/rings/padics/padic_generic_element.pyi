        self, other: pAdicGenericElement | ElementConstructorInput
    ) -> tuple[Self, Self, Self]: ...
    def _AHE_direct(
        self,
        prec: int | Integer | None,
        exp_algorithm: ElementConstructorInput | None = ...,
    ) -> Self: ...
    def _AHE_newton(
        self,
        prec: int | Integer | None,
        log_algorithm: ElementConstructorInput | None = ...,
    ) -> Self: ...
    def _AHE_series(self, prec: int | Integer | None) -> Self: ...
    def __abs__(self) -> RealNumber: ...
    def _exp_binary_splitting(self, aprec: ElementConstructorInput) -> Self: ...
    def _exp_generic(self, aprec: ElementConstructorInput) -> Self: ...
    def _exp_newton(
        self,
        aprec: ElementConstructorInput,
        log_algorithm: ElementConstructorInput | None = ...,
    ) -> Self: ...
    def _floordiv_(
        self, right: pAdicGenericElement | ElementConstructorInput
    ) -> Self: ...
    def _im_gens_(
        self,
        codomain: Parent,
        im_gens: Sequence[ElementConstructorInput],
        base_map: Map | Morphism | None = ...,
    ) -> Self: ...
    def _inverse_pth_root(
        self,
        twist: ElementConstructorInput | None = ...,
        hint: ElementConstructorInput | None = ...,
    ) -> Self: ...
    def _log_binary_splitting(
        self, aprec: ElementConstructorInput, mina: ElementConstructorInput = ...
    ) -> Self: ...
    def _log_generic(
        self, aprec: ElementConstructorInput, mina: ElementConstructorInput = ...
    ) -> Self: ...
    def _mod_(self, right: pAdicGenericElement | ElementConstructorInput) -> Self: ...
    def _number_field_(
        self, K: NumberField_generic | FunctionField | Field
    ) -> Self: ...
    def _polylog_res_1(
        self, n: int | Integer, p_branch: ElementConstructorInput = ...
    ) -> Self: ...
    def _quo_rem(
        self, right: pAdicGenericElement | ElementConstructorInput
    ) -> Self: ...
    def _rational_(self) -> Rational: ...
    def _richcmp_(
        left: pAdicGenericElement | ElementConstructorInput,
        right: pAdicGenericElement | ElementConstructorInput,
        op: int,
    ) -> bool: ...
    def abs(self, prec: int | Integer | None = ...) -> Self: ...
    def val_unit(self) -> Self: ...

