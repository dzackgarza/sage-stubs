from typing import Self

from sage.rings.integer import Integer
from sage.rings.padics.padic_generic import pAdicGeneric
from sage.rings.ring import Ring
from sage.structure.element import CommutativeRingElement, Vector
from sage.structure.parent import ElementConstructorInput

class WittVector(CommutativeRingElement):
    def __init__(
        self, parent: pAdicGeneric, vec: ElementConstructorInput = ...
    ) -> None: ...
    def __getitem__(self, i: int | Integer) -> WittVector: ...
    def __hash__(self) -> int: ...
    def __invert__(self) -> Self: ...
    def __len__(self) -> int | Integer: ...
    def additive_order(self) -> WittVector: ...
    def coordinates(self) -> WittVector: ...
    def is_unit(self) -> bool: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...
    def _richcmp_(
        self, other: WittVector | ElementConstructorInput, op: ElementConstructorInput
    ) -> bool: ...
    def _vector_(self, R: Ring | None = ...) -> Vector: ...

class WittVector_phantom(WittVector):
    def __init__(
        self,
        parent: pAdicGeneric,
        vec: ElementConstructorInput = ...,
        phantom: ElementConstructorInput = ...,
    ) -> None: ...
    def __getitem__(self, i: int | Integer) -> WittVector_phantom: ...
    def coordinates(self) -> WittVector_phantom: ...
    def phantom(self, lift: Ring = ...) -> WittVector_phantom: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...
    def _richcmp_(
        self,
        other: WittVector_phantom | ElementConstructorInput,
        op: ElementConstructorInput,
    ) -> bool: ...
    def _vector_(self, R: Ring) -> Vector: ...

class WittVector_finotti(WittVector): ...
class WittVector_pinvertible(WittVector): ...
class WittVector_standard(WittVector): ...
