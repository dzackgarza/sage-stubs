from collections.abc import Callable
from typing import Self

from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.padics.padic_generic import pAdicGeneric
from sage.rings.padics.padic_generic_element import pAdicGenericElement
from sage.rings.rational import Rational
from sage.rings.valuation.valuation import DiscretePseudoValuation
from sage.structure.element import RingElement
from sage.structure.parent import ElementConstructorInput

def unpickle_le(
    parent: pAdicGeneric,
    value: RingElement | int | Integer | Rational,
    prec: int | Integer,
) -> pAdicGenericElement: ...

class pAdicLatticeElement(pAdicGenericElement):
    def __init__(
        self,
        parent: pAdicGeneric,
        x: pAdicLatticeElement | ElementConstructorInput,
        prec: int | Integer = ...,
        dx: ElementConstructorInput = ...,
        dx_mode: ElementConstructorInput = ...,
        valuation: DiscretePseudoValuation = ...,
        check: bool = ...,
        reduce: bool = ...,
    ) -> None: ...
    def __reduce__(
        self,
    ) -> tuple[Callable[..., Self], tuple[ElementConstructorInput, ...]]: ...
    def approximation(self) -> Self: ...
    def value(self) -> Integer | PlusInfinity: ...
    def residue(
        self,
        absprec: int | Integer = ...,
        field: pAdicGeneric = ...,
        check_prec: int | Integer = ...,
    ) -> Self: ...
    def precision_lattice(self) -> Self: ...
    def precision_absolute(self) -> int | Integer: ...
    def is_precision_capped(self) -> bool: ...
    def valuation(
        self, secure: ElementConstructorInput = ...
    ) -> Integer | PlusInfinity: ...
    def precision_relative(
        self, secure: ElementConstructorInput = ...
    ) -> int | Integer: ...
    def is_equal_to(
        self, other: pAdicLatticeElement | ElementConstructorInput, prec: int | Integer
    ) -> bool: ...
    def __invert__(self) -> Self: ...
    def add_bigoh(self, prec: int | Integer) -> Self: ...
    def lift_to_precision(
        self, prec: int | Integer = ..., infer_precision: int | Integer = ...
    ) -> int | Integer: ...
    def is_zero(self, prec: int | Integer = ...) -> bool: ...
    def lift(self) -> pAdicLatticeElement: ...
    def __rshift__(self, n: int | Integer) -> Self: ...
    def __lshift__(self, n: int | Integer) -> Self: ...
    def unit_part(self) -> Self: ...
    def val_unit(self) -> Self: ...
    def __copy__(self) -> Self: ...
    def expansion(
        self,
        n: int | Integer = ...,
        lift_mode: int | Integer = ...,
        start_val: int | Integer = ...,
    ) -> Self: ...
    def dist(self, other: pAdicLatticeElement | ElementConstructorInput) -> Self: ...
    def _richcmp_(
        self,
        other: pAdicLatticeElement | ElementConstructorInput,
        op: ElementConstructorInput,
    ) -> bool: ...

class pAdicLatticeCapElement(pAdicLatticeElement): ...
class pAdicLatticeFloatElement(pAdicLatticeElement): ...
