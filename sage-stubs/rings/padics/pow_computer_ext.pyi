from collections.abc import Callable

from sage.rings.integer import Integer
from sage.rings.padics.pow_computer import PowComputer_class
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Element
from sage.structure.factory import FactoryArgument

class ntl_ZZ_pContext_class: ...
class ntl_ZZ_pX: ...
class ZZ_pX_Modulus_c: ...

class PowComputer_ext(PowComputer_class):
    def __init__(self, prime: Integer, cache_limit: int, prec_cap: int, ram_prec_cap: int, in_field: bool, poly: Polynomial, shift_seed: Element | None = None) -> None: ...
    def __reduce__(self) -> tuple[Callable[..., PowComputer_class], tuple[FactoryArgument, ...]]: ...
    def _pow_ZZ_tmp_test(self, n: int) -> Integer: ...
    def _pow_ZZ_tmp_demo(self, m: int, n: int) -> list[Integer]: ...
    def _pow_ZZ_top_test(self) -> Integer: ...
    def _ram_prec_cap(self) -> int: ...

class PowComputer_ZZ_pX(PowComputer_ext):
    def polynomial(self) -> Polynomial: ...
    def _get_context_test(self, n: int) -> ntl_ZZ_pContext_class: ...
    def _get_context_capdiv_test(self, n: int) -> ntl_ZZ_pContext_class: ...
    def speed_test(self, n: int, runs: int) -> None: ...
    def _get_top_context_test(self) -> ntl_ZZ_pContext_class: ...
    def _restore_context_test(self, n: int) -> ntl_ZZ_pContext_class: ...
    def _restore_context_capdiv_test(self, n: int) -> ntl_ZZ_pContext_class: ...
    def _restore_top_context_test(self) -> ntl_ZZ_pContext_class: ...
    def _get_modulus_test(self, a: ntl_ZZ_pX, b: ntl_ZZ_pX, n: Integer) -> ZZ_pX_Modulus_c: ...
    def _get_top_modulus_test(self, a: ntl_ZZ_pX, b: ntl_ZZ_pX) -> ZZ_pX_Modulus_c: ...
    def _capdiv_test(self, n: int) -> int: ...

class PowComputer_ZZ_pX_FM(PowComputer_ZZ_pX): ...

class PowComputer_ZZ_pX_FM_Eis(PowComputer_ZZ_pX_FM):
    def _low_shifter(self, i: int) -> ntl_ZZ_pX: ...
    def _high_shifter(self, i: int) -> ntl_ZZ_pX: ...

class PowComputer_ZZ_pX_small(PowComputer_ZZ_pX): ...

class PowComputer_ZZ_pX_small_Eis(PowComputer_ZZ_pX_small):
    def _low_shifter(self, i: int) -> ntl_ZZ_pX: ...
    def _high_shifter(self, i: int) -> ntl_ZZ_pX: ...

class PowComputer_ZZ_pX_big(PowComputer_ZZ_pX):
    def reset_dictionaries(self) -> None: ...
    def _context_dict(self) -> dict[int, ntl_ZZ_pContext_class]: ...
    def _modulus_dict(self) -> dict[int, ZZ_pX_Modulus_c]: ...

class PowComputer_ZZ_pX_big_Eis(PowComputer_ZZ_pX_big):
    def _low_shifter(self, i: int) -> ntl_ZZ_pX: ...
    def _high_shifter(self, i: int) -> ntl_ZZ_pX: ...
