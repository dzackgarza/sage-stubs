    ) -> pAdicGenericElement: ...
    def __iter__(self) -> Iterator[pAdicGenericElement]: ...
    def __len__(self) -> int | Integer: ...
    def __next__(self) -> pAdicGenericElement: ...

class ExpansionIterable(SageObject):
