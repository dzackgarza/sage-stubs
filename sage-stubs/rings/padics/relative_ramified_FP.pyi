class FPElement(pAdicTemplateElement):
    def __copy__(self) -> Self: ...
    def __reduce__(
        self,
    ) -> tuple[Callable[..., Self], tuple[ElementConstructorInput, ...]]: ...
    def _neg_(self) -> Self: ...
    def _add_(self, _right: ElementConstructorInput) -> Self: ...
    def _sub_(self, _right: ElementConstructorInput) -> Self: ...
    def __invert__(self) -> Self: ...
    def _mul_(self, _right: ElementConstructorInput) -> Self: ...
    def _div_(self, _right: ElementConstructorInput) -> Self: ...
    def _quo_rem(self, _right: ElementConstructorInput) -> tuple[Self, Self]: ...
    def __pow__(
        self, _right: ElementConstructorInput, dummy: ElementConstructorInput
    ) -> Self: ...
    def _repr_(
        self, mode: str | None = ..., do_latex: ElementConstructorInput = ...
    ) -> str: ...
    def add_bigoh(self, absprec: int | Integer | None) -> Self: ...
    def is_zero(self, absprec: int | Integer | None = ...) -> bool: ...
    def __bool__(self) -> bool: ...
    def is_equal_to(
        self, _right: ElementConstructorInput, absprec: int | Integer | None = ...
    ) -> bool: ...
    def _teichmuller_set_unsafe(self) -> None: ...
    def _polynomial_list(self, pad: ElementConstructorInput = ...) -> list[Integer]: ...
    def polynomial(self, var: str = ...) -> Polynomial: ...
    def precision_absolute(self) -> Integer | PlusInfinity: ...
    def precision_relative(self) -> Integer | PlusInfinity: ...
    def unit_part(self) -> Self: ...
    def val_unit(
        self, p: int | Integer | FunctionFieldPlace | NumberFieldIdeal | None = ...
    ) -> tuple[Integer | PlusInfinity, Self]: ...
    def __hash__(self) -> int: ...

