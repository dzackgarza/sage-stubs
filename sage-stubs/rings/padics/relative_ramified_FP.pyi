class pAdicTemplateElement(pAdicGenericElement):
    def __init__(
        self,
        parent: Parent,
        x: pAdicTemplateElement | ElementConstructorInput,
        absprec: int | Integer | None = ...,
        relprec: int | Integer | None = ...,
    ) -> None: ...
    def __lshift__(self, shift: ElementConstructorInput) -> Self: ...
    def __rshift__(self, shift: ElementConstructorInput) -> Self: ...
    def lift_to_precision(self, absprec: int | Integer | None = ...) -> Self: ...
    def expansion(
        self,
        n: int | Integer | None = ...,
        lift_mode: ElementConstructorInput = ...,
        start_val: ElementConstructorInput | None = ...,
    ) -> Self: ...
    def teichmuller_expansion(self, n: int | Integer | None = ...) -> Self: ...
    def _ext_p_list(self, pos: ElementConstructorInput) -> Self: ...
    def unit_part(self) -> Self: ...
    def _prime_pow(self) -> Self: ...
    def residue(
        self,
        absprec: int | Integer | None = ...,
        field: pAdicGeneric | None = ...,
        check_prec: ElementConstructorInput = ...,
    ) -> Self: ...

class ExpansionIter(SageObject):
    def __cinit__(
