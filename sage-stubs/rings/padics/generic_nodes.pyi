from typing import Self

import sage.rings.abc
from sage.categories.category import Category
from sage.categories.pushout import CompletionFunctor, Functor
from sage.rings.function_field.place import FunctionFieldPlace
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.integer_ring import IntegerRing_class
from sage.rings.number_field.number_field_ideal import NumberFieldIdeal
from sage.rings.padics.local_generic import LocalGeneric
from sage.rings.padics.padic_base_generic import pAdicBaseGeneric
from sage.rings.padics.padic_generic import pAdicGeneric
from sage.rings.padics.padic_generic_element import pAdicGenericElement
from sage.rings.ring import Ring
from sage.structure.parent import ElementConstructorInput, Parent

class pAdicRingGeneric(pAdicGeneric, sage.rings.abc.pAdicRing):
    def is_field(self, proof: bool = True) -> bool: ...
    def krull_dimension(self) -> int: ...

class pAdicFieldGeneric(pAdicGeneric, sage.rings.abc.pAdicField):
    def is_field(self, proof: bool = True) -> bool: ...

class pAdicRingBaseGeneric(pAdicBaseGeneric, pAdicRingGeneric):
    def construction(
        self, forbid_frac_field: bool = False
    ) -> tuple[CompletionFunctor, IntegerRing_class]: ...
    def random_element(self, algorithm: str = "default") -> pAdicGenericElement: ...

class CappedAbsoluteGeneric(LocalGeneric):
    def is_capped_absolute(self) -> bool: ...

class CappedRelativeGeneric(LocalGeneric):
    def is_capped_relative(self) -> bool: ...

class FixedModGeneric(LocalGeneric):
    def is_fixed_mod(self) -> bool: ...

class FloatingPointGeneric(LocalGeneric):
    def is_floating_point(self) -> bool: ...

class FloatingPointRingGeneric(FloatingPointGeneric): ...
class FloatingPointFieldGeneric(FloatingPointGeneric): ...
class CappedRelativeRingGeneric(CappedRelativeGeneric): ...
class CappedRelativeFieldGeneric(CappedRelativeGeneric): ...

class pAdicLatticeGeneric(pAdicGeneric):
    def __init__(
        self,
        p: int | Integer | FunctionFieldPlace | NumberFieldIdeal,
        prec: int | Integer | None,
        print_mode: ElementConstructorInput,
        names: str | tuple[str, ...] | None,
        label: ElementConstructorInput | None = ...,
        category: Category | None = ...,
    ) -> None: ...
    def is_lattice_prec(self) -> bool: ...
    def precision_cap(self) -> Integer | PlusInfinity: ...
    def precision_cap_relative(self) -> pAdicGenericElement: ...
    def precision_cap_absolute(self) -> pAdicGenericElement: ...
    def precision(self) -> pAdicGenericElement: ...
    def label(self) -> pAdicGenericElement: ...
    def _element_constructor_(
        self,
        x: pAdicGenericElement | ElementConstructorInput,
        prec: int | Integer | None = ...,
    ) -> pAdicGenericElement | ElementConstructorInput: ...
    def convert_multiple(
        self, *elts: ElementConstructorInput
    ) -> pAdicGenericElement | list[None]: ...

class pAdicRelaxedGeneric(pAdicGeneric):
    def is_relaxed(self) -> bool: ...
    def is_secure(self) -> bool: ...
    def default_prec(self) -> pAdicGenericElement: ...
    def halting_prec(self) -> pAdicGenericElement: ...
    def precision_cap(self) -> Integer | PlusInfinity: ...
    def _coerce_map_from_(self, R: Ring) -> bool: ...
    def _element_constructor_(
        self,
        x: pAdicGenericElement | ElementConstructorInput,
        prec: int | Integer | None = ...,
    ) -> pAdicGenericElement: ...
    def an_element(self, unbounded: ElementConstructorInput = ...) -> Self: ...
    def some_elements(self, unbounded: ElementConstructorInput = ...) -> list[Self]: ...
    def unknown(
        self, start_val: int | Integer = ..., digits: int | Integer | None = ...
    ) -> pAdicGenericElement: ...
    def random_element(
        self, integral: bool = ..., prec: int | Integer | None = ...
    ) -> Self: ...
    def teichmuller(
        self, x: pAdicGenericElement | ElementConstructorInput
    ) -> pAdicGenericElement: ...
    def teichmuller_system(self) -> list[pAdicGenericElement]: ...

class pAdicFixedModRingGeneric(pAdicRingGeneric, FixedModGeneric): ...
class pAdicCappedAbsoluteRingGeneric(pAdicRingGeneric, CappedAbsoluteGeneric): ...
class pAdicCappedRelativeRingGeneric(pAdicRingGeneric, CappedRelativeRingGeneric): ...
class pAdicCappedRelativeFieldGeneric(
    pAdicFieldGeneric, CappedRelativeFieldGeneric
): ...
class pAdicFloatingPointRingGeneric(pAdicRingGeneric, FloatingPointRingGeneric): ...
class pAdicFloatingPointFieldGeneric(pAdicFieldGeneric, FloatingPointFieldGeneric): ...

class pAdicFieldBaseGeneric(pAdicBaseGeneric, pAdicFieldGeneric):
    def composite(
        self, subfield1: ElementConstructorInput, subfield2: ElementConstructorInput
    ) -> Self: ...
    def subfields_of_degree(self, n: int | Integer) -> int: ...
    def subfield(self, list: ElementConstructorInput) -> Self: ...
    def construction(
        self, forbid_frac_field: Ring = ...
    ) -> tuple[Functor, Parent] | None: ...
