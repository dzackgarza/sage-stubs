from collections.abc import Iterator
from typing import Self

from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.structure.element import CommutativeRingElement, Element
from sage.structure.parent import ElementConstructorInput

class LocalGenericElement(CommutativeRingElement):
    def __iter__(self) -> Iterator[LocalGenericElement]: ...
    def _latex_(self) -> str: ...
    def add_bigoh(self, absprec: int | Integer | None) -> Self: ...
    def euclidean_degree(self) -> Integer: ...
    def inverse_of_unit(self) -> Self: ...
    def is_integral(self) -> bool: ...
    def is_padic_unit(self) -> bool: ...
    def is_unit(self) -> bool: ...
    def normalized_valuation(self) -> Integer | PlusInfinity: ...
    def quo_rem(
        self, other: LocalGenericElement | ElementConstructorInput, integral: bool = ...
    ) -> tuple[Self, Self]: ...
    def slice(
        self,
        i: int | Integer,
        j: int | Integer,
        k: int | Integer = ...,
        lift_mode: ElementConstructorInput = ...,
    ) -> Self: ...
    def sqrt(
        self, extend: bool = ..., all: bool = ..., algorithm: str | None = ...
    ) -> Self | list[Self] | Element: ...
    def _div_(self, right: LocalGenericElement | ElementConstructorInput) -> Self: ...
    def _min_valuation(self) -> Self: ...
    def _sub_(self, right: LocalGenericElement | ElementConstructorInput) -> Self: ...
    def _test_expansion(self, **options: ElementConstructorInput) -> Self: ...
    def _test_trivial_powers(self, **options: ElementConstructorInput) -> Self: ...
