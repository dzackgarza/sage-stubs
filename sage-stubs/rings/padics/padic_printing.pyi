) -> pAdicGenericElement: ...

class pAdicPrinterDefaults(SageObject):
    def __init__(
        self,
        mode: str = ...,
        pos: ElementConstructorInput = ...,
        max_ram_terms: ElementConstructorInput = ...,
        max_unram_terms: ElementConstructorInput = ...,
        max_terse_terms: ElementConstructorInput = ...,
        sep: ElementConstructorInput = ...,
        alphabet: ElementConstructorInput = ...,
    ) -> None: ...
    def mode(self, mode: str = ...) -> pAdicGenericElement: ...
    def allow_negatives(
        self, neg: ElementConstructorInput = ...
    ) -> pAdicGenericElement: ...
    def max_series_terms(
        self, max: ElementConstructorInput = ...
    ) -> pAdicGenericElement: ...
    def max_unram_terms(
        self, max: ElementConstructorInput = ...
    ) -> pAdicGenericElement: ...
    def max_poly_terms(
        self, max: ElementConstructorInput = ...
    ) -> pAdicGenericElement: ...
    def sep(self, sep: ElementConstructorInput = ...) -> pAdicGenericElement: ...
    def alphabet(
        self, alphabet: ElementConstructorInput = ...
    ) -> pAdicGenericElement: ...

