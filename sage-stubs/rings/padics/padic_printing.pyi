    def _max_unram_terms(self) -> pAdicGenericElement: ...
    def _pos(self) -> pAdicGenericElement: ...
    def _print_mode(self) -> pAdicGenericElement: ...
    def _ram_name(self) -> pAdicGenericElement: ...
    def _ring(self) -> pAdicGenericElement: ...
    def _sep(self) -> pAdicGenericElement: ...
    def _show_prec(self) -> pAdicGenericElement: ...
    def _uniformizer_name(self) -> pAdicGenericElement: ...
