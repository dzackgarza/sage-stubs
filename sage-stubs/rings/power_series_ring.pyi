from collections.abc import Iterator

from sage.categories.pushout import CompletionFunctor
from sage.rings.fraction_field import FractionField_generic
from sage.rings.laurent_series_ring import LaurentSeriesRing
from sage.rings.polynomial.polynomial_ring import PolynomialRing_generic
from sage.rings.power_series_poly import PowerSeries_poly
from sage.rings.power_series_ring_element import PowerSeries
from sage.rings.ring import CommutativeRing, Field
from sage.structure.element import Element
from sage.structure.nonexact import Nonexact
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class PowerSeriesRing_generic(UniqueRepresentation, Parent, Nonexact):
    def __init__(
        self,
        base_ring: CommutativeRing | int,
        name: str | None = None,
        default_prec: int | None = None,
        sparse: bool = False,
        implementation: str | None = None,
        category: object = None,
    ) -> None: ...
    def base_ring(self) -> CommutativeRing: ...
    def characteristic(self) -> int: ...
    def is_sparse(self) -> bool: ...
    def is_dense(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def gen(self, n: int = ...) -> PowerSeries_poly: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple[Element, ...]: ...
    def is_field(self, proof: bool = ...) -> bool: ...
    def is_finite(self) -> bool: ...
    def default_prec(self) -> int: ...
    def change_ring(self, R: CommutativeRing) -> PowerSeriesRing_generic: ...
    def fraction_field(self) -> FractionField_generic | LaurentSeriesRing: ...
    def some_elements(self) -> Iterator[PowerSeries_poly]: ...
    def variable_names_recursive(self, depth: int | None = None) -> tuple[str, ...]: ...
    def construction(self) -> tuple[CompletionFunctor, PolynomialRing_generic]: ...
    def base_extend(self, R: CommutativeRing) -> PowerSeriesRing_generic: ...
    def change_variable_name(self, var: str) -> PowerSeriesRing_generic: ...
    def uniformizer(self) -> PowerSeries: ...
    def random_element(
        self, prec: int | None = None, *args: object, **kwds: object
    ) -> PowerSeries: ...
    def __contains__(self, x: object) -> bool: ...
    def residue_field(self) -> Field: ...
    def laurent_series_ring(self) -> LaurentSeriesRing: ...

class PowerSeriesRing_domain(PowerSeriesRing_generic):
    def fraction_field(self) -> LaurentSeriesRing: ...

class PowerSeriesRing_over_field(PowerSeriesRing_domain):
    def fraction_field(self) -> LaurentSeriesRing: ...
