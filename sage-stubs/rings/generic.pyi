from collections.abc import Iterable, Iterator

from sage.structure.element import Element

class ProductTree:
    def __init__(self, leaves: Iterable[Element]) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Element]: ...
    def root(self) -> Element: ...
    def leaves(self) -> tuple[Element, ...]: ...
    def remainders(self, x: Element) -> list[Element]: ...
    def interpolation(self, xs: list[Element] | tuple[Element, ...]) -> Element: ...

def prod_with_derivative(pairs: Iterable[tuple[Element, Element]]) -> tuple[Element, Element]: ...
