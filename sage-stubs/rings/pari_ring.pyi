from sage.misc.fast_methods import Singleton
from sage.structure.element import RingElement
from sage.structure.parent import Parent

class Pari(RingElement):
    def __init__(self, x: object, parent: object = None) -> None: ...
    def __neg__(self) -> Pari: ...
    def __pow__(self, other: object) -> Pari: ...
    def __invert__(self) -> Pari: ...

class PariRing(Singleton, Parent):
    def __init__(self) -> None: ...
    def is_field(self, proof: bool = True) -> bool: ...
    def characteristic(self) -> int: ...
    def random_element(self, x: object = None, y: object = None, distribution: str | None = None) -> Pari: ...
    def zeta(self) -> Pari: ...
