from typing import Literal, NoReturn as _NoReturn, Self, overload
from sage.misc.fast_methods import Singleton
from sage.rings.ring import CommutativeRing
from sage.structure.element import InfinityElement as InfinityElement, RingElement
from sage.structure.parent import Parent

class InfinityRing_class(CommutativeRing):
    def __init__(self) -> None: ...
    def fraction_field(self) -> _NoReturn: ...
    def ngens(self) -> int: ...
    @overload
    def gen(self, n: Literal[0] = 0) -> PlusInfinity: ...
    @overload
    def gen(self, n: Literal[1]) -> MinusInfinity: ...
    @overload
    def gen(self, n: int) -> PlusInfinity | MinusInfinity: ...
    def gens(self) -> tuple[PlusInfinity, MinusInfinity]: ...
    def is_zero(self) -> bool: ...
    def is_commutative(self) -> bool: ...

class MinusInfinity(_uniq, AnInfinity, InfinityElement):
    def __init__(self, parent: InfinityRing_class = ...) -> None: ...
    def __neg__(self) -> PlusInfinity: ...
    def sqrt(self) -> _NoReturn: ...

class PlusInfinity(_uniq, AnInfinity, InfinityElement):
    def __init__(self, parent: InfinityRing_class = ...) -> None: ...
    def __neg__(self) -> MinusInfinity: ...
    def sqrt(self) -> PlusInfinity: ...

InfinityRing: InfinityRing_class
infinity: PlusInfinity
Infinity: PlusInfinity
minus_infinity: MinusInfinity

class _uniq:
    def __new__(cls) -> Self: ...

class AnInfinity:
    def lcm(self, x: PlusInfinity | MinusInfinity) -> PlusInfinity | MinusInfinity: ...

class UnsignedInfinityRing_class(Singleton, Parent):
    def __init__(self) -> None: ...
    def ngens(self) -> int: ...
    def gen(self, n: int = 0) -> UnsignedInfinity: ...
    def gens(self) -> tuple[UnsignedInfinity, ...]: ...
    def less_than_infinity(self) -> LessThanInfinity: ...

class LessThanInfinity(_uniq, RingElement):
    def __init__(self, parent: UnsignedInfinityRing_class = ...) -> None: ...
    def sign(self) -> int: ...

class UnsignedInfinity(_uniq, AnInfinity, InfinityElement):
    def __init__(self) -> None: ...
    def __hash__(self) -> int: ...

class SignError(ArithmeticError): ...

class FiniteNumber(RingElement):
    def __init__(self, parent: Parent, x: object) -> None: ...
    def __invert__(self) -> FiniteNumber: ...
    def sign(self) -> int: ...
    def sqrt(self) -> FiniteNumber: ...

UnsignedInfinityRing: UnsignedInfinityRing_class

def check_comparison(ring: Parent) -> None: ...
def check_signed_infinity(pos_inf: PlusInfinity) -> None: ...
