from typing import Self

from sage.categories.pushout import ConstructionFunctor, Functor
from sage.rings.function_field.divisor import FunctionFieldDivisor
from sage.rings.function_field.element import FunctionFieldElement
from sage.rings.function_field.function_field import FunctionField
from sage.rings.function_field.order import FunctionFieldOrder
from sage.rings.function_field.place import FunctionFieldPlace
from sage.rings.integer import Integer
from sage.rings.ring import Ring
from sage.structure.element import AdditiveGroupElement
from sage.structure.parent import ElementConstructorInput, Parent

class JacobianPoint_base(AdditiveGroupElement):
    def addflip(
        self, other: FunctionFieldElement | ElementConstructorInput
    ) -> Self: ...
    def divisor(self) -> FunctionFieldDivisor: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class JacobianPoint_finite_field_base(JacobianPoint_base):
    def additive_order(self) -> Self: ...
    def frobenius(self) -> Self: ...

class JacobianGroupFunctor(ConstructionFunctor):
    rank: int | Integer

    def __init__(self, base_field: FunctionField, field: FunctionField) -> None: ...
    def merge(
        self, other: FunctionFieldElement | ElementConstructorInput
    ) -> FunctionField: ...

class JacobianGroup_base(Parent):
    def __init__(
        self,
        parent: FunctionField,
        function_field: ElementConstructorInput,
        base_div: ElementConstructorInput,
    ) -> None: ...
    def construction(self) -> tuple[Functor, Parent] | None: ...
    def parent(self) -> FunctionField: ...
    def function_field(self) -> FunctionFieldElement: ...
    def base_divisor(self) -> FunctionFieldDivisor: ...
    def _repr_(self) -> str: ...
    def _coerce_map_from_(self, S: Ring | Parent) -> FunctionFieldElement | None: ...

class JacobianGroup_finite_field_base(JacobianGroup_base):
    def order(self, algorithm: str = ...) -> FunctionFieldOrder: ...
    def get_points(self, n: int | Integer) -> FunctionFieldElement: ...
    def some_elements(self) -> list[FunctionFieldElement]: ...

class Jacobian_base(Parent):
    def __init__(
        self,
        function_field: ElementConstructorInput,
        base_div: ElementConstructorInput,
        **kwds: ElementConstructorInput,
    ) -> None: ...
    def __call__(
        self, x: FunctionFieldElement | ElementConstructorInput
    ) -> FunctionFieldElement: ...
    def curve(self) -> FunctionFieldElement: ...
    def base_curve(self) -> FunctionFieldElement: ...
    def facade_for(self) -> FunctionFieldElement: ...
    def base_divisor(self) -> FunctionFieldDivisor: ...
    def group(self, k_ext: ElementConstructorInput = ...) -> FunctionFieldElement: ...
    def set_base_place(self, place: FunctionFieldPlace) -> FunctionFieldElement: ...
    def _repr_(self) -> str: ...
    def _an_element_(self) -> Self: ...
