import builtins
from collections.abc import (
    Iterable,
)

from sage.rings.function_field.function_field import FunctionField
from sage.rings.integer import Integer

from .place import FunctionFieldPlace

class _SageObject: ...

def divisor(self, data: builtins.object) -> _SageObject: ...
def prime_divisor(
    self, place: builtins.object, m: builtins.int = ...
) -> _SageObject: ...

class FunctionFieldDivisor:
    def __init__(self, parent: DivisorGroup, data: builtins.object) -> None: ...
    def __hash__(self) -> int: ...
    def dict(self) -> _SageObject: ...
    def list(self) -> _SageObject: ...
    def support(self) -> _SageObject: ...
    def multiplicity(self, place: builtins.object) -> _SageObject: ...
    valuation: _SageObject

    def is_effective(self) -> bool: ...
    def is_prime(self) -> bool: ...
    def place(self) -> FunctionFieldPlace: ...
    def numerator(self) -> _SageObject: ...
    def denominator(self) -> _SageObject: ...
    def degree(self) -> Integer: ...
    def dimension(self) -> Integer: ...
    def basis_function_space(self) -> _SageObject: ...
    def function_space(self) -> _SageObject: ...
    def basis_differential_space(self) -> _SageObject: ...
    def differential_space(self) -> _SageObject: ...

class DivisorGroup:
    Element: _SageObject

    def __init__(self, field: builtins.object) -> None: ...
    def function_field(self) -> FunctionField: ...
    def effective_divisors(
        self,
        of_degree: builtins.object = ...,
        max_degree: builtins.object = ...,
        avoid: builtins.object = ...,
    ) -> Iterable[FunctionFieldDivisor]: ...
