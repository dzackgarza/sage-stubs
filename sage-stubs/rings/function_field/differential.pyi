from collections.abc import Callable
from typing import Self

from sage.categories.category import Category
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.function_field.divisor import FunctionFieldDivisor
from sage.rings.function_field.function_field import FunctionField
from sage.rings.function_field.place import FunctionFieldPlace
from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring import Ring
from sage.sets.family import Family
from sage.structure.element import Element, ModuleElement
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

class FunctionFieldDifferential(ModuleElement):
    def __init__(
        self,
        parent: FunctionField,
        f: Polynomial | MPolynomial,
        t: ElementConstructorInput = ...,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def divisor(self) -> FunctionFieldDivisor: ...
    def valuation(self, place: FunctionFieldPlace) -> Integer: ...
    def residue(self, place: FunctionFieldPlace) -> Self: ...
    def monomial_coefficients(
        self, copy: bool = ...
    ) -> dict[Element, FunctionFieldDifferential]: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _richcmp_(
        self,
        other: FunctionFieldDifferential | ElementConstructorInput,
        op: ElementConstructorInput,
    ) -> bool: ...

class FunctionFieldDifferential_global(FunctionFieldDifferential):
    def cartier(self) -> Self: ...

class DifferentialsSpace(UniqueRepresentation, Parent):
    def __init__(self, field: FunctionField, category: Category = ...) -> None: ...
    def function_field(self) -> FunctionField: ...
    def basis(self) -> Family: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(
        self, f: Polynomial | MPolynomial | Map | Callable[..., Element]
    ) -> FunctionFieldDifferential: ...
    def _coerce_map_from_(self, S: Ring | Parent) -> DifferentialsSpaceInclusion: ...
    def _an_element_(self) -> FunctionFieldDifferential: ...

class DifferentialsSpace_global(DifferentialsSpace): ...

class DifferentialsSpaceInclusion(Morphism):
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def _repr_(self) -> str: ...
    def _call_(self, v: FunctionFieldDifferential) -> FunctionFieldDifferential: ...
