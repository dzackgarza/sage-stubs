from typing import Self

from sage.matrix.matrix0 import Matrix
from sage.rings.function_field.ideal import (
    FunctionFieldIdeal,
    FunctionFieldIdealInfinite,
)
from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring import Ring
from sage.structure.parent import ElementConstructorInput
from sage.structure.richcmp import richcmp

class FunctionFieldIdeal_polymod(FunctionFieldIdeal):
    def __init__(
        self,
        ring: Ring,
        hnf: ElementConstructorInput,
        denominator: ElementConstructorInput = ...,
    ) -> None: ...
    def __bool__(self) -> bool: ...
    def __hash__(self) -> int: ...
    def __contains__(self, x: object) -> bool: ...
    def __invert__(self) -> Self: ...
    def intersect(
        self, other: FunctionFieldIdeal_polymod | ElementConstructorInput
    ) -> Self: ...
    def hnf(self) -> Self: ...
    def denominator(self) -> Self: ...
    def module(self) -> Self: ...
    def gens_over_base(self) -> Self: ...
    def gens(self) -> tuple[FunctionFieldIdeal_polymod, ...]: ...
    def basis_matrix(self) -> Matrix: ...
    def is_integral(self) -> bool: ...
    def ideal_below(self) -> Self: ...
    def norm(self) -> Self: ...
    def is_prime(self) -> bool: ...
    def valuation(self, ideal: FunctionFieldIdeal) -> Integer: ...
    def prime_below(self) -> Self: ...
    def _richcmp_(
        self,
        other: FunctionFieldIdeal_polymod | ElementConstructorInput,
        op: ElementConstructorInput,
    ) -> richcmp: ...

class FunctionFieldIdeal_global(FunctionFieldIdeal_polymod):
    def __init__(
        self,
        ring: Ring,
        hnf: ElementConstructorInput,
        denominator: ElementConstructorInput = ...,
    ) -> None: ...
    def __pow__(self, mod: Ring) -> Self: ...
    def gens(self) -> tuple[FunctionFieldIdeal_global, ...]: ...
    def gens_two(self) -> Self: ...

class FunctionFieldIdealInfinite_polymod(FunctionFieldIdealInfinite):
    def __init__(self, ring: Ring, ideal: FunctionFieldIdeal) -> None: ...
    def __hash__(self) -> int: ...
    def __contains__(self, x: object) -> bool: ...
    def __pow__(self, n: int | Integer) -> Self: ...
    def __invert__(self) -> Self: ...
    def gens(self) -> tuple[FunctionFieldIdealInfinite_polymod, ...]: ...
    def gens_two(self) -> Self: ...
    def gens_over_base(self) -> Self: ...
    def ideal_below(self) -> Self: ...
    def is_prime(self) -> bool: ...
    def prime_below(self) -> Self: ...
    def valuation(self, ideal: FunctionFieldIdeal) -> Integer: ...
    def _richcmp_(
        self,
        other: FunctionFieldIdealInfinite_polymod | ElementConstructorInput,
        op: Polynomial | MPolynomial,
    ) -> richcmp: ...
