from collections.abc import Sequence
from typing import Self

from sage.categories.category import Category
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.modules.free_module import FreeModule_generic
from sage.rings.function_field.derivations import FunctionFieldDerivation
from sage.rings.function_field.element import FunctionFieldElement
from sage.rings.function_field.element_polymod import FunctionFieldElement_polymod
from sage.rings.function_field.function_field import FunctionField
from sage.rings.function_field.ideal import FunctionFieldIdeal
from sage.rings.function_field.order import FunctionFieldOrder
from sage.rings.function_field.place import FunctionFieldPlace
from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring import Field
from sage.structure.parent import ElementConstructorInput, Parent

class FunctionField_polymod(FunctionField):
    def __init__(
        self,
        polynomial: Polynomial | MPolynomial,
        names: str | tuple[str, ...],
        category: Category = ...,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def gen(self, n: int | Integer = ...) -> FunctionFieldElement: ...
    def ngens(self) -> int | Integer: ...
    def monic_integral_model(self, names: str | tuple[str, ...] = ...) -> Self: ...
    def constant_field(self) -> FunctionField: ...
    def constant_base_field(self) -> FunctionField: ...
    def degree(self, base: FunctionField = ...) -> int | Integer: ...
    def base_field(self) -> FunctionField: ...
    def random_element(
        self, *args: ElementConstructorInput, **kwds: ElementConstructorInput
    ) -> FunctionFieldElement: ...
    def polynomial(self) -> Polynomial: ...
    def is_separable(self, base: FunctionField = ...) -> bool: ...
    def polynomial_ring(self) -> Parent: ...
    def free_module(
        self, base: FunctionField = ..., basis: FunctionField = ..., map: bool = ...
    ) -> FreeModule_generic | tuple[FreeModule_generic, Morphism, Morphism]: ...
    def maximal_order(self) -> FunctionFieldOrder: ...
    def maximal_order_infinite(self) -> FunctionFieldOrder: ...
    def different(self) -> FunctionFieldIdeal: ...
    def equation_order(self) -> FunctionFieldOrder: ...
    def hom(
        self,
        im_gens: Sequence[ElementConstructorInput],
        base_morphism: Map | Morphism = ...,
    ) -> Morphism: ...
    def genus(self) -> int | Integer: ...
    def simple_model(self, name: str = ...) -> Self: ...
    def primitive_element(self) -> FunctionFieldElement: ...
    def separable_model(self, names: str | tuple[str, ...] = ...) -> Self: ...
    def change_variable_name(self, name: str) -> Self: ...
    def _element_constructor_(
        self, x: FunctionFieldElement | ElementConstructorInput
    ) -> FunctionFieldElement_polymod: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class FunctionField_simple(FunctionField_polymod):
    def places_above(
        self, p: int | Integer | FunctionFieldPlace
    ) -> list[FunctionFieldPlace]: ...
    def constant_field(self) -> FunctionField: ...
    def exact_constant_field(self, name: str = ...) -> tuple[Field, Morphism]: ...
    def genus(self) -> int | Integer: ...
    def residue_field(
        self, place: FunctionFieldPlace, name: str = ...
    ) -> Field | tuple[Field, Morphism, Morphism]: ...
    def places_infinite(
        self, degree: int | Integer = ...
    ) -> list[FunctionFieldPlace]: ...
    def get_infinite_place(self, degree: int | Integer = ...) -> FunctionFieldPlace: ...

class FunctionField_char_zero(FunctionField_simple):
    def higher_derivation(self) -> FunctionFieldDerivation: ...

class FunctionField_global(FunctionField_simple):
    def __init__(
        self, polynomial: Polynomial | MPolynomial, names: str | tuple[str, ...]
    ) -> None: ...
    def maximal_order(self) -> FunctionFieldOrder: ...
    def higher_derivation(self) -> FunctionFieldDerivation: ...
    def places(self, degree: int | Integer = ...) -> list[FunctionFieldPlace]: ...
    def gaps(self) -> list[Integer]: ...
    def weierstrass_places(self) -> list[FunctionFieldPlace]: ...
    def L_polynomial(self, name: str = ...) -> Polynomial: ...
    def number_of_rational_places(self, r: int | Integer = ...) -> int | Integer: ...

class FunctionField_integral(FunctionField_simple):
    def equation_order(self) -> FunctionFieldOrder: ...
    def primitive_integal_element_infinite(self) -> FunctionFieldElement: ...
    def equation_order_infinite(self) -> FunctionFieldOrder: ...

class FunctionField_char_zero_integral(
    FunctionField_char_zero, FunctionField_integral
): ...
class FunctionField_global_integral(FunctionField_global, FunctionField_integral): ...
