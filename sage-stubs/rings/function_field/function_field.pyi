from collections.abc import Callable
from typing import Literal

from sage.categories.category import Category
from sage.categories.homset import hom
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.function_field.divisor import DivisorGroup, FunctionFieldDivisor
from sage.rings.function_field.element import FunctionFieldElement
from sage.rings.function_field.extensions import ConstantFieldExtension
from sage.rings.function_field.function_field_rational import RationalFunctionField
from sage.rings.function_field.jacobian_base import Jacobian_base
from sage.rings.function_field.maps import FunctionFieldCompletion
from sage.rings.function_field.order import FunctionFieldOrder
from sage.rings.function_field.order_basis import (
    FunctionFieldOrder_basis,
    FunctionFieldOrderInfinite_basis,
)
from sage.rings.function_field.place import FunctionFieldPlace, PlaceSet
from sage.rings.function_field.valuation import FunctionFieldValuation_base
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.number_field.number_field import NumberField_generic
from sage.rings.number_field.number_field_ideal import NumberFieldIdeal
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring import Field
from sage.rings.valuation.valuation import DiscretePseudoValuation
from sage.structure.element import Element
from sage.structure.parent import ElementConstructorInput, Parent

class FunctionField(Field):
    def constant_base_field(self) -> Field: ...
    def base_field(self) -> Field: ...
    def gen(self) -> FunctionFieldElement: ...
    def maximal_order(self) -> FunctionFieldOrder: ...
    def is_rational_function_field(self) -> bool: ...
    def __init__(
        self,
        base_field: FunctionField,
        names: str | tuple[str, ...] | None,
        category: Category | None = ...,
    ) -> None: ...
    def is_perfect(self) -> bool: ...
    def some_elements(self) -> list[FunctionFieldElement]: ...
    def characteristic(self) -> Integer: ...
    def is_finite(self) -> Literal[False]: ...
    def is_global(self) -> bool: ...
    def extension(
        self,
        f: Polynomial | MPolynomial | Map | Callable[..., Element],
        names: str | tuple[str, ...] | None = ...,
    ) -> FunctionField | NumberField_generic | tuple[Parent, Morphism, Morphism]: ...
    def order_with_basis(
        self, basis: FunctionField, check: bool = ...
    ) -> FunctionFieldOrder_basis: ...
    def order(
        self, x: FunctionFieldElement | ElementConstructorInput, check: bool = ...
    ) -> Integer | PlusInfinity: ...
    def order_infinite_with_basis(
        self, basis: FunctionField, check: bool = ...
    ) -> FunctionFieldOrderInfinite_basis: ...
    def order_infinite(
        self, x: FunctionFieldElement | ElementConstructorInput, check: bool = ...
    ) -> FunctionFieldElement: ...
    def _coerce_map_from_(
        self, source: int | Integer
    ) -> Morphism | FunctionFieldElement | hom: ...
    def rational_function_field(self) -> RationalFunctionField: ...
    def valuation(
        self, prime: int | Integer | FunctionFieldPlace
    ) -> FunctionFieldValuation_base: ...
    def space_of_differentials(self) -> FunctionFieldElement: ...
    def space_of_holomorphic_differentials(self) -> FunctionFieldElement: ...
    def basis_of_holomorphic_differentials(self) -> FunctionFieldElement: ...
    def divisor_group(self) -> DivisorGroup: ...
    def place_set(self) -> PlaceSet: ...
    def completion(
        self,
        place: FunctionFieldPlace,
        name: str | None = ...,
        prec: int | Integer | None = ...,
        gen_name: str | None = ...,
    ) -> FunctionFieldCompletion: ...
    def hilbert_symbol(
        self,
        a: FunctionFieldElement | ElementConstructorInput,
        b: FunctionFieldElement | ElementConstructorInput,
        P: NumberFieldIdeal | FunctionFieldPlace | Polynomial | DiscretePseudoValuation,
    ) -> Integer: ...
    def extension_constant_field(self, k: int | Integer) -> ConstantFieldExtension: ...
    def places_finite(
        self, degree: int | Integer = ...
    ) -> list[FunctionFieldPlace]: ...
    def get_finite_place(self, degree: int | Integer) -> FunctionFieldPlace | None: ...
    def get_infinite_place(
        self, degree: int | Integer
    ) -> FunctionFieldPlace | None: ...
    def get_place(self, degree: int | Integer) -> FunctionFieldPlace | None: ...
    def jacobian(
        self,
        model: str = ...,
        base_div: FunctionFieldPlace | FunctionFieldDivisor | None = ...,
        extra_caching: bool = ...,
        **kwds: ElementConstructorInput,
    ) -> Jacobian_base: ...
