from typing import Literal, overload

from sage.categories.morphism import Morphism
from sage.matrix.matrix0 import Matrix
from sage.rings.function_field.drinfeld_modules.drinfeld_module import DrinfeldModule
from sage.rings.function_field.drinfeld_modules.homset import DrinfeldModuleHomset
from sage.rings.ideal import Ideal_generic
from sage.rings.integer import Integer
from sage.rings.polynomial.ore_polynomial_element import OrePolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import RingElement
from sage.structure.unique_representation import UniqueRepresentation

class DrinfeldModuleMorphism(
    Morphism[OrePolynomial, OrePolynomial], UniqueRepresentation
):
    @staticmethod
    def __classcall_private__(
        class_: type[DrinfeldModuleMorphism],
        parent: DrinfeldModuleHomset,
        x: DrinfeldModuleMorphism | OrePolynomial | RingElement,
    ) -> DrinfeldModuleMorphism: ...
    def __init__(
        self,
        parent: DrinfeldModuleHomset,
        ore_pol: OrePolynomial,
    ) -> None: ...
    def parent(self) -> DrinfeldModuleHomset: ...
    def domain(self) -> DrinfeldModule: ...
    def codomain(self) -> DrinfeldModule: ...
    def __hash__(self) -> int: ...
    def is_zero(self) -> bool: ...
    def is_identity(self) -> bool: ...
    def is_isogeny(self) -> bool: ...
    def is_isomorphism(self) -> bool: ...
    def ore_polynomial(self) -> OrePolynomial: ...
    def degree(self) -> Integer: ...
    def __add__(
        self,
        other: DrinfeldModuleMorphism | RingElement,
    ) -> DrinfeldModuleMorphism: ...
    def _composition_(
        self,
        other: DrinfeldModuleMorphism,
        H: DrinfeldModuleHomset,
    ) -> DrinfeldModuleMorphism: ...
    def inverse(self) -> DrinfeldModuleMorphism: ...
    def __invert__(self) -> DrinfeldModuleMorphism: ...
    def right_gcd(
        self,
        other: DrinfeldModuleMorphism,
    ) -> DrinfeldModuleMorphism: ...
    def left_lcm(
        self,
        other: DrinfeldModuleMorphism,
    ) -> DrinfeldModuleMorphism: ...
    def _motive_matrix(self) -> Matrix: ...
    @overload
    def norm(self, ideal: Literal[True] = ...) -> Ideal_generic: ...
    @overload
    def norm(self, ideal: Literal[False]) -> Polynomial: ...
    @overload
    def norm(self, ideal: bool = ...) -> Ideal_generic | Polynomial: ...
    def dual_isogeny(self) -> DrinfeldModuleMorphism: ...
    def characteristic_polynomial(self, var: str = ...) -> Polynomial: ...
    def charpoly(self, var: str = ...) -> Polynomial: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...
