from typing import Self

from sage.calculus.predefined import H
from sage.categories.morphism import Morphism
from sage.rings.function_field.ideal import FunctionFieldIdeal
from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Element
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

class DrinfeldModuleMorphism(Morphism, UniqueRepresentation):
    @staticmethod
    def __classcall_private__(
        cls: type[DrinfeldModuleMorphism],
        parent: Parent,
        x: Element | ElementConstructorInput,
    ) -> DrinfeldModuleMorphism: ...
    def __init__(self, parent: Parent, ore_pol: Polynomial | MPolynomial) -> None: ...
    def __hash__(self) -> int: ...
    def is_zero(self) -> bool: ...
    def is_identity(self) -> bool: ...
    def is_isogeny(self) -> bool: ...
    def is_isomorphism(self) -> bool: ...
    def ore_polynomial(self) -> Element: ...
    def degree(self) -> int | Integer: ...
    def __add__(self, other: Element | ElementConstructorInput) -> Self: ...
    def inverse(self) -> Element: ...
    def __invert__(self) -> Self: ...
    def right_gcd(self, other: Element | ElementConstructorInput) -> Element: ...
    def left_lcm(self, other: Element | ElementConstructorInput) -> Element: ...
    def norm(self, ideal: FunctionFieldIdeal = ...) -> Element: ...
    def dual_isogeny(self) -> Element: ...
    def characteristic_polynomial(
        self, var: Polynomial | MPolynomial = ...
    ) -> Polynomial: ...
    def charpoly(self, var: Polynomial | MPolynomial = ...) -> Polynomial: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...
    def _composition_(
        self, other: Element | ElementConstructorInput, H: Polynomial | MPolynomial
    ) -> H: ...
