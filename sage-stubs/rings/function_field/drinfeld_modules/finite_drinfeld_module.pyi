from sage.categories.category import Category
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.function_field.drinfeld_modules.drinfeld_module import DrinfeldModule
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Element

class DrinfeldModule_finite(DrinfeldModule):
    def __init__(self, gen: Polynomial | MPolynomial, category: Category) -> None: ...
    def frobenius_endomorphism(self) -> Element: ...
    def frobenius_charpoly(
        self, var: Polynomial | MPolynomial = ..., algorithm: str = ...
    ) -> Element: ...
    def frobenius_norm(self) -> Element: ...
    def frobenius_trace(self, algorithm: str = ...) -> Element: ...
    def invert(self, ore_pol: Polynomial | MPolynomial) -> Element: ...
    def is_isogenous(self, psi: Map | Morphism) -> bool: ...
    def is_supersingular(self) -> bool: ...
    def is_ordinary(self) -> bool: ...
