from sage.rings.function_field.drinfeld_modules.drinfeld_module import DrinfeldModule
from sage.rings.integer import Integer
from sage.structure.element import Element

class DrinfeldModule_charzero(DrinfeldModule):
    def exponential(self, prec: int | Integer = ..., name: str = ...) -> Element: ...
    def logarithm(self, prec: int | Integer = ..., name: str = ...) -> Element: ...
    def goss_polynomial(
        self, n: int | Integer, var: int | Integer = ...
    ) -> Element: ...

class DrinfeldModule_rational(DrinfeldModule_charzero):
    def coefficient_in_function_ring(self, n: int | Integer) -> Element: ...
    def coefficients_in_function_ring(self, sparse: bool = ...) -> Element: ...
    def class_polynomial(self) -> Element: ...
