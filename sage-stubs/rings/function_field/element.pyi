from typing import Self

from sage.libs.pari.gen import gen
from sage.matrix.matrix2 import Matrix
from sage.rings.function_field.differential import FunctionFieldDifferential
from sage.rings.function_field.divisor import FunctionFieldDivisor
from sage.rings.function_field.place import FunctionFieldPlace
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Element, FieldElement
from sage.structure.parent import ElementConstructorInput, Parent

class FunctionFieldElement(FieldElement):
    def __reduce__(
        self,
    ) -> tuple[type[FunctionFieldElement], tuple[ElementConstructorInput, ...]]: ...
    def _new_c(self) -> FunctionFieldElement: ...
    def __pari__(self) -> gen: ...
    def _latex_(self) -> str: ...
    def matrix(self, base: FunctionFieldElement | None = ...) -> Matrix: ...
    def trace(self) -> Element: ...
    def norm(self) -> Element: ...
    def degree(self) -> int: ...
    def characteristic_polynomial(self, var: str = ...) -> Polynomial: ...
    def minimal_polynomial(self, var: str = ...) -> Polynomial: ...
    def is_integral(self) -> bool: ...
    def derivative(self) -> FunctionFieldElement: ...
    def higher_derivative(
        self, i: int, separating_element: FunctionFieldElement | None = ...
    ) -> FunctionFieldElement: ...
    def valuation(self, place: Element) -> int: ...
    def evaluate(self, place: Element) -> Element: ...
    def is_nth_power(self, n: int) -> bool: ...
    def nth_root(self, n: int) -> FunctionFieldElement: ...
    def differential(self) -> FunctionFieldDifferential: ...
    def divisor(self) -> FunctionFieldDivisor: ...
    def divisor_of_poles(self) -> FunctionFieldDivisor: ...
    def divisor_of_zeros(self) -> FunctionFieldDivisor: ...
    def poles(self) -> list[FunctionFieldPlace]: ...
    def subs(
        self,
        in_dict: ElementConstructorInput | None = ...,
        **kwds: ElementConstructorInput,
    ) -> Self: ...
    def zeros(self) -> list[FunctionFieldPlace]: ...

def is_FunctionFieldElement(
    x: FunctionFieldElement | ElementConstructorInput,
) -> bool: ...
def make_FunctionFieldElement(
    parent: Parent,
    element_class: ElementConstructorInput,
    representing_element: ElementConstructorInput,
) -> FunctionFieldElement: ...
