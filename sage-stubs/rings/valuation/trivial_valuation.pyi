from sage.rings.infinity import PlusInfinity
from sage.rings.ring import Ring
from sage.rings.valuation.valuation import (
    DiscretePseudoValuation,
    DiscreteValuation,
    InfiniteDiscretePseudoValuation,
)
from sage.rings.valuation.value_group import DiscreteValueGroup
from sage.schemes.elliptic_curves.ell_modular_symbols import zero
from sage.structure.element import RingElement
from sage.structure.factory import UniqueFactory
from sage.structure.parent import ElementConstructorInput, Parent

class TrivialValuationFactory(UniqueFactory):
    def __init__(
        self,
        clazz: ElementConstructorInput,
        parent: DiscretePseudoValuation,
        *args: ElementConstructorInput,
        **kwargs: ElementConstructorInput,
    ) -> None: ...
    def create_key(self, domain: Parent) -> tuple[ElementConstructorInput, ...]: ...
    def create_object(
        self,
        version: int | tuple[int, ...],
        key: tuple[ElementConstructorInput, ...],
        **extra_args: ElementConstructorInput,
    ) -> TrivialValuationFactory: ...

class TrivialDiscretePseudoValuation_base(DiscretePseudoValuation):
    def uniformizer(self) -> RingElement: ...
    def is_trivial(self) -> bool: ...
    def is_negative_pseudo_valuation(self) -> bool: ...

class TrivialDiscretePseudoValuation(
    TrivialDiscretePseudoValuation_base, InfiniteDiscretePseudoValuation
):
    def __init__(self, parent: DiscretePseudoValuation) -> None: ...
    def value_group(self) -> DiscreteValueGroup: ...
    def residue_ring(self) -> Ring: ...
    def reduce(self, x: RingElement | ElementConstructorInput) -> RingElement: ...
    def lift(self, X: RingElement | ElementConstructorInput) -> RingElement: ...
    def _call_(self, x: RingElement | ElementConstructorInput) -> PlusInfinity: ...
    def _repr_(self) -> str: ...

class TrivialDiscreteValuation(TrivialDiscretePseudoValuation_base, DiscreteValuation):
    def __init__(self, parent: DiscretePseudoValuation) -> None: ...
    def value_group(self) -> DiscreteValueGroup: ...
    def residue_ring(self) -> Ring: ...
    def reduce(self, x: RingElement | ElementConstructorInput) -> RingElement: ...
    def lift(self, X: RingElement | ElementConstructorInput) -> RingElement: ...
    def extensions(self, ring: Ring) -> list[DiscretePseudoValuation]: ...
    def _call_(
        self, x: RingElement | ElementConstructorInput
    ) -> PlusInfinity | zero: ...
    def _repr_(self) -> str: ...

TrivialValuation: UniqueFactory
TrivialPseudoValuation: RingElement
