from collections.abc import Sequence
from typing import Self

from sage.misc.functional import coerce
from sage.rings.ring import Ring
from sage.structure.element import RingElement
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

class DiscreteValuationCodomain(UniqueRepresentation, Parent):
    def __init__(self) -> None: ...
    def _element_constructor_(
        self, x: RingElement | ElementConstructorInput
    ) -> coerce | RingElement | ElementConstructorInput: ...
    def _repr_(self) -> str: ...

class DiscreteValueGroup(UniqueRepresentation, Parent):
    @staticmethod
    def __classcall__(
        class_: type[DiscreteValueGroup], generator: Ring
    ) -> DiscreteValueGroup: ...
    def __init__(self, generator: ElementConstructorInput) -> None: ...
    def __add__(self, other: RingElement | ElementConstructorInput) -> Self: ...
    def index(self, other: RingElement | ElementConstructorInput) -> RingElement: ...
    def numerator(self) -> RingElement: ...
    def denominator(self) -> RingElement: ...
    def gen(self) -> RingElement: ...
    def some_elements(self) -> list[RingElement]: ...
    def is_trivial(self) -> bool: ...
    def _element_constructor_(
        self, x: RingElement | ElementConstructorInput
    ) -> coerce: ...
    def _repr_(self) -> str: ...

class DiscreteValueSemigroup(UniqueRepresentation, Parent):
    @staticmethod
    def __classcall__(
        class_: type[DiscreteValueSemigroup],
        generators: Sequence[ElementConstructorInput],
    ) -> DiscreteValueSemigroup: ...
    def __init__(self, generators: Sequence[ElementConstructorInput]) -> None: ...
    def __add__(self, other: RingElement | ElementConstructorInput) -> Self: ...
    def gens(self) -> tuple[RingElement, ...]: ...
    def some_elements(self) -> list[RingElement]: ...
    def is_trivial(self) -> bool: ...
    def is_group(self) -> bool: ...
    def _element_constructor_(
        self, x: RingElement | ElementConstructorInput
    ) -> coerce: ...
    def _repr_(self) -> str: ...
