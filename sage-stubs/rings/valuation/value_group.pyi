from collections.abc import Iterable, Iterator

from sage.rings.infinity import MinusInfinity, PlusInfinity
from sage.rings.integer import Integer
from sage.rings.rational import Rational
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

type ValuationValue = Rational | PlusInfinity | MinusInfinity
type RationalInput = ElementConstructorInput
type SemigroupGenerators = RationalInput | Iterable[RationalInput]

class DiscreteValuationCodomain(
    UniqueRepresentation,
    Parent[ValuationValue],
):
    def __init__(self) -> None: ...
    def _element_constructor_(self, x: RationalInput) -> ValuationValue: ...
    def _repr_(self) -> str: ...

class DiscreteValueGroup(
    UniqueRepresentation,
    Parent[Rational],
):
    @staticmethod
    def __classcall__(
        class_: type[DiscreteValueGroup],
        generator: RationalInput,
    ) -> DiscreteValueGroup: ...
    def __init__(self, generator: Rational) -> None: ...
    def _element_constructor_(self, x: RationalInput) -> Rational: ...
    def _repr_(self) -> str: ...
    def __add__(
        self,
        other: DiscreteValueGroup | DiscreteValueSemigroup | RationalInput,
    ) -> DiscreteValueGroup | DiscreteValueSemigroup: ...
    def _mul_(
        self,
        other: RationalInput,
        switch_sides: bool = ...,
    ) -> DiscreteValueGroup: ...
    def index(self, other: DiscreteValueGroup) -> Integer: ...
    def numerator(self) -> Integer: ...
    def denominator(self) -> Integer: ...
    def gen(self) -> Rational: ...
    def some_elements(self) -> list[Rational]: ...
    def is_trivial(self) -> bool: ...
    def _element_with_valuation(
        self,
        subgroup: DiscreteValueGroup,
        s: RationalInput,
    ) -> tuple[Integer, Integer]: ...

class DiscreteValueSemigroup(
    UniqueRepresentation,
    Parent[Rational],
):
    @staticmethod
    def __classcall__(
        class_: type[DiscreteValueSemigroup],
        generators: SemigroupGenerators,
    ) -> DiscreteValueSemigroup: ...
    def __init__(self, generators: tuple[Rational, ...]) -> None: ...
    def _solve_linear_program(
        self,
        target: RationalInput,
    ) -> dict[int, Integer] | None: ...
    def _element_constructor_(self, x: RationalInput) -> Rational: ...
    def _repr_(self) -> str: ...
    def __add__(
        self,
        other: DiscreteValueGroup | DiscreteValueSemigroup | RationalInput,
    ) -> DiscreteValueSemigroup: ...
    def _mul_(
        self,
        other: RationalInput,
        switch_sides: bool = ...,
    ) -> DiscreteValueSemigroup: ...
    def gens(self) -> tuple[Rational, ...]: ...
    def some_elements(self) -> Iterator[Rational]: ...
    def is_trivial(self) -> bool: ...
    def is_group(self) -> bool: ...
