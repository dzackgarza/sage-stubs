from typing import Self

from sage.categories.action import Action
from sage.categories.homset import Homset
from sage.categories.morphism import Morphism
from sage.rings.infinity import MinusInfinity, PlusInfinity
from sage.rings.integer import Integer
from sage.rings.rational import Rational
from sage.rings.real_mpfr import RealNumber
from sage.rings.ring import Field, Ring
from sage.rings.valuation.valuation import DiscretePseudoValuation
from sage.rings.valuation.value_group import DiscreteValueGroup, DiscreteValueSemigroup
from sage.structure.element import RingElement
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation

class DiscretePseudoValuationSpace(UniqueRepresentation, Homset):
    def __init__(self, domain: Parent) -> None: ...
    def __contains__(self, x: object) -> bool: ...
    def __call__(self, x: RingElement | ElementConstructorInput) -> RingElement: ...

    class ElementMethods(SageObject):
        def is_discrete_pseudo_valuation(self) -> bool: ...
        def is_discrete_valuation(self) -> bool: ...
        def is_negative_pseudo_valuation(self) -> bool: ...
        def is_trivial(self) -> bool: ...
        def uniformizer(self) -> RingElement: ...
        def value_group(self) -> DiscreteValueGroup: ...
        def value_semigroup(self) -> DiscreteValueSemigroup: ...
        def element_with_valuation(
            self, s: RingElement | ElementConstructorInput
        ) -> Self: ...
        def residue_ring(self) -> Ring: ...
        def residue_field(self) -> Field | tuple[Field, Morphism, Morphism]: ...
        def reduce(self, x: RingElement | ElementConstructorInput) -> RingElement: ...
        def lift(self, X: RingElement | ElementConstructorInput) -> RingElement: ...
        def extension(self, ring: Ring) -> Self: ...
        def extensions(self, ring: Ring) -> list[DiscretePseudoValuation]: ...
        def restriction(self, ring: Ring) -> Self: ...
        def change_domain(self, ring: Ring) -> Self: ...
        def scale(self, scalar: RingElement | int | Integer | Rational) -> Self: ...
        def separating_element(self, others: ElementConstructorInput) -> Self: ...
        def shift(
            self,
            x: RingElement | ElementConstructorInput,
            s: RingElement | ElementConstructorInput,
        ) -> Self: ...
        def simplify(
            self,
            x: RingElement | ElementConstructorInput,
            error: int | Integer | Rational | RealNumber = ...,
            force: bool = ...,
        ) -> Self: ...
        def lower_bound(
            self, x: RingElement | ElementConstructorInput
        ) -> Integer | Rational | PlusInfinity | MinusInfinity: ...
        def upper_bound(
            self, x: RingElement | ElementConstructorInput
        ) -> Integer | Rational | PlusInfinity | MinusInfinity: ...
        def inverse(
            self, x: RingElement | ElementConstructorInput, precision: int | Integer
        ) -> Self: ...

    def _an_element_(self) -> Self: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(
        self, x: RingElement | ElementConstructorInput
    ) -> RingElement | ElementConstructorInput: ...

class ScaleAction(Action): ...
