from sage.categories.action import Action
from sage.rings.infinity import PlusInfinity
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.power_series_ring import PowerSeriesRing_generic
from sage.rings.power_series_ring_element import PowerSeries
from sage.structure.element import Element

type ElementList[E] = list[E]

class PowerSeries_poly(PowerSeries):
    def __init__(
        self,
        parent: PowerSeriesRing_generic | PowerSeriesRing,
        f: Polynomial | Element | int = 0,
        prec: int | PlusInfinity | bool = ...,
        check: bool = True,
        is_gen: bool = False,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def polynomial(self) -> Polynomial: ...
    def valuation(self) -> int: ...
    def degree(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __call__(self, *x: object, **kwds: object) -> Element: ...
    def __getitem__(self, n: int) -> Element: ...
    def truncate(self, prec: int | PlusInfinity = ...) -> Polynomial: ...
    def truncate_powerseries(self, prec: int) -> PowerSeries_poly: ...
    def list(self) -> ElementList[Element]: ...
    def monomial_coefficients(self, copy: bool = True) -> dict[int, Element]: ...
    def integral(self, var: object = None) -> PowerSeries_poly: ...
    def revert(self, precision: int | None = None) -> PowerSeries_poly: ...
    def reverse(self, precision: int | None = None) -> PowerSeries_poly: ...
    def pade(self, m: int, n: int) -> tuple[Polynomial, Polynomial]: ...

class BaseRingFloorDivAction(Action): ...
