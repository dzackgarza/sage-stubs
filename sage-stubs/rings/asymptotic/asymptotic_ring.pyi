from collections.abc import Callable, Iterable, Iterator, Mapping
from typing import Literal, NamedTuple, Self

from sage.categories.category import Category
from sage.categories.map import Map
from sage.categories.pushout import ConstructionFunctor
from sage.data_structures.mutable_poset import MutablePoset
from sage.misc.fast_methods import WithLocals
from sage.plot.graphics import Graphics
from sage.rings.asymptotic.growth_group import GenericGrowthGroup
from sage.rings.asymptotic.term_monoid import (
    GenericTerm,
    GenericTermMonoid,
    TermMonoidFactory,
)
from sage.rings.integer import Integer
from sage.rings.rational import Rational
from sage.structure.element import CommutativeAlgebraElement, Element, RingElement
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation
from sage.symbolic.expression import Expression

type Precision = int | Integer | None
type TermType = Literal["O", "B", "exact"]
type LocalValue = ElementConstructorInput | Callable[..., ElementConstructorInput]

class NoConvergenceError(RuntimeError): ...

class SingularityAnalysisResult(NamedTuple):
    asymptotic_expansion: AsymptoticExpansion
    singular_expansions: dict[ElementConstructorInput, AsymptoticExpansion]

class AsymptoticExpansion(CommutativeAlgebraElement):
    def __init__(
        self,
        parent: AsymptoticRing,
        summands: MutablePoset | Iterable[GenericTerm],
        simplify: bool = ...,
        convert: bool = ...,
    ) -> None: ...
    def parent(self) -> AsymptoticRing: ...
    @property
    def summands(self) -> MutablePoset: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def has_same_summands(self, other: ElementConstructorInput) -> bool: ...
    def _repr_(self, latex: bool = ...) -> str: ...
    def _latex_(self) -> str: ...
    def show(self) -> None: ...
    def monomial_coefficient(self, monomial: ElementConstructorInput) -> RingElement: ...
    def __invert__(self, precision: Precision = ...) -> AsymptoticExpansion: ...
    def truncate(self, precision: Precision = ...) -> AsymptoticExpansion | GenericTerm: ...
    def exact_part(self) -> AsymptoticExpansion: ...
    def error_part(self) -> AsymptoticExpansion: ...
    def __pow__(
        self,
        exponent: ElementConstructorInput,
        precision: Precision = ...,
    ) -> AsymptoticExpansion: ...
    def __pow_number__(
        self,
        exponent: int | Integer | Rational,
        precision: Precision = ...,
        check_convergence: bool = ...,
    ) -> AsymptoticExpansion: ...
    def sqrt(self, precision: Precision = ...) -> AsymptoticExpansion: ...
    def O(self) -> AsymptoticExpansion: ...
    def log(
        self,
        base: ElementConstructorInput | None = ...,
        precision: Precision = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> AsymptoticExpansion: ...
    def is_exact(self) -> bool: ...
    def is_little_o_of_one(self) -> bool: ...
    def rpow(
        self,
        base: ElementConstructorInput,
        precision: Precision = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> AsymptoticExpansion: ...
    def exp(self, precision: Precision = ...) -> AsymptoticExpansion: ...
    def subs(
        self,
        rules: Mapping[ElementConstructorInput, ElementConstructorInput] | None = ...,
        domain: Parent | None = ...,
        **kwds: ElementConstructorInput,
    ) -> AsymptoticExpansion | RingElement | Expression: ...
    def compare_with_values(
        self,
        variable: str | Expression | AsymptoticExpansion,
        function: Callable[[ElementConstructorInput], ElementConstructorInput],
        values: Iterable[ElementConstructorInput],
        rescaled: bool = ...,
        ring: Parent | None = ...,
    ) -> list[tuple[ElementConstructorInput, RingElement]]: ...
    def plot_comparison(
        self,
        variable: str | Expression | AsymptoticExpansion,
        function: Callable[[ElementConstructorInput], ElementConstructorInput],
        values: Iterable[ElementConstructorInput],
        rescaled: bool = ...,
        ring: Parent | None = ...,
        relative_tolerance: float | RingElement = ...,
        **kwargs: ElementConstructorInput,
    ) -> Graphics: ...
    def symbolic_expression(self, R: Parent | None = ...) -> Expression: ...
    def map_coefficients(
        self,
        f: Map[RingElement, RingElement] | Callable[[RingElement], RingElement],
        new_coefficient_ring: Parent | None = ...,
    ) -> AsymptoticExpansion: ...
    def factorial(self) -> AsymptoticExpansion: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def limit(self) -> RingElement: ...
    def B(self, valid_from: ElementConstructorInput = ...) -> AsymptoticExpansion: ...

class AsymptoticRing(
    Parent[AsymptoticExpansion],
    UniqueRepresentation,
    WithLocals,
):
    Element: type[AsymptoticExpansion]
    @staticmethod
    def __classcall__(
        class_: type[AsymptoticRing],
        growth_group: GenericGrowthGroup | str | None = ...,
        coefficient_ring: Parent[RingElement] | None = ...,
        names: str | tuple[str, ...] | None = ...,
        category: Category | None = ...,
        default_prec: int | Integer | None = ...,
        term_monoid_factory: TermMonoidFactory | None = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> AsymptoticRing: ...
    def __init__(
        self,
        growth_group: GenericGrowthGroup,
        coefficient_ring: Parent[RingElement],
        category: Category,
        default_prec: int | Integer,
        term_monoid_factory: TermMonoidFactory,
        locals: Mapping[str, LocalValue],
    ) -> None: ...
    @property
    def growth_group(self) -> GenericGrowthGroup: ...
    @property
    def coefficient_ring(self) -> Parent[RingElement]: ...
    @property
    def default_prec(self) -> int | Integer: ...
    @property
    def term_monoid_factory(self) -> TermMonoidFactory: ...
    def term_monoid(self, type: TermType) -> GenericTermMonoid: ...
    def change_parameter(self, **kwds: ElementConstructorInput) -> AsymptoticRing: ...
    def _element_constructor_(
        self,
        data: ElementConstructorInput | Iterable[GenericTerm],
        simplify: bool = ...,
        convert: bool = ...,
    ) -> AsymptoticExpansion: ...
    def _coerce_map_from_(self, R: Parent) -> bool | None: ...
    def _repr_(self) -> str: ...
    def _an_element_(self) -> AsymptoticExpansion: ...
    def some_elements(self) -> Iterator[AsymptoticExpansion]: ...
    def gens(self) -> tuple[AsymptoticExpansion, ...]: ...
    def gen(self, n: int | Integer = ...) -> AsymptoticExpansion: ...
    def ngens(self) -> int: ...
    def coefficients_of_generating_function(
        self,
        function: Callable[[Expression], Expression],
        singularities: Iterable[ElementConstructorInput],
        precision: Precision = ...,
        return_singular_expansions: bool = ...,
        error_term: AsymptoticExpansion | None = ...,
    ) -> AsymptoticExpansion | SingularityAnalysisResult: ...
    def create_summand(
        self,
        type: TermType,
        data: ElementConstructorInput | None = ...,
        **kwds: ElementConstructorInput,
    ) -> AsymptoticExpansion: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def construction(self) -> tuple[AsymptoticRingFunctor, Parent[RingElement]]: ...
    @staticmethod
    def B(
        expression: AsymptoticExpansion,
        valid_from: ElementConstructorInput = ...,
    ) -> AsymptoticExpansion: ...

class AsymptoticRingFunctor(ConstructionFunctor):
    def __init__(
        self,
        growth_group: GenericGrowthGroup,
        default_prec: int | Integer | None = ...,
        category: Category | None = ...,
        term_monoid_factory: TermMonoidFactory | None = ...,
        locals: Mapping[str, LocalValue] | None = ...,
        cls: type[AsymptoticRing] = ...,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def _apply_functor(self, coefficient_ring: Parent[RingElement]) -> AsymptoticRing: ...
    def merge(self, other: ConstructionFunctor) -> AsymptoticRingFunctor | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
