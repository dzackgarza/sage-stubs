from collections.abc import Callable
from typing import Self

from sage.categories.category import Category
from sage.categories.map import Map
from sage.categories.pushout import ConstructionFunctor, Functor
from sage.misc.fast_methods import WithLocals
from sage.plot.graphics import Graphics
from sage.rings.asymptotic.growth_group import GenericGrowthGroup
from sage.rings.asymptotic.term_monoid import GenericTerm
from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.rational import Rational
from sage.rings.ring import Ring
from sage.structure.element import CommutativeAlgebraElement, Element, RingElement
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation
from sage.symbolic.expression import Expression

class RuntimeError: ...
class SingularityAnalysisResult: ...
class Stirling: ...

class AsymptoticExpansion(CommutativeAlgebraElement):
    def __init__(
        self,
        parent: Parent,
        summands: ElementConstructorInput,
        simplify: ElementConstructorInput = ...,
        convert: ElementConstructorInput = ...,
    ) -> None: ...
    @property
    def summands(self) -> tuple[GenericTerm, ...]: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def has_same_summands(
        self, other: AsymptoticExpansion | ElementConstructorInput
    ) -> bool: ...
    def _repr_(self, latex: Ring = ...) -> str: ...
    def _latex_(self) -> str: ...
    def show(self) -> None: ...
    def monomial_coefficient(self, monomial: Ring) -> AsymptoticExpansion | Ring: ...
    def __invert__(
        self, precision: int | Integer | None = ...
    ) -> AsymptoticExpansion: ...
    def truncate(self, precision: int | Integer | None = ...) -> Self: ...
    def exact_part(self) -> AsymptoticExpansion: ...
    def error_part(self) -> AsymptoticExpansion: ...
    def __pow__(
        self, exponent: int | Integer | Rational, precision: int | Integer | None = ...
    ) -> AsymptoticExpansion: ...
    def __pow_number__(
        self,
        exponent: int | Integer | Rational,
        precision: int | Integer | None = ...,
        check_convergence: int | Integer = ...,
    ) -> AsymptoticExpansion: ...
    def sqrt(
        self, precision: int | Integer | None = ...
    ) -> Self | list[Self] | Element: ...
    def O(self) -> AsymptoticExpansion: ...
    def log(
        self,
        base: Ring | None = ...,
        precision: int | Integer | None = ...,
        locals: Ring | None = ...,
    ) -> AsymptoticExpansion: ...
    def is_exact(self) -> bool: ...
    def is_little_o_of_one(self) -> bool: ...
    def rpow(
        self,
        base: Ring,
        precision: int | Integer | None = ...,
        locals: Ring | None = ...,
    ) -> AsymptoticExpansion: ...
    def exp(self, precision: int | Integer | None = ...) -> AsymptoticExpansion: ...
    def subs(
        self,
        rules: Ring | None = ...,
        domain: Parent | None = ...,
        **kwds: ElementConstructorInput,
    ) -> Self | RingElement: ...
    def compare_with_values(
        self,
        variable: str | Expression | int,
        function: Ring,
        values: Ring,
        rescaled: Ring = ...,
        ring: Ring = ...,
    ) -> list[tuple[ElementConstructorInput, Element]]: ...
    def plot_comparison(
        self,
        variable: str | Expression | int,
        function: Ring,
        values: Ring,
        rescaled: Ring = ...,
        ring: Ring = ...,
        relative_tolerance: Ring = ...,
        **kwargs: ElementConstructorInput,
    ) -> Graphics: ...
    def symbolic_expression(self, R: Ring | None = ...) -> AsymptoticExpansion: ...
    def map_coefficients(
        self,
        f: Polynomial | MPolynomial | Map | Callable[..., Element],
        new_coefficient_ring: int | Integer | None = ...,
    ) -> AsymptoticExpansion: ...
    def factorial(self) -> AsymptoticExpansion: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def limit(self) -> AsymptoticExpansion: ...
    def B(self, valid_from: Ring = ...) -> AsymptoticExpansion: ...

class AsymptoticRing(Parent, UniqueRepresentation, WithLocals):
    def variable_names(self) -> tuple[str, ...]: ...
    def base_ring(self) -> Ring: ...
    def gens(self) -> tuple[AsymptoticExpansion, ...]: ...
    @staticmethod
    def __classcall__(
        class_: type[AsymptoticRing],
        growth_group: ElementConstructorInput | None = ...,
        coefficient_ring: ElementConstructorInput | None = ...,
        names: str | tuple[str, ...] | None = ...,
        category: Category | None = ...,
        default_prec: ElementConstructorInput | None = ...,
        term_monoid_factory: ElementConstructorInput | None = ...,
        locals: ElementConstructorInput | None = ...,
    ) -> AsymptoticRing: ...
    def __init__(
        self,
        growth_group: ElementConstructorInput,
        coefficient_ring: ElementConstructorInput,
        category: Category | None,
        default_prec: ElementConstructorInput,
        term_monoid_factory: ElementConstructorInput,
        locals: ElementConstructorInput,
    ) -> None: ...
    @property
    def growth_group(self) -> GenericGrowthGroup: ...
    @property
    def coefficient_ring(self) -> Ring: ...
    @property
    def default_prec(self) -> AsymptoticExpansion: ...
    @property
    def term_monoid_factory(self) -> AsymptoticExpansion: ...
    def term_monoid(self, type: int | Integer) -> Parent: ...
    def change_parameter(
        self, **kwds: ElementConstructorInput
    ) -> AsymptoticExpansion | Self: ...
    def _element_constructor_(
        self,
        data: int | Integer,
        simplify: int | Integer = ...,
        convert: int | Integer = ...,
    ) -> AsymptoticExpansion: ...
    def _coerce_map_from_(self, R: Ring) -> bool | None: ...
    def _repr_(self) -> str: ...
    def _an_element_(self) -> AsymptoticExpansion: ...
    def some_elements(self) -> list[AsymptoticExpansion]: ...
    def gen(self, n: int | Integer = ...) -> AsymptoticExpansion: ...
    def ngens(self) -> int: ...
    def coefficients_of_generating_function(
        self,
        function: int | Integer,
        singularities: int | Integer,
        precision: int | Integer | None = ...,
        return_singular_expansions: int | Integer = ...,
        error_term: int | Integer | None = ...,
    ) -> int | Integer | SingularityAnalysisResult: ...
    def create_summand(
        self,
        type: int | Integer,
        data: int | Integer | None = ...,
        **kwds: ElementConstructorInput,
    ) -> AsymptoticExpansion: ...
    def construction(self) -> tuple[Functor, Parent] | None: ...
    @staticmethod
    def B(
        expression: ElementConstructorInput, valid_from: Ring = ...
    ) -> AsymptoticExpansion: ...

class NoConvergenceError(RuntimeError): ...

class AsymptoticRingFunctor(ConstructionFunctor):
    def __init__(
        self,
        growth_group: ElementConstructorInput,
        default_prec: ElementConstructorInput | None = ...,
        category: Category | None = ...,
        term_monoid_factory: ElementConstructorInput | None = ...,
        locals: ElementConstructorInput | None = ...,
        cls: type[Parent] | None = ...,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def merge(
        self, other: AsymptoticExpansion | ElementConstructorInput
    ) -> Self | AsymptoticRingFunctor: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
