from collections.abc import Iterable, Iterator, Mapping
from typing import Literal, NamedTuple, Self, overload

from sage.categories.category import Category
from sage.categories.pushout import ConstructionFunctor, Functor
from sage.rings.asymptotic.misc import LocalValue, WithLocals
from sage.rings.integer import Integer
from sage.rings.rational import Rational
from sage.structure.element import MultiplicativeGroupElement, RingElement
from sage.structure.factory import UniqueFactory
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import CachedRepresentation, UniqueRepresentation

class Variable(CachedRepresentation, SageObject):
    var_repr: str
    var_bases: tuple[str, ...]
    latex_name: str
    def __init__(
        self,
        var: str,
        repr: str | None = ...,
        latex_name: str | None = ...,
        ignore: Iterable[str] | None = ...,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def is_monomial(self) -> bool: ...
    @staticmethod
    def extract_variable_names(s: str | ElementConstructorInput) -> tuple[str, ...]: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class PartialConversionValueError(ValueError):
    element: ElementConstructorInput
    def __init__(self, element: ElementConstructorInput, *args: object, **kwds: object) -> None: ...

class PartialConversionElement(SageObject):
    growth_group: GenericGrowthGroup
    raw_element: ElementConstructorInput
    def __init__(
        self,
        growth_group: GenericGrowthGroup,
        raw_element: ElementConstructorInput,
    ) -> None: ...
    def split(self) -> tuple[PartialConversionElement, PartialConversionElement]: ...
    def is_compatible(self, other: GenericGrowthGroup) -> bool: ...
    def _repr_(self) -> str: ...

class GenericGrowthElement(MultiplicativeGroupElement):
    def __init__(
        self,
        parent: GenericGrowthGroup,
        raw_element: ElementConstructorInput,
    ) -> None: ...
    def parent(self) -> GenericGrowthGroup: ...
    def __hash__(self) -> int: ...
    def __invert__(self) -> Self: ...
    def factors(self) -> tuple[GenericGrowthElement, ...]: ...
    def is_lt_one(self) -> bool: ...
    def log(self, base: ElementConstructorInput | None = ...) -> GenericGrowthElement: ...
    def log_factor(
        self,
        base: ElementConstructorInput | None = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> tuple[tuple[GenericGrowthElement, RingElement], ...]: ...
    def rpow(self, base: ElementConstructorInput) -> GenericGrowthElement: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def _repr_(self) -> str: ...

class GenericGrowthGroup(
    UniqueRepresentation,
    Parent[GenericGrowthElement],
    WithLocals,
):
    Element: type[GenericGrowthElement]
    @staticmethod
    def __classcall__(
        class_: type[GenericGrowthGroup],
        base: Parent[RingElement],
        var: str | Variable | None = ...,
        category: Category | None = ...,
        ignore_variables: Iterable[str] | None = ...,
    ) -> GenericGrowthGroup: ...
    def __init__(
        self,
        base: Parent[RingElement],
        var: Variable | None,
        category: Category,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def _an_element_(self) -> GenericGrowthElement: ...
    def some_elements(self) -> Iterator[GenericGrowthElement]: ...
    def le(
        self,
        left: ElementConstructorInput,
        right: ElementConstructorInput,
    ) -> bool: ...
    def _element_constructor_(
        self,
        data: ElementConstructorInput,
        raw_element: ElementConstructorInput | None = ...,
    ) -> GenericGrowthElement: ...
    def is_compatible(self, other: GenericGrowthGroup) -> bool: ...
    def _coerce_map_from_(self, S: Parent) -> bool | None: ...
    def gens_monomial(self) -> tuple[GenericGrowthElement, ...]: ...
    def gens(self) -> tuple[GenericGrowthElement, ...]: ...
    def gen(self, n: int | Integer = ...) -> GenericGrowthElement: ...
    def ngens(self) -> int: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def extended_by_non_growth_group(self) -> GenericGrowthGroup: ...
    def non_growth_group(self) -> GenericGrowthGroup: ...
    def _repr_(self, condense: bool = ...) -> str: ...

class AbstractGrowthGroupFunctor(ConstructionFunctor):
    rank: int
    var: Variable
    domain: Parent[RingElement]
    def __init__(self, var: Variable, domain: Parent[RingElement]) -> None: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def _repr_(self) -> str: ...

class DecreasingGrowthElementError(ValueError):
    element: GenericGrowthElement
    def __init__(self, element: GenericGrowthElement, *args: object, **kwds: object) -> None: ...

class MonomialGrowthElement(GenericGrowthElement):
    @property
    def exponent(self) -> RingElement: ...
    def __invert__(self) -> Self: ...
    def __pow__(self, exponent: int | Integer | Rational) -> Self: ...
    def _repr_(self, latex: bool = ...) -> str: ...
    def _latex_(self) -> str: ...

class MonomialGrowthGroup(GenericGrowthGroup):
    Element: type[MonomialGrowthElement]
    def gens_monomial(self) -> tuple[MonomialGrowthElement, ...]: ...
    def gens_logarithmic(self) -> tuple[MonomialGrowthElement, ...]: ...
    def construction(self) -> tuple[MonomialGrowthGroupFunctor, Parent[RingElement]]: ...
    @classmethod
    @overload
    def factory(
        cls,
        base: Parent[RingElement],
        var: str | Variable,
        extend_by_non_growth_group: bool = ...,
        return_factors: Literal[False] = ...,
        **kwds: ElementConstructorInput,
    ) -> GenericGrowthGroup: ...
    @classmethod
    @overload
    def factory(
        cls,
        base: Parent[RingElement],
        var: str | Variable,
        extend_by_non_growth_group: bool,
        return_factors: Literal[True],
        **kwds: ElementConstructorInput,
    ) -> tuple[GenericGrowthGroup, ...]: ...
    def non_growth_group(self) -> GenericGrowthGroup: ...

class MonomialGrowthGroupFunctor(AbstractGrowthGroupFunctor):
    def __init__(self, var: Variable) -> None: ...
    def _apply_functor(self, base: Parent[RingElement]) -> MonomialGrowthGroup: ...

class ExponentialGrowthElement(GenericGrowthElement):
    @property
    def base(self) -> RingElement: ...
    def __invert__(self) -> Self: ...
    def __pow__(self, exponent: int | Integer | Rational) -> Self: ...
    def _repr_(self, latex: bool = ...) -> str: ...
    def _latex_(self) -> str: ...

class ExponentialGrowthGroup(GenericGrowthGroup):
    Element: type[ExponentialGrowthElement]
    def __init__(
        self,
        base: Parent[RingElement],
        *args: ElementConstructorInput,
        **kwds: ElementConstructorInput,
    ) -> None: ...
    def _an_element_(self) -> ExponentialGrowthElement: ...
    def some_elements(self) -> Iterator[ExponentialGrowthElement]: ...
    def gens(self) -> tuple[ExponentialGrowthElement, ...]: ...
    def construction(self) -> tuple[ExponentialGrowthGroupFunctor, Parent[RingElement]]: ...
    @classmethod
    @overload
    def factory(
        cls,
        base: Parent[RingElement],
        var: str | Variable,
        extend_by_non_growth_group: bool = ...,
        return_factors: Literal[False] = ...,
        **kwds: ElementConstructorInput,
    ) -> GenericGrowthGroup: ...
    @classmethod
    @overload
    def factory(
        cls,
        base: Parent[RingElement],
        var: str | Variable,
        extend_by_non_growth_group: bool,
        return_factors: Literal[True],
        **kwds: ElementConstructorInput,
    ) -> tuple[GenericGrowthGroup, ...]: ...
    def non_growth_group(self) -> GenericGrowthGroup: ...

class ExponentialGrowthGroupFunctor(AbstractGrowthGroupFunctor):
    def __init__(self, var: Variable) -> None: ...
    def _apply_functor(self, base: Parent[RingElement]) -> ExponentialGrowthGroup: ...

class GenericNonGrowthElement(GenericGrowthElement): ...
class GenericNonGrowthGroup(GenericGrowthGroup): ...
class ExponentialNonGrowthElement(GenericNonGrowthElement, ExponentialGrowthElement): ...

class ExponentialNonGrowthGroup(GenericNonGrowthGroup, ExponentialGrowthGroup):
    def construction(self) -> tuple[ExponentialNonGrowthGroupFunctor, Parent[RingElement]]: ...

class ExponentialNonGrowthGroupFunctor(ExponentialGrowthGroupFunctor):
    def _apply_functor(self, base: Parent[RingElement]) -> ExponentialNonGrowthGroup: ...

class MonomialNonGrowthElement(GenericNonGrowthElement, MonomialGrowthElement): ...

class MonomialNonGrowthGroup(GenericNonGrowthGroup, MonomialGrowthGroup):
    def construction(self) -> tuple[MonomialNonGrowthGroupFunctor, Parent[RingElement]]: ...

class MonomialNonGrowthGroupFunctor(MonomialGrowthGroupFunctor):
    def _apply_functor(self, base: Parent[RingElement]) -> MonomialNonGrowthGroup: ...

class GrowthGroupFactor(NamedTuple):
    cls: type[GenericGrowthGroup]
    base: Parent[RingElement]
    var: str
    extend_by_non_growth_group: bool

class GrowthGroupFactory(UniqueFactory):
    def create_key_and_extra_args(
        self,
        specification: str,
        **kwds: ElementConstructorInput,
    ) -> tuple[tuple[GrowthGroupFactor, ...], dict[str, ElementConstructorInput]]: ...
    def create_object(
        self,
        version: int | tuple[int, ...],
        factors: tuple[GrowthGroupFactor, ...],
        **kwds: ElementConstructorInput,
    ) -> GenericGrowthGroup: ...

GrowthGroup: GrowthGroupFactory
