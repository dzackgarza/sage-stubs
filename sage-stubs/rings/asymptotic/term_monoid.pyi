from collections.abc import Iterator, Mapping
from typing import Literal, Self

from sage.categories.category import Category
from sage.rings.asymptotic.growth_group import GenericGrowthElement, GenericGrowthGroup
from sage.rings.asymptotic.misc import LocalValue, WithLocals
from sage.rings.integer import Integer
from sage.rings.rational import Rational
from sage.structure.element import MultiplicativeGroupElement, RingElement
from sage.structure.factory import UniqueFactory
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

type TermType = Literal["O", "B", "exact"]
type TermConstructionValue = Parent | GenericGrowthElement | RingElement | ElementConstructorInput
type TermConstruction = tuple[type[GenericTerm], dict[str, TermConstructionValue]]
type TermMonoidKey = tuple[
    type[GenericTermMonoid],
    GenericGrowthGroup,
    Parent[RingElement],
]

class ZeroCoefficientError(ValueError): ...

def absorption(left: GenericTerm, right: GenericTerm) -> GenericTerm: ...
def can_absorb(left: GenericTerm, right: GenericTerm) -> bool: ...

class GenericTerm(MultiplicativeGroupElement):
    growth: GenericGrowthElement
    def __init__(
        self,
        parent: GenericTermMonoid,
        growth: GenericGrowthElement,
    ) -> None: ...
    def parent(self) -> GenericTermMonoid: ...
    def construction(self) -> TermConstruction: ...
    def __invert__(self) -> Self: ...
    def __pow__(self, exponent: int | Integer | Rational) -> Self: ...
    def can_absorb(self, other: GenericTerm) -> bool: ...
    def absorb(self, other: GenericTerm, check: bool = ...) -> GenericTerm: ...
    def log_term(
        self,
        base: ElementConstructorInput | None = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> tuple[GenericTerm, ...]: ...
    def is_constant(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def is_little_o_of_one(self) -> bool: ...
    def rpow(self, base: ElementConstructorInput) -> GenericTerm: ...
    def variable_names(self) -> tuple[str, ...]: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class GenericTermMonoid(
    UniqueRepresentation,
    Parent[GenericTerm],
    WithLocals,
):
    Element: type[GenericTerm]
    @staticmethod
    def __classcall__(
        class_: type[GenericTermMonoid],
        term_monoid_factory: TermMonoidFactory,
        growth_group: GenericGrowthGroup,
        coefficient_ring: Parent[RingElement],
        category: Category | None = ...,
    ) -> GenericTermMonoid: ...
    def __init__(
        self,
        term_monoid_factory: TermMonoidFactory,
        growth_group: GenericGrowthGroup,
        coefficient_ring: Parent[RingElement],
        category: Category,
    ) -> None: ...
    @property
    def term_monoid_factory(self) -> TermMonoidFactory: ...
    def term_monoid(self, type: TermType) -> GenericTermMonoid: ...
    @property
    def growth_group(self) -> GenericGrowthGroup: ...
    @property
    def coefficient_ring(self) -> Parent[RingElement]: ...
    def change_parameter(
        self,
        growth_group: GenericGrowthGroup | None = ...,
        coefficient_ring: Parent[RingElement] | None = ...,
    ) -> GenericTermMonoid: ...
    def from_construction(
        self,
        construction: TermConstruction,
        **kwds_overrides: TermConstructionValue,
    ) -> GenericTerm: ...
    def _an_element_(self) -> GenericTerm: ...
    def some_elements(self) -> Iterator[GenericTerm]: ...
    def le(self, left: ElementConstructorInput, right: ElementConstructorInput) -> bool: ...
    def _repr_(self) -> str: ...
    def _coerce_map_from_(self, S: Parent) -> bool | None: ...
    def _element_constructor_(
        self,
        data: ElementConstructorInput | TermConstruction,
        **kwds: TermConstructionValue,
    ) -> GenericTerm: ...

class OTerm(GenericTerm):
    def __invert__(self) -> Self: ...
    def __pow__(self, exponent: int | Integer | Rational) -> Self: ...
    def can_absorb(self, other: GenericTerm) -> bool: ...
    def log_term(
        self,
        base: ElementConstructorInput | None = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> tuple[GenericTerm, ...]: ...
    def is_little_o_of_one(self) -> bool: ...
    def rpow(self, base: ElementConstructorInput) -> GenericTerm: ...
    def _repr_(self, latex: bool = ...) -> str: ...
    def _latex_(self) -> str: ...

class OTermMonoid(GenericTermMonoid):
    Element: type[OTerm]
    def _coerce_map_from_(self, S: Parent) -> bool | None: ...
    def _repr_(self) -> str: ...

class TermWithCoefficient(GenericTerm):
    coefficient: RingElement
    def __init__(
        self,
        parent: TermWithCoefficientMonoid,
        growth: GenericGrowthElement,
        coefficient: RingElement,
    ) -> None: ...
    def construction(self) -> TermConstruction: ...
    def _repr_(self) -> str: ...

class TermWithCoefficientMonoid(GenericTermMonoid):
    Element: type[TermWithCoefficient]
    def _an_element_(self) -> GenericTerm: ...
    def some_elements(self) -> Iterator[GenericTerm]: ...
    def _repr_(self) -> str: ...

class ExactTerm(TermWithCoefficient):
    def __invert__(self) -> Self: ...
    def __pow__(self, exponent: int | Integer | Rational) -> Self: ...
    def can_absorb(self, other: GenericTerm) -> bool: ...
    def log_term(
        self,
        base: ElementConstructorInput | None = ...,
        locals: Mapping[str, LocalValue] | None = ...,
    ) -> tuple[GenericTerm, ...]: ...
    def is_constant(self) -> bool: ...
    def is_little_o_of_one(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def rpow(self, base: ElementConstructorInput) -> GenericTerm: ...
    def _repr_(self, latex: bool = ...) -> str: ...
    def _latex_(self) -> str: ...

class ExactTermMonoid(TermWithCoefficientMonoid):
    Element: type[ExactTerm]
    def _repr_(self) -> str: ...

class BTerm(TermWithCoefficient):
    valid_from: ElementConstructorInput
    def __init__(
        self,
        parent: BTermMonoid,
        growth: GenericGrowthElement,
        valid_from: ElementConstructorInput,
        **kwds: TermConstructionValue,
    ) -> None: ...
    def construction(self) -> TermConstruction: ...
    def can_absorb(self, other: GenericTerm) -> bool: ...
    def _repr_(self, latex: bool = ...) -> str: ...
    def _latex_(self) -> str: ...

class BTermMonoid(TermWithCoefficientMonoid):
    Element: type[BTerm]
    def _coerce_map_from_(self, S: Parent) -> bool | None: ...
    def _an_element_(self) -> GenericTerm: ...
    def some_elements(self) -> Iterator[GenericTerm]: ...
    def _repr_(self) -> str: ...

class TermMonoidFactory(UniqueRepresentation, UniqueFactory):
    ExactTermMonoid: type[ExactTermMonoid]
    OTermMonoid: type[OTermMonoid]
    BTermMonoid: type[BTermMonoid]
    def __init__(
        self,
        name: str,
        exact_term_monoid_class: type[ExactTermMonoid] | None = ...,
        O_term_monoid_class: type[OTermMonoid] | None = ...,
        B_term_monoid_class: type[BTermMonoid] | None = ...,
    ) -> None: ...
    def create_key_and_extra_args(
        self,
        term_monoid: TermType | GenericTermMonoid,
        growth_group: GenericGrowthGroup | str | None = ...,
        coefficient_ring: Parent[RingElement] | None = ...,
        asymptotic_ring: Parent | None = ...,
        **kwds: TermConstructionValue,
    ) -> tuple[TermMonoidKey, dict[str, TermConstructionValue]]: ...
    def create_object(
        self,
        version: int | tuple[int, ...],
        key: TermMonoidKey,
        **kwds: TermConstructionValue,
    ) -> GenericTermMonoid: ...
    def __hash__(self) -> int: ...
    def _repr_(self) -> str: ...

DefaultTermMonoidFactory: TermMonoidFactory
