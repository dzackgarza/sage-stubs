from typing import overload

from sage.categories.map import Map, Section
from sage.categories.morphism import Morphism
from sage.rings.finite_rings.finite_field_prime_modn import FiniteField_prime_modn
from sage.rings.finite_rings.integer_mod import IntegerMod_abstract
from sage.rings.finite_rings.maps_finite_field import FiniteFieldVectorSpaceIsomorphism
from sage.rings.ideal import Ideal_generic
from sage.rings.integer import Integer
from sage.rings.morphism import RingHomomorphism
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.quotient_ring import QuotientRingIdeal_generic
from sage.rings.ring import Field, Ring, _IdealArg, _IdealKwds
from sage.structure.element import Element
from sage.structure.factory import (
    FactoryArgument,
    FactoryCacheKey,
    FactoryExtraArgs,
    FactoryVersion,
    UniqueFactory,
)
from sage.structure.parent import Parent

class ResidueFieldFactory(UniqueFactory):
    def create_key_and_extra_args(self, *args: FactoryArgument, **kwds: FactoryArgument) -> tuple[FactoryCacheKey, FactoryExtraArgs]: ...
    def create_object(self, version: FactoryVersion, key: FactoryCacheKey, **kwds: FactoryArgument) -> ResidueField_generic: ...

class ResidueField_generic(Field):
    def __init__(self, p: Ideal_generic) -> None: ...
    def ideal(self, *args: _IdealArg, **kwds: _IdealKwds) -> QuotientRingIdeal_generic: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _coerce_map_from_(self, R: Parent) -> Morphism | bool | None: ...
    @overload
    def lift(self) -> RingHomomorphism: ...
    @overload
    def lift(self, x: Element) -> Element: ...
    def reduction_map(self) -> ReductionMap: ...
    def lift_map(self) -> LiftingMap: ...
    def _richcmp_(self, x: ResidueField_generic, op: int) -> bool: ...
    def __hash__(self) -> int: ...

class ReductionMap(Map):
    def __init__(self, K: Ring, F: ResidueField_generic, to_vs: FiniteFieldVectorSpaceIsomorphism, to_order: FiniteFieldVectorSpaceIsomorphism, PB: list[Element], PBinv: list[Element]) -> None: ...
    def _call_(self, x: Element) -> Element: ...
    def section(self) -> LiftingMap: ...

class ResidueFieldHomomorphism_global(RingHomomorphism):
    def __init__(self, K: Ring, F: ResidueField_generic, to_vs: FiniteFieldVectorSpaceIsomorphism, to_order: FiniteFieldVectorSpaceIsomorphism, PB: list[Element], PBinv: list[Element]) -> None: ...
    def _call_(self, x: Element) -> Element: ...
    def section(self) -> LiftingMap: ...
    def lift(self, x: Element | None = None) -> Element: ...

class LiftingMap(Section):
    def __init__(self, reduction: ReductionMap, to_order: FiniteFieldVectorSpaceIsomorphism, PB: list[Element]) -> None: ...
    def _call_(self, x: Element) -> Element: ...
    def _repr_type(self) -> str: ...

class ResidueFiniteField_prime_modn(ResidueField_generic, FiniteField_prime_modn):
    def __init__(self, p: Ideal_generic, name: str, intp: FiniteField_prime_modn, to_vs: FiniteFieldVectorSpaceIsomorphism, to_order: FiniteFieldVectorSpaceIsomorphism, PB: list[Element]) -> None: ...
    def _element_constructor_(self, x: Element | int | Integer | str | Polynomial | None) -> IntegerMod_abstract: ...
