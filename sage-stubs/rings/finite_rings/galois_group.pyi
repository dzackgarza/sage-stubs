from sage.groups.abelian_gps.abelian_group_element import AbelianGroupElement
from sage.groups.galois_group import GaloisGroup_cyc
from sage.rings.finite_rings.finite_field_base import FiniteField
from sage.rings.finite_rings.hom_finite_field import FiniteFieldHomomorphism_generic
from sage.rings.integer import Integer
from sage.structure.element import Element

class GaloisGroup_GFElement(AbelianGroupElement):
    def as_hom(self) -> FiniteFieldHomomorphism_generic: ...
    def __call__(self, x: Element) -> Element: ...
    def fixed_field(self) -> tuple[FiniteField, FiniteFieldHomomorphism_generic]: ...

class GaloisGroup_GF(GaloisGroup_cyc):
    def __init__(self, field: FiniteField) -> None: ...
    def _repr_(self) -> str: ...
    def _element_constructor_(self, x: Integer | GaloisGroup_GFElement | None, check: bool = True) -> GaloisGroup_GFElement: ...
