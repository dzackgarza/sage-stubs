from sage.categories.morphism import Morphism
from sage.matrix.matrix0 import Matrix
from sage.modules.free_module import FreeModule_generic
from sage.rings.finite_rings.finite_field_base import FiniteField
from sage.structure.element import Element

class FiniteFieldVectorSpaceIsomorphism(Morphism):
    def _repr_(self) -> str: ...
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...

class MorphismVectorSpaceToFiniteField(FiniteFieldVectorSpaceIsomorphism):
    def __init__(self, V: FreeModule_generic, K: FiniteField, C: Matrix) -> None: ...
    def _call_(self, v: Element) -> Element: ...

class MorphismFiniteFieldToVectorSpace(FiniteFieldVectorSpaceIsomorphism):
    def __init__(self, K: FiniteField, V: FreeModule_generic, C: Matrix) -> None: ...
    def _call_(self, e: Element) -> Element: ...
