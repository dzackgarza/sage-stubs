from sage.categories.map import Map
from sage.rings.finite_rings.finite_field_prime_modn import FiniteField_prime_modn
from sage.rings.finite_rings.hom_finite_field import (
    FiniteFieldHomomorphism_generic,
    FrobeniusEndomorphism_finite_field,
    SectionFiniteFieldHomomorphism_generic,
)
from sage.rings.finite_rings.homset import FiniteFieldHomset
from sage.structure.element import Element

class SectionFiniteFieldHomomorphism_prime(SectionFiniteFieldHomomorphism_generic):
    def _call_(self, x: Element) -> Element: ...

class FiniteFieldHomomorphism_prime(FiniteFieldHomomorphism_generic):
    def __init__(self, parent: FiniteFieldHomset, im_gens: tuple[Element, ...] | None = None, base_map: Map | None = None, check: bool = False, section_class: type[SectionFiniteFieldHomomorphism_generic] | None = None) -> None: ...
    def _call_(self, x: Element) -> Element: ...

class FrobeniusEndomorphism_prime(FrobeniusEndomorphism_finite_field):
    def __init__(self, domain: FiniteField_prime_modn, power: int = 1) -> None: ...
    def _call_(self, x: Element) -> Element: ...
    def _composition(self, right: FrobeniusEndomorphism_finite_field) -> FrobeniusEndomorphism_prime: ...
    def __pow__(self, n: int, modulus: Element) -> FrobeniusEndomorphism_prime: ...
    def fixed_field(self) -> tuple[FiniteField_prime_modn, FiniteFieldHomomorphism_prime]: ...
