from sage.categories.map import Map, Section
from sage.rings.finite_rings.finite_field_base import FiniteField
from sage.rings.finite_rings.homset import FiniteFieldHomset
from sage.rings.morphism import FrobeniusEndomorphism_generic, RingHomomorphism_im_gens
from sage.structure.element import Element

class SectionFiniteFieldHomomorphism_generic(Section):
    def _call_(self, x: Element) -> Element: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class FiniteFieldHomomorphism_generic(RingHomomorphism_im_gens):
    def __init__(
        self,
        parent: FiniteFieldHomset,
        im_gens: tuple[Element, ...] | None = None,
        base_map: Map | None = None,
        check: bool = True,
        section_class: type[SectionFiniteFieldHomomorphism_generic] | None = None,
    ) -> None: ...
    def __copy__(self) -> FiniteFieldHomomorphism_generic: ...
    def _latex_(self) -> str: ...
    def _call_(self, x: Element) -> Element: ...
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def section(self) -> SectionFiniteFieldHomomorphism_generic: ...
    def _inverse_image_element(self, b: Element) -> Element: ...
    def __hash__(self) -> int: ...

class FrobeniusEndomorphism_finite_field(FrobeniusEndomorphism_generic):
    def __init__(self, domain: FiniteField, n: int = 1) -> None: ...
    def _repr_(self) -> str: ...
    def _repr_short(self) -> str: ...
    def _latex_(self) -> str: ...
    def _call_(self, x: Element) -> Element: ...
    def order(self) -> int: ...
    def power(self) -> int: ...
    def __pow__(
        self, n: int, modulus: Element
    ) -> FrobeniusEndomorphism_finite_field: ...
    def inverse(self) -> FrobeniusEndomorphism_finite_field: ...
    def _composition(
        self, right: FrobeniusEndomorphism_finite_field
    ) -> FrobeniusEndomorphism_finite_field: ...
    def fixed_field(self) -> tuple[FiniteField, FiniteFieldHomomorphism_generic]: ...
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def is_identity(self) -> bool: ...
    def __hash__(self) -> int: ...
