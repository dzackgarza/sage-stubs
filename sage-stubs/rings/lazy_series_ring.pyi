from collections.abc import Callable

from sage.categories.pushout import CompletionFunctor
from sage.rings.lazy_series import (
    LazyCompletionGradedAlgebraElement,
    LazyDirichletSeries,
    LazyLaurentSeries,
    LazyPowerSeries,
    LazyPseudoDifferentialOperator,
)
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class LazySeriesRing(UniqueRepresentation, Parent):
    def undefined(
        self, valuation: int | None = None, name: str | None = None
    ) -> LazyLaurentSeries: ...
    def define_implicitly(
        self, series: LazyLaurentSeries, equations: object, max_lookahead: int = 1
    ) -> None: ...
    def one(self) -> Element: ...
    def zero(self) -> Element: ...
    def characteristic(self) -> int: ...
    def is_sparse(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def prod(
        self,
        f: Callable[[int], Element],
        a: int | None = None,
        b: object = ...,
        add_one: bool = False,
    ) -> Element: ...
    def sum(
        self, f: Callable[[int], Element], a: int | None = None, b: object = ...
    ) -> Element: ...

class LazyLaurentSeriesRing(LazySeriesRing):
    def __init__(
        self,
        base_ring: Ring,
        names: str | tuple[str, ...],
        sparse: bool = True,
        category: object = None,
    ) -> None: ...
    def gen(self, n: int = 0) -> LazyLaurentSeries: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple[Element, ...]: ...
    def some_elements(self) -> list[Element]: ...
    def series(
        self,
        coefficient: object,
        valuation: object,
        degree: int | None = None,
        constant: object = None,
    ) -> LazyLaurentSeries: ...
    def uniformizer(self) -> LazyLaurentSeries: ...
    def residue_field(self) -> Ring: ...
    def taylor(self, f: Element) -> LazyLaurentSeries: ...
    def q_pochhammer(self, q: Element | None = None) -> LazyLaurentSeries: ...
    def euler(self) -> LazyLaurentSeries: ...
    def jacobi_theta(
        self, w: Element, a: object = 0, b: object = 0
    ) -> LazyLaurentSeries: ...
    def polylog(self, s: object) -> LazyLaurentSeries: ...
    def dilog(self) -> LazyLaurentSeries: ...

class LazyPowerSeriesRing(LazySeriesRing):
    def __init__(
        self,
        base_ring: Ring,
        names: str | tuple[str, ...],
        sparse: bool = True,
        category: object = None,
    ) -> None: ...
    def construction(self) -> tuple[CompletionFunctor, Parent]: ...
    def gen(self, n: int = 0) -> LazyPowerSeries: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple[Element, ...]: ...
    def uniformizer(self) -> LazyPowerSeries: ...
    def residue_field(self) -> Ring: ...
    def fraction_field(self) -> LazyLaurentSeriesRing: ...
    def some_elements(self) -> list[Element]: ...
    def taylor(self, f: Element) -> LazyPowerSeries: ...

class LazyCompletionGradedAlgebra(LazySeriesRing):
    def __init__(
        self, basis: object, sparse: bool = True, category: object = None
    ) -> None: ...
    def some_elements(self) -> list[LazyCompletionGradedAlgebraElement]: ...

class LazySymmetricFunctions(LazyCompletionGradedAlgebra): ...

class LazyDirichletSeriesRing(LazySeriesRing):
    def __init__(
        self,
        base_ring: Ring,
        names: str | tuple[str, ...],
        sparse: bool = True,
        category: object = None,
    ) -> None: ...
    def one(self) -> LazyDirichletSeries: ...
    def some_elements(self) -> list[Element]: ...
    def polylogarithm(self, z: object) -> LazyDirichletSeries: ...

class LazyPseudoDifferentialOperatorRing(LazySeriesRing):
    def __init__(self, variable: str, sparse: bool, base_ring: Ring) -> None: ...
    def variable(self) -> str: ...
    def gen(self, n: int = 0) -> LazyPseudoDifferentialOperator: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple[Element, ...]: ...
