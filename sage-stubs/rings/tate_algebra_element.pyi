from typing import overload

from sage.rings.tate_algebra import TateAlgebra_generic, TateTermMonoid
from sage.rings.tate_algebra_ideal import TateAlgebraIdeal
from sage.structure.element import CommutativeAlgebraElement, Element, MonoidElement

class TateAlgebraTerm(MonoidElement):
    def __init__(self, parent: TateTermMonoid, coeff: Element, exponent: object = None) -> None: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def coefficient(self) -> Element: ...
    def exponent(self) -> tuple[int, ...]: ...
    def valuation(self) -> int: ...
    def __call__(self, *args: object) -> Element: ...
    def is_coprime_with(self, other: TateAlgebraTerm) -> bool: ...
    def gcd(self, other: TateAlgebraTerm) -> TateAlgebraTerm: ...
    def lcm(self, other: TateAlgebraTerm) -> TateAlgebraTerm: ...
    def is_divisible_by(self, other: TateAlgebraTerm, integral: bool = False) -> bool: ...
    def divides(self, other: TateAlgebraTerm, integral: bool = False) -> bool: ...

class TateAlgebraElement(CommutativeAlgebraElement):
    def __init__(self, parent: TateAlgebra_generic, x: object, prec: int | None = None, reduce: bool = True) -> None: ...
    def inverse_of_unit(self, prec: int | None = None) -> TateAlgebraElement: ...
    def is_unit(self) -> bool: ...
    def __pow__(self, exponent: object, modulus: object = ...) -> TateAlgebraElement: ...
    def square_root(self, prec: int | None = None) -> TateAlgebraElement: ...
    def sqrt(self, prec: int | None = None) -> TateAlgebraElement: ...
    def nth_root(self, n: int = 2, prec: int | None = None) -> TateAlgebraElement: ...
    def __call__(self, *args: object) -> Element: ...
    def __bool__(self) -> bool: ...
    def is_zero(self, prec: int | None = None) -> bool: ...
    def restriction(self, log_radii: object) -> TateAlgebraElement: ...
    def terms(self) -> list[TateAlgebraTerm]: ...
    def monomials(self) -> list[TateAlgebraTerm]: ...
    def monomial_coefficients(self) -> dict[tuple[int, ...], Element]: ...
    def coefficient(self, exponent: object) -> Element: ...
    def __getitem__(self, exponent: object) -> Element: ...
    def coefficients(self) -> list[Element]: ...
    def add_bigoh(self, n: int) -> TateAlgebraElement: ...
    def lift_to_precision(self, prec: int | None = None) -> TateAlgebraElement: ...
    def precision_absolute(self) -> int: ...
    def valuation(self) -> int: ...
    def precision_relative(self) -> int: ...
    def log(self, prec: int | None = None) -> TateAlgebraElement: ...
    def exp(self, prec: int | None = None) -> TateAlgebraElement: ...
    def leading_term(self, secure: bool = False) -> TateAlgebraTerm: ...
    def leading_coefficient(self, secure: bool = False) -> Element: ...
    def leading_monomial(self, secure: bool = False) -> TateAlgebraTerm: ...
    def is_monic(self) -> bool: ...
    def weierstrass_degree(self) -> int: ...
    def degree(self) -> int: ...
    def weierstrass_degrees(self) -> tuple[int, ...]: ...
    def degrees(self) -> tuple[int, ...]: ...
    def residue(self, n: int | None = None) -> Element: ...
    def quo_rem(self, divisors: list[TateAlgebraElement] | tuple[TateAlgebraElement, ...]) -> tuple[list[TateAlgebraElement], TateAlgebraElement]: ...
    def reduce(self, I: TateAlgebraIdeal) -> TateAlgebraElement: ...
    def Spoly(self, other: TateAlgebraElement) -> TateAlgebraElement: ...
