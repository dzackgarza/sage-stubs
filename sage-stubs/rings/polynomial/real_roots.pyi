class interval_bernstein_polynomial:
    def variations(self) -> int: ...
    def try_split(self, ctx: context, logging_note: str) -> bool: ...
    def try_rand_split(self, ctx: context, logging_note: str) -> bool: ...
    def region(self) -> tuple[Rational, Rational]: ...
    def region_width(self) -> Rational: ...

class interval_bernstein_polynomial_integer(interval_bernstein_polynomial):
    def __init__(self, coeffs: object, lower: Rational, upper: Rational, lsign: int, usign: int, error: int, scale_log2: int, level: int, slope_err: object) -> None: ...
    def _type_code(self) -> str: ...
    def de_casteljau(self, ctx: context, mid: Rational, msign: int = 0) -> interval_bernstein_polynomial_integer: ...
    def as_float(self) -> interval_bernstein_polynomial_float: ...
    def get_msb_bit(self) -> int: ...
    def down_degree(self, ctx: context, max_err: object, exp_err_shift: int) -> interval_bernstein_polynomial_integer: ...
    def down_degree_iter(self, ctx: context, max_scale: int) -> Iterator[interval_bernstein_polynomial_integer]: ...
    def downscale(self, bits: int) -> interval_bernstein_polynomial_integer: ...
    def slope_range(self) -> tuple[Rational, Rational]: ...

class interval_bernstein_polynomial_float(interval_bernstein_polynomial):
    def __init__(self, coeffs: object, lower: Rational, upper: Rational, lsign: int, usign: int, neg_err: float, pos_err: float, scale_log2: int, level: int, slope_err: object) -> None: ...
    def _type_code(self) -> str: ...
    def de_casteljau(self, ctx: context, mid: Rational, msign: int = 0) -> interval_bernstein_polynomial_float: ...
    def as_float(self) -> interval_bernstein_polynomial_float: ...
    def get_msb_bit(self) -> int: ...
    def slope_range(self) -> tuple[Rational, Rational]: ...

class PrecisionError(ValueError): ...

class bernstein_polynomial_factory:
    def _sign(self, v: object) -> int: ...
    def lsign(self) -> int: ...
    def usign(self) -> int: ...

class bernstein_polynomial_factory_intlist(bernstein_polynomial_factory):
    def __init__(self, coeffs: object) -> None: ...
    def coeffs_bitsize(self) -> int: ...
    def bernstein_polynomial(self, scale_log2: int) -> interval_bernstein_polynomial_integer: ...

class bernstein_polynomial_factory_ratlist(bernstein_polynomial_factory):
    def __init__(self, coeffs: object) -> None: ...
    def coeffs_bitsize(self) -> int: ...
    def bernstein_polynomial(self, scale_log2: int) -> interval_bernstein_polynomial_integer: ...

class bernstein_polynomial_factory_ar(bernstein_polynomial_factory):
    def __init__(self, poly: object, neg: bool) -> None: ...
    def coeffs_bitsize(self) -> int: ...
    def bernstein_polynomial(self, scale_log2: int) -> interval_bernstein_polynomial_float: ...

class ocean:
    def __init__(self, ctx: context, bpf: bernstein_polynomial_factory, mapping: object) -> None: ...
    def _islands(self) -> list[island]: ...
    def approx_bp(self, scale_log2: int) -> interval_bernstein_polynomial_integer | interval_bernstein_polynomial_float: ...
    def find_roots(self) -> None: ...
    def roots(self) -> list[island]: ...
    def refine_all(self) -> None: ...
    def all_done(self) -> bool: ...
    def reset_root_width(self, isle_num: int, target_width: Rational) -> None: ...
    def increase_precision(self) -> None: ...

class island:
    def __init__(self, bp: object, lgap: rr_gap, rgap: rr_gap) -> None: ...
    def _info(self) -> str: ...
    def shrink_bp(self, ctx: context) -> interval_bernstein_polynomial_integer | interval_bernstein_polynomial_float: ...
    def refine(self, ctx: context) -> None: ...
    def refine_recurse(self, ctx: context, bp: object, ancestors: list[object], history: object, rightmost: bool) -> None: ...
    def less_bits(self, ancestors: list[object], bp: object) -> bool: ...
    def more_bits(self, ctx: context, ancestors: list[object], bp: object, rightmost: bool) -> bool: ...
    def reset_root_width(self, target_width: Rational) -> None: ...
    def bp_done(self, bp: object) -> bool: ...
    def done(self, ctx: context) -> bool: ...
    def has_root(self) -> bool: ...

class rr_gap:
    def __init__(self, lower: Rational, upper: Rational, sign: int) -> None: ...
    def region(self) -> tuple[Rational, Rational]: ...

class linear_map:
    def __init__(self, lower: Rational, upper: Rational) -> None: ...
    def from_ocean(self, region: object) -> tuple[Rational, Rational]: ...
    def to_ocean(self, region: object) -> tuple[Rational, Rational]: ...

class warp_map:
    def __init__(self, neg: bool) -> None: ...
    def from_ocean(self, region: object) -> tuple[Rational, Rational]: ...
    def to_ocean(self, region: object) -> tuple[Rational, Rational]: ...

