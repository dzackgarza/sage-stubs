from collections.abc import Sequence

from sage.homology.free_resolution import FiniteFreeResolution_free_module
from sage.homology.graded_resolution import GradedFiniteFreeResolution_free_module
from sage.interfaces.expect import ExpectElement
from sage.plot.graphics import Graphics
from sage.rings.ideal import Ideal_generic
from sage.rings.infinity import PlusInfinity
from sage.rings.noncommutative_ideals import Ideal_nc
from sage.rings.polynomial.groebner_fan import GroebnerFan
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.multi_polynomial_ring_base import MPolynomialRing_base
from sage.rings.polynomial.multi_polynomial_sequence import PolynomialSequence_generic
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.quotient_ring import QuotientRingIdeal_generic
from sage.rings.rational import Rational
from sage.structure.element import CommutativeRingElement, Element
from sage.structure.parent import Parent
from sage.structure.sequence import Sequence_generic

class MethodDecorator: ...
class GroebnerStrategy: ...

class RequireField(MethodDecorator):
    def __call__(self, *args: object, **kwds: object) -> Element: ...

class MPolynomialIdeal_magma_repr:
    def _magma_init_(self, magma: object) -> str: ...
    def _groebner_basis_magma(
        self, deg_bound: object = None, prot: bool = False, magma: object = ...
    ) -> list[MPolynomial]: ...

class MPolynomialIdeal_singular_base_repr:
    def syzygy_module(self) -> Parent: ...
    def _groebner_basis_libsingular(
        self, algorithm: str = "groebner", *args: object, **kwds: object
    ) -> list[MPolynomial]: ...
    def _groebner_cover(self) -> list[MPolynomial]: ...

class MPolynomialIdeal_singular_repr(MPolynomialIdeal_singular_base_repr):
    def _singular_(self, singular: object = None) -> ExpectElement: ...
    def _groebner_strategy(self) -> GroebnerStrategy: ...
    def complete_primary_decomposition(
        self, algorithm: str = "sy"
    ) -> list[tuple[MPolynomialIdeal, int]]: ...
    def primary_decomposition(self, algorithm: str = "sy") -> list[Ideal_generic]: ...
    def associated_primes(self, algorithm: str = "sy") -> list[Ideal_generic]: ...
    def is_prime(self) -> bool: ...
    def triangular_decomposition(
        self, algorithm: str | None = None, singular: object = None
    ) -> Sequence_generic: ...
    def dimension(self, singular: object = None) -> int: ...
    def vector_space_dimension(self) -> int | PlusInfinity: ...
    def _groebner_basis_ginv(
        self,
        algorithm: str = "TQ",
        criteria: str = "CritPartially",
        division_interface: str = "Janet",
    ) -> list[MPolynomial]: ...
    def _groebner_basis_singular(
        self, algorithm: str = "groebner", *args: object, **kwds: object
    ) -> list[MPolynomial]: ...
    def _groebner_basis_singular_raw(
        self,
        algorithm: str = "groebner",
        singular: object = None,
        *args: object,
        **kwds: object,
    ) -> list[MPolynomial]: ...
    def genus(self) -> int | Rational: ...
    def intersection(self, *others: object) -> MPolynomialIdeal: ...
    def minimal_associated_primes(self) -> list[Ideal_generic]: ...
    def radical(self) -> Ideal_generic: ...
    def integral_closure(
        self, p: int = 0, r: bool = True, singular: object = None
    ) -> Sequence_generic: ...
    def syzygy_module(self) -> Parent: ...
    def free_resolution(
        self, *args: object, **kwds: object
    ) -> FiniteFreeResolution_free_module: ...
    def graded_free_resolution(
        self, *args: object, **kwds: object
    ) -> GradedFiniteFreeResolution_free_module: ...
    def interreduced_basis(self) -> list[MPolynomial]: ...
    def basis_is_groebner(self, singular: object = None) -> bool: ...
    def transformed_basis(
        self,
        algorithm: str = "gwalk",
        other_ring: object = None,
        singular: object = None,
    ) -> list[MPolynomial]: ...
    def elimination_ideal(
        self, variables: object, algorithm: object = None, *args: object, **kwds: object
    ) -> MPolynomialIdeal | NCPolynomialIdeal: ...
    def _elimination_ideal_libsingular(self, variables: object) -> MPolynomialIdeal: ...
    def quotient(self, J: MPolynomialIdeal) -> MPolynomialIdeal: ...
    def saturation(self, other: MPolynomialIdeal) -> tuple[MPolynomialIdeal, int]: ...
    def variety(
        self,
        ring: object = None,
        *,
        algorithm: str = "triangular_decomposition",
        proof: bool = True,
    ) -> list[dict[MPolynomial, Element]]: ...
    def _variety_triangular_decomposition(
        self, ring: object
    ) -> list[dict[MPolynomial, Element]]: ...
    def hilbert_polynomial(self, algorithm: str = "sage") -> Polynomial: ...
    def hilbert_series(
        self, grading: object = None, algorithm: str = "sage"
    ) -> CommutativeRingElement: ...
    def hilbert_numerator(
        self, grading: object = None, algorithm: str = "sage"
    ) -> CommutativeRingElement: ...
    def _normal_basis_libsingular(
        self, degree: object, weights: object = None
    ) -> list[MPolynomial]: ...
    def normal_basis(
        self,
        degree: object = None,
        algorithm: str = "libsingular",
        singular: object = None,
    ) -> list[MPolynomial]: ...

class MPolynomialIdeal_macaulay2_repr:
    def _groebner_basis_macaulay2(
        self, strategy: object = None
    ) -> list[MPolynomial]: ...
    def _reduce_using_macaulay2(self, f: object) -> MPolynomial: ...

class NCPolynomialIdeal(MPolynomialIdeal_singular_repr, Ideal_nc):
    def __init__(
        self, ring: object | Ring, gens: object, coerce: bool = True, side: str = "left"
    ) -> None: ...
    def __call_singular(self, cmd: object, arg: object = None) -> Element: ...
    def std(self) -> NCPolynomialIdeal: ...
    def groebner_basis(self) -> list[MPolynomial]: ...
    def elimination_ideal(
        self, variables: object, algorithm: object = None, *args: object, **kwds: object
    ) -> NCPolynomialIdeal: ...
    def twostd(self) -> NCPolynomialIdeal: ...
    def _groebner_strategy(self) -> GroebnerStrategy: ...
    def reduce(self, p: object) -> Element: ...
    def _contains_(self, p: object) -> bool: ...
    def syzygy_module(self) -> Parent: ...
    def res(self, length: int) -> Parent: ...
    def is_homogeneous(self) -> bool: ...

class MPolynomialIdeal(
    MPolynomialIdeal_singular_repr,
    MPolynomialIdeal_macaulay2_repr,
    MPolynomialIdeal_magma_repr,
    Ideal_generic,
):
    def __init__(
        self,
        ring: MPolynomialRing_base | Parent,
        gens: object | Sequence[Element] | Element,
        coerce: bool = True,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def gens(self) -> Sequence_generic: ...
    @property
    def basis(self) -> Sequence_generic: ...
    def __richcmp__(self, other: object, op: int) -> bool: ...
    def groebner_fan(
        self,
        is_groebner_basis: bool = False,
        symmetry: object = None,
        verbose: bool = False,
    ) -> GroebnerFan: ...
    def groebner_basis(
        self,
        algorithm: str = "",
        deg_bound: object = None,
        mult_bound: object = None,
        prot: bool = False,
        *args: object,
        **kwds: object,
    ) -> PolynomialSequence_generic: ...
    def groebner_cover(self) -> list[tuple[object, object]]: ...
    def change_ring(self, P: object) -> MPolynomialIdeal: ...
    def subs(self, in_dict: object = None, **kwds: object) -> MPolynomialIdeal: ...
    def reduce(self, f: object | Element) -> MPolynomial: ...
    def _contains_(self, f: object) -> bool: ...
    def homogenize(self, var: str = "h") -> MPolynomialIdeal: ...
    def is_homogeneous(self) -> bool: ...
    def degree_of_semi_regularity(self) -> int: ...
    def plot(self, *args: object, **kwds: object) -> Graphics: ...
    def random_element(self, *args: object, **kwds: object) -> Element: ...
    def weil_restriction(self) -> MPolynomialIdeal: ...

class MPolynomialIdeal_quotient(QuotientRingIdeal_generic, MPolynomialIdeal):
    def reduce(self, f: object) -> MPolynomial: ...
    def __richcmp__(self, other: object, op: int) -> bool: ...
