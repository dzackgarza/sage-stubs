from sage.categories.map import Section
from sage.rings.morphism import RingHomomorphism
from sage.rings.polynomial.ore_polynomial_ring import OrePolynomialRing
from sage.rings.polynomial.skew_polynomial_element import SkewPolynomial_generic_dense
from sage.rings.ring import Ring
from sage.structure.element import Element

def _base_ring_to_fraction_field(S: Ring) -> Ring: ...
def _minimal_vanishing_polynomial(R: object, eval_pts: object) -> SkewPolynomial_generic_dense: ...
def _lagrange_polynomial(R: object, eval_pts: object, values: object) -> SkewPolynomial_generic_dense: ...

class SkewPolynomialRing(OrePolynomialRing):
    def __init__(self, base_ring: Ring, morphism: object, derivation: object, name: str, sparse: bool, category: object = None) -> None: ...
    def minimal_vanishing_polynomial(self, eval_pts: object) -> SkewPolynomial_generic_dense: ...
    def lagrange_polynomial(self, points: object) -> SkewPolynomial_generic_dense: ...

class SectionSkewPolynomialCenterInjection(Section):
    def _call_(self, x: object) -> Element: ...
    def _richcmp_(self, right: object, op: int) -> bool: ...

class SkewPolynomialCenterInjection(RingHomomorphism):
    def __init__(self, domain: object, codomain: object, embed: object, order: object) -> None: ...
    def _repr_(self) -> str: ...
    def _call_(self, x: object) -> Element: ...
    def _richcmp_(self, right: object, op: int) -> bool: ...
    def section(self) -> SectionSkewPolynomialCenterInjection: ...

class SkewPolynomialRing_finite_order(SkewPolynomialRing):
    def __init__(self, base_ring: Ring, morphism: object, derivation: object, name: str, sparse: bool, category: object = None) -> None: ...
    def center(self, name: str | None = None, names: str | tuple[str, ...] | None = None, default: bool = False) -> Ring: ...

class SkewPolynomialRing_finite_field(SkewPolynomialRing_finite_order):
    def __init__(self, base_ring: Ring, morphism: object, derivation: object, names: str | tuple[str, ...], sparse: bool, category: object = None) -> None: ...
    def _new_retraction_map(self, seed: object = None) -> None: ...
    def _retraction(self, x: object, newmap: bool = False, seed: object = None) -> Element: ...
