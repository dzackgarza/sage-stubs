from collections.abc import Iterator

from sage.rings.polynomial.pbori.pbori import (
    BooleanMonomial,
    BooleanPolynomial,
    BooleanPolynomialRing,
)

class Block:
    size: int
    reverse: bool
    start_index: int
    var_name: str

    def __init__(
        self, var_name: str, size: int, start_index: int = 0, reverse: bool = False
    ) -> None: ...
    def __iter__(self) -> Iterator[object]: ...
    def __getitem__(self, i: int) -> BooleanMonomial: ...
    def __len__(self) -> int: ...
    def register(self, start: int, context: object) -> None: ...

class AlternatingBlock:
    reverse: bool
    size_per_variable: int

    def __init__(
        self,
        var_names: object,
        size_per_variable: int,
        start_index: int = 0,
        reverse: bool = False,
    ) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[object]: ...
    def __getitem__(self, i: int) -> BooleanMonomial: ...
    def register(self, start: int, context: object) -> None: ...

class AdderBlock(AlternatingBlock):
    adder_bits: int
    start_index: int
    carries: str
    sums: str
    input2: str
    input1: str

    def __init__(
        self,
        adder_bits: int,
        sums: str | int = "s",
        carries: str | int = "c",
        input1: str | bool = "a",
        input2: str = "b",
        start_index: int = 0,
    ) -> None: ...
    def register(self, start: int, context: object) -> None: ...
    def implement(self, equations: object) -> None: ...

class HigherOrderBlock:
    var_name: str

    def __init__(
        self,
        var_name: str,
        size_tuple: tuple[int, ...],
        start_index_tuple: object = None,
        reverse: bool = False,
    ) -> None: ...
    def __getitem__(self, i: int) -> BooleanMonomial: ...
    def __iter__(self) -> Iterator[object]: ...
    def __len__(self) -> int: ...
    def register(self, start: int, context: object) -> None: ...

class InOutBlock:
    in_start_index: int
    out_start_index: int
    input: Block
    output: Block

    def __init__(
        self,
        out_size: int,
        in_size: int,
        output: str = "out",
        input: str = "in",
        in_start_index: int = 0,
        out_start_index: int = 0,
        out_start_index_alt: object = None,
    ) -> None: ...
    def __iter__(self) -> Iterator[object]: ...
    def __getitem__(self, i: int) -> BooleanMonomial: ...
    def __len__(self) -> int: ...
    def register(self, start: int, context: object) -> None: ...

class MultiBlock:
    def __init__(
        self,
        sizes: object = None,
        var_names: list[str] = ["v"],
        start_indices: list[int] = [],
        reverses: object = None,
    ) -> None: ...
    def __iter__(self) -> Iterator[object]: ...
    def __getitem__(self, i: int) -> BooleanMonomial: ...
    def __len__(self) -> int: ...
    def register(self, start: int, context: object) -> None: ...

class PrefixedDictProxy:
    prefix: str

    def __init__(self, wrapped: dict[object, object], prefix: str) -> None: ...
    def __getitem__(self, k: object) -> BooleanMonomial: ...
    def __setitem__(self, k: object, v: object) -> None: ...

class MacroBlock:
    prefix: str

    def __init__(self, prefix: str) -> None: ...
    def declare(self, blocks: object) -> None: ...
    def connect(self, combinations: object) -> None: ...
    def __iter__(self) -> Iterator[object]: ...
    def __getitem__(self, i: int) -> BooleanMonomial: ...
    def __len__(self) -> int: ...
    def resolve(self, localname: str) -> BooleanMonomial: ...
    def register(self, start: int, context: object) -> None: ...
    def implement(self, equations: object) -> None: ...

class IfThen:
    supposedToBeValid: bool

    def __init__(
        self, ifpart: object, thenpart: object, supposed_to_be_valid: bool = True
    ) -> None: ...

def shift(self, i: int) -> BooleanPolynomial: ...
def if_then(self, t: object, supposed_to_be_valid: bool = True) -> IfThen: ...
def declare_ring(self, context: object = None) -> BooleanPolynomialRing: ...
def declare_block_scheme(self, context: object) -> BooleanPolynomialRing: ...
def main_test(self) -> None: ...
