from random import Random

from sage.rings.polynomial.pbori.pbori import BooleanMonomial, BooleanPolynomial

class CNFEncoder:
    random_generator: Random

    def __init__(self, r: object, random_seed: int = 16) -> None: ...
    def zero_blocks(self, f: object) -> list[BooleanMonomial]: ...
    def clauses(self, f: BooleanPolynomial) -> list[object]: ...
    def polynomial_clauses(self, f: BooleanPolynomial) -> list[object]: ...
    def to_dimacs_index(self, v: object) -> int: ...
    def dimacs_encode_clause(self, c: object) -> str: ...
    def dimacs_encode_polynomial(self, p: BooleanPolynomial) -> str: ...
    def dimacs_cnf(self, polynomial_system: object) -> str: ...

class CryptoMiniSatEncoder(CNFEncoder):
    def dimacs_encode_polynomial(self, p: BooleanPolynomial) -> str: ...
    def dimacs_cnf(self, polynomial_system: object) -> str: ...
