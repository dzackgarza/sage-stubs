from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.integer import Integer
from sage.rings.morphism import RingHomomorphism
from sage.rings.polynomial.ore_function_field import OreFunctionField
from sage.rings.polynomial.ore_polynomial_element import OrePolynomial, OrePolynomialBaseringInjection
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class OrePolynomialRing(UniqueRepresentation, Parent):
    @staticmethod
    def __classcall_private__(cls: type[OrePolynomialRing], base_ring: Ring, twist: object = None, names: str | tuple[str, ...] | None = None, sparse: bool = False, polcast: bool = True) -> OrePolynomialRing: ...
    def __init__(self, base_ring: Ring, morphism: object, derivation: object, name: str, sparse: bool, category: object = None) -> None: ...
    def __reduce__(self) -> tuple[type, tuple[object, ...]]: ...
    def _element_constructor_(self, a: object = None, check: bool = True, construct: bool = False, **kwds: object) -> OrePolynomial: ...
    def _coerce_map_from_base_ring(self) -> OrePolynomialBaseringInjection: ...
    def _coerce_map_from_(self, P: object) -> Morphism | bool | None: ...
    def _repr_twist(self) -> str: ...
    def _latex_twist(self) -> str: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def change_variable_name(self, var: str) -> OrePolynomialRing: ...
    def characteristic(self) -> Integer: ...
    def twisting_morphism(self, n: int = 1) -> RingHomomorphism: ...
    def twisting_derivation(self) -> Map: ...
    def gen(self, n: int = 0) -> OrePolynomial: ...
    def gens(self) -> tuple[OrePolynomial, ...]: ...
    def gens_dict(self, copy: bool = ...) -> dict[str, Element]: ...
    def is_finite(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def is_sparse(self) -> bool: ...
    def ngens(self) -> int: ...
    def random_element(self, degree: tuple[int, int] = (-1, 2), monic: bool = False, *args: object, **kwds: object) -> OrePolynomial: ...
    def random_irreducible(self, degree: int = 2, monic: bool = True, *args: object, **kwds: object) -> OrePolynomial: ...
    def is_field(self, proof: bool = False) -> bool: ...
    def fraction_field(self) -> OreFunctionField: ...
    def quotient_module(self, P: object, names: str | tuple[str, ...] | list[str] | None = None) -> Parent: ...
    def _pushout_(self, other: object) -> OrePolynomialRing | None: ...
