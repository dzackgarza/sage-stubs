from collections.abc import Callable

from sage.rings.ideal import Ideal_generic
from sage.rings.polynomial.laurent_polynomial import LaurentPolynomial
from sage.rings.polynomial.laurent_polynomial_ring_base import LaurentPolynomialRing_generic
from sage.structure.element import Element

class LaurentPolynomialIdeal(Ideal_generic):
    def __init__(self, ring: LaurentPolynomialRing_generic, gens: object, coerce: bool = True, hint: object = None) -> None: ...
    def set_hint(self, hint: Ideal_generic) -> None: ...
    def hint(self) -> Ideal_generic: ...
    def _richcmp_(self, right_r: object, op: int) -> bool: ...
    def __contains__(self, f: object) -> bool: ...
    def gens_reduced(self) -> tuple[LaurentPolynomial, ...]: ...
    def change_ring(self, R: LaurentPolynomialRing_generic, hint: object = None) -> LaurentPolynomialIdeal: ...
    def base_extend(self, F: object) -> LaurentPolynomialIdeal: ...
    def apply_map(self, f: Callable[..., Element], new_ring: object = None, new_base_ring: object = None, apply_to_hint: object = None) -> LaurentPolynomialIdeal: ...
    def apply_coeff_map(self, f: Callable[..., Element], new_base_ring: object = None, forward_hint: bool = True) -> LaurentPolynomialIdeal: ...
    def toric_coordinate_change(self, M: object, forward_hint: bool = True) -> LaurentPolynomialIdeal: ...
    def __add__(self, other: LaurentPolynomialIdeal) -> LaurentPolynomialIdeal: ...
    def normalize_gens(self) -> None: ...
    def polynomial_ideal(self, saturate: bool = True) -> Ideal_generic: ...
    def groebner_basis(self, saturate: bool = True) -> tuple[LaurentPolynomial, ...]: ...
    def is_one(self) -> bool: ...
    def is_binomial(self, groebner_basis: bool = False) -> bool: ...
    def associated_primes(self) -> list[Ideal_generic]: ...
    def minimal_associated_primes(self) -> list[Ideal_generic]: ...
    def radical(self) -> LaurentPolynomialIdeal: ...
    def dimension(self) -> int: ...
