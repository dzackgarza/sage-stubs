from sage.categories.map import Map, Section
from sage.categories.morphism import Morphism
from sage.rings.integer import Integer
from sage.rings.morphism import RingHomomorphism
from sage.rings.polynomial.ore_function_element import OreFunction, OreFunctionBaseringInjection
from sage.rings.polynomial.ore_polynomial_ring import OrePolynomialRing
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class OreFunctionField(Parent, UniqueRepresentation):
    def __init__(self, ring: OrePolynomialRing, category: object = None) -> None: ...
    def _element_constructor_(self, *args: object, **kwds: object) -> OreFunction: ...
    def _coerce_map_from_base_ring(self) -> OreFunctionBaseringInjection: ...
    def _coerce_map_from_(self, P: object) -> Morphism | bool | None: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def change_variable_name(self, var: str) -> OreFunctionField: ...
    def characteristic(self) -> Integer: ...
    def twisting_morphism(self, n: int = 1) -> RingHomomorphism: ...
    def twisting_derivation(self) -> Map: ...
    def gen(self, n: int = 0) -> OreFunction: ...
    def gens(self) -> tuple[OreFunction, ...]: ...
    def gens_dict(self, copy: bool = ...) -> dict[str, Element]: ...
    def is_finite(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def is_sparse(self) -> bool: ...
    def ngens(self) -> int: ...
    def random_element(self, degree: int = 2, monic: bool = False, *args: object, **kwds: object) -> OreFunction: ...
    def is_field(self, proof: bool = False) -> bool: ...
    def fraction_field(self) -> OreFunctionField: ...

class SectionOreFunctionCenterInjection(Section):
    def __init__(self, embed: object) -> None: ...
    def _call_(self, x: object) -> Element: ...
    def _richcmp_(self, right: object, op: int) -> bool: ...

class OreFunctionCenterInjection(RingHomomorphism):
    def __init__(self, domain: object, codomain: object, ringembed: object) -> None: ...
    def _repr_(self) -> str: ...
    def _call_(self, x: object) -> Element: ...
    def _richcmp_(self, right: object, op: int) -> bool: ...
    def section(self) -> SectionOreFunctionCenterInjection: ...

class OreFunctionField_with_large_center(OreFunctionField):
    def __init__(self, ring: OrePolynomialRing, category: object = None) -> None: ...
    def center(self, name: str | None = None, names: str | tuple[str, ...] | None = None, default: bool = False) -> Ring: ...
