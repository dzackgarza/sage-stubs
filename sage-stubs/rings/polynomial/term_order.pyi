    def sortkey_lex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_invlex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_deglex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_degrevlex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_neglex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_negdegrevlex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_negdeglex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_degneglex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_wdegrevlex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_wdeglex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_negwdeglex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_negwdegrevlex(self, f: object) -> tuple[object, ...]: ...
    def sortkey_block(self, f: object) -> tuple[object, ...]: ...
    def greater_tuple_matrix(self, f: object, g: object) -> bool: ...
    def greater_tuple_lex(self, f: object, g: object) -> bool: ...
    def greater_tuple_invlex(self, f: object, g: object) -> bool: ...
    def greater_tuple_deglex(self, f: object, g: object) -> bool: ...
    def greater_tuple_degrevlex(self, f: object, g: object) -> bool: ...
    def greater_tuple_negdegrevlex(self, f: object, g: object) -> bool: ...
    def greater_tuple_negdeglex(self, f: object, g: object) -> bool: ...
    def greater_tuple_degneglex(self, f: object, g: object) -> bool: ...
    def greater_tuple_neglex(self, f: object, g: object) -> bool: ...
    def greater_tuple_wdeglex(self, f: object, g: object) -> bool: ...
    def greater_tuple_wdegrevlex(self, f: object, g: object) -> bool: ...
    def greater_tuple_negwdeglex(self, f: object, g: object) -> bool: ...
    def greater_tuple_negwdegrevlex(self, f: object, g: object) -> bool: ...
    def greater_tuple_block(self, f: object, g: object) -> bool: ...
    def tuple_weight(self, f: object) -> int: ...
    def name(self) -> str: ...
    def _repr_(self) -> str: ...
    def singular_str(self) -> str: ...
    def singular_moreblocks(self) -> int: ...
    def macaulay2_str(self) -> str: ...
    def magma_str(self) -> str: ...
    def blocks(self) -> tuple[TermOrder, ...]: ...
    def matrix(self) -> Matrix: ...
    def weights(self) -> list[int] | list[list[int]]: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __add__(self, other: TermOrder) -> TermOrder: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> TermOrder: ...
    def __iter__(self) -> Iterator[TermOrder]: ...
    def is_global(self) -> bool: ...
    def is_local(self) -> bool: ...
