from collections.abc import Callable, Iterator
from typing import Literal, overload

from sage.geometry.polyhedron.base import Polyhedron_base
from sage.interfaces.expect import Expect, ExpectElement
from sage.rings.infinity import MinusInfinity, PlusInfinity
from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.rational import Rational
from sage.rings.ring import Ring
from sage.structure.element import CommutativeAlgebraElement, Element
from sage.structure.factorization import Factorization
from sage.structure.parent import Parent

class LaurentPolynomial(CommutativeAlgebraElement):
    def _add_(self, other: LaurentPolynomial) -> LaurentPolynomial: ...
    def _mul_(self, other: LaurentPolynomial) -> LaurentPolynomial: ...
    def _floordiv_(self, other: LaurentPolynomial) -> LaurentPolynomial: ...
    def _integer_(self, ZZ: Parent) -> Integer | None: ...
    def _rational_(self) -> Rational: ...
    def change_ring(self, R: Ring) -> LaurentPolynomial: ...
    def number_of_terms(self) -> int: ...
    def hamming_weight(self) -> int: ...
    def monomial_coefficients(self) -> dict[object, Element]: ...
    def map_coefficients(self, f: Callable[[Element], Element], new_base_ring: object = None) -> LaurentPolynomial: ...

class LaurentPolynomial_univariate(LaurentPolynomial):
    def __init__(self, parent: Parent, f: object, n: int = 0) -> None: ...
    def __reduce__(self) -> tuple[object, tuple[object, ...]]: ...
    def _polynomial_(self, R: Parent) -> Polynomial: ...
    def is_unit(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def _im_gens_(self, codomain: object, im_gens: object, base_map: object = None) -> Element: ...
    def _normalize(self) -> None: ...
    def _repr_(self) -> str: ...
    def _regina_(self, regina: Expect | None = None) -> ExpectElement: ...
    def _latex_(self) -> str: ...
    def __hash__(self) -> int: ...
    def __getitem__(self, i: int) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...
    def _symbolic_(self, R: Parent) -> Element: ...
    def coefficients(self) -> list[Element]: ...
    def exponents(self) -> list[int]: ...
    def newton_polytope(self) -> Polyhedron_base: ...
    def __setitem__(self, n: int, value: Element) -> None: ...
    def _unsafe_mutate(self, i: int, value: Element) -> None: ...
    def _add_(self, right_m: LaurentPolynomial) -> LaurentPolynomial_univariate: ...
    def _sub_(self, right_m: LaurentPolynomial) -> LaurentPolynomial_univariate: ...
    def degree(self) -> int | MinusInfinity: ...
    def __neg__(self) -> LaurentPolynomial_univariate: ...
    def _mul_(self, right_r: LaurentPolynomial) -> LaurentPolynomial_univariate: ...
    def _rmul_(self, c: Element) -> LaurentPolynomial_univariate: ...
    def _lmul_(self, c: Element) -> LaurentPolynomial_univariate: ...
    def is_monomial(self) -> bool: ...
    def __pow__(self, r: int, mod: object = ...) -> LaurentPolynomial_univariate: ...
    def _floordiv_(self, rhs: LaurentPolynomial) -> LaurentPolynomial_univariate: ...
    def shift(self, k: int) -> LaurentPolynomial_univariate: ...
    def __lshift__(self, k: int) -> LaurentPolynomial_univariate: ...
    def __rshift__(self, k: int) -> LaurentPolynomial_univariate: ...
    def _div_(self, rhs: LaurentPolynomial) -> LaurentPolynomial_univariate: ...
    def __invert__(self) -> LaurentPolynomial_univariate: ...
    def inverse_of_unit(self) -> LaurentPolynomial_univariate: ...
    def xgcd(self, other: LaurentPolynomial) -> tuple[Element, LaurentPolynomial_univariate, LaurentPolynomial_univariate]: ...
    def inverse_mod(self, a: LaurentPolynomial_univariate, m: LaurentPolynomial_univariate) -> LaurentPolynomial_univariate: ...
    def _fraction_pair(self) -> tuple[Polynomial, Polynomial]: ...
    def gcd(self, right: LaurentPolynomial_univariate) -> LaurentPolynomial_univariate: ...
    def euclidean_degree(self) -> int: ...
    def quo_rem(self, other: LaurentPolynomial_univariate) -> tuple[LaurentPolynomial_univariate, LaurentPolynomial_univariate]: ...
    def _richcmp_(self, right_r: object, op: int) -> bool: ...
    def valuation(self, p: object = None) -> int | PlusInfinity: ...
    def truncate(self, n: int) -> LaurentPolynomial_univariate: ...
    def variable_name(self) -> str: ...
    def variables(self) -> tuple[LaurentPolynomial_univariate, ...]: ...
    def polynomial_construction(self) -> tuple[Polynomial, int]: ...
    def monomial_reduction(self) -> tuple[Polynomial, LaurentPolynomial_univariate]: ...
    def is_constant(self) -> bool: ...
    @overload
    def is_square(self, root: Literal[False] = ...) -> bool: ...
    @overload
    def is_square(self, root: Literal[True]) -> tuple[bool, LaurentPolynomial_univariate]: ...
    def __copy__(self) -> LaurentPolynomial_univariate: ...
    def derivative(self, *args: object) -> LaurentPolynomial_univariate: ...
    def _derivative(self, var: object = None) -> LaurentPolynomial_univariate: ...
    def integral(self) -> LaurentPolynomial_univariate: ...
    def __call__(self, *x: object, **kwds: object) -> Element: ...
    def factor(self) -> Factorization: ...
    def residue(self) -> Element: ...
    def constant_coefficient(self) -> Element: ...
    def _as_extended_polynomial(self) -> MPolynomial: ...
    def divides(self, other: LaurentPolynomial_univariate) -> bool: ...
