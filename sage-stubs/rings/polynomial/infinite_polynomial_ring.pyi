from sage.categories.morphism import Morphism
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.polynomial.infinite_polynomial_element import InfinitePolynomial_dense, InfinitePolynomial_sparse
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.factory import FactoryArgument, FactoryCacheKey, FactoryVersion, UniqueFactory
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject

class KeyPolynomialBasis: ...

class InfinitePolynomialRingFactory(UniqueFactory):
    def create_key(self, *args: FactoryArgument, **kwds: FactoryArgument) -> FactoryCacheKey: ...
    def create_object(self, version: FactoryVersion, key: FactoryCacheKey, **extra_args: FactoryArgument) -> InfinitePolynomialRing_sparse | InfinitePolynomialRing_dense: ...

class InfiniteGenDict:
    def __init__(self, Gens: object) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __getitem__(self, k: object) -> Element: ...

class GenDictWithBasering:
    def __init__(self, parent: object, start: object) -> None: ...
    def __next__(self) -> Element: ...
    def __getitem__(self, k: object) -> Element: ...

class InfinitePolynomialRing_sparse(Ring):
    def __init__(self, R: Ring, names: object, order: object) -> None: ...
    def monomial(self, m: object) -> InfinitePolynomial_sparse: ...
    def _latex_(self) -> str: ...
    def _an_element_(self) -> InfinitePolynomial_sparse: ...
    def one(self) -> InfinitePolynomial_sparse: ...
    def construction(self) -> tuple[object, object]: ...
    def _coerce_map_from_(self, S: object) -> Morphism | bool | None: ...
    def _element_constructor_(self, x: object) -> InfinitePolynomial_sparse: ...
    def tensor_with_ring(self, R: Ring) -> InfinitePolynomialRing_sparse: ...
    def is_noetherian(self) -> bool: ...
    def is_field(self, *args: object, **kwds: object) -> bool: ...
    def varname_key(self, x: str) -> tuple[int, ...]: ...
    def ngens(self) -> int: ...
    def gen(self, i: int | None = None) -> InfinitePolynomialGen: ...
    def _first_ngens(self, n: int) -> tuple[Element, ...]: ...
    def gens_dict(self, copy: bool = ...) -> dict[str, Element]: ...
    def _ideal_class_(self, n: int = 0) -> type[object]: ...
    def characteristic(self) -> Integer: ...
    def is_integral_domain(self, *args: object, **kwds: object) -> bool: ...
    def krull_dimension(self, *args: object, **kwds: object) -> int: ...
    def order(self) -> PlusInfinity: ...
    def key_basis(self) -> KeyPolynomialBasis: ...

class InfinitePolynomialGen(SageObject):
    def __init__(self, parent: object, name: str) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def _latex_(self) -> str: ...
    def __getitem__(self, i: int) -> InfinitePolynomial_sparse: ...
    def _repr_(self) -> str: ...

class InfinitePolynomialRing_dense(InfinitePolynomialRing_sparse):
    def __init__(self, R: Ring, names: object, order: object) -> None: ...
    def construction(self) -> tuple[object, object]: ...
    def tensor_with_ring(self, R: Ring) -> InfinitePolynomialRing_dense: ...
    def polynomial_ring(self) -> Ring: ...
