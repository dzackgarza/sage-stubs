def PolynomialSequence(arg1: object, arg2: object = None, immutable: bool = False, cr: bool = False, cr_str: str | None = None) -> PolynomialSequence_generic: ...

class PolynomialSequence_generic(Sequence_generic):
    def __init__(self, parts: object, ring: MPolynomialRing_base, immutable: bool = False, cr: bool = False, cr_str: str | None = None) -> None: ...
    def __copy__(self) -> PolynomialSequence_generic: ...
    def ring(self) -> MPolynomialRing_base: ...
    def nparts(self) -> int: ...
    def parts(self) -> tuple[MPolynomial, ...]: ...
    def part(self, i: int) -> MPolynomial: ...
    def ideal(self) -> MPolynomialIdeal: ...
    def groebner_basis(self, *args: object, **kwargs: object) -> PolynomialSequence_generic: ...
    def monomials(self) -> list[MPolynomial]: ...
    def nmonomials(self) -> int: ...
    def variables(self) -> tuple[MPolynomial, ...]: ...
    def nvariables(self) -> int: ...
    def algebraic_dependence(self) -> list[MPolynomial] | None: ...
    def coefficients_monomials(self, order: object = None, sparse: bool = True) -> tuple[object, list[MPolynomial]]: ...
    def macaulay_matrix(self, degree: int, homogeneous: bool = False, variables: object = None, return_indices: bool = False, remove_zero: bool = False, reduced: bool = False, **kwds: object) -> Matrix | tuple[Matrix, object]: ...
    def subs(self, *args: object, **kwargs: object) -> PolynomialSequence_generic: ...
    def _singular_(self, G: Expect | None = ...) -> ExpectElement: ...
    def _magma_init_(self, magma: object) -> str: ...
    def _is_short_for_repr(self) -> bool: ...
    def _repr_(self) -> str: ...
    def _repr_pretty_(self, p: object, cycle: object) -> None: ...
    def connection_graph(self) -> Graph: ...
    def connected_components(self) -> list[list[MPolynomial]]: ...
    def _groebner_strategy(self) -> GroebnerStrategy: ...
    def maximal_degree(self) -> int: ...
    def minimal_degree(self) -> int: ...
    def reduced(self) -> PolynomialSequence_generic: ...
    def is_groebner(self, singular: object = ...) -> bool: ...

class PolynomialSequence_gf2(PolynomialSequence_generic):
    def eliminate_linear_variables(self, maxlength: int | PlusInfinity = ..., skip: object = None, return_reductors: bool = False, use_polybori: bool = False) -> PolynomialSequence_gf2 | tuple[PolynomialSequence_gf2, object]: ...
    def _groebner_strategy(self) -> GroebnerStrategy: ...
    def solve(self, algorithm: str = 'polybori', n: int = 1, eliminate_linear_variables: bool = True, verbose: bool = False, **kwds: object) -> list[dict[object, Element]]: ...
    def reduced(self) -> PolynomialSequence_gf2: ...
    def coefficients_monomials(self, order: object = None, sparse: bool = True) -> tuple[object, list[MPolynomial]]: ...

class PolynomialSequence_gf2e(PolynomialSequence_generic):
    def weil_restriction(self) -> PolynomialSequence_gf2: ...
