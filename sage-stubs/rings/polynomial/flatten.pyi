from sage.categories.morphism import Morphism
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.structure.element import Element

class FlatteningMorphism(Morphism):
    def __init__(self, domain: object) -> None: ...
    def _call_(self, p: object) -> MPolynomial: ...
    def section(self) -> UnflatteningMorphism: ...
    def inverse(self) -> UnflatteningMorphism: ...

class UnflatteningMorphism(Morphism):
    def __init__(self, domain: object, codomain: object) -> None: ...
    def _call_(self, p: object) -> MPolynomial: ...

class SpecializationMorphism(Morphism):
    def __init__(self, domain: object, D: object) -> None: ...
    def _call_(self, p: object) -> MPolynomial: ...

class FractionSpecializationMorphism(Morphism):
    def __init__(self, domain: object, D: object) -> None: ...
    def _call_(self, p: object) -> Element: ...
