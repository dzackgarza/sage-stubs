from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.polynomial.ore_polynomial_element import OrePolynomial
from sage.structure.element import AlgebraElement, Element, RingElement
from sage.structure.parent import Parent

class OreFunction(AlgebraElement):
    def __init__(self, parent: Parent, numerator: object, denominator: object = None, simplify: bool = True) -> None: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def __hash__(self) -> int: ...
    def _richcmp_(self, other: object, op: int) -> bool: ...
    def left_denominator(self) -> OrePolynomial: ...
    def right_numerator(self) -> OrePolynomial: ...
    def _reverse_fraction(self) -> OreFunction: ...
    def right_denominator(self) -> OrePolynomial: ...
    def left_numerator(self) -> OrePolynomial: ...
    def is_zero(self) -> bool: ...
    def _add_(self, other: OreFunction) -> OreFunction: ...
    def _sub_(self, other: OreFunction) -> OreFunction: ...
    def _neg_(self) -> OreFunction: ...
    def _mul_(self, other: OreFunction) -> OreFunction: ...
    def _div_(self, other: OreFunction) -> OreFunction: ...
    def __invert__(self) -> OreFunction: ...
    def hilbert_shift(self, s: RingElement, var: str | None = None) -> OreFunction: ...

class ConstantOreFunctionSection(Map):
    def _call_(self, x: object) -> Element: ...

class OreFunctionBaseringInjection(Morphism):
    def __init__(self, domain: object, codomain: object) -> None: ...
    def an_element(self) -> OreFunction: ...
    def _call_(self, x: object) -> Element: ...
    def section(self) -> ConstantOreFunctionSection: ...

class OreFunction_with_large_center(OreFunction):
    def reduced_trace(self, var: str | None = None) -> RingElement: ...
    def reduced_norm(self, var: str | None = None) -> RingElement: ...
