from collections.abc import Callable

from sage.rings.polynomial.multi_polynomial_element import MPolynomial_polydict
from sage.rings.polynomial.multi_polynomial_ring_base import MPolynomialRing_base
from sage.rings.polynomial.polynomial_singular_interface import PolynomialRing_singular_repr
from sage.rings.ring import Ring

class MPolynomialRing_macaulay2_repr:
    def _macaulay2_init_(self, macaulay2: object = None) -> str: ...

class MPolynomialRing_polydict(MPolynomialRing_macaulay2_repr, PolynomialRing_singular_repr, MPolynomialRing_base):
    def __init__(self, base_ring: Ring, n: int, names: object, order: object) -> None: ...
    def _monomial_order_function(self) -> Callable[..., int]: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def _element_constructor_(self, x: object = 0, check: bool = True) -> MPolynomial_polydict: ...
    def monomial_quotient(self, f: MPolynomial_polydict, g: MPolynomial_polydict, coeff: bool = False) -> MPolynomial_polydict: ...
    def monomial_lcm(self, f: MPolynomial_polydict, g: MPolynomial_polydict) -> MPolynomial_polydict: ...
    def monomial_reduce(self, f: MPolynomial_polydict, G: object) -> MPolynomial_polydict: ...
    def monomial_divides(self, a: MPolynomial_polydict, b: MPolynomial_polydict) -> bool: ...
    def monomial_pairwise_prime(self, h: MPolynomial_polydict, g: MPolynomial_polydict) -> bool: ...
    def monomial_all_divisors(self, t: MPolynomial_polydict) -> list[MPolynomial_polydict]: ...
    def sum(self, terms: object) -> MPolynomial_polydict: ...

class MPolynomialRing_polydict_domain(MPolynomialRing_polydict):
    def __init__(self, base_ring: Ring, n: int, names: object, order: object) -> None: ...
    def is_field(self, proof: bool = True) -> bool: ...
