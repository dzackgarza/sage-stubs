class Polynomial(CommutativePolynomial):
    def __init__(
        self, parent: Parent, is_gen: bool = False, construct: bool = False
    ) -> None: ...
    def plot(
        self, xmin: object = None, xmax: object = None, *args: object, **kwds: object
    ) -> Graphics: ...
    def subs(
        self, in_dict: dict[object, object] | None = None, *args: object, **kwds: object
    ) -> Element: ...
    def __call__(self, *args: object, **kwds: object) -> Element: ...
    def compose_trunc(self, other: Polynomial, n: int) -> Polynomial: ...
    def __bool__(self) -> bool: ...
    def __getitem__(self, n: int) -> Element: ...
    def newton_polytope(self) -> Polyhedron_base: ...
    def __iter__(self) -> Iterator[Element]: ...
    def __hash__(self) -> int: ...
    def __invert__(self) -> Polynomial: ...
    def inverse_of_unit(self) -> Polynomial: ...
    def inverse_mod(self, a: Polynomial, m: Polynomial) -> Polynomial: ...
    def revert_series(self, n: int) -> Polynomial: ...
    def multiplication_trunc(self, other: Polynomial, n: int) -> Polynomial: ...
    def square(self) -> Polynomial: ...
    def squarefree_decomposition(self) -> Factorization: ...
    @overload
    def is_square(self, root: Literal[False] = ...) -> bool: ...
    @overload
    def is_square(self, root: Literal[True]) -> tuple[bool, Polynomial]: ...
    def any_irreducible_factor(
        self, degree: int | None = None, assume_squarefree: bool = False
    ) -> bool: ...
    def any_root(
        self,
        ring: object = None,
        degree: int | None = None,
        assume_squarefree: bool = False,
    ) -> bool: ...
    def __truediv__(self, right: object) -> Element: ...
    def __pow__(self, right: int, modulus: object = ...) -> Polynomial: ...
    def power_trunc(self, n: int, prec: int) -> Polynomial: ...
    def __mod__(self, other: Polynomial) -> Polynomial: ...
    def mod(self, other: Polynomial) -> Polynomial: ...
    def base_ring(self) -> Rings.ParentMethods[RingElement]: ...
    def base_extend(self, R: Ring) -> Polynomial: ...
    def change_variable_name(self, var: str) -> Polynomial: ...
    def change_ring(self, R: Ring) -> Polynomial: ...
    def degree(self, gen: object = ...) -> Integer: ...
    def euclidean_degree(self) -> int | PlusInfinity: ...
    def denominator(self) -> Element: ...
    def numerator(self) -> Polynomial: ...
    def derivative(self, *args: object) -> Polynomial: ...
    def gradient(self) -> list[Polynomial]: ...
    def integral(self, var: object = None) -> Polynomial: ...
    def monomial_coefficients(self, copy: object = None) -> dict[object, Element]: ...
    def factor(self, **kwargs: object) -> Factorization: ...
    def splitting_field(
        self, names: object = None, map: bool = False, **kwds: object
    ) -> NumberField_generic | tuple[NumberField_generic, RingHomomorphism]: ...
    def pseudo_quo_rem(
        self, other: Polynomial
    ) -> tuple[Polynomial, Polynomial, Element]: ...
    def gcd(self, other: Polynomial) -> Polynomial: ...
    def lcm(self, other: Polynomial) -> Polynomial: ...
    def is_primitive(self, n: object = None, n_prime_divs: object = None) -> bool: ...
    def is_constant(self) -> bool: ...
    def is_monomial(self) -> bool: ...
    def root_field(
        self, names: object, check_irreducible: bool = True
    ) -> NumberField_generic: ...
    def sylvester_matrix(
        self, right: Polynomial, variable: object = None
    ) -> Matrix: ...
    def constant_coefficient(self) -> Element: ...
    def is_monic(self) -> bool: ...
    def is_unit(self) -> bool: ...
    def is_nilpotent(self) -> bool: ...
    def is_gen(self) -> bool: ...
    def lc(self) -> Element: ...
    def leading_coefficient(self) -> Element: ...
    def canonical_associate(self) -> Polynomial: ...
    def lm(self) -> Polynomial: ...
    def lt(self) -> Polynomial: ...
    def monic(self) -> Polynomial: ...
    def coefficients(
        self, sparse: bool = ...
    ) -> list[Element] | dict[int, Element]: ...
    def global_height(self, prec: object = None) -> RealNumber: ...
    def local_height(self, v: object, prec: object = None) -> RealNumber: ...
    def local_height_arch(self, i: int, prec: object = None) -> RealNumber: ...
    def exponents(self) -> list[int]: ...
    def prec(self) -> int: ...
    def padded_list(self, n: int | None = None) -> list[Element]: ...
    def monomial_coefficient(self, m: object) -> Element: ...
    def monomials(self) -> list[Polynomial]: ...
    def newton_raphson(self, n: int, x0: object) -> Polynomial: ...
    def polynomial(self, var: object) -> Polynomial: ...
    def newton_slopes(self, p: object, lengths: bool = False) -> list[Rational]: ...
    def dispersion_set(self, other: Polynomial | None = None) -> list[int]: ...
    def dispersion(self, other: Polynomial | None = None) -> int: ...
    def resultant(self, other: Polynomial) -> Element: ...
    def subresultants(self, other: Polynomial) -> list[Polynomial]: ...
    @staticmethod
    def composed_op(
        p1: Polynomial,
        p2: Polynomial,
        op: Callable[[Element, Element], Element],
        algorithm: object = None,
        monic: bool = False,
    ) -> Polynomial: ...
    def compose_power(
        self, k: int, algorithm: object = None, monic: bool = False
    ) -> Polynomial: ...
    def adams_operator_on_roots(self, n: int, monic: bool = False) -> Polynomial: ...
    def symmetric_power(self, k: int, monic: bool = False) -> Polynomial: ...
    def discriminant(self) -> Element: ...
    def reverse(self, degree: int | None = None) -> Polynomial: ...
    @overload
    def roots(
        self, ring: Parent | None = ..., multiplicities: Literal[True] = ...
    ) -> list[tuple[RingElement, Integer]]: ...
    @overload
    def roots(
        self, ring: Parent | None, multiplicities: Literal[False]
    ) -> list[RingElement]: ...
    def real_roots(self) -> list[RealNumber]: ...
    def complex_roots(self) -> list[ComplexNumber]: ...
    def number_of_roots_in_interval(
        self, a: object = None, b: object = None
    ) -> int: ...
    def number_of_real_roots(self) -> int: ...
    def all_roots_in_interval(
        self, a: object = None, b: object = None
    ) -> list[RealNumber]: ...
    def is_real_rooted(self) -> bool: ...
    def reciprocal_transform(self, R: object = 1, q: object = 1) -> Polynomial: ...
    def trace_polynomial(self) -> Polynomial: ...
    @overload
    def is_weil_polynomial(self, return_q: Literal[False] = ...) -> bool: ...
    @overload
    def is_weil_polynomial(self, return_q: Literal[True]) -> tuple[bool, int]: ...
    def is_lorentzian(self, explain: bool = False) -> bool: ...
    def variable_name(self) -> str: ...
    def xgcd(self, other: Polynomial) -> tuple[Element, Polynomial, Polynomial]: ...
    def rational_reconstruction(
        self, m: object, n_deg: int | None = None, d_deg: int | None = None
    ) -> Polynomial | tuple[Polynomial, Polynomial]: ...
    def variables(self) -> tuple[Polynomial, ...]: ...
    def args(self) -> tuple[Polynomial, ...]: ...
    def valuation(self, p: object = None) -> int | PlusInfinity: ...
    def ord(self, p: object = None) -> int | PlusInfinity: ...
    def add_bigoh(self, prec: int) -> PowerSeries_poly: ...
    def is_irreducible(self) -> bool: ...
    def shift(self, n: int) -> Polynomial: ...
    def is_squarefree(self) -> bool: ...
    def radical(self) -> Polynomial: ...
    def content_ideal(self) -> Ideal_generic: ...
    def norm(self, p: object) -> Element: ...
    def map_coefficients(
        self, f: Callable[[Element], Element], new_base_ring: object = None
    ) -> Polynomial: ...
    @overload
    def is_cyclotomic(
        self, certificate: Literal[False] = ..., algorithm: str = "pari"
    ) -> bool: ...
    @overload
    def is_cyclotomic(
        self, certificate: Literal[True], algorithm: str = "pari"
    ) -> int: ...
    def is_cyclotomic_product(self) -> bool: ...
    def cyclotomic_part(self) -> Polynomial: ...
    def has_cyclotomic_factor(self) -> bool: ...
    def homogenize(self, var: str = "h") -> Polynomial: ...
    def is_homogeneous(self) -> bool: ...
    def nth_root(self, n: int) -> Polynomial | None: ...
    def divides(self, p: Polynomial) -> bool: ...

class Polynomial_generic_dense(Polynomial):
    def __init__(
        self,
        parent: Parent,
        x: object | bool = None,
        check: bool = True,
        is_gen: bool = False,
        construct: bool = False,
    ) -> None: ...

class Polynomial_generic_dense_inexact(Polynomial_generic_dense): ...

class ConstantPolynomialSection(Map):
    def __init__(
        self,
        parent: object
        | Homset[
            Map[_DomainElement, _CodomainElement], _DomainElement, _CodomainElement
        ],
    ) -> None: ...

class PolynomialBaseringInjection(Morphism): ...
