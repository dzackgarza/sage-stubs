from collections.abc import Callable, Iterator
from typing import Self, TypeAlias

from sage.structure.element import Element

_ElementTupleList: TypeAlias = list[tuple[object, Element]]
_ElementList: TypeAlias = list[Element]
_ExpTupleList: TypeAlias = list[tuple[int, ...]]

class PolyDict:
    def __init__(self, pdict: dict[object, object], check: bool = True) -> None: ...
    def remove_zeros(self, zero_test: object = None) -> None: ...
    def apply_map(self, f: Callable[..., Element]) -> None: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __len__(self) -> int: ...
    def __richcmp__(self, right: PolyDict, op: int) -> bool: ...
    def rich_compare(self, other: PolyDict, op: int, sortkey: object = None) -> bool: ...
    def list(self) -> _ElementTupleList: ...
    def dict(self) -> dict[object, Element]: ...
    def coefficients(self) -> _ElementList: ...
    def exponents(self) -> _ExpTupleList: ...
    def __getitem__(self, e: object) -> Element: ...
    def get(self, e: object, default: object = None) -> Element | None: ...
    def degree(self, x: object = None) -> int | tuple[int, ...]: ...
    def total_degree(self, w: object = None) -> int: ...
    def polynomial_coefficient(self, degrees: object) -> PolyDict: ...
    def coefficient(self, mon: object) -> Element: ...
    def is_homogeneous(self, w: object = None) -> bool: ...
    def is_constant(self) -> bool: ...
    def homogenize(self, var: int) -> PolyDict: ...
    def latex(self, vars: object, atomic_exponents: bool = True, atomic_coefficients: bool = True, sortkey: object = None) -> str: ...
    def poly_repr(self, vars: object, atomic_exponents: bool = True, atomic_coefficients: bool = True, sortkey: object = None) -> str: ...
    def __iadd__(self, other: PolyDict) -> Self: ...
    def __neg__(self) -> PolyDict: ...
    def __add__(self, other: PolyDict) -> PolyDict: ...
    def __mul__(self, right: PolyDict) -> PolyDict: ...
    def scalar_rmult(self, s: Element) -> PolyDict: ...
    def scalar_lmult(self, s: Element) -> PolyDict: ...
    def term_lmult(self, exponent: object, s: Element) -> PolyDict: ...
    def term_rmult(self, exponent: object, s: Element) -> PolyDict: ...
    def __sub__(self, other: PolyDict) -> PolyDict: ...
    def derivative_i(self, i: int) -> PolyDict: ...
    def derivative(self, x: object) -> PolyDict: ...
    def integral_i(self, i: int) -> PolyDict: ...
    def integral(self, x: object) -> PolyDict: ...
    def lcmt(self, greater_etuple: object) -> PolyDict: ...
    def __reduce__(self) -> tuple[object, tuple[object, ...]]: ...
    def min_exp(self) -> ETuple: ...
    def max_exp(self) -> ETuple: ...

class ETuple:
    def __init__(self, data: object = None, length: object = None) -> None: ...
    def __bool__(self) -> bool: ...
    def __add__(self, other: ETuple) -> ETuple: ...
    def __mul__(self, factor: int) -> ETuple: ...
    def __getitem__(self, i: int) -> int: ...
    def __hash__(self) -> int: ...
    def __len__(self) -> int: ...
    def __contains__(self, elem: object) -> bool: ...
    def __richcmp__(self, other: ETuple, op: int) -> bool: ...
    def __iter__(self) -> Iterator[int]: ...
    def __reduce__(self) -> tuple[object, tuple[object, ...]]: ...
    def unweighted_degree(self) -> int: ...
    def weighted_degree(self, w: tuple[int, ...]) -> int: ...
    def unweighted_quotient_degree(self, other: ETuple) -> int: ...
    def weighted_quotient_degree(self, other: ETuple, w: tuple[int, ...]) -> int: ...
    def eadd(self, other: ETuple) -> ETuple: ...
    def eadd_p(self, other: int, pos: int) -> ETuple: ...
    def eadd_scaled(self, other: ETuple, scalar: int) -> ETuple: ...
    def esub(self, other: ETuple) -> ETuple: ...
    def emul(self, factor: int) -> ETuple: ...
    def emax(self, other: ETuple) -> ETuple: ...
    def emin(self, other: ETuple) -> ETuple: ...
    def dotprod(self, other: ETuple) -> int: ...
    def escalar_div(self, n: int) -> ETuple: ...
    def divide_by_gcd(self, other: ETuple) -> ETuple: ...
    def divide_by_var(self, pos: int) -> ETuple: ...
    def divides(self, other: ETuple) -> bool: ...
    def is_constant(self) -> bool: ...
    def is_multiple_of(self, n: int) -> bool: ...
    def nonzero_positions(self, sort: bool = False) -> list[int]: ...
    def common_nonzero_positions(self, other: ETuple, sort: bool = False) -> list[int]: ...
    def nonzero_values(self, sort: bool = True) -> list[int]: ...
    def reversed(self) -> ETuple: ...
    def sparse_iter(self) -> Iterator[tuple[int, int]]: ...
    def combine_to_positives(self, other: ETuple) -> ETuple: ...

def gen_index(x: PolyDict) -> int: ...
def monomial_exponent(p: PolyDict) -> ETuple: ...
def make_PolyDict(data: object) -> PolyDict: ...
def make_ETuple(data: object, length: object) -> ETuple: ...
