from sage.rings.polynomial.infinite_polynomial_element import InfinitePolynomial

class SymmetricReductionStrategy:
    def __init__(self, Parent: object, L: object = None, tailreduce: bool = False, good_input: object = None) -> None: ...
    def __getinitargs__(self) -> tuple[object, ...]: ...
    def __getstate__(self) -> tuple[object, ...]: ...
    def __setstate__(self, L: object) -> None: ...
    def __richcmp__(self, other: object, op: int) -> bool: ...
    def gens(self) -> tuple[InfinitePolynomial, ...]: ...
    def setgens(self, L: object) -> None: ...
    def reset(self) -> None: ...
    def __call__(self, p: object) -> InfinitePolynomial: ...
    def add_generator(self, p: object, good_input: object = None) -> None: ...
    def reduce(self, p: object, notail: bool = False, report: object = None) -> InfinitePolynomial: ...
    def tailreduce(self, p: object, report: object = None) -> InfinitePolynomial: ...
