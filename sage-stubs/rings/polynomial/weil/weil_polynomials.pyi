from sage.rings.polynomial.polynomial_element import Polynomial

class dfs_manager:
    def node_count(self) -> int: ...
    def advance_exhaust(self) -> int: ...

class WeilPolynomials_iter:
    def __init__(self, d: int, q: int, sign: int, lead: int, node_limit: object, parallel: bool, squarefree: bool, polring: object = None) -> None: ...
    def __iter__(self) -> WeilPolynomials_iter: ...
    def __next__(self) -> Polynomial: ...
    def node_count(self) -> int: ...

class WeilPolynomials:
    def __init__(self, d: int, q: int, sign: int = 1, lead: int = 1, node_limit: object = None, parallel: bool = False, squarefree: bool = False, polring: object = None) -> None: ...
    def __iter__(self) -> WeilPolynomials_iter: ...
    def node_count(self) -> int: ...
