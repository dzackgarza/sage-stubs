class OrderFactory(UniqueFactory):
    def get_object(
        self,
        version: int | tuple[int, ...],
        key: tuple[ElementConstructorInput, ...],
        extra_args: ElementConstructorInput,
    ) -> NumberField_generic: ...

class AbsoluteOrderFactory(OrderFactory):
    def create_key_and_extra_args(
        self,
        K: NumberField_generic | FunctionField | Field,
        module_rep: ElementConstructorInput,
        is_maximal: bool | None = ...,
        check: bool = ...,
        is_maximal_at: bool = ...,
    ) -> tuple[
        tuple[NumberField_generic | FunctionField | Field, ElementConstructorInput],
        dict[str, bool | dict[p, bool]],
    ]: ...
    def create_object(
        self,
        version: int | tuple[int, ...],
        key: tuple[ElementConstructorInput, ...],
        is_maximal: bool | None = ...,
        is_maximal_at: bool = ...,
    ) -> Order_absolute: ...
    def reduce_data(
        self, order: NumberFieldOrder | FunctionFieldOrder
    ) -> NumberField_generic: ...

class RelativeOrderFactory(OrderFactory):
    def create_key_and_extra_args(
        self,
        K: NumberField_generic | FunctionField | Field,
        absolute_order: ElementConstructorInput,
        is_maximal: bool | None = ...,
        check: bool = ...,
        is_maximal_at: bool = ...,
    ) -> tuple[
        tuple[NumberField_generic | FunctionField | Field, ElementConstructorInput],
        dict[str, bool | dict[p, bool]],
    ]: ...
    def create_object(
        self,
        version: int | tuple[int, ...],
        key: tuple[ElementConstructorInput, ...],
        is_maximal: bool | None = ...,
        is_maximal_at: bool = ...,
    ) -> Order_relative: ...

