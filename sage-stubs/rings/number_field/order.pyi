class Order(Order, Parent):
    def ring_generators(self) -> list[NumberFieldElement]: ...
    def basis(self) -> list[NumberFieldElement]: ...
    def discriminant(self) -> Integer: ...
    def different(self) -> NumberFieldElement: ...
    def is_maximal(self, p: Integer | None = ...) -> bool: ...
    def index(self) -> Integer: ...
    def uniformizer(self, p: Integer) -> NumberFieldElement: ...
    def __init__(self, K: NumberField_generic | FunctionField | Field) -> None: ...
    def fractional_ideal(
        self, *args: ElementConstructorInput, **kwds: ElementConstructorInput
    ) -> NumberFieldIdeal: ...
    def ideal(
        self, *args: ElementConstructorInput, **kwds: ElementConstructorInput
    ) -> NumberFieldIdeal | FunctionFieldIdeal: ...
    def _coerce_map_from_(self, R: Ring) -> bool: ...
    def __mul__(
        self, right: NumberFieldElement | ElementConstructorInput
    ) -> NumberFieldIdeal | FunctionFieldIdeal: ...
    def __rmul__(
        self, left: NumberFieldElement | ElementConstructorInput
    ) -> NumberFieldIdeal | FunctionFieldIdeal: ...
    def is_field(self, proof: bool = ...) -> bool: ...
    def is_integrally_closed(self) -> bool: ...
    def krull_dimension(self) -> one: ...
    def integral_closure(self) -> NumberFieldOrder | FunctionFieldOrder | Self: ...
    def gen(self, i: int | Integer) -> Self: ...
    def ngens(self) -> int: ...
    def gens(self) -> tuple: ...
    def coordinates(
        self, x: NumberFieldElement | ElementConstructorInput
    ) -> Vector: ...
    def free_module(
        self,
    ) -> FreeModule_generic | tuple[FreeModule_generic, Morphism, Morphism]: ...
    def zeta(
        self, n: int | Integer = ..., all: bool = ...
    ) -> NumberFieldElement | list[NumberFieldElement]: ...
    def number_field(self) -> NumberField_generic: ...
    def ambient(self) -> NumberFieldElement: ...
    def residue_field(
        self,
        prime: int | Integer,
        names: str | tuple[str, ...] | None = ...,
        check: bool = ...,
    ) -> Field | tuple[Field, Morphism, Morphism]: ...
    def fraction_field(self) -> NumberFieldElement: ...
    def degree(self) -> Integer: ...
    def rank(self) -> Integer: ...
    def class_number(
        self, proof: bool | None = ...
    ) -> class_number | NumberFieldElement: ...
    def class_group(
        self, proof: bool | None = ..., names: str | tuple[str, ...] | None = ...
    ) -> ClassGroup: ...
    def is_suborder(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __hash__(self) -> NumberFieldElement: ...
    def conductor(self) -> sqrt: ...
    def random_element(
        self, *args: ElementConstructorInput, **kwds: ElementConstructorInput
    ) -> Self: ...
    def absolute_degree(self) -> Integer: ...
    def valuation(
        self, p: int | Integer | FunctionFieldPlace | NumberFieldIdeal
    ) -> Integer | Rational | PlusInfinity | MinusInfinity: ...
    def some_elements(self) -> list[Self]: ...

class RelativeOrder(Order):
    def __init__(
        self,
        K: NumberField,
        absolute_order: Order,
        is_maximal: str = ...,
        is_maximal_at: tuple[Integer, ...] = ...,
    ) -> None: ...

