class Order_absolute(Order):
    def __init__(
        self,
        K: NumberField_generic | FunctionField | Field,
        module_rep: ElementConstructorInput,
    ) -> None: ...
    def _element_constructor_(
        self, x: NumberFieldElement | ElementConstructorInput
    ) -> NumberFieldElement: ...
    def __add__(
        left: NumberFieldElement | ElementConstructorInput,
        right: NumberFieldElement | ElementConstructorInput,
    ) -> AbsoluteOrder | NumberFieldElement | ElementConstructorInput: ...
    def __and__(
        left: NumberFieldElement | ElementConstructorInput,
        right: NumberFieldElement | ElementConstructorInput,
    ) -> AbsoluteOrder | NumberFieldElement | ElementConstructorInput: ...
    def discriminant(self) -> Integer | Rational | NumberFieldElement: ...
    def is_maximal(
        self, p: int | Integer | FunctionFieldPlace | NumberFieldIdeal | None = ...
    ) -> bool: ...
    def change_names(self, names: str | tuple[str, ...] | None) -> order: ...
    def index_in(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> Rational: ...
    def module(self) -> NumberFieldElement: ...
    def intersection(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> Self | NumberFieldElement | ElementConstructorInput: ...
    def _repr_(self) -> str: ...
    def basis(self) -> Family[Element]: ...
    def absolute_order(self) -> Self: ...
    def _magma_init_(self, magma: Polynomial | MPolynomial) -> format: ...

class Order_relative(Order):
    def __init__(
        self,
        K: NumberField_generic | FunctionField | Field,
        absolute_order: ElementConstructorInput,
    ) -> None: ...
    def _element_constructor_(
        self, x: NumberFieldElement | ElementConstructorInput
    ) -> OrderElement_relative: ...
    def _repr_(self) -> str: ...
    def absolute_order(
        self, names: str | tuple[str, ...] | None = ...
    ) -> NumberFieldElement: ...
    def basis(self) -> Family[Element]: ...
    def __add__(
        left: NumberFieldElement | ElementConstructorInput,
        right: NumberFieldElement | ElementConstructorInput,
    ) -> RelativeOrder | NumberFieldElement | ElementConstructorInput: ...
    def __and__(
        left: NumberFieldElement | ElementConstructorInput,
        right: NumberFieldElement | ElementConstructorInput,
    ) -> RelativeOrder | NumberFieldElement | ElementConstructorInput: ...
    def is_maximal(
        self, p: int | Integer | FunctionFieldPlace | NumberFieldIdeal | None = ...
    ) -> bool: ...
    def absolute_discriminant(self) -> discriminant: ...
    def is_suborder(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> bool: ...
    def index_in(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> Rational: ...

