from typing import Self

from sage.categories.category import Category
from sage.categories.homset import Homset
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.rings.homset import RingHomset_generic
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.number_field.number_field import NumberField_generic
from sage.rings.number_field.number_field_element import NumberFieldElement
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import ElementConstructorInput, Parent

class RelativeNumberFieldHomset(
    NumberFieldHomset, Homset[NumberField_generic, NumberField_generic]
):
    def __init__(
        self,
        R: NumberField_generic,
        S: NumberField_generic,
        category: Category | None = ...,
    ) -> None: ...
    def _element_constructor_(
        self,
        x: NumberFieldElement | ElementConstructorInput,
        base_map: Map | Morphism | None = ...,
        check: bool = ...,
    ) -> NumberFieldElement: ...
    def default_base_hom(self) -> NumberFieldElement: ...
    def list(self) -> list[Self]: ...

class NumberFieldHomset(RingHomset_generic):
    def __init__(
        self, R: Ring, S: Ring | Parent, category: Category | None = ...
    ) -> None: ...
    def _element_constructor_(
        self, x: NumberFieldElement | ElementConstructorInput, check: bool = ...
    ) -> NumberFieldElement: ...
    def _an_element_(self) -> Self: ...
    def _repr_(self) -> str: ...
    def order(self) -> Integer | PlusInfinity: ...
    def list(self) -> list[Self]: ...
    def __getitem__(self, n: int | Integer) -> Element: ...

class CyclotomicFieldHomset(NumberFieldHomset):
    def _element_constructor_(
        self, x: NumberFieldElement | ElementConstructorInput, check: bool = ...
    ) -> NumberFieldElement: ...
    def list(self) -> list[Self]: ...
