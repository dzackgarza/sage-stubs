    def automorphisms(self) -> Sequence: ...
    def logarithmic_embedding(
        self, prec: int | Integer | None = ...
    ) -> hom | Vector: ...
    def places(
        self,
        all_complex: Polynomial | MPolynomial = ...,
        prec: int | Integer | None = ...,
    ) -> list[Morphism | FunctionFieldPlace]: ...
    def absolute_different(self) -> NumberFieldElement: ...
    def relative_different(
        self,
    ) -> NumberFieldElement | NumberFieldIdeal | FunctionFieldIdeal: ...
    def different(self) -> NumberFieldElement: ...
    def absolute_discriminant(self, v: int | Integer | None = ...) -> discriminant: ...
    def relative_discriminant(self) -> NumberFieldIdeal | FunctionFieldIdeal: ...
    def discriminant(self) -> Integer | Rational | NumberFieldElement: ...
    def disc(self) -> NumberFieldElement: ...
    def order(
        self, *gens: Sequence[ElementConstructorInput], **kwds: ElementConstructorInput
    ) -> Integer | PlusInfinity: ...
    def is_free(self, proof: bool | None = ...) -> bool: ...
    def lift_to_base(self, element: bool) -> NumberFieldElement: ...
