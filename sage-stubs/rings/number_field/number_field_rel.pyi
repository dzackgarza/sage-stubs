    def free_module(
        self,
        base: NumberField | RationalField | None = ...,
        basis: None = ...,
        map: Literal[True] = True,
    ) -> _RelativeVectorSpaceMaps | _AbsoluteVectorSpaceMaps: ...
    @overload
    def relative_vector_space(
        self,
        base: NumberField | None = ...,
        basis: None = ...,
        map: Literal[False] = False,
    ) -> FreeModule_ambient_field: ...
    @overload
