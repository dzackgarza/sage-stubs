    def _pari_init_(self) -> str: ...

class NumberFieldFractionalIdeal(
    MultiplicativeGroupElement, Ideal_fractional, NumberFieldIdeal
):

    def __init__(
        self,
        field: NumberField_generic,
        gens: Sequence[ElementConstructorInput],
        coerce: ElementConstructorInput = ...,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def divides(self, other: NumberFieldElement | ElementConstructorInput) -> bool: ...
    def factor(self) -> Factorization: ...
    def prime_factors(self) -> list[NumberFieldIdeal]: ...
    def __invert__(self) -> NumberFieldIdeal | FunctionFieldIdeal: ...
    def is_maximal(self) -> bool: ...
    def is_trivial(self, proof: bool | None = ...) -> bool: ...
    def ramification_index(self) -> Integer: ...
    def reduce(
        self, f: Polynomial | MPolynomial | Map | Callable[..., Element]
    ) -> sum: ...
    def residues(self) -> xmrange_iter: ...
    def invertible_residues(self, reduce: bool = ...) -> Self: ...
    def invertible_residues_mod(
        self, subgp_gens: int | Integer = ..., reduce: bool = ...
    ) -> xmrange_iter: ...
    def denominator(self) -> Integer: ...
    def numerator(self) -> Integer | NumberFieldElement: ...
    def is_coprime(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> bool: ...
    def idealcoprime(self, J: int | Integer) -> k: ...
    def small_residue(
        self, f: Polynomial | MPolynomial | Map | Callable[..., Element]
    ) -> k: ...
    def idealstar(self, flag: int | Integer = ...) -> AbelianGroup: ...
    def ideallog(
        self,
        x: NumberFieldElement | ElementConstructorInput,
        gens: Sequence[ElementConstructorInput] | None = ...,
        check: bool = ...,
    ) -> list[Element] | list[ZZ]: ...
    def element_1_mod(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> K: ...
    def euler_phi(self) -> prod: ...
    def prime_to_S_part(self, S: Ring | Parent) -> Self | p | valuation: ...
    def is_S_unit(self, S: Ring | Parent) -> bool: ...
    def is_S_integral(self, S: Ring | Parent) -> bool: ...
    def prime_to_idealM_part(
        self, M: Matrix | ModuleElement | int | Integer
    ) -> Self | NumberFieldIdeal | FunctionFieldIdeal: ...
    def residue_field(
        self, names: str | tuple[str, ...] | None = ...
    ) -> Field | tuple[Field, Morphism, Morphism]: ...
    def residue_class_degree(self) -> Integer: ...
    def ray_class_number(self) -> ZZ: ...

def basis_to_module(
    B: NumberFieldElement | ElementConstructorInput,
    K: NumberField_generic | FunctionField | Field,
) -> NumberFieldElement: ...

class QuotientMap(Morphism):
    def __init__(
        self,
        K: NumberField_generic | FunctionField | Field,
        M_OK_change: ElementConstructorInput,
        Q: Polynomial | MPolynomial,
        I: NumberFieldIdeal | FunctionFieldIdeal,
    ) -> None: ...
    def __call__(
        self, x: NumberFieldElement | ElementConstructorInput
    ) -> NumberFieldElement: ...

class LiftMap(Morphism):
    def __init__(
        self,
        OK: ElementConstructorInput,
        M_OK_map: ElementConstructorInput,
        Q: ElementConstructorInput,
        I: NumberFieldIdeal | FunctionFieldIdeal,
    ) -> None: ...
    def __call__(
        self, x: NumberFieldElement | ElementConstructorInput
    ) -> NumberFieldElement: ...

def quotient_char_p(
    I: NumberFieldIdeal | FunctionFieldIdeal,
    p: int | Integer | FunctionFieldPlace | NumberFieldIdeal,
) -> tuple[quotient, QuotientMap, LiftMap]: ...
