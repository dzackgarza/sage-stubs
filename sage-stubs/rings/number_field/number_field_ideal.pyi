    def integral_split(self) -> tuple[Self | prod, prod]: ...
    def intersection(
        self, other: NumberFieldElement | ElementConstructorInput
    ) -> NumberFieldIdeal | FunctionFieldIdeal: ...
    def is_integral(self) -> bool: ...
    def is_maximal(self) -> bool: ...
    def pari_prime(self) -> Vector: ...
    def ideal_class_log(self, proof: bool | None = ...) -> NumberFieldElement: ...
    def S_ideal_class_log(self, S: Ring | Parent) -> list[Self]: ...
    def is_zero(self) -> bool: ...
    def relative_norm(self) -> NumberFieldElement: ...
    def absolute_ramification_index(self) -> Integer: ...
    def relative_ramification_index(self) -> Integer: ...
    def number_field(self) -> NumberField_generic: ...
    def smallest_integer(self) -> ZZ: ...
    def valuation(
        self, p: int | Integer | FunctionFieldPlace | NumberFieldIdeal
    ) -> Integer | Rational | PlusInfinity | MinusInfinity: ...
