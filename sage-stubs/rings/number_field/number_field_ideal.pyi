    def gens(self) -> tuple[NumberFieldElement, ...]: ...
    def ramification_index(self) -> int: ...
    def residue_field(self, names: str | None = ...) -> FiniteField: ...
    def residue_class_degree(self) -> int: ...
    def __init__(
        self,
        field: NumberField_generic,
        gens: Sequence[ElementConstructorInput],
        coerce: ElementConstructorInput = ...,
    ) -> None: ...
    def __hash__(self) -> Self: ...
    def _latex_(self) -> str: ...
    def _richcmp_(
        self,
        other: NumberFieldElement | ElementConstructorInput,
        op: ElementConstructorInput,
    ) -> richcmp | NumberFieldElement: ...
    def coordinates(self, x: NumberFieldElement | ElementConstructorInput) -> Self: ...
    def _repr_(self) -> str: ...
    def __pari__(self) -> Self: ...
    def pari_hnf(self) -> Self: ...
    def basis(self) -> Family[Element]: ...
    def free_module(
        self,
    ) -> FreeModule_generic | tuple[FreeModule_generic, Morphism, Morphism]: ...
