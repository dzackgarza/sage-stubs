class NumberFieldFactory(UniqueFactory):
    def create_key_and_extra_args(
        self,
        polynomial: Polynomial | MPolynomial,
        name: str | None,
        check: bool,
        embedding: Map | Morphism | None,
        latex_name: str,
        assume_disc_small: ElementConstructorInput,
        maximize_at_primes: ElementConstructorInput,
        structure: ElementConstructorInput,
    ) -> tuple[
        tuple[
            base_ring,
            polynomial,
            normalize_names,
            tuple[parent, root_from_approx],
            NumberField_generic,
            tuple[ElementConstructorInput, ...],
            ElementConstructorInput,
            NumberFieldElement,
        ],
        dict[str, bool],
    ]: ...
    def create_object(
        self,
        version: int | tuple[int, ...],
        key: tuple[ElementConstructorInput, ...],
        check: bool,
    ) -> NumberField_absolute | NumberField_relative | NumberField_quadratic: ...

