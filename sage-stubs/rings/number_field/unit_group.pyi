from sage.groups.abelian_gps.values import AbelianGroupWithValues_class
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring import Ring
from sage.structure.parent import ElementConstructorInput, Parent

from .number_field_base import NumberField
from .number_field_element import NumberFieldElement
from .number_field_ideal import NumberFieldIdeal

class UnitGroup(AbelianGroupWithValues_class):
    def rank(self) -> int: ...
    def fundamental_units(self) -> list[NumberFieldElement]: ...
    def roots_of_unity(self) -> list[NumberFieldElement]: ...
    def torsion_generator(self) -> NumberFieldElement: ...
    def zeta_order(self) -> int: ...
    def zeta(
        self, n: int = ..., all: bool = ...
    ) -> NumberFieldElement | list[NumberFieldElement]: ...
    def number_field(self) -> NumberField: ...
    def primes(self) -> list[NumberFieldIdeal]: ...
    def log(self, u: NumberFieldElement) -> tuple[int, ...]: ...
    def exp(self, exponents: tuple[int, ...] | list[int]) -> NumberFieldElement: ...
    def __init__(
        self,
        number_field: Polynomial | MPolynomial,
        proof: bool = ...,
        S: Ring | Parent | None = ...,
    ) -> None: ...
    def _element_constructor_(
        self, u: ElementConstructorInput
    ) -> NumberFieldElement: ...
    def _repr_(self) -> str: ...
