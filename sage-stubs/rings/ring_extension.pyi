from sage.categories.map import Map
from sage.modules.free_module import FreeModule_generic
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.morphism import RingHomomorphism
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring import Ring
from sage.rings.ring_extension_morphism import RingExtensionHomomorphism
from sage.structure.element import Element
from sage.structure.factory import (
    FactoryArgument,
    FactoryCacheKey,
    FactoryExtraArgs,
    FactoryVersion,
    UniqueFactory,
)
from sage.structure.parent import Parent

def tower_bases(ring: Ring, degree: bool = ...) -> list[Ring]: ...
def common_base(K: Ring, L: Ring, degree: bool = ...) -> Ring: ...
def generators(ring: Ring, base: Ring) -> tuple[Element, ...]: ...
def variable_names(ring: Ring, base: Ring) -> tuple[str, ...]: ...

class RingExtensionFactory(UniqueFactory):
    def create_key_and_extra_args(
        self, *args: FactoryArgument, **kwds: FactoryArgument
    ) -> tuple[FactoryCacheKey, FactoryExtraArgs]: ...
    def create_object(
        self, version: FactoryVersion, key: FactoryCacheKey, **extra_args: object
    ) -> RingExtension_generic: ...

RingExtension: RingExtensionFactory

class RingExtension_generic(Parent):
    def __init__(
        self,
        defining_morphism: Map | None,
        print_options: dict[str, object] = ...,
        import_methods: bool = True,
        is_backend: bool = False,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def construction(self) -> tuple[object, object] | None: ...
    def backend(self, force: bool = False) -> RingExtension_generic: ...
    def from_base_ring(self, r: Element) -> Element: ...
    def print_options(self, **options: object) -> None: ...
    def base(self) -> Ring: ...
    def bases(self) -> tuple[Ring, ...]: ...
    def absolute_base(self) -> Ring: ...
    def is_defined_over(self, base: Ring) -> bool: ...
    def defining_morphism(self, base: Ring | None = None) -> RingHomomorphism: ...
    def gens(self, base: Ring | None = None) -> tuple[Element, ...]: ...
    def ngens(self, base: Ring | None = None) -> int: ...
    def gen(self) -> Element: ...
    def random_element(self) -> Element: ...
    def degree_over(self, base: Ring | None = None) -> Integer | PlusInfinity: ...
    def degree(self, base: Ring) -> Integer: ...
    def relative_degree(self) -> Integer: ...
    def absolute_degree(self) -> Integer: ...
    def is_finite_over(self, base: Ring | None = None) -> bool: ...
    def is_free_over(self, base: Ring | None = None) -> bool: ...
    def is_field(self, proof: bool = True) -> bool: ...
    def fraction_field(
        self, extend_base: bool = False
    ) -> RingExtensionFractionField: ...
    def hom(
        self,
        im_gens: list[Element] | tuple[Element, ...],
        codomain: Parent | None = None,
        base_map: RingHomomorphism | None = None,
        category: object = None,
        check: bool = True,
    ) -> RingExtensionHomomorphism: ...
    def characteristic(self) -> Integer: ...

class RingExtensionFractionField(RingExtension_generic):
    def __init__(
        self, defining_morphism: Map | None, ring: Ring | None = None, **kwargs: object
    ) -> None: ...
    def ring(self) -> Ring: ...

class RingExtensionWithBasis(RingExtension_generic):
    def __init__(
        self,
        defining_morphism: Map | None,
        basis: object,
        names: object | bool = None,
        check: bool = True,
        **kwargs: object,
    ) -> None: ...
    def basis_over(self, base: Ring | None = None) -> list[Element]: ...
    def free_module(
        self, base: Ring | None = None, map: bool = True
    ) -> FreeModule_generic: ...
    def fraction_field(
        self, extend_base: bool = False
    ) -> RingExtensionFractionField: ...

class RingExtensionWithGen(RingExtensionWithBasis):
    def __init__(
        self,
        defining_morphism: Map | None,
        gen: object,
        names: object,
        check: bool = True,
        **kwargs: object,
    ) -> None: ...
    def modulus(self, var: str = "x") -> Polynomial: ...
    def gens(self, base: Ring | None = None) -> tuple[Element, ...]: ...
    def fraction_field(
        self, extend_base: bool = False
    ) -> RingExtensionFractionField: ...
