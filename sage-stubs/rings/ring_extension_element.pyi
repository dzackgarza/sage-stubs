from typing import Literal, overload

from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.ring_extension import RingExtension_generic
from sage.structure.element import CommutativeAlgebraElement, Element

class RingExtensionElement(CommutativeAlgebraElement):
    def __init__(self, parent: RingExtension_generic, x: object, *args: object, **kwds: object) -> None: ...
    def __getitem__(self, i: int) -> Element: ...
    def __call__(self, *args: object, **kwargs: object) -> Element: ...
    def __hash__(self) -> int: ...
    def backend(self, force: bool = False) -> RingExtensionElement: ...
    def in_base(self) -> bool: ...
    def additive_order(self) -> Integer: ...
    def multiplicative_order(self) -> Integer | PlusInfinity: ...
    def is_unit(self) -> bool: ...
    def is_nilpotent(self) -> bool: ...
    def is_prime(self) -> bool: ...
    @overload
    def is_square(self, root: Literal[False] = False) -> bool: ...
    @overload
    def is_square(self, root: Literal[True]) -> tuple[bool, RingExtensionElement]: ...
    @overload
    def sqrt(self, extend: bool = True, all: Literal[False] = False, name: object = None) -> RingExtensionElement: ...
    @overload
    def sqrt(self, extend: bool = True, all: Literal[True] = True, name: object = None) -> list[RingExtensionElement]: ...

class RingExtensionFractionFieldElement(RingExtensionElement):
    def __hash__(self) -> int: ...
    def numerator(self) -> Element: ...
    def denominator(self) -> Element: ...

class RingExtensionWithBasisElement(RingExtensionElement):
    def __hash__(self) -> int: ...
    def vector(self, base: object = None) -> Element: ...
    def polynomial(self, base: object = None, var: str = "x") -> Polynomial: ...
    def matrix(self, base: object = None) -> Element: ...
    def trace(self, base: object = None) -> Element: ...
    def norm(self, base: object = None) -> Element: ...
    def charpoly(self, base: object = None, var: str = "x") -> Polynomial: ...
    def minpoly(self, base: object = None, var: str = "x") -> Polynomial: ...
