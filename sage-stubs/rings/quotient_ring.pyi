from typing import overload

from sage.categories.pushout import QuotientFunctor
from sage.rings.ideal import Ideal_generic, Ideal_principal
from sage.rings.morphism import RingHomomorphism, RingHomomorphism_cover
from sage.rings.quotient_ring_element import QuotientRingElement
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent

class QuotientRing_nc(Parent):
    def __init__(
        self,
        R: Ring,
        I: Ideal_generic,
        names: str | tuple[str, ...],
        category: object = None,
    ) -> None: ...
    def construction(self) -> tuple[QuotientFunctor, Ring]: ...
    def is_commutative(self) -> bool: ...
    def cover(self) -> RingHomomorphism_cover: ...
    @overload
    def lift(self) -> RingHomomorphism: ...
    @overload
    def lift(self, x: Element) -> Element: ...
    def characteristic(self) -> int: ...
    def defining_ideal(self) -> Ideal_generic: ...
    def is_field(self, proof: bool = True) -> bool: ...
    def is_integral_domain(self, proof: bool = True) -> bool: ...
    def is_noetherian(self) -> bool: ...
    def cover_ring(self) -> Ring: ...
    def ideal(self, *gens: object, **kwds: object) -> QuotientRingIdeal_generic: ...
    def gen(self, i: int = 0) -> QuotientRingElement: ...
    def gens(self) -> tuple[Element, ...]: ...

class QuotientRing_generic(QuotientRing_nc, Ring):
    def __init__(
        self,
        R: Ring,
        I: Ideal_generic,
        names: str | tuple[str, ...],
        category: object = None,
    ) -> None: ...

class QuotientRingIdeal_generic(Ideal_generic):
    def radical(self) -> Ideal_generic: ...

class QuotientRingIdeal_principal(Ideal_principal, QuotientRingIdeal_generic): ...
