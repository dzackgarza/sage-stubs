from sage.categories.pushout import CompletionFunctor
from sage.rings.integer import Integer
from sage.rings.laurent_series_ring_element import LaurentSeries
from sage.rings.polynomial.polynomial_ring import PolynomialRing_general
from sage.rings.power_series_ring import PowerSeriesRing_generic
from sage.rings.ring import Ring
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation

class LaurentSeriesRing(UniqueRepresentation, Parent):
    def __init__(self, power_series: PowerSeriesRing_generic) -> None: ...
    def base_extend(self, R: Ring) -> LaurentSeriesRing: ...
    def fraction_field(self) -> LaurentSeriesRing: ...
    def change_ring(self, R: Ring) -> LaurentSeriesRing: ...
    def is_sparse(self) -> bool: ...
    def is_field(self, proof: bool = True) -> bool: ...
    def is_dense(self) -> bool: ...
    def random_element(self, algorithm: str = "default") -> LaurentSeries: ...
    def construction(self) -> tuple[CompletionFunctor, Parent]: ...
    def characteristic(self) -> Integer: ...
    def residue_field(self) -> Ring: ...
    def default_prec(self) -> int: ...
    def is_exact(self) -> bool: ...
    def gen(self, n: int = 0) -> LaurentSeries: ...
    def gens(self) -> tuple[LaurentSeries, ...]: ...
    def uniformizer(self) -> LaurentSeries: ...
    def ngens(self) -> int: ...
    def polynomial_ring(self) -> PolynomialRing_general: ...
    def laurent_polynomial_ring(self) -> Parent: ...
    def power_series_ring(self) -> PowerSeriesRing_generic: ...
