from collections.abc import Sequence
from typing import Generic, Never, TypeVar

from sage.categories.category import Category
from sage.categories.rings import Rings
from sage.homology.free_resolution import FiniteFreeResolution_free_module
from sage.homology.graded_resolution import GradedFiniteFreeResolution_free_module
from sage.rings.morphism import RingHomomorphism
from sage.rings.ring import Field
from sage.structure.element import Element, MonoidElement, RingElement
from sage.structure.parent import Parent

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

class Ideal_generic(MonoidElement):
    def __init__(
        self, ring: Parent, gens: Sequence[Element] | Element = ..., coerce: bool = ...
    ) -> None: ...
    def __contains__(self, x: object) -> bool: ...
    def gen(self, i: int = ...) -> Element: ...
    def gens(self) -> tuple[Element, ...]: ...
    def ring(self) -> Parent: ...
    def ngens(self) -> int: ...
    def random_element(self, *args: object, **kwds: object) -> Element: ...
    def __bool__(self) -> bool: ...
    def base_ring(self) -> Rings.ParentMethods[RingElement]: ...
    def apply_morphism(self, phi: RingHomomorphism) -> Ideal_generic: ...
    def reduce(self, f: Element) -> Element: ...
    def gens_reduced(self) -> tuple[Element, ...]: ...
    def is_maximal(self) -> bool: ...
    def is_primary(self, P: Ideal_generic | None = None) -> bool: ...
    def primary_decomposition(self) -> list[Ideal_generic]: ...
    def is_prime(self) -> bool: ...
    def associated_primes(self) -> list[Ideal_generic]: ...
    def minimal_associated_primes(self) -> list[Ideal_generic]: ...
    def embedded_primes(self) -> list[Element]: ...
    def is_principal(self) -> bool: ...
    def is_trivial(self) -> bool: ...
    def category(self) -> Category: ...
    def norm(self) -> Ideal_generic: ...
    def absolute_norm(self) -> Never: ...
    def free_resolution(
        self, *args: object, **kwds: object
    ) -> FiniteFreeResolution_free_module: ...
    def graded_free_resolution(
        self, *args: object, **kwds: object
    ) -> GradedFiniteFreeResolution_free_module: ...

class Ideal_principal(Ideal_generic, Generic[_Scalar]):
    def is_principal(self) -> bool: ...
    def gen(self, i: int = 0) -> RingElement: ...
    def __hash__(self) -> int: ...
    def divides(self, other: Ideal_principal[_Scalar]) -> bool: ...

class Ideal_pid(Ideal_generic, Generic[_Scalar]):
    def gen(self, i: int = ...) -> RingElement: ...
    def __contains__(self, x: object) -> bool: ...
    def gens(self) -> tuple[RingElement, ...]: ...
    def is_zero(self) -> bool: ...
    def gcd(self, other: Ideal_pid[_Scalar] | _Scalar) -> Ideal_pid[_Scalar]: ...
    def reduce(self, f: Element) -> RingElement: ...
    def is_prime(self) -> bool: ...
    def is_maximal(self) -> bool: ...
    def residue_field(self) -> Field: ...
    def radical(self) -> Ideal_pid[RingElement]: ...

class Ideal_fractional(Ideal_generic): ...
