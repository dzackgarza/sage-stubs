from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial_element import MPolynomial_polydict
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

class TropicalMPolynomial(MPolynomial_polydict):
    def subs(
        self, fixed: ElementConstructorInput = ..., **kwds: ElementConstructorInput
    ) -> TropicalMPolynomial: ...
    def plot3d(self, color: ElementConstructorInput = ...) -> TropicalMPolynomial: ...
    def tropical_variety(self) -> TropicalMPolynomial: ...
    def newton_polytope(self) -> TropicalMPolynomial: ...
    def dual_subdivision(self) -> TropicalMPolynomial: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class TropicalMPolynomialSemiring(UniqueRepresentation, Parent):
    def __init__(
        self,
        base_semiring: ElementConstructorInput,
        n: int | Integer,
        names: str | tuple[str, ...],
        order: ElementConstructorInput,
    ) -> None: ...
    def term_order(self) -> TropicalMPolynomialSemiring: ...
    def one(self) -> TropicalMPolynomialSemiring: ...
    def zero(self) -> TropicalMPolynomialSemiring: ...
    def random_element(
        self,
        degree: int | Integer = ...,
        terms: ElementConstructorInput = ...,
        choose_degree: ElementConstructorInput = ...,
        *args: ElementConstructorInput,
        **kwargs: ElementConstructorInput,
    ) -> TropicalMPolynomialSemiring: ...
    def gen(self, n: int | Integer = ...) -> TropicalMPolynomialSemiring: ...
    def gens(self) -> tuple[TropicalMPolynomialSemiring, ...]: ...
    def ngens(self) -> int | Integer: ...
    def _element_constructor_(
        self, x: TropicalMPolynomialSemiring | ElementConstructorInput
    ) -> TropicalMPolynomialSemiring: ...
    def _repr_(self) -> str: ...
