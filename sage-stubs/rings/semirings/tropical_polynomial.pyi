from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.polynomial.polynomial_element_generic import Polynomial_generic_sparse
from sage.rings.semirings.tropical_semiring import TropicalSemiringElement
from sage.structure.element import Element
from sage.structure.factorization import Factorization
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation
from sage.symbolic.expression import Expression

class TropicalPolynomial(Polynomial_generic_sparse):
    def roots(self) -> list[TropicalSemiringElement]: ...
    def split_form(self) -> TropicalPolynomial: ...
    def factor(self) -> Factorization: ...
    def piecewise_function(self) -> Expression: ...
    def plot(
        self, xmin: Polynomial | MPolynomial = ..., xmax: Polynomial | MPolynomial = ...
    ) -> Element: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class TropicalPolynomialSemiring(UniqueRepresentation, Parent):
    @staticmethod
    def __classcall_private__(
        class_: type[TropicalPolynomialSemiring],
        base_semiring: ElementConstructorInput,
        names: str | tuple[str, ...],
    ) -> TropicalPolynomialSemiring: ...
    def __init__(
        self, base_semiring: ElementConstructorInput, names: str | tuple[str, ...]
    ) -> None: ...
    def one(self) -> TropicalPolynomialSemiring: ...
    def zero(self) -> TropicalPolynomialSemiring: ...
    def gen(self, n: int | Integer = ...) -> TropicalPolynomialSemiring: ...
    def gens(self) -> tuple[TropicalPolynomialSemiring, ...]: ...
    def ngens(self) -> int | Integer: ...
    def random_element(
        self,
        degree: int | Integer = ...,
        monic: bool = ...,
        *args: ElementConstructorInput,
        **kwds: ElementConstructorInput,
    ) -> TropicalPolynomialSemiring: ...
    def is_sparse(self) -> bool: ...
    def interpolation(self, points: int | Integer) -> TropicalPolynomialSemiring: ...
    def _element_constructor_(
        self,
        x: TropicalPolynomialSemiring | ElementConstructorInput | None = ...,
        check: bool = ...,
    ) -> TropicalPolynomialSemiring: ...
    def _repr_(self) -> str: ...
