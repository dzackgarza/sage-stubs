from collections.abc import Callable
from typing import Self

from sage.categories.map import Map
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import ElementConstructorInput, Parent
from sage.structure.unique_representation import UniqueRepresentation

class TropicalSemiringElement(Element):
    def __init__(
        self, parent: TropicalSemiring, val: ElementConstructorInput = ...
    ) -> None: ...
    def __reduce__(
        self,
    ) -> tuple[Callable[..., Self], tuple[ElementConstructorInput, ...]]: ...
    def __hash__(self) -> int: ...
    def __neg__(self) -> Self: ...
    def __invert__(self) -> Self: ...
    def __pow__(
        base: ElementConstructorInput,
        exp: ElementConstructorInput,
        dummy: ElementConstructorInput,
    ) -> Self: ...
    def multiplicative_order(self) -> Self: ...
    def lift(self) -> TropicalSemiringElement: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...
    def _add_(
        left: TropicalSemiringElement | ElementConstructorInput,
        right: TropicalSemiringElement | ElementConstructorInput,
    ) -> Self: ...
    def _div_(
        left: TropicalSemiringElement | ElementConstructorInput,
        right: TropicalSemiringElement | ElementConstructorInput,
    ) -> Self: ...
    def _mul_(
        left: TropicalSemiringElement | ElementConstructorInput,
        right: TropicalSemiringElement | ElementConstructorInput,
    ) -> Self: ...
    def _richcmp_(
        left: TropicalSemiringElement | ElementConstructorInput,
        right: TropicalSemiringElement | ElementConstructorInput,
        op: int,
    ) -> bool: ...

class TropicalSemiring(Parent, UniqueRepresentation):
    def __init__(
        self, base: ElementConstructorInput, use_min: ElementConstructorInput = ...
    ) -> None: ...
    def zero(self) -> TropicalSemiringElement: ...
    def one(self) -> TropicalSemiringElement: ...
    def gens(self) -> tuple[TropicalSemiringElement, ...]: ...
    def _coerce_map_from_(self, S: Ring | Parent) -> TropicalSemiringElement: ...
    def _element_constructor_(
        self, val: ElementConstructorInput
    ) -> TropicalSemiringElement: ...
    def _latex_(self) -> str: ...
    def _repr_(self) -> str: ...

class TropicalToTropical(Map):

    def _call_(
        self, x: TropicalSemiringElement | ElementConstructorInput
    ) -> Element: ...
