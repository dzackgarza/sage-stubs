from sage.rings.integer import Integer
from sage.rings.polynomial.multi_polynomial import MPolynomial
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Element
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation

class TropicalVariety(UniqueRepresentation, SageObject):
    def __init__(self, poly: Polynomial | MPolynomial) -> None: ...
    def dimension(self) -> int | Integer: ...
    def number_of_components(self) -> TropicalVariety: ...
    def components(self) -> TropicalVariety: ...
    def weight_vectors(self) -> TropicalVariety: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class TropicalSurface(TropicalVariety):
    def plot(self, color: Polynomial | MPolynomial = ...) -> Element: ...
    def _repr_(self) -> str: ...

class TropicalCurve(TropicalVariety):
    def vertices(self) -> TropicalCurve: ...
    def weight_vectors(self) -> TropicalCurve: ...
    def is_smooth(self) -> bool: ...
    def is_simple(self) -> bool: ...
    def genus(self) -> int | Integer: ...
    def contribution(self) -> TropicalCurve: ...
    def plot(self) -> Element: ...
    def _repr_(self) -> str: ...
