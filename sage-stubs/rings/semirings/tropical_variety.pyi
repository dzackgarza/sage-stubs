from sage.modules.free_module_element import FreeModuleElement
from sage.plot.graphics import Graphics
from sage.plot.plot3d.base import Graphics3d
from sage.rings.integer import Integer
from sage.rings.semirings.tropical_mpolynomial import TropicalMPolynomial
from sage.structure.element import ModuleElement, RingElement
from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation
from sage.symbolic.expression import Expression

type RGBColor = tuple[float, float, float]
type SurfaceColor = str | RGBColor | list[str | RGBColor] | tuple[str | RGBColor, ...]
type _TropicalCoordinate = RingElement | Expression
type _TropicalPoint = tuple[_TropicalCoordinate, ...]
type _TropicalParametricComponent = tuple[Expression, ...]
type _TropicalConditions = list[Expression]
type _TropicalComponentEntry = _TropicalParametricComponent | _TropicalConditions | int
type _TropicalComponent = list[_TropicalComponentEntry]
type _TropicalWeightVector = FreeModuleElement[RingElement]

class TropicalVariety(UniqueRepresentation, SageObject):
    def __init__(self, poly: TropicalMPolynomial) -> None: ...
    def dimension(self) -> int | Integer: ...
    def number_of_components(self) -> Integer: ...
    def components(self) -> list[_TropicalComponent]: ...
    def weight_vectors(
        self,
    ) -> dict[_TropicalPoint, list[_TropicalWeightVector]]: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...

class TropicalSurface(TropicalVariety):
    def plot(self, color: SurfaceColor = ...) -> Graphics3d: ...
    def _repr_(self) -> str: ...

class TropicalCurve(TropicalVariety):
    def vertices(self) -> set[_TropicalPoint]: ...
    def weight_vectors(
        self,
    ) -> dict[_TropicalPoint, list[_TropicalWeightVector]]: ...
    def is_smooth(self) -> bool: ...
    def is_simple(self) -> bool: ...
    def genus(self) -> int: ...
    def contribution(self) -> int | ModuleElement: ...
    def plot(self) -> Graphics: ...
    def _repr_(self) -> str: ...
