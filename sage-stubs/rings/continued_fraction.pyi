from collections.abc import Iterator
from typing import overload

from sage.misc.lazy_list import lazy_list_generic
from sage.rings.infinity import PlusInfinity
from sage.rings.integer import Integer
from sage.rings.number_field.number_field_element import NumberFieldElement
from sage.rings.rational import Rational
from sage.rings.real_mpfr import RealNumber
from sage.structure.element import Element
from sage.structure.sage_object import SageObject

def continued_fraction(
    self, value: Element | None = None
) -> ContinuedFraction_base: ...
def continued_fraction_list(
    self,
    type: str = "std",
    partial_convergents: bool = False,
    bits: int | None = None,
    nterms: int | None = None,
) -> list[Integer | int]: ...
def convergents(self) -> lazy_list_generic | list[Rational]: ...

class ContinuedFraction_base(SageObject):
    def __init__(self) -> None: ...
    def str(
        self, nterms: int = 10, unicode: bool = False, join: bool = True
    ) -> str: ...
    def __abs__(self) -> ContinuedFraction_base: ...
    def __eq__(self, other: object) -> bool: ...
    def __float__(self) -> float: ...
    def numerator(self, n: int) -> Integer: ...
    def denominator(self, n: int) -> Integer: ...
    def convergent(self, n: int) -> Rational: ...
    def convergents(self) -> lazy_list_generic | list[Rational]: ...
    def quotients(self) -> lazy_list_generic | list[Integer]: ...
    @overload
    def __getitem__(self, n: int) -> Integer: ...
    @overload
    def __getitem__(self, n: slice) -> ContinuedFraction_base: ...
    def __iter__(self) -> Iterator[Integer]: ...
    def __int__(self) -> int: ...
    def sign(self) -> Integer: ...
    def floor(self) -> Integer: ...
    def ceil(self) -> Integer: ...
    def __bool__(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def is_one(self) -> bool: ...
    def is_minus_one(self) -> bool: ...
    def additive_order(self) -> Integer | PlusInfinity: ...
    def multiplicative_order(self) -> Integer | PlusInfinity: ...
    def numerical_approx(
        self,
        prec: int | None = None,
        digits: int | None = None,
        algorithm: object = None,
    ) -> RealNumber: ...
    def apply_homography(
        self,
        a: Integer | int,
        b: Integer | int,
        c: Integer | int,
        d: Integer | int,
        forward_value: bool = False,
    ) -> ContinuedFraction_base: ...
    def __neg__(self) -> ContinuedFraction_base: ...
    def __invert__(self) -> ContinuedFraction_base: ...

class ContinuedFraction_periodic(ContinuedFraction_base):
    def __init__(
        self,
        x1: tuple[Integer | int, ...],
        x2: tuple[Integer | int, ...] | None = None,
        check: bool = True,
    ) -> None: ...
    def period(self) -> tuple[Integer, ...]: ...
    def preperiod(self) -> tuple[Integer, ...]: ...
    def quotient(self, n: int) -> Integer | PlusInfinity: ...
    def length(self) -> int: ...
    def preperiod_length(self) -> int: ...
    def period_length(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def value(self) -> NumberFieldElement: ...
    def __len__(self) -> int: ...
    def __invert__(self) -> ContinuedFraction_base: ...
    def __neg__(self) -> ContinuedFraction_base: ...

class ContinuedFraction_real(ContinuedFraction_base):
    def __init__(self, x: Element) -> None: ...
    def length(self) -> PlusInfinity: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def quotient(self, n: int) -> Integer | PlusInfinity: ...
    def value(self) -> Element: ...

class ContinuedFraction_infinite(ContinuedFraction_base):
    def __init__(
        self, w: object, value: Element | None = None, check: bool = True
    ) -> None: ...
    def length(self) -> PlusInfinity: ...
    def quotient(self, n: int) -> Integer | PlusInfinity: ...
    def quotients(self) -> lazy_list_generic: ...
    def value(self) -> Element: ...
    def __neg__(self) -> ContinuedFraction_base: ...
