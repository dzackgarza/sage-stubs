from sage.rings.quotient_ring import QuotientRing_nc
from sage.structure.element import Element, RingElement

type ElementList[E] = list[E]

class QuotientRingElement(RingElement):
    def __init__(self, parent: QuotientRing_nc, rep: Element, reduce: bool = True) -> None: ...
    def lift(self) -> Element: ...
    def __bool__(self) -> bool: ...
    def is_unit(self) -> bool: ...
    def __hash__(self) -> int: ...
    def lt(self) -> QuotientRingElement: ...
    def lm(self) -> QuotientRingElement: ...
    def lc(self) -> Element: ...
    def variables(self) -> tuple[QuotientRingElement, ...]: ...
    def monomials(self) -> ElementList[QuotientRingElement]: ...
    def reduce(self, G: object) -> QuotientRingElement: ...
