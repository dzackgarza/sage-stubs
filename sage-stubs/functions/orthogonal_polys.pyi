from sage.symbolic.function import BuiltinFunction, ConversionTable, FunctionArgument, FunctionKeyword, FunctionResult, GinacFunction


class OrthogonalFunction(BuiltinFunction):
    def __init__(
        self,
        name: str,
        nargs: int = 2,
        latex_name: str | None = None,
        conversions: ConversionTable | None = None,
    ) -> None: ...
    def eval_formula(self, *args: FunctionArgument) -> FunctionResult: ...
    def __call__(
        self,
        *args: FunctionArgument,
        **kwds: FunctionKeyword,
    ) -> FunctionResult: ...


class ChebyshevFunction(OrthogonalFunction):
    def __call__(
        self,
        n: FunctionArgument,
        *args: FunctionArgument,
        **kwds: FunctionKeyword,
    ) -> FunctionResult: ...


class Func_chebyshev_T(ChebyshevFunction):
    def __init__(self) -> None: ...
    def eval_formula(self, n: int, x: FunctionArgument) -> FunctionResult: ...
    def eval_algebraic(self, n: int, x: FunctionArgument) -> FunctionResult: ...
class Func_chebyshev_U(ChebyshevFunction):
    def __init__(self) -> None: ...
    def eval_formula(self, n: int, x: FunctionArgument) -> FunctionResult: ...
    def eval_algebraic(self, n: int, x: FunctionArgument) -> FunctionResult: ...
class Func_legendre_P(GinacFunction):
    def __init__(self) -> None: ...
class Func_legendre_Q(BuiltinFunction):
    def __init__(self) -> None: ...
    def eval_recursive(self, n: int, arg: FunctionArgument, **kwds: FunctionKeyword) -> FunctionResult: ...
    def eval_formula(self, n: int, arg: FunctionArgument, **kwds: FunctionKeyword) -> FunctionResult: ...
class Func_assoc_legendre_P(BuiltinFunction):
    def __init__(self) -> None: ...
    def eval_gen_poly(
        self,
        n: int,
        m: int,
        arg: FunctionArgument,
        **kwds: FunctionKeyword,
    ) -> FunctionResult: ...
class Func_assoc_legendre_Q(BuiltinFunction):
    def __init__(self) -> None: ...
    def eval_recursive(
        self,
        n: int,
        m: int,
        x: FunctionArgument,
        **kwds: FunctionKeyword,
    ) -> FunctionResult: ...
class Func_hermite(GinacFunction):
    def __init__(self) -> None: ...
class Func_jacobi_P(OrthogonalFunction):
    def __init__(self) -> None: ...
class Func_ultraspherical(GinacFunction):
    def __init__(self) -> None: ...
class Func_laguerre(OrthogonalFunction):
    def __init__(self) -> None: ...
class Func_gen_laguerre(OrthogonalFunction):
    def __init__(self) -> None: ...
class Func_krawtchouk(OrthogonalFunction):
    def __init__(self) -> None: ...
    def eval_formula(self, k: int, x: FunctionArgument, n: int, p: FunctionArgument) -> FunctionResult: ...
    def eval_recursive(self, j: int, x: FunctionArgument, n: int, p: FunctionArgument, *args: FunctionArgument, **kwds: FunctionKeyword) -> FunctionResult: ...
class Func_meixner(OrthogonalFunction):
    def __init__(self) -> None: ...
    def eval_formula(self, n: int, x: FunctionArgument, b: FunctionArgument, c: FunctionArgument) -> FunctionResult: ...
    def eval_recursive(self, n: int, x: FunctionArgument, b: FunctionArgument, c: FunctionArgument, *args: FunctionArgument, **kwds: FunctionKeyword) -> FunctionResult: ...
class Func_hahn(OrthogonalFunction):
    def __init__(self) -> None: ...
