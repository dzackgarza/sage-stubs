from collections.abc import Callable, Hashable, Iterable, Iterator
from typing import overload

from _typeshed import SupportsRichComparison
from sage.graphs.generic_graph import GenericGraph

# An edge is ``(u, v)``, or ``(u, v, label)`` when the view has labels; a
# vertex is any hashable object and a label is any object.
type _Edge = tuple[Hashable, Hashable] | tuple[Hashable, Hashable, object]

class EdgesView:
    def __init__(
        self,
        G: GenericGraph,
        vertices: Hashable | Iterable[Hashable] | None = None,
        vertices2: Hashable | Iterable[Hashable] | None = None,
        labels: bool = True,
        ignore_direction: bool = False,
        sort: bool = False,
        key: Callable[[_Edge], SupportsRichComparison] | None = None,
        sort_vertices: bool = True,
    ) -> None: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def _iter_unsorted(self) -> Iterator[_Edge]: ...
    def __iter__(self) -> Iterator[_Edge]: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, right: object) -> bool: ...
    def __contains__(self, e: object) -> bool: ...
    @overload
    def __getitem__(self, i: int) -> _Edge: ...
    @overload
    def __getitem__(self, i: slice) -> list[_Edge]: ...
    def __add__(self, right: EdgesView) -> list[_Edge]: ...
    def __mul__(self, right: int) -> list[_Edge]: ...
