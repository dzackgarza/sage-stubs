from sage.structure.element import Element
from sage.structure.sage_object import SageObject

class GraphPlot(SageObject):
    def _repr_(self) -> str: ...
    def set_pos(self) -> Element: ...
    def set_vertices(self) -> Element: ...
    def set_edges(self) -> Element: ...
    def _polar_hack_for_multidigraph(self, A: Element | int | str | bool | None, B: Element | int | str | bool | None, VR: Element | int | str | bool | None) -> Element: ...
    def show(self) -> Element: ...
    def plot(self) -> Element: ...
    def layout_tree(self, root: Element | int | str | bool | None, orientation: Element | int | str | bool | None) -> Element: ...
