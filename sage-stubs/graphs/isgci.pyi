from sage.structure.element import Element
from sage.structure.sage_object import SageObject

class GraphClass(SageObject, CachedRepresentation):
    def _repr_(self) -> str: ...
    def forbidden_subgraphs(self) -> Element: ...
    def description(self) -> Element: ...

class GraphClasses(UniqueRepresentation):
    def get_class(self, id: Element | int | str | bool | None) -> Element: ...
    def classes(self) -> Element: ...
    def inclusions(self) -> Element: ...
    def smallgraphs(self) -> Element: ...
    def inclusion_digraph(self) -> Element: ...
    def _download_db(self) -> Element: ...
    def _parse_db(self) -> Element: ...
    def update_db(self) -> Element: ...
    def _get_ISGCI(self) -> Element: ...
    def show_all(self) -> Element: ...

class CachedRepresentation: ...

class UniqueRepresentation: ...
