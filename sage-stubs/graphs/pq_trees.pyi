from sage.rings.integer import Integer
from sage.structure.element import Element

def reorder_sets(sets: Element | int | str | bool | None) -> Element: ...

class PQ:
    def reverse(self) -> Element: ...
    def number_of_children(self) -> int: ...
    def ordering(self) -> list[Element]: ...
    def simplify(self, v: Element, left: Element | int | str | bool | None, right: Element | int | str | bool | None) -> Element: ...
    def flatten(self) -> Element: ...

class P(PQ):
    def set_contiguous(self, v: Element) -> Element: ...
    def cardinality(self) -> Integer: ...
    def orderings(self) -> Integer: ...

class Q(PQ):
    def set_contiguous(self, v: Element) -> Element: ...
    def cardinality(self) -> Integer: ...
    def orderings(self) -> Integer: ...
