from __future__ import annotations

from collections.abc import Iterator
from typing import Self, overload

from sage.monoids.free_monoid_element import FreeMonoidElement
from sage.probability.random_variable import DiscreteProbabilitySpace
from sage.rings.integer import Integer
from sage.rings.real_mpfr import RealNumber


type StringMonoidData = str | list[int | Integer]


class StringMonoidElement(FreeMonoidElement):
    def __init__(
        self,
        S: StringMonoid_class,
        x: StringMonoidData,
        check: bool = ...,
    ) -> None: ...
    def parent(self) -> StringMonoid_class: ...
    def _richcmp_(
        self,
        other: StringMonoidElement,
        op: int,
    ) -> bool: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def __mul__(self, y: StringMonoidElement) -> Self: ...
    def __pow__(self, n: int | Integer) -> Self: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[StringMonoidElement]: ...
    @overload
    def __getitem__(self, n: int | Integer) -> StringMonoidElement: ...
    @overload
    def __getitem__(self, n: slice) -> StringMonoidElement: ...
    def decoding(self, padic: bool = ...) -> str: ...
    def coincidence_index(self, prec: int | Integer = ...) -> RealNumber: ...
    def character_count(self) -> dict[StringMonoidElement, int]: ...
    def frequency_distribution(
        self,
        length: int | Integer = ...,
        prec: int | Integer = ...,
    ) -> DiscreteProbabilitySpace: ...


from sage.monoids.string_monoid import StringMonoid_class
