from collections.abc import Mapping
from sage.interfaces.tab_completion import ExtraTabCompletion
from sage.rings.rational import Rational
from sage.symbolic.expression import Expression


type UnitScale = Rational | int | str
type UnitCategoryData = Mapping[str, UnitScale]
type UnitDatabase = Mapping[str, UnitCategoryData]
type UnitState = tuple[str, UnitDatabase]


one: Rational
unitdict: UnitDatabase
unit_to_type: dict[str, str]
value_to_unit: dict[str, dict[UnitScale, str]]
unit_docs: dict[str, dict[str, str]]
unit_derivations: dict[str, str]


def evalunitdict() -> None: ...
def vars_in_str(s: str) -> list[str]: ...
def unit_derivations_expr(v: str) -> Expression: ...


class UnitExpression(Expression):
    def _instancedoc_(self) -> str: ...


def str_to_unit(name: str) -> UnitExpression: ...


class Units(ExtraTabCompletion):
    def __init__(self, data: UnitDatabase, name: str = "") -> None: ...
    def __getstate__(self) -> UnitState: ...
    def __setstate__(self, state: UnitState) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __getattr__(self, name: str) -> UnitExpression | Units: ...
    def __repr__(self) -> str: ...


units: Units

def unitdocs(unit: UnitExpression | Expression) -> str: ...
def is_unit(s: UnitExpression | Expression | str) -> bool: ...
def convert(
    expr: Expression,
    target: UnitExpression | Expression | None = None,
) -> Expression: ...
def base_units(unit: UnitExpression | Expression) -> Expression: ...
def convert_temperature(
    expr: Expression,
    target: UnitExpression | Expression,
) -> Expression: ...
