from sage.rings.abc import AlgebraicField_common
from sage.structure.element import Element
from sage.symbolic.expression import Expression, SymbolicOperator
from sage.symbolic.expression_conversions import Converter, SymbolicPyObject


class AlgebraicConverter(Converter[Element]):
    field: AlgebraicField_common

    def __init__(self, field: AlgebraicField_common) -> None: ...
    def pyobject(self, ex: Expression, obj: SymbolicPyObject) -> Element: ...
    def arithmetic(self, ex: Expression, operator: SymbolicOperator) -> Element: ...
    def composition(self, ex: Expression, operator: SymbolicOperator) -> Element: ...


def algebraic(ex: Expression, field: AlgebraicField_common) -> Element: ...
