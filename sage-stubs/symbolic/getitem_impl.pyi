from collections.abc import Callable

from sage.symbolic.expression import Expression

type SymbolicIndex = int | slice | list[int] | tuple[int, ...]

def normalize_index(arg: SymbolicIndex, nops: int, err_msg: str) -> int: ...

def normalize_index_for_doctests(arg: int, nops: int) -> int: ...

class OperandsWrapper:
    def __getitem__(self, arg: SymbolicIndex) -> Expression | OperandsWrapper: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def __reduce__(self) -> tuple[Callable[[Expression], OperandsWrapper], tuple[Expression]]: ...

def restore_op_wrapper(expr: Expression) -> OperandsWrapper: ...
