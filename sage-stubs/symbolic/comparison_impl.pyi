from collections.abc import Iterable
from typing import TypeVar

from sage.symbolic.expression import Expression

_Expression = TypeVar("_Expression", bound=Expression)

def print_order(lhs: Expression, rhs: Expression) -> int: ...

class _print_key:
    def __init__(self, ex: Expression) -> None: ...
    def __lt__(self, other: _print_key) -> bool: ...

def print_sorted(expressions: Iterable[_Expression]) -> list[_Expression]: ...

class _math_key:
    def __init__(self, ex: Expression) -> None: ...
    def __lt__(self, other: _math_key) -> bool: ...

def math_sorted(expressions: Iterable[_Expression]) -> list[_Expression]: ...

def mixed_order(lhs: Expression, rhs: Expression) -> int: ...

class _mixed_key:
    def __init__(self, ex: Expression) -> None: ...
    def __lt__(self, other: _mixed_key) -> bool: ...

def mixed_sorted(expressions: Iterable[_Expression]) -> list[_Expression]: ...
