from collections.abc import Callable

from sage.ext.fast_callable import ExpressionTreeBuilder, FastCallableFloatWrapper
from sage.interfaces.expect import Expect
from sage.rings.polynomial.multi_polynomial_ring_base import MPolynomialRing_base
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.symbolic.expression import Expression
from sage.symbolic.function import Function

type _Converted = str | Element | Expression | FastCallableFloatWrapper | None

class FakeExpression:
    def __init__(self, operands: list[object], operator: object) -> None: ...
    def pyobject(self) -> None: ...
    def operands(self) -> list[object]: ...
    def __getitem__(self, i: int) -> FakeExpression: ...
    def operator(self) -> Callable[..., object] | Function: ...
    def _fast_callable_(self, etb: ExpressionTreeBuilder) -> FastCallableFloatWrapper: ...

class Converter:
    def __init__(self, use_fake_div: bool = ...) -> None: ...
    def __call__(self, ex: Expression | None = ...) -> _Converted: ...
    def get_fake_div(self, ex: Expression) -> FakeExpression | Expression: ...
    def pyobject(self, ex: Expression, obj: object) -> _Converted: ...
    def symbol(self, ex: Expression) -> _Converted: ...
    def relation(self, ex: Expression, operator: object) -> _Converted: ...
    def derivative(self, ex: Expression, operator: object) -> _Converted: ...
    def arithmetic(self, ex: Expression, operator: object) -> _Converted: ...
    def composition(self, ex: Expression, operator: object) -> _Converted: ...

class InterfaceInit(Converter):
    def __init__(self, interface: Expect) -> None: ...
    def symbol(self, ex: Expression) -> str: ...
    def pyobject(self, ex: Expression, obj: object) -> str: ...
    def relation(self, ex: Expression, operator: object) -> str: ...
    def tuple(self, ex: Expression) -> str: ...
    def derivative(self, ex: Expression, operator: object) -> str: ...
    def arithmetic(self, ex: Expression, operator: object) -> str: ...
    def composition(self, ex: Expression, operator: object) -> str: ...

class FriCASConverter(InterfaceInit):
    def __init__(self) -> None: ...
    def pyobject(self, ex: Expression, obj: object) -> str: ...
    def symbol(self, ex: Expression) -> str: ...
    def derivative(self, ex: Expression, operator: object) -> str: ...

fricas_converter: FriCASConverter

class PolynomialConverter(Converter):
    def __init__(
        self,
        ex: Expression,
        base_ring: Ring | None = ...,
        ring: MPolynomialRing_base | None = ...,
    ) -> None: ...
    def symbol(self, ex: Expression) -> Element: ...
    def pyobject(self, ex: Expression, obj: object) -> Element: ...
    def composition(self, ex: Expression, operator: object) -> Element: ...
    def relation(self, ex: Expression, op: object) -> Element: ...
    def arithmetic(self, ex: Expression, operator: object) -> Element: ...

def polynomial(
    ex: Expression, base_ring: Ring | None = ..., ring: MPolynomialRing_base | None = ...
) -> Element: ...

class LaurentPolynomialConverter(PolynomialConverter):
    def __init__(
        self,
        ex: Expression,
        base_ring: Ring | None = ...,
        ring: MPolynomialRing_base | None = ...,
    ) -> None: ...

def laurent_polynomial(
    ex: Expression, base_ring: Ring | None = ..., ring: MPolynomialRing_base | None = ...
) -> Element: ...

class FastCallableConverter(Converter):
    def __init__(self, ex: Expression, etb: ExpressionTreeBuilder) -> None: ...
    def pyobject(self, ex: Expression, obj: object) -> FastCallableFloatWrapper: ...
    def relation(self, ex: Expression, operator: object) -> FastCallableFloatWrapper: ...
    def arithmetic(self, ex: Expression, operator: object) -> FastCallableFloatWrapper: ...
    def symbol(self, ex: Expression) -> FastCallableFloatWrapper: ...
    def composition(self, ex: Expression, function: object) -> FastCallableFloatWrapper: ...
    def tuple(self, ex: Expression) -> list[Expression]: ...

def fast_callable(ex: Expression, etb: ExpressionTreeBuilder) -> FastCallableFloatWrapper: ...

class RingConverter(Converter):
    def __init__(self, R: Ring, subs_dict: dict[Expression, Element] | None = ...) -> None: ...
    def symbol(self, ex: Expression) -> Element: ...
    def pyobject(self, ex: Expression, obj: object) -> Element: ...
    def arithmetic(self, ex: Expression, operator: object) -> Element: ...
    def composition(self, ex: Expression, operator: object) -> Element: ...

class ExpressionTreeWalker(Converter):
    def __init__(self, ex: Expression) -> None: ...
    def symbol(self, ex: Expression) -> Expression: ...
    def pyobject(self, ex: Expression, obj: object) -> Expression: ...
    def relation(self, ex: Expression, operator: object) -> Expression: ...
    def arithmetic(self, ex: Expression, operator: object) -> Expression: ...
    def composition(self, ex: Expression, operator: object) -> Expression: ...
    def derivative(self, ex: Expression, operator: object) -> Expression: ...
    def tuple(self, ex: Expression) -> list[Expression]: ...

class SubstituteFunction(ExpressionTreeWalker):
    def __init__(self, ex: Expression, *args: Expression) -> None: ...
    def composition(self, ex: Expression, operator: object) -> Expression: ...
    def derivative(self, ex: Expression, operator: object) -> Expression: ...

class Exponentialize(ExpressionTreeWalker):
    half: Expression
    two: Expression
    x: Expression
    CircDict: dict[Function, Callable[..., Expression]]
    Circs: list[Function]
    def __init__(self, ex: Expression) -> None: ...
    def composition(self, ex: Expression, op: object) -> Expression: ...

class DeMoivre(ExpressionTreeWalker):
    def __init__(self, ex: Expression, force: bool = ...) -> None: ...
    def composition(self, ex: Expression, op: object) -> Expression: ...

class HalfAngle(ExpressionTreeWalker):
    x: Expression
    one: Expression
    two: Expression
    half: Expression
    halfx: Expression
    HalvesDict: dict[Function, Callable[..., Expression]]
    Halves: list[Function]
    def __init__(self, ex: Expression) -> None: ...
    def composition(self, ex: Expression, op: object) -> Expression: ...

class HoldRemover(ExpressionTreeWalker):
    def __init__(self, ex: Expression, exclude: list[Function] | None = ...) -> None: ...
    def composition(self, ex: Expression, operator: object) -> Expression: ...
