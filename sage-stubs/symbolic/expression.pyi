from collections.abc import Callable

from sage.rings.integer import Integer
from sage.structure.element import Expression as Expression_abc
from sage.structure.parent import ElementConstructorInput


class Expression(Expression_abc):
    def __call__(
        self,
        *args: ElementConstructorInput,
        **kwds: ElementConstructorInput,
    ) -> Expression: ...
    def subs(
        self,
        *args: ElementConstructorInput,
        **kwds: ElementConstructorInput,
    ) -> Expression: ...
    def operator(self) -> Callable[..., ElementConstructorInput] | None: ...
    def operands(self) -> list[Expression]: ...
    def variables(self) -> tuple[Expression, ...]: ...
    def is_polynomial(self, variable: Expression) -> bool: ...
    def degree(self, variable: Expression) -> Expression: ...
    def coefficient(
        self,
        variable: Expression,
        n: int | Integer = ...,
    ) -> Expression: ...
    def numerator(self) -> Expression: ...
    def denominator(self) -> Expression: ...
    def is_infinity(self) -> bool: ...
    def __add__(self, other: ElementConstructorInput) -> Expression: ...
    def __radd__(self, other: ElementConstructorInput) -> Expression: ...
    def __sub__(self, other: ElementConstructorInput) -> Expression: ...
    def __rsub__(self, other: ElementConstructorInput) -> Expression: ...
    def __mul__(self, other: ElementConstructorInput) -> Expression: ...
    def __rmul__(self, other: ElementConstructorInput) -> Expression: ...
    def __truediv__(self, other: ElementConstructorInput) -> Expression: ...
    def __rtruediv__(self, other: ElementConstructorInput) -> Expression: ...
    def __pow__(self, other: ElementConstructorInput) -> Expression: ...
    def __neg__(self) -> Expression: ...
    def sqrt(self) -> Expression: ...
    def simplify_full(self) -> Expression: ...
