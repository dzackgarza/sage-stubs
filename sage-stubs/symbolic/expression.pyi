from collections.abc import Callable, Iterator, Mapping, Sequence
from types import NotImplementedType
from typing import Literal, Protocol, Self, overload

from sage.matrix.matrix0 import Matrix
from sage.plot.graphics import Graphics
from sage.rings.infinity import MinusInfinity
from sage.rings.integer import Integer
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.power_series_ring_element import PowerSeries
from sage.structure.element import Element, Expression as Expression_abc, RingElement
from sage.structure.parent import ElementConstructorInput, Parent
from sage.symbolic.getitem_impl import OperandsWrapper
from sage.symbolic.maxima_wrapper import MaximaWrapper


type SymbolicInput = ElementConstructorInput
type SymbolicVariable = Expression | str
type SymbolicDomain = Literal["complex", "real", "positive", "integer"] | str
type SymbolicSubstitution = Mapping[Expression | str, SymbolicInput]
type SymbolicSolution = Expression | dict[Expression, Expression]
type SymbolicRoot = Expression | RingElement
type ExpressionState = tuple[int, list[str], str]
type NumericalIntegralResult = tuple[float, float, Integer, Integer]
type ExtremumResult = tuple[float, float]
type FactorList = list[tuple[Expression, Integer]]




class SymbolicOperator(Protocol):
    def __call__(
        self,
        *args: SymbolicInput,
        **kwargs: SymbolicInput,
    ) -> SymbolicInput: ...


class RootConvergence(Protocol):
    converged: bool
    flag: str
    function_calls: int
    iterations: int
    root: float


