class ExpressionIterator(Iterator[Expression]):
    def __iter__(self) -> Self: ...
    def __next__(self) -> Expression: ...


class hold_class:
    def __call__(self, ex: SymbolicInput) -> Expression: ...
    def __enter__(self) -> hold_class: ...
    def __exit__(self, *args: object) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...


hold: hold_class


