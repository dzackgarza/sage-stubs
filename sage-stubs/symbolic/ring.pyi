    def _element_constructor_(self, x: SageCoercionAtom) -> Expression: ...
    def _force_pyobject(
        self, x: SageCoercionAtom, force: bool = False, recursive: bool = True
    ) -> Element: ...
    def wild(self, n: int = 0) -> Element: ...
    def __contains__(self, x: object) -> bool: ...
    def characteristic(self) -> int: ...
    def _an_element_(self) -> Element: ...
    def is_field(self, proof: bool = True) -> bool: ...
    def is_finite(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def pi(self) -> Element: ...
    def I(self) -> Element: ...
    def symbol(
        self,
        name: str | None = None,
        latex_name: str | None = None,
        domain: str | None = None,
    ) -> Element: ...
    def temp_var(
        self, n: int | None = None, domain: str | None = None
    ) -> Element | tuple[Element, ...]: ...
    def cleanup_var(self, symbol: Element | list[Element]) -> None: ...
    def var(
        self,
        name: str,
        latex_name: str | None = None,
        n: int | None = None,
        domain: str | None = None,
    ) -> Expression | tuple[Expression, ...]: ...
    def zero(self) -> Expression: ...
    def _repr_element_(self, x: Element) -> str: ...
    def _latex_element_(self, x: Element) -> str: ...
    def _call_element_(
        self, element: Element, *args: Element, **kwds: Element
    ) -> Element: ...
    def subring(self, *args: Element, **kwds: Element) -> Parent: ...
    def _fricas_init_(self) -> str: ...

def the_SymbolicRing() -> SymbolicRing: ...

SR: SymbolicRing

