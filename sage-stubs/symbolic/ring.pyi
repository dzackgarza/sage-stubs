from collections.abc import Callable, Iterable
from types import TracebackType
from typing import Literal, Self

from sage.categories.morphism import Morphism
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.sage_object import SageCoercionAtom, SageObject
from sage.symbolic.expression import Expression, SymbolicInput


type SymbolicDomain = Literal["complex", "real", "positive", "integer"] | str


class SymbolicRing(Parent[Expression]):
    def __init__(self, base_ring: Parent | None = None) -> None: ...
    def __reduce__(self) -> tuple[Callable[[], SymbolicRing], tuple[()]]: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _coerce_map_from_(self, R: Parent) -> bool: ...
    def _element_constructor_(self, x: SymbolicInput) -> Expression: ...
    def _force_pyobject(
        self,
        x: SymbolicInput,
        force: bool = False,
        recursive: bool = True,
    ) -> Element | int | float | complex: ...
    def wild(self, n: int = 0) -> Expression: ...
    def __contains__(self, x: SymbolicInput) -> bool: ...
    def characteristic(self) -> Integer: ...
    def _an_element_(self) -> Expression: ...
    def is_field(self, proof: bool = True) -> bool: ...
    def fraction_field(self) -> Self: ...
    def is_finite(self) -> bool: ...
    def is_exact(self) -> bool: ...
    def pi(self) -> Expression: ...
    def I(self) -> Expression: ...
    def symbol(
        self,
        name: str | None = None,
        latex_name: str | None = None,
        domain: SymbolicDomain | None = None,
    ) -> Expression: ...
    def temp_var(
        self,
        n: int | None = None,
        domain: SymbolicDomain | None = None,
    ) -> Expression | TemporaryVariables: ...
    def cleanup_var(
        self,
        symbol: Expression | Iterable[Expression],
    ) -> None: ...
    def var(
        self,
        name: str,
        latex_name: str | None = None,
        n: int | None = None,
        domain: SymbolicDomain | None = None,
    ) -> Expression | tuple[Expression, ...]: ...
    def _repr_element_(self, x: Expression) -> str: ...
    def _latex_element_(self, x: Expression) -> str: ...
    def _call_element_(
        self,
        element: Expression,
        *args: SymbolicInput,
        **kwds: SymbolicInput,
    ) -> Expression: ...
    def subring(
        self,
        *,
        accepting_variables: Iterable[Expression | str] | None = None,
        rejecting_variables: Iterable[Expression | str] | None = None,
        no_variables: bool = False,
    ) -> SymbolicRing: ...
    def _fricas_init_(self) -> str: ...


def the_SymbolicRing() -> SymbolicRing: ...


SR: SymbolicRing


class NumpyToSRMorphism(Morphism[SageCoercionAtom, Expression]):
    def __init__(self, numpy_type: type) -> None: ...
    def _call_(self, a: SageCoercionAtom) -> Expression: ...


class UnderscoreSageMorphism(Morphism[SageObject, Expression]):
    def __init__(self, t: type[SageObject], R: Parent) -> None: ...
    def _call_(self, a: SageObject) -> Expression: ...


def var(
    name: str,
    *,
    latex_name: str | None = None,
    n: int | None = None,
    domain: SymbolicDomain | None = None,
) -> Expression | tuple[Expression, ...]: ...

def isidentifier(x: str) -> bool: ...


class TemporaryVariables(tuple[Expression, ...]):
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exception_type: type[BaseException] | None = None,
        exception: BaseException | None = None,
        traceback: TracebackType | None = None,
    ) -> Literal[False]: ...
