class UnderscoreSageMorphism(Morphism):
    def __init__(self, t: type[SageObject], R: Parent) -> None: ...
    def _call_(self, a: SageObject) -> Element: ...

def var(name: str, **kwds: str | int | None) -> Element | tuple[Element, ...]: ...
def isidentifier(x: str) -> bool: ...

class TemporaryVariables(tuple[Element, ...]):
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exception_type: type[BaseException] | None,
        exception: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...
