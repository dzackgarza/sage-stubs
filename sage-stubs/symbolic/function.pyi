from collections.abc import Callable

from sage.symbolic.expression import Expression
from sage.structure.element import Element

type SymbolicValue = Expression | Element | int | float | complex
type SymbolicCallable = Callable[..., SymbolicValue]
type ConversionTable = dict[str, str]
type SymbolicFunctionState = tuple[
    int, str, int, str | None, ConversionTable | None, bool, list[bytes | None]
]

class Function:
    def __init__(
        self, name: str, nargs: int, latex_name: str | None = None,
        conversions: ConversionTable | None = None, evalf_params_first: bool = True,
        alt_name: str | None = None,
    ) -> None: ...
    def _evalf_try_(self, *args: SymbolicValue) -> SymbolicValue | None: ...
    def __hash__(self) -> int: ...
    def _latex_(self) -> str: ...
    def name(self) -> str: ...
    def number_of_arguments(self) -> int: ...
    def __richcmp__(self, other: Function, op: int) -> bool: ...
    def __call__(
        self, *args: SymbolicValue, coerce: bool = True, hold: bool = False
    ) -> SymbolicValue: ...
    def variables(self) -> tuple[Expression, ...]: ...
    def default_variable(self) -> Expression: ...
    def _is_numerical(self, x: SymbolicValue) -> bool: ...
    def _interface_init_(self, I: Element | None = None) -> str: ...
    def _mathematica_init_(self) -> str: ...
    @property
    def _sympy_init_(self, I: Element | None = None) -> str: ...
    @property
    def _sympy_(self) -> SymbolicCallable: ...
    def _maxima_init_(self, I: Element | None = None) -> str: ...
    def _fast_callable_(self, expression_tree_builder: Element) -> Element: ...
    def _eval_numpy_(self, *args: SymbolicValue) -> SymbolicValue: ...
    def _eval_mpmath_(self, *args: SymbolicValue) -> SymbolicValue: ...

class GinacFunction(Function):
    def __init__(
        self, name: str, nargs: int = 1, latex_name: str | None = None,
        conversions: ConversionTable | None = None, ginac_name: str | None = None,
        evalf_params_first: bool = True, preserved_arg: int | None = None,
        alt_name: str | None = None,
    ) -> None: ...

class BuiltinFunction(Function):
    def __init__(
        self, name: str, nargs: int = 1, latex_name: str | None = None,
        conversions: ConversionTable | None = None, evalf_params_first: bool = True,
        alt_name: str | None = None, preserved_arg: int | None = None,
    ) -> None: ...
    def _method_arguments(self, arg: SymbolicValue) -> list[SymbolicValue]: ...
    def __call__(
        self, *args: SymbolicValue, coerce: bool = True, hold: bool = False,
        dont_call_method_on_arg: bool = False,
    ) -> SymbolicValue: ...
    def _is_registered(self) -> bool: ...
    def _evalf_or_eval_(self, *args: SymbolicValue) -> SymbolicValue: ...
    def __reduce__(self) -> tuple[type[BuiltinFunction], tuple[()]]: ...
    def __setstate__(self, state: list[int]) -> None: ...

class SymbolicFunction(Function):
    def __init__(
        self, name: str, nargs: int = 0, latex_name: str | None = None,
        conversions: ConversionTable | None = None, evalf_params_first: bool = True,
    ) -> None: ...
    def _is_registered(self) -> bool: ...
    def _hash_(self) -> int: ...
    def __hash__(self) -> int: ...
    def __getstate__(self) -> SymbolicFunctionState: ...
    def __setstate__(self, state: SymbolicFunctionState) -> None: ...

def pickle_wrapper(f: SymbolicCallable | None) -> bytes | None: ...
def unpickle_wrapper(p: bytes | None) -> SymbolicCallable | None: ...
