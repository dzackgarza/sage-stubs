from collections.abc import Callable
from typing import TypeVar

from sage.symbolic.expression import Expression

_Operand = TypeVar("_Operand")
type SymbolicFunction = Callable[..., Expression]

def add_vararg(first: _Operand, *rest: _Operand) -> _Operand: ...
def mul_vararg(first: _Operand, *rest: _Operand) -> _Operand: ...

arithmetic_operators: dict[Callable[..., Expression], str] = ...
relation_operators: dict[Callable[[Expression, Expression], bool], str] = ...

class FDerivativeOperator:
    def __init__(self, function: SymbolicFunction, parameter_set: list[int]) -> None: ...
    def __call__(self, *args: Expression) -> Expression: ...
    def function(self) -> SymbolicFunction: ...
    def change_function(self, new: SymbolicFunction) -> FDerivativeOperator: ...
    def parameter_set(self) -> list[int]: ...

class DerivativeOperator:
    class DerivativeOperatorWithParameters:
        def __init__(self, parameter_set: list[int]) -> None: ...
        def __call__(self, function: SymbolicFunction) -> FDerivativeOperator: ...

    def __getitem__(
        self, args: int | tuple[int, ...]
    ) -> DerivativeOperatorWithParameters: ...
