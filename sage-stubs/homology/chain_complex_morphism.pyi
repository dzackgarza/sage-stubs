from collections.abc import Hashable, Mapping
from typing import Generic, Self, TypeVar, overload

from sage.categories.morphism import Morphism
from sage.matrix.matrix import Matrix
from sage.structure.element import RingElement

_Degree = TypeVar("_Degree", bound=Hashable, default=int)
_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)


class ChainComplexMorphism(
    Morphism[
        Chain_class[_Degree, _Scalar],
        Chain_class[_Degree, _Scalar],
    ],
    Generic[_Degree, _Scalar],
):
    def __init__(
        self,
        matrices: Mapping[_Degree, Matrix[_Scalar]],
        C: ChainComplex_class[_Degree, _Scalar],
        D: ChainComplex_class[_Degree, _Scalar],
        check: bool = ...,
    ) -> None: ...
    def parent(self) -> ChainComplexHomspace[_Degree, _Scalar]: ...
    def domain(self) -> ChainComplex_class[_Degree, _Scalar]: ...
    def codomain(self) -> ChainComplex_class[_Degree, _Scalar]: ...
    def in_degree(self, n: _Degree) -> Matrix[_Scalar]: ...

    @overload
    def to_matrix(self, deg: None = ...) -> Matrix[_Scalar]: ...
    @overload
    def to_matrix(self, deg: _Degree) -> Matrix[_Scalar]: ...

    def dual(self) -> ChainComplexMorphism[_Degree, _Scalar]: ...
    def __neg__(self) -> Self: ...
    def __add__(self, x: ChainComplexMorphism[_Degree, _Scalar]) -> Self: ...
    def __sub__(self, x: ChainComplexMorphism[_Degree, _Scalar]) -> Self: ...

    @overload
    def __mul__(
        self,
        x: ChainComplexMorphism[_Degree, _Scalar],
    ) -> ChainComplexMorphism[_Degree, _Scalar]: ...
    @overload
    def __mul__(self, x: _Scalar) -> Self: ...

    def __rmul__(self, x: _Scalar) -> Self: ...
    def __eq__(self, x: object) -> bool: ...
    def is_identity(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def is_injective(self) -> bool: ...
    def __hash__(self) -> int: ...


from sage.homology.chain_complex import Chain_class, ChainComplex_class
from sage.homology.chain_complex_homspace import ChainComplexHomspace
