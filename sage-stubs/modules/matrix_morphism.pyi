from typing import Generic, Literal, Self, TypeVar

from sage.categories.homset import Homset
from sage.categories.map import Map
from sage.categories.morphism import Morphism
from sage.matrix.matrix0 import Matrix
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Element, RingElement
from sage.structure.factorization import Factorization
from sage.structure.parent import Parent
from sage.structure.sequence import Sequence_generic

_DomainElement = TypeVar("_DomainElement", bound=Element, default=Element)
_CodomainElement = TypeVar("_CodomainElement", bound=Element, default=Element)
_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

type MatrixSide = Literal["left", "right"]

class MatrixMorphism_abstract(
    Morphism[_DomainElement, _CodomainElement],
    Generic[_DomainElement, _CodomainElement, _Scalar],
):
    def __init__(
        self,
        parent: Homset[
            Map[_DomainElement, _CodomainElement],
            _DomainElement,
            _CodomainElement,
        ],
        side: MatrixSide = ...,
    ) -> None: ...
    def parent(
        self,
    ) -> Homset[
        Map[_DomainElement, _CodomainElement],
        _DomainElement,
        _CodomainElement,
    ]: ...
    def domain(self) -> Parent[_DomainElement]: ...
    def codomain(self) -> Parent[_CodomainElement]: ...
    def _call_(self, x: _DomainElement) -> _CodomainElement: ...
    def _call_with_args(
        self,
        x: _DomainElement,
        args: tuple[object, ...] = ...,
        kwds: dict[str, object] = ...,
    ) -> _CodomainElement: ...
    def __invert__(self) -> Self: ...
    def inverse(self) -> Self: ...
    def side(self) -> MatrixSide: ...
    def side_switch(self) -> Self: ...
    def __add__(self, right: object) -> Self: ...
    def __neg__(self) -> Self: ...
    def __sub__(self, other: object) -> Self: ...
    def base_ring(self) -> Parent[_Scalar]: ...
    def characteristic_polynomial(self, var: str = ...) -> Polynomial: ...
    charpoly = characteristic_polynomial
    def determinant(self) -> _Scalar: ...
    det = determinant
    def fcp(self, var: str = ...) -> Factorization: ...
    def trace(self) -> _Scalar: ...
    def decomposition(
        self,
        *args: object,
        **kwds: object,
    ) -> Sequence_generic: ...
    def kernel(self) -> Parent[_DomainElement]: ...
    def image(self) -> Parent[_CodomainElement]: ...
    def matrix(self) -> Matrix[_Scalar]: ...
    def _matrix_(self) -> Matrix[_Scalar]: ...
    def rank(self) -> int: ...
    def nullity(self) -> int: ...
    def is_bijective(self) -> bool: ...
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def is_identity(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def is_equal_function(self, other: MatrixMorphism_abstract) -> bool: ...
    def restrict_domain(self, sub: Parent[_DomainElement]) -> Self: ...
    def restrict_codomain(self, sub: Parent[_CodomainElement]) -> Self: ...
    def restrict(self, sub: Parent[_DomainElement]) -> Self: ...

class MatrixMorphism(
    MatrixMorphism_abstract[_DomainElement, _CodomainElement, _Scalar],
    Generic[_DomainElement, _CodomainElement, _Scalar],
):
    def __init__(
        self,
        parent: Homset[
            Map[_DomainElement, _CodomainElement],
            _DomainElement,
            _CodomainElement,
        ],
        A: Matrix[_Scalar]
        | MatrixMorphism_abstract[_DomainElement, _CodomainElement, _Scalar],
        copy_matrix: bool = ...,
        side: MatrixSide = ...,
    ) -> None: ...
    def matrix(
        self,
        side: MatrixSide | None = ...,
    ) -> Matrix[_Scalar]: ...
