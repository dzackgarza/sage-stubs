from typing import Generic, TypeVar

from sage.modules.free_module_element import (
    FreeModuleElement,
    FreeModuleElement_generic_dense,
)
from sage.structure.element import ElementConstructorInput, RingElement

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

class OreModuleElement(
    FreeModuleElement_generic_dense[_Scalar],
    Generic[_Scalar],
):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def is_mutable(self) -> bool: ...
    def __setitem__(self, i: int, v: ElementConstructorInput) -> None: ...
    def __hash__(self) -> int: ...
    def vector(self) -> FreeModuleElement[_Scalar]: ...
    def image(self, integral: bool = ...) -> OreModuleElement[RingElement]: ...
