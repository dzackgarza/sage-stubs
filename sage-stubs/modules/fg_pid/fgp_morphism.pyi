from collections.abc import Sequence
from typing import Generic, Self, TypeVar

from sage.categories.homset import Homset
from sage.categories.morphism import Morphism
from sage.matrix.matrix import Matrix
from sage.modules.fg_pid.fgp_element import FGP_Element
from sage.modules.fg_pid.fgp_module import FGP_Module_class
from sage.structure.element import RingElement

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)


class FGP_Homset(
    Homset[
        FGP_Morphism[_Scalar],
        FGP_Element[_Scalar],
        FGP_Element[_Scalar],
    ],
    Generic[_Scalar],
):
    def domain(self) -> FGP_Module_class[_Scalar]: ...
    def codomain(self) -> FGP_Module_class[_Scalar]: ...
    def zero(self) -> FGP_Morphism[_Scalar]: ...
    def identity(self) -> FGP_Morphism[_Scalar]: ...
    one = identity
    def _element_constructor_(
        self,
        matrix: Matrix[_Scalar]
        | Sequence[FGP_Element[_Scalar]],
    ) -> FGP_Morphism[_Scalar]: ...


class FGP_Morphism(
    Morphism[FGP_Element[_Scalar], FGP_Element[_Scalar]],
    Generic[_Scalar],
):
    def __init__(
        self,
        parent: FGP_Homset[_Scalar],
        matrix: Matrix[_Scalar]
        | Sequence[FGP_Element[_Scalar]],
    ) -> None: ...
    def domain(self) -> FGP_Module_class[_Scalar]: ...
    def codomain(self) -> FGP_Module_class[_Scalar]: ...
    def matrix(self) -> Matrix[_Scalar]: ...
    def _call_(self, x: FGP_Element[_Scalar]) -> FGP_Element[_Scalar]: ...
    def kernel(self) -> FGP_Module_class[_Scalar]: ...
    def image(self) -> FGP_Module_class[_Scalar]: ...
    def rank(self) -> int: ...
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def is_bijective(self) -> bool: ...
    def inverse(self) -> Self: ...
    __invert__ = inverse
    def lift(self) -> object: ...
    def __mul__(self, right: Self) -> Self: ...
