from collections.abc import Iterable, Iterator
from typing import Self

from sage.matrix.matrix import Matrix
from sage.modules.free_module import FreeModule_generic, FreeModule_submodule
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.integer import Integer
from sage.rings.rational import Rational
from sage.structure.element import ModuleElement, RingElement
from sage.structure.parent import ElementConstructorInput, Parent


class TorsionQuadraticModuleElement(ModuleElement):
    def parent(self) -> TorsionQuadraticModule: ...
    def lift(self) -> FreeModuleElement[RingElement]: ...
    def vector(self) -> FreeModuleElement[RingElement]: ...
    def additive_order(self) -> Integer: ...
    order = additive_order
    def bilinear_product(
        self,
        other: TorsionQuadraticModuleElement,
    ) -> Rational: ...
    inner_product = bilinear_product
    def quadratic_product(self) -> Rational: ...
    q = quadratic_product
    def __neg__(self) -> Self: ...
    def __add__(self, other: TorsionQuadraticModuleElement) -> Self: ...
    def __sub__(self, other: TorsionQuadraticModuleElement) -> Self: ...
    def __rmul__(self, scalar: int | Integer) -> Self: ...


class TorsionQuadraticModule(Parent[TorsionQuadraticModuleElement]):
    Element: type[TorsionQuadraticModuleElement]
    def __init__(
        self,
        V: FreeModule_generic[RingElement],
        W: FreeModule_submodule[RingElement],
        modulus: int | Integer | Rational = ...,
        check: bool = ...,
    ) -> None: ...
    def cover(self) -> FreeModule_generic[RingElement]: ...
    V = cover
    def relations(self) -> FreeModule_submodule[RingElement]: ...
    W = relations
    def modulus(self) -> Rational: ...
    def gram_matrix(self) -> Matrix[Rational]: ...
    def bilinear_form(self) -> Matrix[Rational]: ...
    def quadratic_form(self) -> Matrix[Rational]: ...
    def invariants(self) -> tuple[Integer, ...]: ...
    elementary_divisors = invariants
    def ngens(self) -> int: ...
    def gen(self, i: int | Integer) -> TorsionQuadraticModuleElement: ...
    def gens(self) -> tuple[TorsionQuadraticModuleElement, ...]: ...
    def zero(self) -> TorsionQuadraticModuleElement: ...
    def __iter__(self) -> Iterator[TorsionQuadraticModuleElement]: ...
    def _element_constructor_(
        self,
        x: TorsionQuadraticModuleElement
        | FreeModuleElement[RingElement]
        | Iterable[ElementConstructorInput],
    ) -> TorsionQuadraticModuleElement: ...
    def cardinality(self) -> Integer: ...
    order = cardinality
    def is_nondegenerate(self) -> bool: ...
    def radical(self) -> TorsionQuadraticModule: ...
    def orthogonal_complement(
        self,
        submodule: Iterable[TorsionQuadraticModuleElement],
    ) -> TorsionQuadraticModule: ...
    def primary_part(self, p: int | Integer) -> TorsionQuadraticModule: ...
    def jordan_decomposition(self) -> tuple[TorsionQuadraticModule, ...]: ...
