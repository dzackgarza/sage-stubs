_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

class IndexedFreeModuleElement:
    def __init__(
        self, M: Matrix[_Scalar], x: FreeModuleElement[_Scalar] | Sequence[_Scalar]
    ) -> None: ...
    def __iter__(self) -> Iterator[FreeModuleElement[_Scalar]]: ...
    def __contains__(self, x: Hashable) -> bool: ...
    def __hash__(self) -> int: ...
    def support(self) -> Sequence[Hashable]: ...
    def coefficient(self, m: Hashable) -> FreeModule_generic: ...
    def __getitem__(self, m: Hashable) -> FreeModuleElement[_Scalar] | _Scalar: ...
    def __richcmp__(self, other: Self, op: int) -> bool: ...
    def _add_(self, other: Self) -> Self: ...
    def _sub_(self, other: Self) -> Self: ...
    def _mul_(self, other: Self) -> Self: ...
    def _rmul_(self, other: ElementConstructorInput) -> Self: ...
    def _neg_(self) -> Self: ...
    def __copy__(self) -> Self: ...
