from collections.abc import Iterable, Iterator
from typing import Generic, Self, TypeVar

from sage.modules.free_module import FreeModule_generic, FreeModule_submodule
from sage.modules.free_module_element import FreeModuleElement
from sage.modules.free_module_morphism import FreeModuleMorphism
from sage.rings.integer import Integer
from sage.sets.family import AbstractFamily
from sage.structure.element import ModuleElement, RingElement
from sage.structure.parent import ElementConstructorInput, Parent

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)


class FreeModule_quotient_element(ModuleElement, Generic[_Scalar]):
    def parent(self) -> FreeModule_quotient[_Scalar]: ...
    def lift(self) -> FreeModuleElement[_Scalar]: ...
    def vector(self) -> FreeModuleElement[_Scalar]: ...
    def additive_order(self) -> Integer: ...
    order = additive_order
    def __neg__(self) -> Self: ...
    def __add__(self, other: FreeModule_quotient_element[_Scalar]) -> Self: ...
    def __sub__(self, other: FreeModule_quotient_element[_Scalar]) -> Self: ...
    def __rmul__(self, scalar: _Scalar | int | Integer) -> Self: ...


class FreeModule_quotient(
    Parent[FreeModule_quotient_element[_Scalar]],
    Generic[_Scalar],
):
    Element: type[FreeModule_quotient_element[_Scalar]]
    def __init__(
        self,
        V: FreeModule_generic[_Scalar],
        W: FreeModule_submodule[_Scalar],
        check: bool = ...,
    ) -> None: ...
    def cover(self) -> FreeModule_generic[_Scalar]: ...
    V = cover
    def relations(self) -> FreeModule_submodule[_Scalar]: ...
    W = relations
    def base_ring(self) -> Parent[_Scalar]: ...
    def rank(self) -> int: ...
    dimension = rank
    def ngens(self) -> int: ...
    def gen(self, i: int | Integer) -> FreeModule_quotient_element[_Scalar]: ...
    def gens(self) -> tuple[FreeModule_quotient_element[_Scalar], ...]: ...
    def basis(self) -> AbstractFamily: ...
    def zero(self) -> FreeModule_quotient_element[_Scalar]: ...
    def random_element(self, *args: object, **kwds: object) -> FreeModule_quotient_element[_Scalar]: ...
    def __iter__(self) -> Iterator[FreeModule_quotient_element[_Scalar]]: ...
    def _element_constructor_(
        self,
        x: FreeModuleElement[_Scalar]
        | FreeModule_quotient_element[_Scalar]
        | Iterable[ElementConstructorInput],
    ) -> FreeModule_quotient_element[_Scalar]: ...
    def quotient_map(self) -> FreeModuleMorphism[_Scalar]: ...
    def lift_map(self) -> FreeModuleMorphism[_Scalar]: ...
    def invariants(self) -> tuple[Integer, ...]: ...
    def is_finite(self) -> bool: ...
    def cardinality(self) -> Integer: ...
