class AbstractSimplex_class(SageObject):
    def __init__(
        self,
        dim: int,
        degeneracies: tuple[int, ...] = ...,
        underlying: NonDegenerateSimplex | None = ...,
        name: str | None = ...,
        latex_name: str | None = ...,
    ) -> None: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: object) -> bool: ...
    def __gt__(self, other: object) -> bool: ...
    def __le__(self, other: object) -> bool: ...
    def __ge__(self, other: object) -> bool: ...
    def nondegenerate(self) -> NonDegenerateSimplex: ...
    def degeneracies(self) -> list[int]: ...
    def is_degenerate(self) -> bool: ...
    def is_nondegenerate(self) -> bool: ...
    def dimension(self) -> int: ...
    def apply_degeneracies(self, *args: int) -> Self: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, memo: dict[object, object]) -> Self: ...

class NonDegenerateSimplex(AbstractSimplex_class, WithEqualityById):
    def __init__(
        self, dim: int, name: str | None = ..., latex_name: str | None = ...
    ) -> None: ...

def AbstractSimplex(
    dim: int,
    degeneracies: tuple[int, ...] = ...,
    underlying: NonDegenerateSimplex | None = ...,
    name: str | None = ...,
    latex_name: str | None = ...,
) -> NonDegenerateSimplex | AbstractSimplex_class: ...

class SimplicialSet_arbitrary(Parent):
    def faces(self, simplex: AbstractSimplex_class) -> list[AbstractSimplex_class]: ...
    def face(self, simplex: AbstractSimplex_class, i: int) -> AbstractSimplex_class | None: ...
    def __contains__(self, x: object) -> bool: ...
    def alexander_whitney(
        self, simplex: AbstractSimplex_class, dim_left: int
    ) -> list[tuple[int, AbstractSimplex_class, AbstractSimplex_class]]: ...
    def nondegenerate_simplices(
        self, max_dim: int | None = ...
    ) -> list[AbstractSimplex_class]: ...
    def cells(
        self, subcomplex: SimplicialSet_arbitrary | None = ..., max_dim: int | None = ...
    ) -> dict[int, list[AbstractSimplex_class]]: ...
    def n_cells(
        self, n: int, subcomplex: SimplicialSet_arbitrary | None = ...
    ) -> list[AbstractSimplex_class]: ...
    def all_n_simplices(self, n: int) -> list[AbstractSimplex_class]: ...
    def identity(self) -> SimplicialSetMorphism: ...
    def constant_map(
        self,
        codomain: SimplicialSet_arbitrary | None = ...,
        point: AbstractSimplex_class | None = ...,
    ) -> SimplicialSetMorphism: ...
    def is_reduced(self) -> bool: ...
    def graph(self) -> Graph: ...
    def is_connected(self) -> bool: ...
    def subsimplicial_set(self, simplices: list[AbstractSimplex_class]) -> SubSimplicialSet: ...
    def chain_complex(
        self,
        dimensions: list[int] | None = ...,
        base_ring: object = ...,
        augmented: bool = ...,
        cochain: bool = ...,
        verbose: bool = ...,
        subcomplex: SimplicialSet_arbitrary | None = ...,
        check: bool = ...,
    ) -> ChainComplex_class: ...
    def homology(self, dim: int | None = ..., **kwds: object) -> dict[int, HomologyGroup_class]: ...
    def cohomology(self, dim: int | None = ..., **kwds: object) -> dict[int, HomologyGroup_class]: ...
    def betti(
        self, dim: int | None = ..., subcomplex: SimplicialSet_arbitrary | None = ...
    ) -> dict[int, int] | int: ...
    def n_chains(
        self, n: int, base_ring: object = ..., cochains: bool = ...
    ) -> Chains | Cochains: ...
    def quotient(
        self, subcomplex: SimplicialSet_arbitrary, vertex_name: str = ...
    ) -> QuotientOfSimplicialSet: ...
    def disjoint_union(self, *others: SimplicialSet_arbitrary) -> DisjointUnionOfSimplicialSets: ...
    def coproduct(self, *others: SimplicialSet_arbitrary) -> DisjointUnionOfSimplicialSets: ...
    def product(self, *others: SimplicialSet_arbitrary) -> ProductOfSimplicialSets: ...
    cartesian_product: Callable[..., ProductOfSimplicialSets]
    def pushout(self, *maps: SimplicialSetMorphism) -> PushoutOfSimplicialSets: ...
    def pullback(self, *maps: SimplicialSetMorphism) -> PullbackOfSimplicialSets: ...
    def wedge(self, *others: SimplicialSet_arbitrary) -> WedgeOfSimplicialSets: ...
    def cone(self) -> ConeOfSimplicialSet: ...
    def suspension(self, n: int = ...) -> Self: ...
    def join(self, *others: SimplicialSet_arbitrary) -> None: ...
    def reduce(self) -> Self: ...
    def rename_latex(self, s: str) -> None: ...

class SimplicialSet_finite(SimplicialSet_arbitrary):
    def __init__(
        self,
        data: dict[object, object] | SimplicialSet_arbitrary | None,
        base_point: object = ...,
        name: str | None = ...,
        check: bool = ...,
        category: object = ...,
        latex_name: str | None = ...,
    ) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __copy__(self) -> Self: ...
    def face_data(self) -> dict[object, object]: ...
    def n_skeleton(self, n: int) -> SubSimplicialSet: ...
    def f_vector(self) -> list[int]: ...
    def euler_characteristic(self) -> int: ...
    def chain_complex(
        self,
        dimensions: list[int] | None = ...,
        base_ring: object = ...,
        augmented: bool = ...,
        cochain: bool = ...,
        verbose: bool = ...,
        subcomplex: SimplicialSet_arbitrary | None = ...,
        check: bool = ...,
    ) -> ChainComplex_class: ...
    def algebraic_topological_model(
        self, base_ring: object = ...
    ) -> tuple[ChainContraction, ChainComplex_class]: ...

SimplicialSet: type[SimplicialSet_finite]

def standardize_degeneracies(*L: tuple[int, ...]) -> tuple[tuple[int, ...], ...]: ...

def all_degeneracies(n: int, l: int = ...) -> set[tuple[int, ...]]: ...

def standardize_face_maps(*L: tuple[int, ...]) -> tuple[tuple[int, ...], ...]: ...

def face_degeneracies(m: int, I: int) -> tuple[tuple[int, ...], int]: ...

def shrink_simplicial_complex(K: SimplicialComplex) -> SimplicialSet_finite: ...
