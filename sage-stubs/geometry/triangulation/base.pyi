from collections.abc import Iterator

from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject

class Point(SageObject):
    def __hash__(self) -> int: ...
    def point_configuration(self) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...
    def __len__(self) -> int: ...
    def index(self) -> Element: ...
    def projective(self) -> Element: ...
    def affine(self) -> Element: ...
    def reduced_affine(self) -> Element: ...
    def reduced_projective(self) -> Element: ...
    def reduced_affine_vector(self) -> Element: ...
    def reduced_projective_vector(self) -> Element: ...
    def _repr_(self) -> str: ...

class PointConfiguration_base(Parent):
    def __hash__(self) -> int: ...
    def reduced_affine_vector_space(self) -> Element: ...
    def reduced_projective_vector_space(self) -> Element: ...
    def ambient_dim(self) -> Element: ...
    def dim(self) -> int: ...
    def _assert_is_affine(self) -> Element: ...
    def __getitem__(self, i: int) -> Element: ...
    def n_points(self) -> Element: ...
    def points(self) -> Element: ...
    def point(self, i: int) -> Element: ...
    def __len__(self) -> int: ...
    def simplex_to_int(self, simplex: Element | int | str | bool | None) -> Element: ...
    def int_to_simplex(self, s: int) -> Element: ...

class ConnectedTriangulationsIterator(SageObject):
    def __iter__(self) -> Iterator[Element]: ...
