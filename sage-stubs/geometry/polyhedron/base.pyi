from sage.geometry.fan import RationalPolyhedralFan
from sage.geometry.hyperplane_arrangement.arrangement import (
    HyperplaneArrangementElement,
)
from sage.geometry.polyhedron.base7 import Polyhedron_base7
from sage.matrix.matrix import Matrix
from sage.numerical.mip import MixedIntegerLinearProgram
from sage.rings.rational import Rational
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.topology.cubical_complex import CubicalComplex
from sage.topology.simplicial_complex import SimplicialComplex

class Polyhedron_base(Polyhedron_base7):
    def _test_basic_properties(self, tester: object = ...) -> None: ...
    def to_linear_program(
        self,
        return_variable_vector: bool = ...,
        solver: str | None = ...,
        base_ring: Ring | None = ...,
    ) -> MixedIntegerLinearProgram | tuple[MixedIntegerLinearProgram, object]: ...
    def boundary_complex(self) -> SimplicialComplex | CubicalComplex: ...
    def center(self) -> list[Rational]: ...
    def radius_square(self) -> Rational: ...
    def radius(self) -> Rational: ...
    def is_inscribed(self, tolerance: float = ...) -> bool: ...
    def hyperplane_arrangement(self) -> HyperplaneArrangementElement: ...
    def normal_fan(self, **kwargs: object) -> RationalPolyhedralFan: ...
    def face_fan(self, **kwargs: object) -> RationalPolyhedralFan: ...
    def is_minkowski_summand(self, other: Polyhedron_base) -> bool: ...
    def barycentric_subdivision(self) -> SimplicialComplex: ...
    def permutations_to_matrices(self) -> list[Matrix]: ...
    def bounding_box(self) -> tuple[tuple[Rational, ...], tuple[Rational, ...]]: ...
    def _polymake_init_(self) -> str | Element: ...
