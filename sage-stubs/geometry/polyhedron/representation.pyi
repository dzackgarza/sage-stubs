from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.sage_object import SageObject

def repr_pretty(coefficients: Element | int | str | bool | None, type: Element | int | str | bool | None, prefix: Element | int | str | bool | None, indices: Element | int | str | bool | None, latex: Element | int | str | bool | None, style: Element | int | str | bool | None, split: Element | int | str | bool | None) -> Element: ...

class PolyhedronRepresentation(SageObject):
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> Element: ...
    def __hash__(self) -> int: ...
    def _comparison_scalar(self) -> Element: ...
    def vector(self, base_ring: Ring) -> Element: ...
    def polyhedron(self) -> Element: ...
    def index(self) -> Element: ...
    def count(self, i: int) -> int: ...

class Hrepresentation(PolyhedronRepresentation):
    def _set_data(self, polyhedron: Element | int | str | bool | None, data: Element | int | str | bool | None) -> Element: ...
    def is_H(self) -> bool: ...
    def is_inequality(self) -> bool: ...
    def is_equation(self) -> bool: ...
    def A(self) -> Element: ...
    def b(self) -> Element: ...
    def neighbors(self) -> Element: ...
    def adjacent(self) -> Element: ...
    def is_incident(self, Vobj: Element | int | str | bool | None) -> bool: ...
    def eval(self, Vobj: Element | int | str | bool | None) -> Element: ...
    def incident(self) -> Element: ...
    def repr_pretty(self) -> Element: ...
    def _latex_(self) -> str: ...

class Inequality(Hrepresentation):
    def type(self) -> Element: ...
    def is_facet_defining_inequality(self, other: Element) -> bool: ...
    def _repr_(self) -> str: ...
    def contains(self, Vobj: Element | int | str | bool | None) -> bool: ...
    def interior_contains(self, Vobj: Element | int | str | bool | None) -> Element: ...
    def outer_normal(self) -> Element: ...

class Equation(Hrepresentation):
    ...

class Vrepresentation(PolyhedronRepresentation):
    def is_V(self) -> bool: ...
    def is_vertex(self) -> bool: ...
    def is_ray(self) -> bool: ...
    def is_line(self) -> bool: ...

class Vertex(Vrepresentation):
    def homogeneous_vector(self, base_ring: Ring) -> Element: ...
    def evaluated_on(self, Hobj: Element | int | str | bool | None) -> Element: ...
    def is_integral(self) -> bool: ...

class Ray(Vrepresentation):
    ...

class Line(Vrepresentation):
    ...
