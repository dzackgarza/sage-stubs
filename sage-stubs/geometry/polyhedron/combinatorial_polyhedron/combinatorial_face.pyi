from sage.structure.element import Element
from sage.structure.sage_object import SageObject

class CombinatorialFace(SageObject):
    def _repr_(self) -> str: ...
    def __hash__(self) -> int: ...
    def is_subface(self, other: Element) -> bool: ...
    def dimension(self) -> int: ...
    def ambient_dimension(self) -> Element: ...
    def ambient_Vrepresentation(self) -> Element: ...
    def ambient_V_indices(self) -> Element: ...
    def n_ambient_Vrepresentation(self) -> Element: ...
    def ambient_Hrepresentation(self) -> Element: ...
    def ambient_H_indices(self, add_equations: Element | int | str | bool | None) -> Element: ...
    def n_ambient_Hrepresentation(self, add_equations: Element | int | str | bool | None) -> Element: ...
    def as_combinatorial_polyhedron(self, quotient: Element | int | str | bool | None) -> Element: ...
