from sage.structure.element import Element
from sage.structure.sage_object import SageObject

class PivotedInequalities(SageObject):
    def _pivot_inequalities(self, A: Element | int | str | bool | None) -> Element: ...
    def _unpivot_ray(self, ray: Element | int | str | bool | None) -> Element: ...

class Hrep2Vrep(PivotedInequalities):
    def _init_Vrep(self, inequalities: Element | int | str | bool | None, equations: Element | int | str | bool | None) -> Element: ...
    def _split_linear_subspace(self) -> Element: ...
    def _extract_Vrep(self, DD: Element | int | str | bool | None) -> Element: ...
    def _repr_(self) -> str: ...
    def verify(self, inequalities: Element | int | str | bool | None, equations: Element | int | str | bool | None) -> Element: ...

class Vrep2Hrep(PivotedInequalities):
    def _extract_Hrep(self, DD: Element | int | str | bool | None) -> Element: ...
