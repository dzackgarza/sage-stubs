from sage.structure.element import Element

def random_inequalities(d: int, n: int) -> Element: ...

class DoubleDescriptionPair:
    def _make_new(self, A_rows: Element | int | str | bool | None, R_cols: Element | int | str | bool | None) -> Element: ...
    def inner_product_matrix(self) -> Element: ...
    def cone(self) -> Element: ...
    def verify(self) -> Element: ...
    def R_by_sign(self, a: Element) -> Element: ...
    def zero_set(self, ray: Element | int | str | bool | None) -> Element: ...
    def is_extremal(self, ray: Element | int | str | bool | None) -> bool: ...
    def matrix_space(self, nrows: Element | int | str | bool | None, ncols: Element | int | str | bool | None) -> Element: ...
    def are_adjacent(self, r1: Element | int | str | bool | None, r2: Element | int | str | bool | None) -> Element: ...
    def dual(self) -> Element: ...
    def first_coordinate_plane(self) -> Element: ...

class Problem:
    def A(self) -> Element: ...
    def A_matrix(self) -> Element: ...
    def dim(self) -> int: ...
    def initial_pair(self) -> Element: ...

class StandardDoubleDescriptionPair(DoubleDescriptionPair):
    def add_inequality(self, a: Element) -> Element: ...

class StandardAlgorithm(Problem):
    def run(self) -> Element: ...
