    def __init__(
        self,
        parent: builtins.object,
        coefficients: builtins.object,
        constant: builtins.object,
    ) -> None: ...
    def normal(self) -> _SageObject: ...
    def __contains__(self, q: object) -> bool: ...
    def polyhedron(self, **kwds: builtins.object) -> _SageObject: ...
    def linear_part(self) -> _SageObject: ...
    def linear_part_projection(self, point: builtins.object) -> _SageObject: ...
    def point(self) -> _SageObject: ...
    def dimension(self) -> _SageObject: ...
    def intersection(self, other: builtins.object) -> _SageObject: ...
    def orthogonal_projection(self, point: builtins.object) -> _SageObject: ...
    def primitive(self, signed: builtins.bool = ...) -> _SageObject: ...
    def plot(self, **kwds: builtins.object) -> _SageObject: ...
    def __or__(self, other: builtins.object) -> Self: ...
    def to_symmetric_space(self) -> _SageObject: ...

class AmbientVectorSpace:
