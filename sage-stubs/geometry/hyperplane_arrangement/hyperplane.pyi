from sage.rings.ring import Ring
from sage.structure.element import Element

class Hyperplane(LinearExpression):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def normal(self) -> Element: ...
    def _normal_pivot(self) -> Element: ...
    def polyhedron(self) -> Element: ...
    def linear_part(self) -> Element: ...
    def linear_part_projection(self, point: Element | int | str | bool | None) -> Element: ...
    def point(self) -> Element: ...
    def dimension(self) -> int: ...
    def intersection(self, other: Element) -> Element: ...
    def orthogonal_projection(self, point: Element | int | str | bool | None) -> Element: ...
    def primitive(self, signed: Element | int | str | bool | None) -> Element: ...
    def _affine_subspace(self) -> Element: ...
    def plot(self) -> Element: ...
    def to_symmetric_space(self) -> Element: ...

class AmbientVectorSpace(LinearExpressionModule):
    def change_ring(self, base_ring: Ring) -> Element: ...
    def symmetric_space(self) -> Element: ...

class LinearExpression: ...

class LinearExpressionModule: ...
