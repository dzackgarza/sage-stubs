from sage.structure.element import Element
from sage.structure.sage_object import SageObject

class VoronoiDiagram(SageObject):
    def points(self) -> Element: ...
    def ambient_dim(self) -> Element: ...
    def regions(self) -> Element: ...
    def _repr_(self) -> str: ...
    def plot(self, cell_colors: Element | int | str | bool | None) -> Element: ...
    def _are_points_in_regions(self) -> Element: ...
