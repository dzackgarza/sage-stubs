from collections.abc import Iterator, Sequence
from typing import Generic, Self, TypeGuard, TypeVar, overload

from sage.categories.category import Category
from sage.categories.homset import Homset
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent

_DomainElement = TypeVar("_DomainElement", default=Element)
_CodomainElement = TypeVar("_CodomainElement", default=Element)
_IntermediateElement = TypeVar("_IntermediateElement")
_SourceElement = TypeVar("_SourceElement")

def is_Map(x: object) -> TypeGuard[Map]: ...

class Map(Element, Generic[_DomainElement, _CodomainElement]):
    @overload
    def __init__(
        self,
        parent: Homset[Map, _DomainElement, _CodomainElement],
        codomain: None = ...,
    ) -> None: ...
    @overload
    def __init__(
        self,
        parent: Parent[_DomainElement] | type[_DomainElement],
        codomain: Parent[_CodomainElement],
    ) -> None: ...
    def __copy__(self) -> Self: ...
    def parent(self) -> Parent[Map[_DomainElement, _CodomainElement]]: ...
    def domain(self) -> Parent[_DomainElement]: ...
    def codomain(self) -> Parent[_CodomainElement]: ...
    def category(self) -> Category: ...
    def category_for(self) -> Category: ...
    def domains(self) -> Iterator[Parent[Element]]: ...
    def _repr_type(self) -> str: ...
    def _repr_defn(self) -> str: ...
    def _repr_(self) -> str: ...
    def _default_repr_(self) -> str: ...
    def __call__(self, x: _DomainElement) -> _CodomainElement: ...
    def _call_(self, x: _DomainElement) -> _CodomainElement: ...
    def __mul__(
        self,
        right: Map[_SourceElement, _DomainElement],
    ) -> Map[_SourceElement, _CodomainElement]: ...
    def _composition(
        self,
        right: Map[_SourceElement, _DomainElement],
    ) -> Map[_SourceElement, _CodomainElement]: ...
    def _composition_(
        self,
        right: Map[_SourceElement, _DomainElement],
        homset: Homset[Map, _SourceElement, _CodomainElement],
    ) -> Map[_SourceElement, _CodomainElement]: ...
    def pre_compose(
        self,
        right: Map[_SourceElement, _DomainElement],
    ) -> Map[_SourceElement, _CodomainElement]: ...
    def post_compose(
        self,
        left: Map[_CodomainElement, _IntermediateElement],
    ) -> Map[_DomainElement, _IntermediateElement]: ...
    def extend_domain(
        self,
        new_domain: Parent[_SourceElement],
    ) -> Map[_SourceElement, _CodomainElement]: ...
    def extend_codomain(
        self,
        new_codomain: Parent[_IntermediateElement],
    ) -> Map[_DomainElement, _IntermediateElement]: ...
    def is_surjective(self) -> bool: ...
    def section(self) -> Map[_CodomainElement, _DomainElement] | None: ...
    def __hash__(self) -> int: ...

class Section(Map[_CodomainElement, _DomainElement]):
    def __init__(self, map: Map[_DomainElement, _CodomainElement]) -> None: ...
    def _repr_type(self) -> str: ...
    def inverse(self) -> Map[_DomainElement, _CodomainElement]: ...

class FormalCompositeMap(Map[_DomainElement, _CodomainElement]):
    @overload
    def __init__(
        self,
        parent: Homset[Map, _DomainElement, _CodomainElement],
        first: Map[_DomainElement, _IntermediateElement],
        second: Map[_IntermediateElement, _CodomainElement],
    ) -> None: ...
    @overload
    def __init__(
        self,
        parent: Homset[Map, _DomainElement, _CodomainElement],
        first: Sequence[Map],
        second: None = ...,
    ) -> None: ...
    def __copy__(self) -> Self: ...
    def __getitem__(self, i: int | Integer) -> Map: ...
    def first(self) -> Map: ...
    def then(self) -> Map: ...
    def is_injective(self) -> bool: ...
    def is_surjective(self) -> bool: ...
    def section(self) -> Map[_CodomainElement, _DomainElement] | None: ...
