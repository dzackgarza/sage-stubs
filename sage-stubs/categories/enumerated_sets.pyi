type EnumeratedElementInput = Element | SageCoercionAtom | Sequence[SageCoercionAtom]

_E = TypeVar("_E")

class EnumeratedSets(CategoryWithAxiom):
    class ElementMethods:
        ...
    class ParentMethods(Sets.ParentMethods[_E], Generic[_E]):
        def __iter__(self) -> Iterator[_E]: ...
        def __len__(self) -> int: ...
        def __getitem__(self, i: int | Integer | slice) -> _E | list[_E]: ...
        def _an_element_(self) -> _E: ...
        def is_empty(self) -> bool: ...
        def iterator_range(self, start: int | Integer | None = None, stop: int | Integer | None = None, step: int | Integer | None = None) -> Iterator[_E]: ...
        def unrank_range(self, start: int | Integer | None = None, stop: int | Integer | None = None, step: int | Integer | None = None) -> list[_E]: ...
        def first(self) -> _E: ...
        def next(self, element: _E) -> _E | None: ...
        def unrank(self, rank: int | Integer) -> _E: ...
        def random_element(self) -> _E: ...
        def rank(self, x: _E) -> int | Integer | None: ...
        def list(self) -> list[_E]: ...
        def cardinality(self) -> Integer | PlusInfinity: ...
        def map(self, f: Callable[[_E], _E], name: str | None = None, *, is_injective: bool = True) -> Parent[_E]: ...
    class CartesianProducts:
        class ParentMethods:
            def first(self) -> tuple[Element, ...]: ...
