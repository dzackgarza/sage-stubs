    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...
    def commutes(self, other: ConstructionFunctor) -> bool: ...

class QuotientFunctor(ConstructionFunctor):
    def __init__(self, I: Ideal_generic, names: str | tuple[str, ...] = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...

