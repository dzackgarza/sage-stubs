class PermutationGroupFunctor(ConstructionFunctor):
    def __init__(self, gens: tuple[Element, ...], domain: Parent = ...) -> None: ...
    def __call__(self, R: Parent | Morphism) -> Parent: ...
    def gens(self) -> tuple[Element, ...]: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...

class EquivariantSubobjectConstructionFunctor(ConstructionFunctor):
    def __init__(self, group: Parent, semi: bool) -> None: ...

class BlackBoxConstructionFunctor(ConstructionFunctor):
    def __init__(self, func: Callable[..., Parent]) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

def pushout(R: Parent, S: Parent) -> Parent: ...
def pushout_lattice(R: Parent, S: Parent) -> tuple[Morphism, Morphism]: ...
def construction_tower(R: Parent) -> list[tuple[ConstructionFunctor | None, Parent]]: ...
def expand_tower(tower: list[tuple[ConstructionFunctor | None, Parent]]) -> list[tuple[ConstructionFunctor | None, Parent]]: ...
def type_to_parent(P: type) -> Parent: ...
