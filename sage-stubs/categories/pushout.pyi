from collections.abc import Callable
from typing import Self

from sage.categories.functor import Functor
from sage.categories.morphism import Morphism
from sage.matrix.matrix0 import Matrix
from sage.rings.ideal import Ideal_generic
from sage.rings.integer import Integer
from sage.rings.morphism import RingHomomorphism
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.rings.polynomial.term_order import TermOrder
from sage.structure.element import Element
from sage.structure.factory import FactoryArgument
from sage.structure.parent import Parent

class ConstructionFunctor(Functor):
    def __mul__(self, other: ConstructionFunctor) -> ConstructionFunctor: ...
    def pushout(self, other: ConstructionFunctor) -> ConstructionFunctor: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...
    def commutes(self, other: ConstructionFunctor) -> bool: ...
    def expand(self) -> list[ConstructionFunctor]: ...
    def common_base(self, other_functor: ConstructionFunctor, self_bases: Parent, other_bases: Parent) -> Parent: ...

class CompositeConstructionFunctor(ConstructionFunctor):
    def __init__(self, *args: FactoryArgument) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __mul__(self, other: ConstructionFunctor) -> ConstructionFunctor: ...
    def expand(self) -> list[ConstructionFunctor]: ...

class IdentityConstructionFunctor(ConstructionFunctor):
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __mul__(self, other: ConstructionFunctor) -> ConstructionFunctor: ...

class MultivariateConstructionFunctor(ConstructionFunctor):
    def common_base(self, other_functor: ConstructionFunctor, self_bases: Parent, other_bases: Parent) -> Parent: ...

class PolynomialFunctor(ConstructionFunctor):
    def __init__(self, var: str, multi_variate: bool = ..., sparse: bool = ..., implementation: str = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...

class MultiPolynomialFunctor(ConstructionFunctor):
    def __init__(self, vars: str | tuple[str, ...], term_order: TermOrder) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __mul__(self, other: ConstructionFunctor) -> ConstructionFunctor: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...
    def expand(self) -> list[ConstructionFunctor]: ...

class InfinitePolynomialFunctor(ConstructionFunctor):
    def __init__(self, gens: tuple[str, ...], order: TermOrder) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __mul__(self, other: ConstructionFunctor) -> ConstructionFunctor: ...
    def merge(self, other: ConstructionFunctor) -> Self | None: ...
    def expand(self) -> list[ConstructionFunctor]: ...

class MatrixFunctor(ConstructionFunctor):
    def __init__(self, nrows: int, ncols: int, sparse: bool = ...) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
