from collections.abc import Hashable, Iterable, Sequence
from typing import Self, overload

from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation

type _CategoryArgument = (
    Category | SageObject | bool | int | str | type | tuple[str, ...] | None
)

class Category(UniqueRepresentation, SageObject):
    parent_class: type
    Constructors: type

    def __init__(self) -> None: ...
    @staticmethod
    @overload
    def join(categories: Iterable[Category]) -> Category: ...
    @staticmethod
    @overload
    def join(
        categories: Iterable[Category], as_list: bool
    ) -> Category | list[Category]: ...
    @staticmethod
    def join(
        categories: Iterable[Category],
        as_list: bool = ...,
        ignore_axioms: tuple[str, ...] = ...,
        axioms: tuple[str, ...] = ...,
    ) -> Category | list[Category]: ...
    @staticmethod
    def meet(categories: Iterable[Category]) -> Category: ...
    @staticmethod
    def __classcall__(
        cls: type[Category],
        *args: _CategoryArgument,
        **options: _CategoryArgument,
    ) -> Category: ...
    @classmethod
    def _set_classcall(cls, value: type[Category]) -> None: ...
    def __call__(
        self,
        x: object,
        *args: object,
        **options: object,
    ) -> SageObject: ...
    def _call_(self, x: object, *args: object, **options: object) -> SageObject: ...
    def super_categories(self) -> list[Category]: ...
    def extra_super_categories(self) -> Sequence[Category]: ...
    def is_subcategory(self, other: Category) -> bool: ...
    def Hom(self, codomain: Category) -> Category: ...
    def HomCategory(self) -> Category: ...
    def EndCategory(self) -> Category: ...
    def AutCategory(self) -> Category: ...
    def base_category(self) -> Category: ...
    def additional_structure(self) -> Category | None: ...
    def Of(
        self, *args: _CategoryArgument, **options: _CategoryArgument
    ) -> Category: ...
    def _with_axiom(self, axiom: str) -> Category: ...
    def Finite(self) -> Category: ...
    def Infinite(self) -> Category: ...
    def Facade(self) -> Category: ...
    def Homsets(self) -> Category: ...
    def _make_named_class(
        self,
        name: str,
        method_provider: type,
        cache: bool = ...,
        picklable: bool = ...,
    ) -> type: ...
    def _repr_object_names(self) -> str: ...
    def _label(self) -> str: ...
    def _short_name(self) -> str: ...
    @classmethod
    def an_instance(cls) -> Self: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def is_abelian(self) -> bool: ...
    def all_super_categories(self, proper: bool = ...) -> list[Category]: ...
    def structure(self) -> frozenset[Category]: ...
    def is_full_subcategory(self, other: Category) -> bool: ...
    def full_super_categories(self) -> list[Category]: ...
    def required_methods(self) -> dict[str, dict[str, list[str]]]: ...
    def or_subcategory(
        self,
        category: Category | tuple[Category, ...] | list[Category] | None = ...,
        join: bool = ...,
    ) -> Category: ...
    def axioms(self) -> frozenset[str]: ...
    def _with_axiom_as_tuple(self, axiom: str) -> tuple[Category, ...]: ...
    def _with_axioms(self, axioms: Iterable[str]) -> Category: ...
    def _without_axiom(self, axiom: str) -> Category: ...
    def _without_axioms(self, named: bool = ...) -> Category: ...
    def category(self) -> Category: ...
    def __contains__(self, x: object) -> bool: ...
    def __and__(self, other: Category) -> Category: ...
    def __or__(self, other: Category) -> Category: ...

class CategoryWithParameters(Category):
    def _make_named_class_key(self, name: str) -> Hashable: ...

class JoinCategory(CategoryWithParameters):
    def __init__(self, super_categories: Iterable[Category]) -> None: ...
    def super_categories(self) -> list[Category]: ...
    def additional_structure(self) -> None: ...
    def is_subcategory(self, other: Category) -> bool: ...
    def _with_axiom(self, axiom: str) -> Category: ...
    def _without_axiom(self, axiom: str) -> Category: ...
    def _without_axioms(self, named: bool = ...) -> Category: ...
    def _repr_object_names(self) -> str: ...
    def _repr_(self, as_join: bool = ...) -> str: ...

def category_sample() -> tuple[Category, ...]: ...
