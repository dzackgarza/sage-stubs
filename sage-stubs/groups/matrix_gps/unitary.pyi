from sage.groups.matrix_gps.linear import LinearMatrixGroup_generic
from sage.matrix.matrix import Matrix
from sage.rings.integer import Integer
from sage.rings.ring import Ring

def finite_field_sqrt(self) -> Integer: ...
def _UG(
    self,
    R: Ring | int,
    special: bool,
    var: str = ...,
    invariant_form: Matrix | None = ...,
) -> UnitaryMatrixGroup_generic: ...
def GU(
    self, R: Ring | int, var: str = ..., invariant_form: Matrix | None = ...
) -> UnitaryMatrixGroup_generic: ...
def SU(
    self, R: Ring | int, var: str = ..., invariant_form: Matrix | None = ...
) -> UnitaryMatrixGroup_generic: ...

class UnitaryMatrixGroup_generic(LinearMatrixGroup_generic):
    def invariant_form(self) -> Matrix: ...
    def _check_matrix(self, x: Matrix, *args: object) -> None: ...
    def degree(self) -> int: ...
    def base_ring(self) -> Ring: ...
