from enum import Enum

from sage.structure.sage_object import SageObject
from sage.structure.unique_representation import UniqueRepresentation


type KnotInfoColumnDefinition = tuple[str, KnotInfoColumnTypes] | list[str | KnotInfoColumnTypes]
type KnotInfoColumnDictionary = dict[str, KnotInfoColumnDefinition]
type KnotInfoRowDictionary = dict[str, list[int]]

columns_white_list: list[str]
columns_black_list: list[str]


class KnotInfoColumnTypes(Enum):
    OnlyKnots: KnotInfoColumnTypes
    OnlyLinks: KnotInfoColumnTypes
    KnotsAndLinks: KnotInfoColumnTypes
    value: str


class KnotInfoColumns(Enum):
    value: tuple[str, KnotInfoColumnTypes]

    @property
    def types(self) -> type[KnotInfoColumnTypes]: ...
    def column_name(self) -> str: ...
    def column_type(self) -> KnotInfoColumnTypes: ...
    def description_webpage(
        self,
        new: int = ...,
        autoraise: bool = ...,
    ) -> bool: ...


class KnotInfoFilename(Enum):
    knots: KnotInfoFilename
    links: KnotInfoFilename
    value: list[str]

    def url(self) -> str: ...
    def excel(self) -> str: ...
    def csv(self) -> str: ...
    def num_knots(self, version: str) -> str: ...
    def sobj_row(self) -> str: ...
    def sobj_column(self) -> str: ...
    def sobj_data(self, column: KnotInfoColumns) -> str: ...
    def description_url(self, column: KnotInfoColumns) -> str: ...
    def diagram_url(self, fname: str, single: bool = ...) -> str: ...


class KnotInfoDataBase(SageObject, UniqueRepresentation):
    filename: type[KnotInfoFilename]

    def __init__(self, install: bool = ...) -> None: ...
    def create_filecache(self, force: bool = ...) -> None: ...
    def version(self) -> str: ...
    def demo_version(self) -> bool: ...
    def knot_list(self) -> list[str]: ...
    def link_list(self) -> list[str]: ...
    def columns(self) -> type[KnotInfoColumns]: ...
    def read_column_dict(self) -> KnotInfoColumnDictionary: ...
    def read_row_dict(self) -> KnotInfoRowDictionary: ...
    def row_names(self) -> dict[str, str]: ...
    def read_num_knots(self) -> int: ...
    def read(self, column: KnotInfoColumns) -> list[str]: ...


column_demo_sample: KnotInfoColumnDictionary
row_demo_sample: KnotInfoRowDictionary
db: KnotInfoDataBase
dc: type[KnotInfoColumns]
data_demo_sample: dict[KnotInfoColumns, list[str]]
