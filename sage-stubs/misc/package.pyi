from typing import NamedTuple

class PackageInfo(NamedTuple):
    name: str
    type: str | None
    source: str | None
    installed_version: str | None
    remote_version: str | None

    def is_installed(self) -> bool: ...

def pkgname_split(self) -> tuple[str, str]: ...
def pip_remote_version(
    self, pypi_url: str = ..., ignore_URLError: bool = ...
) -> str | None: ...
def spkg_type(self) -> str | None: ...
def pip_installed_packages(self=...) -> dict[str, str]: ...
def list_packages(
    self,
    *pkg_types: str,
    pkg_sources: list[str] = ...,
    local: bool = ...,
    ignore_URLError: bool = ...,
    exclude_pip: bool = ...,
) -> dict[str, PackageInfo]: ...
def installed_packages(self=...) -> dict[str, str]: ...
def is_package_installed(self, exclude_pip: bool = ...) -> bool: ...
def is_package_installed_and_updated(self) -> bool: ...
def package_versions(self, local: bool = ...) -> dict[str, tuple[str, str]]: ...
def package_manifest(self) -> dict[str, object]: ...
