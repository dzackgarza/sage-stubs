from collections.abc import Callable, Hashable
from typing import Concatenate, Self, overload

def dict_key[T](o: T) -> Hashable: ...
def cache_key[T](o: T) -> Hashable: ...

class CachedFunction[**P, R]:
    def __init__(
        self,
        f: Callable[P, R],
        classmethod: bool = False,
        name: str | None = None,
        key: Callable[..., Hashable] | None = None,
        do_pickle: bool | None = None,
    ) -> None: ...
    def __call__(self, *args: P.args, **kwds: P.kwargs) -> R: ...
    def cached(self, *args: P.args, **kwds: P.kwargs) -> R: ...
    def is_in_cache(self, *args: P.args, **kwds: P.kwargs) -> bool: ...
    def set_cache(self, value: R, *args: P.args, **kwds: P.kwargs) -> None: ...
    def get_key(self, *args: P.args, **kwds: P.kwargs) -> Hashable: ...
    def clear_cache(self) -> None: ...

class CachedMethod[Owner, **P, R]:
    def __init__(
        self,
        f: Callable[Concatenate[Owner, P], R],
        name: str | None = None,
        key: Callable[..., Hashable] | None = None,
        do_pickle: bool | None = None,
    ) -> None: ...
    def __call__(self, inst: Owner, *args: P.args, **kwds: P.kwargs) -> R: ...
    @overload
    def __get__(self, inst: None, cls: type[Owner] | None = None) -> Self: ...
    @overload
    def __get__(self, inst: Owner, cls: type[Owner] | None = None) -> CachedMethodCaller[P, R]: ...

class CacheDict[R](dict[Hashable, R]): ...

class CachedInParentMethod[Owner, **P, R](CachedMethod[Owner, P, R]): ...

class CachedMethodCaller[**P, R]:
    def __call__(self, *args: P.args, **kwds: P.kwargs) -> R: ...
    def clear_cache(self) -> None: ...
    def is_in_cache(self, *args: P.args, **kwds: P.kwargs) -> bool: ...
    def set_cache(self, value: R, *args: P.args, **kwds: P.kwargs) -> None: ...
    def get_key(self, *args: P.args, **kwds: P.kwargs) -> Hashable: ...

class CachedMethodCallerNoArgs[R](CachedMethodCaller[[], R]):
    def __call__(self) -> R: ...
    def set_cache(self, value: R) -> None: ...
    def clear_cache(self) -> None: ...
    def is_in_cache(self) -> bool: ...

class GloballyCachedMethodCaller[**P, R](CachedMethodCaller[P, R]):
    def get_key_args_kwds(
        self,
        args: tuple[Hashable, ...],
        kwds: dict[str, Hashable],
    ) -> Hashable: ...

@overload
def cached_method[Owner, **P, R](func: Callable[Concatenate[Owner, P], R]) -> CachedMethod[Owner, P, R]: ...
@overload
def cached_method[Owner, **P, R](
    *,
    name: str | None = None,
    key: Callable[..., Hashable] | None = None,
    do_pickle: bool | None = None,
) -> Callable[[Callable[Concatenate[Owner, P], R]], CachedMethod[Owner, P, R]]: ...
@overload
def cached_function[**P, R](func: Callable[P, R]) -> CachedFunction[P, R]: ...
@overload
def cached_function[**P, R](
    *,
    classmethod: bool = False,
    name: str | None = None,
    key: Callable[..., Hashable] | None = None,
    do_pickle: bool | None = None,
) -> Callable[[Callable[P, R]], CachedFunction[P, R]]: ...
def weak_cached_function[**P, R](
    f: Callable[P, R],
    name: str | None = None,
    key: Callable[..., Hashable] | None = None,
) -> CachedFunction[P, R]: ...
