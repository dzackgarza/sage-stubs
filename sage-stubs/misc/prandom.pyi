import random as _random
from typing import TypeVar

_T = TypeVar("_T")

def _pyrand(self) -> _random.Random: ...
def getrandbits(self) -> int: ...
def randrange(self, stop: int | None = ..., step: int = ...) -> int: ...
def randint(self, b: int) -> int: ...
def choice(self) -> _T: ...
def shuffle(self) -> None: ...
def sample(self, k: int) -> list[_T]: ...
def random(self) -> float: ...
def uniform(self, b: float) -> float: ...
def betavariate(self, beta: float) -> float: ...
def expovariate(self) -> float: ...
def gammavariate(self, beta: float) -> float: ...
def gauss(self, sigma: float) -> float: ...
def lognormvariate(self, sigma: float) -> float: ...
def normalvariate(self, sigma: float) -> float: ...
def vonmisesvariate(self, kappa: float) -> float: ...
def paretovariate(self) -> float: ...
def weibullvariate(self, beta: float) -> float: ...
