
from sage.structure.sage_object import SageObject

def list_function(self) -> str: ...
def tuple_function(self, combine_all: bool = False) -> str: ...
def bool_function(self) -> str: ...
def builtin_constant_function(self) -> str: ...
def None_function(self) -> str: ...
def str_function(self) -> str: ...
def dict_function(self) -> str: ...
def float_function(self) -> str: ...

class LatexExpr(str):
    def __new__(cls, s: str) -> LatexExpr: ...
    def _repr_mimebundle_(self, **kwargs: object) -> dict[str, str]: ...

def has_latex_attr(self) -> bool: ...
def default_engine(self) -> str: ...

class _Latex_prefs_object(SageObject):
    def __init__(self) -> None: ...
    def _reset(self) -> None: ...

def latex_extra_preamble(self) -> str: ...

class LatexCall:
    def __init__(self, *args: object) -> None: ...
    def __call__(self, x: object) -> str: ...
    def eval(self, x: object, mode: str = "display", **kwds: object) -> str: ...

class Latex(LatexCall):
    def __init__(self, *args: object) -> None: ...
    def __call__(self, x: object) -> str: ...

class LatexExamples:
    def __init__(self, x: object) -> None: ...
