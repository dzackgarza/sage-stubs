from collections.abc import Callable, Iterable, Iterator

def mrange_iter(self, typ: Callable[[list[object]], object] = ...) -> list[object]: ...
def mrange(self, typ: Callable[[list[int]], object] = ...) -> list[object]: ...
def cartesian_product_iterator(self) -> Iterator[tuple[object, ...]]: ...
def cantor_product(
    self, *args: Iterable[object], **kwds: object
) -> Iterator[tuple[object, ...]]: ...

class xmrange_iter:
    iter_list: list[object]
    typ: Callable[[list[object]], object]

    def __init__(
        self,
        iter_list: list[Iterable[object]],
        typ: Callable[[list[object]], object] = ...,
    ) -> None: ...
    def __iter__(self) -> Iterator[object]: ...
    def __len__(self) -> int: ...
    def cardinality(self) -> int | None: ...

class xmrange:
    sizes: list[int]
    typ: Callable[[list[int]], object]

    def __init__(
        self, sizes: list[int], typ: Callable[[list[int]], object] = ...
    ) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[object]: ...
