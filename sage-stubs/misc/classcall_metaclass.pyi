from typing import TypeVar

from sage.misc.nested_class import NestedClassMetaclass
from sage.structure.sage_object import SageObject

_T = TypeVar("_T", bound=type)

class ClasscallMetaclass(NestedClassMetaclass):
    def __cinit__(self, *args: object, **opts: object) -> None: ...
    def _set_classcall(cls, function: object) -> None: ...
    def __call__(cls, *args: object, **kwds: object) -> SageObject: ...
    def __get__(
        cls, instance: object | None, owner: type[SageObject]
    ) -> type[SageObject]: ...
    def __contains__(cls, x: object) -> bool: ...

def typecall(cls, *args: object, **kwds: object) -> type[SageObject]: ...
def timeCall(T: type[SageObject], n: int, *args: object) -> None: ...
