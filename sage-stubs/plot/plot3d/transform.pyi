from sage.structure.element import Element

class Transformation:
    def get_matrix(self) -> Element: ...
    def is_skew(self, eps: Element | int | str | bool | None) -> bool: ...
    def is_uniform(self, eps: Element | int | str | bool | None) -> bool: ...
    def is_uniform_on(self, basis: Element | int | str | bool | None, eps: Element | int | str | bool | None) -> bool: ...
    def transform_point(self, x: Element) -> Element: ...
    def transform_vector(self, v: Element) -> Element: ...
    def transform_bounding_box(self, box: Element | int | str | bool | None) -> Element: ...
    def max_scale(self) -> Element: ...
    def avg_scale(self) -> Element: ...
    def rotate_arbitrary(self, v: Element, theta: Element | int | str | bool | None) -> Element: ...
