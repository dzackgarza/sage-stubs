from sage.algebras.clifford_algebra_element import CliffordAlgebraElement
from sage.data_structures.bitset import FrozenBitset
from sage.rings.integer import Integer
from sage.structure.element import Element

class GBElement:
    def __init__(self, x: CliffordAlgebraElement, ls: FrozenBitset, n: Integer) -> None: ...
    def __hash__(self) -> int: ...
    def __richcmp__(self, other: GBElement, op: int) -> bool: ...

class GroebnerStrategy:
    def __init__(self, I: Element) -> None: ...
    def compute_groebner(self, reduced: bool = True) -> None: ...
    def reduce_computed_gb(self) -> None: ...
    def reduce(self, f: CliffordAlgebraElement) -> CliffordAlgebraElement: ...
    def sorted_monomials(self, as_dict: bool = False) -> list[FrozenBitset] | dict[Integer, FrozenBitset]: ...
    def monomial_to_int(self) -> dict[FrozenBitset, Integer]: ...

class GroebnerStrategyNegLex(GroebnerStrategy):
    ...

class GroebnerStrategyDegRevLex(GroebnerStrategy):
    ...

class GroebnerStrategyDegLex(GroebnerStrategy):
    ...
