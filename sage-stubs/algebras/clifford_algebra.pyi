from collections.abc import Iterator
from typing import overload
from sage.categories.poor_man_map import PoorManMap

from sage.rings.integer import Integer
from sage.rings.ring import Ring, CommutativeRing
from sage.structure.element import Element, ModuleElement, Matrix
from sage.structure.parent import Parent
from sage.structure.unique_representation import UniqueRepresentation
from sage.sets.family import Family
from sage.algebras.clifford_algebra_element import CliffordAlgebraElement, ExteriorAlgebraElement
from sage.modules.free_module_element import FreeModuleElement
from sage.modules.module import Module
from sage.combinat.free_module import CombinatorialFreeModule
from sage.rings.ideal import Ideal_nc
from sage.modules.with_basis.morphism import ModuleMorphismByLinearity
from sage.modules.free_module import FreeModule_generic
from sage.data_structures.bitset import FrozenBitset
from sage.typeset.ascii_art import AsciiArt
from sage.typeset.unicode_art import UnicodeArt
from sage.quadratic_forms.quadratic_form import QuadraticForm
from sage.homology.chain_complex import ChainComplex
from typing_extensions import Self

class CliffordAlgebraIndices(UniqueRepresentation, Parent):
    def __init__(self, Qdim: int, degree: int | None = None) -> None: ...
    def _element_constructor_(self, x: object) -> FrozenBitset: ...
    def __call__(self, el: object) -> FrozenBitset: ...
    def cardinality(self) -> Integer: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def __iter__(self) -> Iterator[FrozenBitset]: ...
    def __contains__(self, elt: object) -> bool: ...
    def _an_element_(self) -> FrozenBitset: ...

class CliffordAlgebra(CombinatorialFreeModule):
    def __init__(self, Q: object, names: str | tuple[str, ...] | None, category: object = None) -> None: ...
    def _repr_(self) -> str: ...
    def _repr_term(self, m: FrozenBitset) -> str: ...
    def _latex_term(self, m: FrozenBitset) -> str: ...
    def _coerce_map_from_(self, V: Parent) -> bool | None: ...
    def _element_constructor_(self, x: object) -> CliffordAlgebraElement: ...
    def _basis_index_function(self, x: object) -> FrozenBitset: ...
    def gen(self, i: int) -> CliffordAlgebraElement: ...
    def algebra_generators(self) -> Family: ...
    def gens(self) -> tuple[CliffordAlgebraElement, ...]: ...
    def ngens(self) -> int: ...
    def one_basis(self) -> FrozenBitset: ...
    def quadratic_form(self) -> QuadraticForm: ...
    def degree_on_basis(self, m: FrozenBitset) -> int: ...
    def graded_algebra(self) -> CombinatorialFreeModule: ...
    def free_module(self) -> FreeModule_generic: ...
    def dimension(self) -> int: ...
    def pseudoscalar(self) -> CliffordAlgebraElement: ...
    def lift_module_morphism(self, m: ModuleMorphismByLinearity, names: str | tuple[str, ...] | None = None) -> ModuleMorphismByLinearity: ...
    def lift_isometry(self, m: ModuleMorphismByLinearity, names: str | tuple[str, ...] | None = None) -> ModuleMorphismByLinearity: ...
    def center_basis(self) -> tuple[CliffordAlgebraElement, ...]: ...
    def supercenter_basis(self) -> tuple[CliffordAlgebraElement, ...]: ...

class ExteriorAlgebra(CliffordAlgebra):
    def __init__(self, R: CommutativeRing | Module, names: str | tuple[str, ...]) -> None: ...
    def _repr_(self) -> str: ...
    def _repr_term(self, m: FrozenBitset) -> str: ...
    def _ascii_art_term(self, m: FrozenBitset) -> AsciiArt: ...
    def _unicode_art_term(self, m: FrozenBitset) -> UnicodeArt: ...
    def _latex_term(self, m: FrozenBitset) -> str: ...
    def lift_morphism(self, phi: ModuleMorphismByLinearity, names: str | tuple[str, ...] | None = None) -> ModuleMorphismByLinearity: ...
    def volume_form(self) -> ExteriorAlgebraElement: ...
    def boundary(self, s_coeff: dict[tuple[int, int], Element] | list[list[Element]]) -> ExteriorAlgebraBoundary: ...
    def coboundary(self, s_coeff: dict[tuple[int, int], Element] | list[list[Element]]) -> ExteriorAlgebraCoboundary: ...
    def degree_on_basis(self, m: FrozenBitset) -> int: ...
    def coproduct_on_basis(self, a: FrozenBitset) -> ExteriorAlgebraElement: ...
    def antipode_on_basis(self, m: FrozenBitset) -> ExteriorAlgebraElement: ...
    def counit(self, x: ExteriorAlgebraElement) -> Element: ...
    def interior_product_on_basis(self, a: FrozenBitset, b: FrozenBitset) -> ExteriorAlgebraElement: ...
    def lifted_bilinear_form(self, M: Matrix) -> PoorManMap: ...
    def _ideal_class_(self, n: int = 0) -> type: ...
    Element = ExteriorAlgebraElement

class ExteriorAlgebraDifferential(ModuleMorphismByLinearity, UniqueRepresentation):
    def __init__(self, E: ExteriorAlgebra, s_coeff: dict[tuple[int, int], Element] | list[list[Element]]) -> None: ...
    def homology(self, deg: int | None = None, **kwds: object) -> Module: ...

class ExteriorAlgebraBoundary(ExteriorAlgebraDifferential):
    def __init__(self, E: ExteriorAlgebra, s_coeff: dict[tuple[int, int], Element] | list[list[Element]]) -> None: ...
    def _repr_type(self) -> str: ...
    def _on_basis(self, m: FrozenBitset) -> ExteriorAlgebraElement: ...
    def chain_complex(self, R: CommutativeRing | None = None) -> ChainComplex: ...

class ExteriorAlgebraCoboundary(ExteriorAlgebraDifferential):
    def __init__(self, E: ExteriorAlgebra, s_coeff: dict[tuple[int, int], Element] | list[list[Element]]) -> None: ...
    def _repr_type(self) -> str: ...
    def _on_basis(self, m: FrozenBitset) -> ExteriorAlgebraElement: ...
    def chain_complex(self, R: CommutativeRing | None = None) -> ChainComplex: ...

class ExteriorAlgebraIdeal(Ideal_nc):
    def __init__(self, ring: ExteriorAlgebra, gens: list[ExteriorAlgebraElement] | tuple[ExteriorAlgebraElement, ...], coerce: bool = True, side: str = 'twosided') -> None: ...
    def reduce(self, f: ExteriorAlgebraElement) -> ExteriorAlgebraElement: ...
    def _contains_(self, f: object) -> bool: ...
    def __richcmp__(self, other: object, op: int) -> bool: ...
    def __mul__(self, other: object) -> ExteriorAlgebraIdeal: ...
    def groebner_basis(self, term_order: str | None = None, reduced: bool = True) -> tuple[ExteriorAlgebraElement, ...]: ...
