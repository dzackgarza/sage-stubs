from typing import Self

from sage.structure.element import Element

class FreeAlgebraQuotientElement(AlgebraElement):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def vector(self) -> Element: ...
    def _richcmp_(self, other: Element, op: Element | int | str | bool | None) -> Element: ...
    def _add_(self, y: Element) -> Self: ...
    def _sub_(self, y: Element) -> Self: ...
    def _mul_(self, y: Element) -> Self: ...
    def _rmul_(self, c: Element) -> Element: ...
    def _lmul_(self, c: Element) -> Element: ...

class AlgebraElement: ...
