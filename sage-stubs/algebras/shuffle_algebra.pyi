from sage.rings.ring import Ring
from sage.structure.element import Element

class ShuffleAlgebra(CombinatorialFreeModule):
    def variable_names(self) -> str: ...
    def _repr_term(self, t: Element | int | str | bool | None) -> str: ...
    def _repr_(self) -> str: ...
    def one_basis(self) -> Element: ...
    def product_on_basis(self, w1: Element | int | str | bool | None, w2: Element | int | str | bool | None) -> Element: ...
    def antipode_on_basis(self, w: Element) -> Element: ...
    def gen(self, i: int) -> Element: ...
    def some_elements(self) -> list[Element]: ...
    def coproduct_on_basis(self, w: Element) -> Element: ...
    def counit(self, S: Element | int | str | bool | None) -> Element: ...
    def degree_on_basis(self, w: Element) -> int: ...
    def algebra_generators(self) -> Element: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _coerce_map_from_(self, R: Ring) -> Element: ...
    def dual_pbw_basis(self) -> Element: ...
    def to_dual_pbw_element(self, w: Element) -> Element: ...

class DualPBWBasis(CombinatorialFreeModule):
    def shuffle_algebra(self) -> Element: ...
    def product(self, u: Element | int | str | bool | None, v: Element) -> Element: ...
    def antipode(self, elt: Element) -> Element: ...
    def coproduct(self, elt: Element) -> Element: ...
    def expansion(self) -> Element: ...
    def expansion_on_basis(self, w: Element) -> Element: ...

class CombinatorialFreeModule: ...
