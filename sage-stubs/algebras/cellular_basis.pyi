from typing import Self

from sage.structure.element import Element

class CellularBasis(CombinatorialFreeModule):
    def _repr_(self) -> str: ...
    def _latex_term(self, x: Element) -> str: ...
    def cellular_basis_of(self) -> Element: ...
    def cell_poset(self) -> Element: ...
    def cell_module_indices(self, la: Element | int | str | bool | None) -> Element: ...
    def cellular_basis(self) -> Self: ...
    def one(self) -> Element: ...
    def product_on_basis(self, x: Element, y: Element) -> Element: ...

class CombinatorialFreeModule: ...
