import builtins
from typing import Self

from sage.structure.element import Element

class _SageObject: ...

class QuantumOscillatorAlgebra:
    @staticmethod
    def __classcall_private__(
        cls: builtins.object, q: builtins.int = ..., R: builtins.int = ...
    ) -> _SageObject: ...
    def __init__(self, q: builtins.int, R: builtins.int) -> None: ...
    def q(self) -> _SageObject: ...
    def algebra_generators(self) -> _SageObject: ...
    def gens(self) -> tuple[Element, ...]: ...
    def one_basis(self) -> tuple[Element, ...]: ...
    def some_elements(self) -> tuple[Element, ...]: ...
    def fock_space_representation(self) -> _SageObject: ...
    def product_on_basis(
        self, ml: builtins.object, mr: builtins.object
    ) -> _SageObject: ...

    class Element:
        def __invert__(self) -> Self: ...

class FockSpaceRepresentation:
    def __init__(self, oscillator_algebra: builtins.object) -> None: ...
    def vacuum(self) -> _SageObject: ...
    def some_elements(self) -> _SageObject: ...

    class Element: ...
