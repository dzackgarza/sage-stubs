import builtins
from collections.abc import (
    Hashable,
)
from collections.abc import (
    Iterator as _Iterator,
)
from typing import Self

from sage.structure.element import Element

class _SageObject: ...

def repr_from_monomials(
    self, term_repr: builtins.object, use_latex: builtins.bool = ...
) -> str: ...
def repr_factored(self, latex_output: builtins.bool = ...) -> str: ...

