        self, R: builtins.int, names: builtins.object = ..., n: builtins.int = ...
    ) -> None: ...

    class options:
        NAME: _SageObject
        module: _SageObject
        factor_representation: _SageObject

    def degree_on_basis(self, i: builtins.int) -> _SageObject: ...
    def polynomial_ring(self) -> _SageObject: ...
    def basis(self) -> _SageObject: ...
    def algebra_generators(self) -> _SageObject: ...
    gens: _SageObject

    def variables(self) -> _SageObject: ...
    def differentials(self) -> _SageObject: ...
    def gen(self, i: builtins.int) -> _SageObject: ...
    def ngens(self) -> _SageObject: ...
    def one(self) -> _SageObject: ...
    def zero(self) -> _SageObject: ...
    def diff_action(self) -> _SageObject: ...
    Element: _SageObject

class DifferentialWeylAlgebraAction:
    def __init__(self, G: builtins.object) -> None: ...

class InfGenDifferentialWeylAlgebraElement:
    def __iter__(self) -> _Iterator[_SageObject]: ...
    def list(self) -> _SageObject: ...

class InfGenDifferentialWeylAlgebra:
    @staticmethod
    def __classcall_private__(
        cls: builtins.object, R: builtins.int, names: builtins.object = ...
    ) -> _SageObject: ...
    def __init__(self, R: builtins.int, names: builtins.object = ...) -> None: ...
    def gen(self, i: builtins.int) -> _SageObject: ...
    def polynomial_gens(self) -> _SageObject: ...
