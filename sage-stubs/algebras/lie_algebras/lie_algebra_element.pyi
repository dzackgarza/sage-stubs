from collections.abc import Iterator
from typing import Self

from sage.structure.element import Element
from sage.structure.parent import Parent


class LieAlgebraElement(IndexedFreeModuleElement):
    def _im_gens_(self, codomain: Element | int | str | bool | None, im_gens: Element | int | str | bool | None, base_map: Element | int | str | bool | None) -> Element: ...
    def lift(self) -> Element: ...

class LieAlgebraElementWrapper(ElementWrapper):
    def __bool__(self) -> bool: ...
    def _add_(self, right: Element | int | str | bool | None) -> Self: ...
    def _sub_(self, right: Element | int | str | bool | None) -> Self: ...
    def _acted_upon_(self, scalar: Element | int | str | bool | None, self_on_left: Element | int | str | bool | None) -> Element: ...
    def __getitem__(self, i: int) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...

class LieAlgebraMatrixWrapper(LieAlgebraElementWrapper):
    ...

class LieSubalgebraElementWrapper(LieAlgebraElementWrapper):
    def _bracket_(self, x: Element) -> Element: ...
    def _vector_(self, sparse: Element | int | str | bool | None, order: Element | int | str | bool | None) -> Element: ...

class StructureCoefficientsElement(LieAlgebraMatrixWrapper):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _ascii_art_(self) -> Element: ...
    def _unicode_art_(self) -> Element: ...
    def bracket(self, right: Element | int | str | bool | None) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...
    def to_vector(self, sparse: Element | int | str | bool | None, order: Element | int | str | bool | None) -> Element: ...

class UntwistedAffineLieAlgebraElement(Element):
    def _repr_generic(self, style: Element | int | str | bool | None, coeff: Element | int | str | bool | None, t_disp: Element | int | str | bool | None, mult: Element | int | str | bool | None, tensor_symb: Element | int | str | bool | None) -> str: ...
    def c_coefficient(self) -> Element: ...
    def d_coefficient(self) -> Element: ...
    def _richcmp_(self, other: Element, op: Element | int | str | bool | None) -> Element: ...
    def __hash__(self) -> int: ...
    def _neg_(self) -> Self: ...
    def monomial_coefficients(self, copy: Element | int | str | bool | None) -> Element: ...
    def canonical_derivation(self) -> Element: ...
    def _build_untwisted_affine_element(self, P: Parent, t_dict: Element | int | str | bool | None, c: Element, d: int) -> Element: ...

type _BuiltinList[_T] = list[_T]
class FreeLieAlgebraElement(LieAlgebraElement):
    def list(self) -> _BuiltinList[Element]: ...

class LieObject(Element):
    ...

class LieGenerator(LieObject):
    def __hash__(self) -> int: ...

class LieBracket(LieObject):
    def __hash__(self) -> int: ...

class GradedLieBracket(LieBracket):
    def __hash__(self) -> int: ...

class LyndonBracket(GradedLieBracket):
    def __hash__(self) -> int: ...

class ElementWrapper: ...

class IndexedFreeModuleElement: ...
