from collections.abc import Iterator

from sage.rings.ring import Ring
from sage.structure.element import Element

class AffineLieAlgebra(FinitelyGeneratedLieAlgebra):
    def basis(self) -> Element: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _coerce_map_from_(self, R: Ring) -> Element: ...
    def derived_series(self) -> Element: ...
    def is_nilpotent(self) -> bool: ...
    def cartan_type(self) -> Element: ...
    def classical(self) -> Element: ...
    def zero(self) -> Element: ...
    def c(self) -> Element: ...
    def d(self) -> Element: ...
    def lie_algebra_generators(self) -> Element: ...
    def e(self, i: int) -> Element: ...
    def f(self, i: int) -> Element: ...
    def monomial(self, m: int) -> Element: ...

class UntwistedAffineLieAlgebra(AffineLieAlgebra):
    def _repr_(self) -> str: ...
    def derived_subalgebra(self) -> Element: ...

class TwistedAffineLieAlgebra(AffineLieAlgebra):
    def _test_classical_subalgebra(self) -> Element: ...
    def ambient(self) -> Element: ...
    def retract(self, x: Element) -> Element: ...
    def to_ambient(self) -> Element: ...

class TwistedAffineIndices(UniqueRepresentation, Set_generic):
    def __iter__(self) -> Iterator[Element]: ...

class FinitelyGeneratedLieAlgebra: ...

class Set_generic: ...

class UniqueRepresentation: ...
