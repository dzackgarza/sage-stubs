from collections.abc import Iterator

from sage.rings.integer import Integer
from sage.structure.element import Element

class BGGDualModule(CombinatorialFreeModule):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _repr_generator(self, m: int) -> str: ...
    def _latex_generator(self, m: int) -> str: ...
    def degree_on_basis(self, m: int) -> int: ...
    def highest_weight(self) -> Element: ...
    def highest_weight_vector(self) -> Element: ...
    def lie_algebra(self) -> Element: ...
    def dual(self) -> Element: ...
    def _lie_algebra_on_basis(self, b: Element, m: int) -> Element: ...
    def _pbw_monomial_on_basis(self, p: int, m: int) -> Element: ...

class SimpleModuleIndices(IndexedFreeAbelianMonoid):
    def _an_element_(self) -> Element: ...
    def _weight_max_depth(self, mu: Element | int | str | bool | None) -> Element: ...
    def weight_space_basis(self, mu: Element | int | str | bool | None) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...
    def _construct_next_level(self) -> Element: ...
    def cardinality(self) -> Integer: ...

class SimpleModule(ModulePrinting, CombinatorialFreeModule):
    def ambient(self) -> Element: ...
    def lift(self) -> Element: ...
    def retract(self, x: Element) -> Element: ...
    def _lift_on_basis(self, m: int) -> Element: ...
    def pbw_basis(self) -> Element: ...
    def homogeneous_component_basis(self, mu: Element | int | str | bool | None) -> Element: ...

class FiniteDimensionalSimpleModule(SimpleModule):
    def bgg_resolution(self) -> Element: ...

class CombinatorialFreeModule: ...

class IndexedFreeAbelianMonoid: ...

class ModulePrinting: ...
