from sage.rings.ring import Ring
from sage.structure.element import Element

class PoincareBirkhoffWittBasis(CombinatorialFreeModule):
    def _basis_key(self, x: Element) -> Element: ...
    def _monoid_key(self, x: Element) -> Element: ...
    def _monomial_key(self, x: Element) -> Element: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _coerce_map_from_(self, R: Ring) -> Element: ...
    def lie_algebra(self) -> Element: ...
    def algebra_generators(self) -> Element: ...
    def one_basis(self) -> Element: ...
    def product_on_basis(self, lhs: Element | int | str | bool | None, rhs: Element | int | str | bool | None) -> Element: ...
    def degree_on_basis(self, m: int) -> int: ...
    def casimir_element(self, order: Element | int | str | bool | None) -> Element: ...
    def center(self) -> Element: ...

class PoincareBirkhoffWittBasisSemisimpleLieAlgebra(PoincareBirkhoffWittBasis):
    def e(self, i: int) -> Element: ...
    def f(self, i: int) -> Element: ...
    def contravariant_form(self, x: Element, y: Element) -> Element: ...
    def _transpose_on_basis(self, m: int) -> Element: ...
    def transpose(self) -> Element: ...

class CombinatorialFreeModule: ...
