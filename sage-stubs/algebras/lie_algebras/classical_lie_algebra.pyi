from sage.rings.ring import Ring
from sage.structure.element import Element

class ClassicalMatrixLieAlgebra(MatrixLieAlgebraFromAssociative):
    def e(self, i: int) -> Element: ...
    def f(self, i: int) -> Element: ...
    def h(self, i: int) -> Element: ...
    def index_set(self) -> Element: ...
    def cartan_type(self) -> Element: ...
    def epsilon(self, i: int, h: Element) -> Element: ...
    def simple_root(self, i: int, h: Element) -> Element: ...
    def highest_root_basis_elt(self, pos: Element | int | str | bool | None) -> Element: ...
    def basis(self) -> Element: ...
    def affine(self, kac_moody: Element | int | str | bool | None) -> Element: ...

class gl(MatrixLieAlgebraFromAssociative):
    def _repr_(self) -> str: ...
    def killing_form(self, x: Element, y: Element) -> Element: ...
    def monomial(self, i: int) -> Element: ...

class sl(ClassicalMatrixLieAlgebra):
    ...

class so(ClassicalMatrixLieAlgebra):
    ...

class sp(ClassicalMatrixLieAlgebra):
    ...

class ExceptionalMatrixLieAlgebra(ClassicalMatrixLieAlgebra):
    ...

class e6(ExceptionalMatrixLieAlgebra):
    ...

class e7(ExceptionalMatrixLieAlgebra):
    ...

class e8(ExceptionalMatrixLieAlgebra):
    ...

class f4(ExceptionalMatrixLieAlgebra):
    ...

class g2(ExceptionalMatrixLieAlgebra):
    ...

class MatrixCompactRealForm(FinitelyGeneratedLieAlgebra):
    def zero(self) -> Element: ...
    def term(self, i: int, c: Element) -> Element: ...

class LieAlgebraChevalleyBasis(LieAlgebraWithStructureCoefficients):
    def _construct_struct_coeffs(self, R: Ring, p_roots: Element | int | str | bool | None) -> Element: ...
    def _latex_(self) -> str: ...
    def _test_structure_coeffs(self) -> Element: ...
    def _repr_generator(self, m: int) -> str: ...
    def _latex_generator(self, m: int) -> str: ...
    def _basis_key(self, x: Element) -> Element: ...
    def degree_on_basis(self, m: int) -> int: ...
    def _negative_half_index_set(self) -> Element: ...
    def _weight_action(self, m: int, wt: Element | int | str | bool | None) -> Element: ...
    def indices_to_positive_roots_map(self) -> Element: ...
    def lie_algebra_generators(self, str_keys: Element | int | str | bool | None) -> Element: ...
    def _part_generators(self, positive: Element | int | str | bool | None) -> Element: ...
    def gens(self) -> tuple[Element, ...]: ...
    def killing_form_matrix(self) -> Element: ...

class LieAlgebraChevalleyBasis_simply_laced(LieAlgebraChevalleyBasis):
    def asymmetry_function(self) -> Element: ...

class FinitelyGeneratedLieAlgebra: ...

class LieAlgebraWithStructureCoefficients: ...

class MatrixLieAlgebraFromAssociative: ...
