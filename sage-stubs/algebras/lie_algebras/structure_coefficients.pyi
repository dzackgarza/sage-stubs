from sage.rings.ring import Ring
from sage.structure.element import Element

class LieAlgebraWithStructureCoefficients(FinitelyGeneratedLieAlgebra, IndexedGenerators):
    def _standardize_s_coeff(self, index_set: Element | int | str | bool | None) -> Element: ...
    def structure_coefficients(self, include_zeros: Element | int | str | bool | None) -> Element: ...
    def dimension(self) -> int: ...
    def module(self, sparse: Element | int | str | bool | None) -> Element: ...
    def zero(self) -> Element: ...
    def monomial(self, k: int) -> Element: ...
    def term(self, k: int, c: Element) -> Element: ...
    def from_vector(self, v: Element, order: Element | int | str | bool | None, coerce: Element | int | str | bool | None) -> Element: ...
    def _from_dict(self, d: int, coerce: Element | int | str | bool | None, remove_zeros: Element | int | str | bool | None) -> Element: ...
    def some_elements(self) -> list[Element]: ...
    def change_ring(self, R: Ring) -> Element: ...

class FinitelyGeneratedLieAlgebra: ...

class IndexedGenerators: ...
