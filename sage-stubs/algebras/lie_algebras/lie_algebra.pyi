from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent

class LieAlgebra(Parent, UniqueRepresentation):
    def _element_constructor_(self, x: Element) -> Element: ...
    def __getitem__(self, x: Element) -> Element: ...
    def _coerce_map_from_(self, R: Ring) -> Element: ...
    def _Hom_(self, Y: Element | int | str | bool | None, category: Element | int | str | bool | None) -> Element: ...
    def zero(self) -> Element: ...
    def _from_dict(self, d: int, coerce: Element | int | str | bool | None, remove_zeros: Element | int | str | bool | None) -> Element: ...
    def monomial(self, i: int) -> Element: ...
    def term(self, i: int, c: Element) -> Element: ...
    def get_order(self) -> Element: ...

class LieAlgebraWithGenerators(LieAlgebra):
    def lie_algebra_generators(self) -> Element: ...
    def gens(self) -> tuple[Element, ...]: ...
    def gen(self, i: int) -> Element: ...
    def indices(self) -> Element: ...

class FinitelyGeneratedLieAlgebra(LieAlgebraWithGenerators):
    def _repr_(self) -> str: ...
    def _ordered_indices(self) -> Element: ...
    def _an_element_(self) -> Element: ...

class InfinitelyGeneratedLieAlgebra(LieAlgebraWithGenerators):
    ...

class LieAlgebraFromAssociative(LieAlgebraWithGenerators):
    def associative_algebra(self) -> Element: ...
    def is_abelian(self) -> bool: ...

class LiftMorphismToAssociative(LiftMorphism):
    def preimage(self, x: Element) -> Element: ...
    def _call_(self, x: Element) -> Element: ...
    def section(self) -> Element: ...

class MatrixLieAlgebraFromAssociative(LieAlgebraFromAssociative):
    ...

class LiftMorphism: ...

class UniqueRepresentation: ...
