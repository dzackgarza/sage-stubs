from collections.abc import Iterator

from sage.structure.element import Element

class CenterIndices(IndexedFreeAbelianMonoid):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def lift_on_basis(self, m: int) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...
    def some_elements(self) -> list[Element]: ...
    def degree(self, m: int) -> int: ...
    def _construct_next_degree(self) -> Element: ...
    def _reduce(self, vec: Element | int | str | bool | None) -> Element: ...

class SimpleLieCenterIndices(CenterIndices):
    def __iter__(self) -> Iterator[Element]: ...

class CenterUEA(CombinatorialFreeModule):
    def _sorting_key(self, m: int) -> Element: ...
    def algebra_generators(self) -> Element: ...
    def one_basis(self) -> Element: ...
    def ambient(self) -> Element: ...
    def product_on_basis(self, left: Element | int | str | bool | None, right: Element | int | str | bool | None) -> Element: ...
    def degree_on_basis(self, m: int) -> int: ...
    def lift(self) -> Element: ...
    def retract(self, elt: Element) -> Element: ...

class CombinatorialFreeModule: ...

class IndexedFreeAbelianMonoid: ...
