from sage.rings.ring import Ring
from sage.structure.element import Element

class FreeZinbielAlgebra(CombinatorialFreeModule):
    def _repr_term(self, t: Element | int | str | bool | None) -> str: ...
    def _repr_(self) -> str: ...
    def side(self) -> Element: ...
    def algebra_generators(self) -> Element: ...
    def change_ring(self, R: Ring) -> Element: ...
    def gens(self) -> tuple[Element, ...]: ...
    def degree_on_basis(self, t: Element | int | str | bool | None) -> int: ...
    def product_on_basis_left(self, x: Element, y: Element) -> Element: ...
    def product_on_basis_right(self, x: Element, y: Element) -> Element: ...
    def coproduct_on_basis(self, w: Element) -> Element: ...
    def counit(self, S: Element | int | str | bool | None) -> Element: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _coerce_map_from_(self, R: Ring) -> Element: ...
    def construction(self) -> Element: ...

class ZinbielFunctor(ConstructionFunctor):
    def _apply_functor(self, R: Ring) -> Element: ...
    def _apply_functor_to_morphism(self, f: Element) -> Element: ...
    def __hash__(self) -> int: ...
    def merge(self, other: Element) -> Element: ...

class CombinatorialFreeModule: ...

class ConstructionFunctor: ...
