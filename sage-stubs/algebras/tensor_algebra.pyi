from sage.rings.ring import Ring
from sage.structure.element import Element

class TensorAlgebra(CombinatorialFreeModule):
    def _repr_(self) -> str: ...
    def _repr_term(self, m: int) -> str: ...
    def _latex_term(self, m: int) -> str: ...
    def _ascii_art_term(self, m: int) -> Element: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _tensor_constructor_(self, elts: Element | int | str | bool | None) -> Element: ...
    def _coerce_map_from_(self, R: Ring) -> Element: ...
    def construction(self) -> Element: ...
    def degree_on_basis(self, m: int) -> int: ...
    def base_module(self) -> Element: ...
    def one_basis(self) -> Element: ...
    def algebra_generators(self) -> Element: ...
    def product_on_basis(self, a: Element, b: Element) -> Element: ...
    def counit(self, x: Element) -> Element: ...
    def antipode_on_basis(self, m: int) -> Element: ...
    def coproduct_on_basis(self, m: int) -> Element: ...

class TensorAlgebraFunctor(ConstructionFunctor):
    def _apply_functor(self, M: Element | int | str | bool | None) -> Element: ...
    def _apply_functor_to_morphism(self, f: Element) -> Element: ...

class BaseRingLift(Morphism):
    def _call_(self, x: Element) -> Element: ...

class CombinatorialFreeModule: ...

class ConstructionFunctor: ...

class Morphism: ...
