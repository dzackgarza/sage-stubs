from sage.structure.parent import Parent
from sage.structure.element import Element, ModuleElement, RingElement
from sage.structure.unique_representation import UniqueRepresentation
from sage.sets.family import Family

class JordanAlgebra(UniqueRepresentation, Parent):
    def _test_jordan_relations(self, **options: Element | int | float | complex | str | bool) -> None: ...

class SpecialJordanAlgebra(JordanAlgebra):
    def _repr_(self) -> str: ...
    def _element_constructor_(self, x: Element | int | float | complex | str | bool) -> Element: ...
    def _an_element_(self) -> Element: ...
    def basis(self) -> Family: ...
    def gens(self) -> tuple[Element, ...]: ...
    def zero(self) -> Element: ...
    def one(self) -> Element: ...

class JordanAlgebraSymmetricBilinear(JordanAlgebra):
    def _coerce_map_from_base_ring(self) -> bool | None: ...

class ExceptionalJordanAlgebra(JordanAlgebra):
    def _test_multiplication_self_adjoint(self, **options: Element | int | float | complex | str | bool) -> None: ...
    def some_elements(self) -> list[Element]: ...

class Family: ...
class UniqueRepresentation: ...
