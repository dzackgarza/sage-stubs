from sage.structure.element import Element
from sage.structure.parent import Parent

class JordanAlgebra(UniqueRepresentation, Parent):
    def _test_jordan_relations(self) -> Element: ...

class SpecialJordanAlgebra(JordanAlgebra):
    def _repr_(self) -> str: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _an_element_(self) -> Element: ...
    def basis(self) -> Family: ...
    def gens(self) -> tuple[Element, ...]: ...
    def zero(self) -> Element: ...
    def one(self) -> Element: ...

class JordanAlgebraSymmetricBilinear(JordanAlgebra):
    def _coerce_map_from_base_ring(self) -> Element: ...

class ExceptionalJordanAlgebra(JordanAlgebra):
    def _test_multiplication_self_adjoint(self) -> Element: ...
    def some_elements(self) -> list[Element]: ...

class Family: ...

class UniqueRepresentation: ...
