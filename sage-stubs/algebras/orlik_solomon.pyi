from sage.structure.element import Element

class OrlikSolomonAlgebra(CombinatorialFreeModule):
    def _sort_key(self, x: Element) -> Element: ...
    def _repr_term(self, m: int) -> str: ...
    def _repr_(self) -> str: ...
    def one_basis(self) -> Element: ...
    def algebra_generators(self) -> Element: ...
    def product_on_basis(self, a: Element, b: Element) -> Element: ...
    def subset_image(self, S: Element | int | str | bool | None) -> Element: ...
    def degree_on_basis(self, m: int) -> int: ...
    def as_gca(self) -> Element: ...
    def as_cdga(self) -> Element: ...
    def aomoto_complex(self, omega: Element | int | str | bool | None) -> Element: ...

class OrlikSolomonInvariantAlgebra(FiniteDimensionalInvariantModule):
    def construction(self) -> Element: ...
    def _basis_action(self, g: Element, f: Element) -> Element: ...

class CombinatorialFreeModule: ...

class FiniteDimensionalInvariantModule: ...
