from sage.structure.element import Element

class QuantumGroupRepresentation(CombinatorialFreeModule):
    def cartan_type(self) -> Element: ...
    def K_on_basis(self, i: int, b: Element, power: Element | int | str | bool | None) -> Element: ...

class CyclicRepresentation(QuantumGroupRepresentation):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def module_generator(self) -> Element: ...

class AdjointRepresentation(CyclicRepresentation):
    def _zero_elts(self) -> Element: ...
    def e_on_basis(self, i: int, b: Element) -> Element: ...
    def f_on_basis(self, i: int, b: Element) -> Element: ...

class MinusculeRepresentation(CyclicRepresentation):
    ...

class CombinatorialFreeModule: ...
