    def E(self) -> Element: ...
    def E_simple(self) -> Element: ...
    def F(self) -> Element: ...
    def F_simple(self) -> Element: ...
    def K(self) -> Element: ...
    def K_inverse(self) -> Element: ...
    def algebra_generators(self) -> Element: ...
    def _an_element_(self) -> Element: ...
    def some_elements(self) -> list[Element]: ...
    def q(self) -> Element: ...
    def _Hom_(self, Y: Element | int | str | bool | None, category: Element | int | str | bool | None) -> Element: ...
    def highest_weight_module(self, weight: Element | int | str | bool | None) -> Element: ...
    def lower_half(self) -> Element: ...
    def coproduct(self, elt: Element, n: int) -> Element: ...
    def antipode(self, elt: Element) -> Element: ...
    def counit(self, elt: Element) -> Element: ...

class QuantumGroupMorphism(Morphism):
    def _call_(self, val: Element | int | str | bool | None) -> Element: ...
    def im_gens(self) -> Element: ...
    def _repr_defn(self) -> str: ...

class QuantumGroupHomset(HomsetWithBase):
    ...

