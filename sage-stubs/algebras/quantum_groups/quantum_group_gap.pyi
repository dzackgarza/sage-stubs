    def e_tilde(self, i: int) -> Element: ...
    def f_tilde(self, i: int) -> Element: ...

class QuantumGroup(UniqueRepresentation, Parent):
    def _libgap_(self) -> ExpectElement: ...
    def cartan_type(self) -> Element: ...
    def _element_constructor_(self, elt: Element) -> Element: ...
    def one(self) -> Element: ...
    def zero(self) -> Element: ...
