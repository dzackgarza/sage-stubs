from __future__ import annotations

from collections.abc import Iterator, Sequence
from typing import Generic, Self, TypeVar

from sage.rings.polynomial.multi_polynomial_ideal import MPolynomialIdeal
from sage.rings.polynomial.multi_polynomial_libsingular import (
    MPolynomial_libsingular,
)
from sage.structure.element import AlgebraElement, RingElement

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

type LetterplaceExponent = tuple[int, ...]
type LetterplaceReductionInput[_Scalar: RingElement] = (
    FreeAlgebra_letterplace[_Scalar]
    | LetterplaceIdeal[_Scalar]
    | MPolynomialIdeal
    | Sequence[FreeAlgebraElement_letterplace[_Scalar]]
)


class FreeAlgebraElement_letterplace(
    AlgebraElement,
    Generic[_Scalar],
):
    def __init__(
        self,
        A: FreeAlgebra_letterplace[_Scalar],
        x: MPolynomial_libsingular,
        check: bool = ...,
    ) -> None: ...
    def __reduce__(
        self,
    ) -> tuple[
        type[FreeAlgebraElement_letterplace[_Scalar]],
        tuple[FreeAlgebra_letterplace[_Scalar], MPolynomial_libsingular],
    ]: ...
    def __copy__(self) -> Self: ...
    def __hash__(self) -> int: ...
    def __iter__(self) -> Iterator[tuple[LetterplaceExponent, _Scalar]]: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def degree(self) -> int: ...
    def letterplace_polynomial(self) -> MPolynomial_libsingular: ...
    def lm(self) -> Self: ...
    def lt(self) -> Self: ...
    def lc(self) -> _Scalar: ...
    def __bool__(self) -> bool: ...
    def lm_divides(self, p: FreeAlgebraElement_letterplace[_Scalar]) -> bool: ...
    def _richcmp_(
        self,
        other: FreeAlgebraElement_letterplace[_Scalar],
        op: int,
    ) -> bool: ...
    def _neg_(self) -> Self: ...
    def _add_(self, other: Self) -> Self: ...
    def _sub_(self, other: Self) -> Self: ...
    def _lmul_(self, right: RingElement) -> Self: ...
    def _rmul_(self, left: RingElement) -> Self: ...
    def _mul_(self, other: Self) -> Self: ...
    def __pow__(
        self,
        n: int,
        modulus: object | None = ...,
    ) -> Self: ...
    def reduce(
        self,
        G: LetterplaceReductionInput[_Scalar],
    ) -> Self: ...
    def normal_form(self, I: LetterplaceIdeal[_Scalar]) -> Self: ...


from sage.algebras.letterplace.free_algebra_letterplace import (
    FreeAlgebra_letterplace,
)
from sage.algebras.letterplace.letterplace_ideal import LetterplaceIdeal
