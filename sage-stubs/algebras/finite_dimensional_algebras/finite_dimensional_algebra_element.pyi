from typing import Self

from sage.rings.integer import Integer
from sage.structure.element import Element

class FiniteDimensionalAlgebraElement(AlgebraElement):
    def _matrix(self) -> Element: ...
    def vector(self) -> Element: ...
    def matrix(self) -> Element: ...
    def left_matrix(self) -> Element: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def __hash__(self) -> int: ...
    def __getitem__(self, m: int) -> Element: ...
    def __len__(self) -> int: ...
    def _richcmp_(self, other: Element, op: Element | int | str | bool | None) -> Element: ...
    def _add_(self, other: Element) -> Self: ...
    def _sub_(self, other: Element) -> Self: ...
    def _mul_(self, other: Element) -> Self: ...
    def _lmul_(self, other: Element) -> Element: ...
    def _rmul_(self, other: Element) -> Element: ...
    def is_invertible(self) -> bool: ...
    def _inverse(self) -> Element: ...
    def inverse(self) -> Element: ...
    def is_zerodivisor(self) -> bool: ...
    def is_nilpotent(self) -> bool: ...
    def minimal_polynomial(self) -> Element: ...
    def characteristic_polynomial(self) -> Integer: ...

class AlgebraElement: ...
