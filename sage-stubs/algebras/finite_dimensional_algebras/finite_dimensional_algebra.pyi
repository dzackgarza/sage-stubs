from collections.abc import Iterator

from sage.rings.integer import Integer
from sage.rings.ring import Ring
from sage.structure.element import Element
from sage.structure.parent import Parent

class FiniteDimensionalAlgebra(UniqueRepresentation, Parent):
    def _repr_(self) -> str: ...
    def _coerce_map_from_(self, S: Element | int | str | bool | None) -> Element: ...
    def _element_constructor_(self, x: Element) -> Element: ...
    def _Hom_(self, B: Element | int | str | bool | None, category: Element | int | str | bool | None) -> Element: ...
    def ngens(self) -> int: ...
    def gen(self, i: int) -> Element: ...
    def basis(self) -> Element: ...
    def __iter__(self) -> Iterator[Element]: ...
    def _ideal_class_(self, n: int) -> Element: ...
    def table(self) -> Element: ...
    def left_table(self) -> Element: ...
    def base_extend(self, F: Ring) -> Element: ...
    def cardinality(self) -> Integer: ...
    def ideal(self, gens: Element | int | str | bool | None, given_by_matrix: Element | int | str | bool | None, side: Element | int | str | bool | None) -> Element: ...
    def is_associative(self) -> bool: ...
    def is_commutative(self) -> bool: ...
    def is_finite(self) -> bool: ...
    def is_unitary(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def one(self) -> Element: ...
    def random_element(self) -> Element: ...
    def _is_valid_homomorphism_(self, other: Element, im_gens: Element | int | str | bool | None, base_map: Element | int | str | bool | None) -> Element: ...
    def quotient_map(self, ideal: Element | int | str | bool | None) -> Element: ...
    def maximal_ideal(self) -> Element: ...
    def primary_decomposition(self) -> Element: ...
    def maximal_ideals(self) -> Element: ...

class UniqueRepresentation: ...
