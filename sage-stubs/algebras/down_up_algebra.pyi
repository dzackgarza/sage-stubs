import builtins

from sage.structure.element import Element

class _SageObject: ...

class DownUpAlgebra:
    @staticmethod
    def __classcall_private__(
        cls: builtins.object,
        alpha: builtins.object,
        beta: builtins.object,
        gamma: builtins.object,
        base_ring: builtins.object = ...,
    ) -> _SageObject: ...
    def __init__(
        self,
        alpha: builtins.object,
        beta: builtins.object,
        gamma: builtins.object,
        base_ring: builtins.object,
    ) -> None: ...
    def algebra_generators(self) -> _SageObject: ...
    def gens(self) -> tuple[Element, ...]: ...
    def one_basis(self) -> _SageObject: ...
    def product_on_basis(
        self, m1: builtins.object, m2: builtins.object
    ) -> _SageObject: ...
    def degree_on_basis(self, m: builtins.int) -> _SageObject: ...
    def verma_module(self, la: builtins.object) -> _SageObject: ...

class VermaModule:
    @staticmethod
    def __classcall_private__(
        cls: builtins.object, DU: builtins.object, la: builtins.object
    ) -> _SageObject: ...
    def __init__(self, DU: builtins.object, la: builtins.object) -> None: ...
    def highest_weight_vector(self) -> _SageObject: ...
    def weights(self) -> _SageObject: ...

    class Element:
        def is_weight_vector(self) -> builtins.bool: ...
        def weight(self) -> _SageObject: ...
