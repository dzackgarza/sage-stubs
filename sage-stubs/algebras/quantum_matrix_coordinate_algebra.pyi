from sage.structure.element import Element

class QuantumMatrixCoordinateAlgebra_abstract(CombinatorialFreeModule):
    def _repr_term(self, m: int) -> str: ...
    def _latex_term(self, m: int) -> str: ...
    def n(self) -> Element: ...
    def q(self) -> Element: ...
    def one_basis(self) -> Element: ...
    def gens(self) -> tuple[Element, ...]: ...
    def quantum_determinant(self) -> Element: ...
    def product_on_basis(self, a: Element, b: Element) -> Element: ...
    def _bar_on_basis(self, x: Element) -> Element: ...
    def counit_on_basis(self, x: Element) -> Element: ...

class QuantumMatrixCoordinateAlgebra(QuantumMatrixCoordinateAlgebra_abstract):
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def m(self) -> Element: ...
    def algebra_generators(self) -> Family: ...
    def coproduct_on_basis(self, x: Element) -> Element: ...

class QuantumGL(QuantumMatrixCoordinateAlgebra_abstract):
    def _qdet_cancel_monomial(self) -> Element: ...
    def _qdet_remaining(self) -> Element: ...
    def _antipode_on_generator(self, i: int, j: int) -> Element: ...
    def antipode_on_basis(self, x: Element) -> Element: ...

class CombinatorialFreeModule: ...

class Family: ...
