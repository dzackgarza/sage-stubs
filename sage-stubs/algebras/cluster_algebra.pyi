from typing import Self

from sage.structure.element import Element
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject

class ClusterAlgebraElement(ElementWrapper):
    def _add_(self, other: Element) -> Self: ...
    def _neg_(self) -> Self: ...
    def _div_(self, other: Element) -> Self: ...
    def d_vector(self) -> tuple[Element, ...]: ...
    def _repr_(self) -> str: ...

class PrincipalClusterAlgebraElement(ClusterAlgebraElement):
    def g_vector(self) -> Element: ...
    def F_polynomial(self) -> Element: ...
    def is_homogeneous(self) -> bool: ...
    def homogeneous_components(self) -> dict[Element, Element]: ...
    def theta_basis_decomposition(self) -> Element: ...

class ClusterAlgebraSeed(SageObject):
    def __hash__(self) -> int: ...
    def depth(self) -> int: ...
    def path_from_initial_seed(self) -> list[Element]: ...
    def b_matrix(self) -> Element: ...
    def c_matrix(self) -> Element: ...
    def c_vector(self, j: int) -> tuple[Element, ...]: ...
    def c_vectors(self) -> list[tuple[Element, ...]]: ...
    def g_matrix(self) -> Element: ...
    def g_vectors(self) -> list[tuple[Element, ...]]: ...
    def F_polynomials(self) -> list[Element]: ...
    def cluster_variable(self, j: int) -> Element: ...
    def cluster_variables(self) -> list[Element]: ...
    def mutate(self, direction: Element | int | str | bool | None) -> Element: ...
    def _mutated_F(self, k: int, old_g_vector: Element | int | str | bool | None) -> Element: ...

