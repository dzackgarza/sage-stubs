    def initial_cluster_variable_names(self) -> tuple[Element, ...]: ...
    def seeds(self) -> Element: ...
    def reset_exploring_iterator(self, mutating_F: Element | int | str | bool | None) -> Element: ...
    def explore_to_depth(self, depth: Element | int | str | bool | None) -> Element: ...
