
from collections.abc import Hashable, Iterable, Iterator, Sequence
from typing import Generic, Protocol, Self, TypeVar, overload

from sage.categories.category import Category
from sage.categories.rings import Rings
from sage.combinat.free_module import CombinatorialFreeModule
from sage.combinat.integer_vector import IntegerVector
from sage.rings.integer import Integer
from sage.rings.ring import CommutativeRing
from sage.sets.family import AbstractFamily
from sage.structure.element import RingElement

type GeneratorDegree = int | Integer
type GeneratorNames = str | Sequence[str]
type GeneratorDegrees = Sequence[GeneratorDegree]

_Coefficient = TypeVar(
    "_Coefficient",
    bound=RingElement,
    default=RingElement,
)

class _FiniteGCElement(Protocol[_Coefficient]):
    def parent(self) -> FiniteGCAlgebra[_Coefficient]: ...
    def monomial_coefficients(
        self,
        copy: bool = True,
    ) -> dict[IntegerVector, _Coefficient]: ...
    def degree(self) -> GeneratorDegree: ...
    def __add__(self, other: Self) -> Self: ...
    def __sub__(self, other: Self) -> Self: ...
    def __neg__(self) -> Self: ...
    @overload
    def __mul__(self, other: Self) -> Self: ...
    @overload
    def __mul__(self, other: _Coefficient | Integer | int) -> Self: ...
    def __rmul__(self, other: _Coefficient | Integer | int) -> Self: ...
    def __pow__(self, exponent: int | Integer) -> Self: ...

class _FiniteGCGeneratorFamily(Protocol[_Coefficient]):
    def __getitem__(self, i: int | Integer) -> _FiniteGCElement[_Coefficient]: ...
    def __iter__(self) -> Iterator[_FiniteGCElement[_Coefficient]]: ...
    def keys(self) -> Iterable[int]: ...
    def values(self) -> Iterable[_FiniteGCElement[_Coefficient]]: ...

class FiniteGCAlgebra(
    CombinatorialFreeModule,
    Generic[_Coefficient],
):
    @staticmethod
    def __classcall_private__(
        cls: type[FiniteGCAlgebra[_Coefficient]],
        base: Rings.ParentMethods[_Coefficient],
        names: GeneratorNames | None = None,
        degrees: GeneratorDegrees | None = None,
        max_degree: GeneratorDegree | None = None,
        category: Category | None = None,
        **kwargs: str,
    ) -> FiniteGCAlgebra[_Coefficient]: ...
    def __init__(
        self,
        base: Rings.ParentMethods[_Coefficient],
        names: tuple[str, ...],
        degrees: tuple[GeneratorDegree, ...],
        max_degree: GeneratorDegree,
        category: Category | None = None,
        **kwargs: str,
    ) -> None: ...
    def base_ring(self) -> CommutativeRing: ...
    def _valid_index(self, w: IntegerVector) -> bool: ...
    def _repr_(self) -> str: ...
    def ngens(self) -> int: ...
    def product_on_basis(
        self,
        w1: IntegerVector,
        w2: IntegerVector,
    ) -> _FiniteGCElement[_Coefficient]: ...
    def degree_on_basis(self, i: IntegerVector) -> GeneratorDegree: ...
    def _repr_term(self, w: IntegerVector) -> str: ...
    def _latex_term(self, w: IntegerVector) -> str: ...
    def algebra_generators(
        self,
    ) -> _FiniteGCGeneratorFamily[_Coefficient]: ...
    def basis(self) -> AbstractFamily: ...
    def one_basis(self) -> IntegerVector: ...
    def gens(self) -> tuple[_FiniteGCElement[_Coefficient], ...]: ...
    def gen(self, i: int | Integer) -> CombinatorialFreeModule.Element: ...
    def monomial(
        self,
        index: Hashable,
    ) -> CombinatorialFreeModule.Element: ...
    def zero(self) -> CombinatorialFreeModule.Element: ...
    def one(self) -> CombinatorialFreeModule.Element: ...
    def maximal_degree(self) -> GeneratorDegree: ...
    def max_degree(self) -> GeneratorDegree: ...
