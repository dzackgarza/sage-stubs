import builtins

class _SageObject: ...

def normalize_input(self) -> _SageObject: ...

class Parallel:
    p_iter: builtins.str

    def __init__(
        self,
        p_iter: builtins.str = ...,
        ncpus: builtins.object = ...,
        **kwds: builtins.object,
    ) -> None: ...
    def __call__(self, f: builtins.object) -> _SageObject: ...

class ParallelFunction:
    def __init__(self, parallel: builtins.object, func: builtins.object) -> None: ...
    def __call__(
        self, *args: builtins.object, **kwds: builtins.object
    ) -> _SageObject: ...
    def __get__(
        self, instance: builtins.object, owner: builtins.object
    ) -> _SageObject: ...

def parallel(
    self=..., ncpus: builtins.object = ..., **kwds: builtins.object
) -> _SageObject: ...

class Fork:
    verbose: builtins.bool
    timeout: builtins.int

    def __init__(
        self, timeout: builtins.int = ..., verbose: builtins.bool = ...
    ) -> None: ...
    def __call__(self, f: builtins.object) -> _SageObject: ...

def fork(
    self=..., timeout: builtins.int = ..., verbose: builtins.bool = ...
) -> _SageObject: ...
