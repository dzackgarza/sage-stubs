from collections.abc import Iterable


type SplinePoint = tuple[float, float]


class Spline:
    def __init__(self, v: Iterable[SplinePoint] | None = None) -> None: ...
    def __setitem__(self, i: int, xy: SplinePoint) -> None: ...
    def __getitem__(self, i: int) -> SplinePoint: ...
    def __delitem__(self, i: int) -> None: ...
    def append(self, xy: SplinePoint) -> None: ...
    def list(self) -> list[SplinePoint]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __call__(self, x: float) -> float: ...
    def derivative(self, x: float, order: int = 1) -> float: ...
    def definite_integral(self, a: float, b: float) -> float: ...


spline = Spline
