from collections.abc import Callable, Iterable, Sequence
from typing import Generic, Self, TypeVar

from sage.plot.graphics import Graphics
from sage.structure.element import Element, RingElement
from sage.structure.parent import Parent
from sage.structure.sage_object import SageObject


_Value = TypeVar("_Value", bound=Element, default=Element)
_Index = TypeVar("_Index", default=int)
type IndexObject[_Index] = Iterable[_Index] | Parent[_Index]
type RGBColor = tuple[float, float, float]


class IndexedSequence(SageObject, Generic[_Value, _Index]):
    def __init__(
        self,
        L: Sequence[_Value],
        index_object: IndexObject[_Index],
    ) -> None: ...
    def dict(self) -> dict[_Index, _Value]: ...
    def list(self) -> list[_Value]: ...
    def base_ring(self) -> Parent[_Value]: ...
    def index_object(self) -> IndexObject[_Index]: ...
    def _repr_(self) -> str: ...
    def plot_histogram(
        self,
        clr: RGBColor = (0, 0, 1),
        eps: float = 0.4,
    ) -> Graphics: ...
    def plot(self) -> Graphics: ...
    def dft(
        self,
        chi: Callable[[_Index], Element] | None = None,
    ) -> IndexedSequence[Element, _Index]: ...
    def idft(self) -> IndexedSequence[Element, _Index]: ...
    def dct(self) -> IndexedSequence[Element, _Index]: ...
    def dst(self) -> IndexedSequence[Element, _Index]: ...
    def convolution(
        self,
        other: IndexedSequence[Element, _Index],
    ) -> IndexedSequence[Element, _Index]: ...
    def convolution_periodic(
        self,
        other: IndexedSequence[Element, _Index],
    ) -> IndexedSequence[Element, _Index]: ...
    def __mul__(self, other: RingElement | int | float) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    def fft(self) -> IndexedSequence[Element, _Index]: ...
    def ifft(self) -> IndexedSequence[Element, _Index]: ...
    def dwt(
        self,
        other: str = "haar",
        wavelet_k: int = 2,
    ) -> IndexedSequence[Element, _Index]: ...
    def idwt(
        self,
        other: str = "haar",
        wavelet_k: int = 2,
    ) -> IndexedSequence[Element, _Index]: ...
