import builtins
from typing import Self

from sage.rings.integer import Integer

class _SageObject: ...

class QuasiModularFormsElement:
    def __init__(
        self, parent: builtins.object, polynomial: builtins.object
    ) -> None: ...
    def q_expansion(self, prec: builtins.int = ...) -> _SageObject: ...
    qexp: _SageObject

    def __neg__(self) -> Self: ...
    def __bool__(self) -> bool: ...
    def depth(self) -> _SageObject: ...
    def is_zero(self) -> bool: ...
    def is_one(self) -> bool: ...
    def is_graded_modular_form(self) -> bool: ...
    def is_modular_form(self) -> bool: ...
    def polynomial(self, names: builtins.object = ...) -> _SageObject: ...
    to_polynomial: _SageObject

    def weights_list(self) -> list[Integer]: ...
    def is_homogeneous(self) -> bool: ...
    def weight(self) -> Integer: ...
    degree: _SageObject

    def homogeneous_components(self) -> dict[Integer, Self]: ...
    def __getitem__(self, weight: builtins.object) -> Self | None: ...
    homogeneous_component: _SageObject

    def serre_derivative(self) -> Self: ...
    def derivative(self) -> Self: ...
    def coefficients(self, X: builtins.object) -> _SageObject: ...
