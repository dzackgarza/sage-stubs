
from typing import TYPE_CHECKING, Any

from sage.matrix.matrix_dense import Matrix_dense as Matrix
from sage.rings.ring import CommutativeRing
from sage.categories.category import Category
from .module import HeckeModule_free_module
class AmbientHeckeModule(HeckeModule_free_module):
    

    def __init__(
        self,
        base_ring: CommutativeRing,
        rank: int,
        level: int,
        weight: int,
        category: Category | None = None,
    ) -> None: ...
    def __add__(self, other: HeckeModule_free_module) -> AmbientHeckeModule: ...
    def rank(self) -> int: ...
    def complement(self) -> HeckeModule_free_module: ...
    def decomposition_matrix(self) -> Matrix: ...
    def decomposition_matrix_inverse(self) -> Matrix: ...
    def degeneracy_map(self, codomain: Any, t: int = 1) -> Any: ...
    def dual_free_module(self) -> Any: ...
    def fcp(self, n: int, var: str = 'x') -> Any: ...
    def free_module(self) -> Any: ...
    def hecke_bound(self) -> int: ...
    def hecke_module_of_level(self, level: int) -> Any: ...
    def hecke_images(self, i: int, v: list[Any]) -> Matrix: ...
    def intersection(self, other: HeckeModule_free_module) -> HeckeModule_free_module: ...
    def is_ambient(self) -> bool: ...
    def is_full_hecke_module(self, compute: bool = True) -> bool: ...
    def is_new(self, p: int | None = None) -> bool: ...
    def is_old(self, p: int | None = None) -> bool: ...
    def is_submodule(self, V: object) -> bool: ...
    def linear_combination_of_basis(self, v: Any) -> Any: ...
    def new_submodule(self, p: int | None = None) -> HeckeModule_free_module: ...
    def nonembedded_free_module(self) -> Any: ...
    def old_submodule(self, p: int | None = None) -> HeckeModule_free_module: ...
    def submodule(self, M: Any, Mdual: Any = None, check: bool = True) -> HeckeModule_free_module: ...
    def _submodule_class(self) -> Any: ...
    def submodule_from_nonembedded_module(
        self, V: Any, Vdual: Any = None, check: bool = True
    ) -> HeckeModule_free_module: ...
    def submodule_generated_by_images(self, M: Any) -> HeckeModule_free_module: ...
    def _degeneracy_raising_matrix(self, codomain: Any) -> Any: ...
    def _degeneracy_lowering_matrix(self, codomain: Any, t: int) -> Any: ...
    def _hecke_image_of_ith_basis_element(self, n: int, i: int) -> Any: ...
    def _set_dual_free_module(self, V: Any) -> None: ...
    def ambient_hecke_module(self) -> AmbientHeckeModule: ...
