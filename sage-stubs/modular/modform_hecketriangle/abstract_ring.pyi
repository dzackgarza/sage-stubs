from typing import Self

from sage.categories.rings import Rings
from sage.modular.modform_hecketriangle.abstract_space import FormsSpace_abstract
from sage.modular.modform_hecketriangle.analytic_type import AnalyticType
from sage.modular.modform_hecketriangle.graded_ring_element import FormsRingElement
from sage.modular.modform_hecketriangle.hecke_triangle_group_element import (
    HeckeTriangleGroupElement,
)
from sage.modular.modform_hecketriangle.hecke_triangle_groups import HeckeTriangleGroup
from sage.rings.fraction_field import FractionField_generic
from sage.rings.polynomial.multi_polynomial_ring_base import MPolynomialRing_base
from sage.rings.polynomial.plural import NCPolynomialRing_plural
from sage.rings.power_series_ring_element import PowerSeries
from sage.rings.rational import Rational
from sage.rings.ring import Ring
from sage.structure.element import Element as SageElement
from sage.structure.element import RingElement
from sage.structure.parent import Parent

class FormsRing_abstract(Parent):
    Element: type[FormsRingElement]
    def __init__(
        self, group: HeckeTriangleGroup, base_ring: Ring, red_hom: bool, n: int | None
    ) -> None: ...
    def default_prec(self, prec: int | None = ...) -> int: ...
    def disp_prec(self, prec: int | None = ...) -> int: ...
    def default_num_prec(self, prec: int | None = ...) -> int: ...
    def change_ring(self, new_base_ring: Ring) -> Self: ...
    def graded_ring(self) -> Self: ...
    def extend_type(
        self, analytic_type: AnalyticType | None = ..., ring: bool = ...
    ) -> FormsSpace_abstract | FormsRing_abstract: ...
    def reduce_type(
        self,
        analytic_type: AnalyticType | None = ...,
        degree: tuple[Rational | int, HeckeTriangleGroupElement | int | None] | None = ...,
    ) -> FormsSpace_abstract | FormsRing_abstract: ...
    def contains_coeff_ring(self) -> bool: ...
    def construction(self) -> tuple[object, ...]: ...
    def group(self) -> HeckeTriangleGroup: ...
    def hecke_n(self) -> int: ...
    def base_ring(self) -> Rings.ParentMethods[RingElement] | None: ...
    def coeff_ring(self) -> Ring: ...
    def pol_ring(self) -> MPolynomialRing_base: ...
    def rat_field(self) -> FractionField_generic: ...
    def get_d(self, fix_d: bool = ..., d_num_prec: int | None = ...) -> SageElement: ...
    def get_q(
        self, prec: int | None = ..., fix_d: bool = ..., d_num_prec: int | None = ...
    ) -> PowerSeries: ...
    def diff_alg(self) -> NCPolynomialRing_plural: ...
    def _derivative_op(self) -> SageElement: ...
    def _serre_derivative_op(self) -> SageElement: ...
    def has_reduce_hom(self) -> bool: ...
    def is_homogeneous(self) -> bool: ...
    def is_modular(self) -> bool: ...
    def is_weakly_holomorphic(self) -> bool: ...
    def is_holomorphic(self) -> bool: ...
    def is_cuspidal(self) -> bool: ...
    def is_zerospace(self) -> bool: ...
    def analytic_type(self) -> AnalyticType: ...
    def homogeneous_part(
        self, k: Rational | int, ep: HeckeTriangleGroupElement | int | None
    ) -> FormsSpace_abstract | FormsRing_abstract: ...
    def J_inv(self) -> FormsRingElement: ...
    def j_inv(self) -> FormsRingElement: ...
    def f_rho(self) -> FormsRingElement: ...
    def f_i(self) -> FormsRingElement: ...
    def f_inf(self) -> FormsRingElement: ...
    def G_inv(self) -> FormsRingElement: ...
    def g_inv(self) -> FormsRingElement: ...
    def E4(self) -> FormsRingElement: ...
    def E6(self) -> FormsRingElement: ...
    def Delta(self) -> FormsRingElement: ...
    def E2(self) -> FormsRingElement: ...
    def EisensteinSeries(self, k: Rational | int | None = ...) -> FormsRingElement: ...
