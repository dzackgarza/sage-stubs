from typing import Self

from sage.modular.hecke.element import HeckeModuleElement
from sage.modular.hecke.module import HeckeModule_generic
from sage.modular.modsym.space import ModularSymbolsSpace
from sage.modules.free_module_element import FreeModuleElement
from sage.structure.element import Element
from sage.structure.formal_sum import FormalSum

def set_modsym_print_mode(self="manin") -> None: ...

class ModularSymbolsElement(HeckeModuleElement):
    def __init__(
        self,
        parent: ModularSymbolsSpace | HeckeModule_generic,
        x: FreeModuleElement | None,
        check: bool = True,
    ) -> None: ...
    def _repr_(self) -> str: ...
    def _latex_(self) -> str: ...
    def _add_(self, right: ModularSymbolsElement) -> ModularSymbolsElement: ...
    def _rmul_(self, other: Element) -> ModularSymbolsElement: ...
    def _lmul_(self, left: Element) -> ModularSymbolsElement: ...
    def _neg_(self) -> ModularSymbolsElement: ...
    def _sub_(self, other: ModularSymbolsElement | Self) -> ModularSymbolsElement: ...
    def list(self) -> list[Element]: ...
    def manin_symbol_rep(self) -> FormalSum: ...
    def modular_symbol_rep(self) -> FormalSum: ...
