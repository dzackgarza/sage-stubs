from collections.abc import Sequence
from typing import overload
from sage.matrix.matrix0 import Matrix as _ConcreteMatrix
from sage.rings.integer import Integer
from sage.structure.element import Matrix
from sage.structure.element import Element
from sage.structure.parent import Parent

type MatrixBlock = Matrix | Sequence[Sequence[Element | int | Integer]]

def block_diagonal_matrix(
    *blocks: MatrixBlock, sparse: bool = ...
) -> _ConcreteMatrix: ...

def identity_matrix(
    ring: Parent | int | Integer, n: int | Integer = ..., sparse: bool = ...
) -> Matrix: ...
def column_matrix(
    ring: Parent, entries: Sequence[Element | int | Integer], sparse: bool = ...
) -> Matrix: ...
@overload
def diagonal_matrix(
    entries: Sequence[int | Integer], sparse: bool = ...
) -> _ConcreteMatrix: ...
@overload
def diagonal_matrix(
    ring: Parent, entries: Sequence[int | Integer], sparse: bool = ...
) -> _ConcreteMatrix: ...
