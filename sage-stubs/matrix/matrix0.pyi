from collections.abc import Callable, Iterator, Mapping, Sequence
from typing import Generic, Self, TypeVar, overload

from sage.modules.free_module import FreeModule_generic
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.integer import Integer
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import Matrix as MatrixElement
from sage.structure.element import RingElement, Vector
from sage.structure.parent import ElementConstructorInput, Parent

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)
_NewScalar = TypeVar("_NewScalar", bound=RingElement)

type MatrixAxisIndex = int | Integer
type MatrixEntryKey = tuple[MatrixAxisIndex, MatrixAxisIndex]
type MatrixSliceKey = slice | tuple[MatrixAxisIndex | slice, MatrixAxisIndex | slice]


class Matrix(MatrixElement[_Scalar], Generic[_Scalar]):
    def parent(self) -> Parent[Self]: ...
    def base_ring(self) -> Parent[_Scalar]: ...
    def nrows(self) -> int: ...
    def ncols(self) -> int: ...
    def dimensions(self) -> tuple[int, int]: ...
    def is_square(self) -> bool: ...
    def is_sparse(self) -> bool: ...
    def is_dense(self) -> bool: ...

    def list(self) -> list[_Scalar]: ...
    def dense_coefficient_list(self, order: str | None = ...) -> list[_Scalar]: ...
    def dict(self, copy: bool = ...) -> dict[MatrixEntryKey, _Scalar]: ...
    def items(self) -> Iterator[tuple[MatrixEntryKey, _Scalar]]: ...
    def rows(self, copy: bool = ...) -> list[FreeModuleElement[_Scalar]]: ...
    def columns(self, copy: bool = ...) -> list[FreeModuleElement[_Scalar]]: ...
    def row(self, i: MatrixAxisIndex, from_list: bool = ...) -> FreeModuleElement[_Scalar]: ...
    def column(self, j: MatrixAxisIndex, from_list: bool = ...) -> FreeModuleElement[_Scalar]: ...
    def __iter__(self) -> Iterator[FreeModuleElement[_Scalar]]: ...

    @overload
    def __getitem__(self, key: MatrixEntryKey) -> _Scalar: ...
    @overload
    def __getitem__(self, key: MatrixAxisIndex) -> FreeModuleElement[_Scalar]: ...
    @overload
    def __getitem__(self, key: MatrixSliceKey) -> Self: ...
    def __setitem__(
        self,
        key: MatrixEntryKey | MatrixSliceKey,
        value: ElementConstructorInput,
    ) -> None: ...
    def get_unsafe(self, i: int, j: int) -> _Scalar: ...
    def set_unsafe(self, i: int, j: int, value: _Scalar) -> None: ...
    def add_to_entry(self, i: int, j: int, value: _Scalar) -> None: ...

    def __copy__(self) -> Self: ...
    def copy(self) -> Self: ...
    def set_immutable(self) -> None: ...
    def is_immutable(self) -> bool: ...
    def is_mutable(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def is_one(self) -> bool: ...

    def swap_rows(self, r1: int, r2: int) -> None: ...
    def swap_columns(self, c1: int, c2: int) -> None: ...
    def with_swapped_rows(self, r1: int, r2: int) -> Self: ...
    def with_swapped_columns(self, c1: int, c2: int) -> Self: ...
    def rescale_row(self, i: int, scalar: _Scalar, start_col: int = ...) -> None: ...
    def rescale_col(self, j: int, scalar: _Scalar, start_row: int = ...) -> None: ...
    def with_rescaled_row(self, i: int, scalar: _Scalar, start_col: int = ...) -> Self: ...
    def with_rescaled_col(self, j: int, scalar: _Scalar, start_row: int = ...) -> Self: ...
    def add_multiple_of_row(
        self,
        target: int,
        source: int,
        scalar: _Scalar,
        start_col: int = ...,
    ) -> None: ...
    def add_multiple_of_column(
        self,
        target: int,
        source: int,
        scalar: _Scalar,
        start_row: int = ...,
    ) -> None: ...
    def with_added_multiple_of_row(
        self,
        target: int,
        source: int,
        scalar: _Scalar,
        start_col: int = ...,
    ) -> Self: ...
    def with_added_multiple_of_column(
        self,
        target: int,
        source: int,
        scalar: _Scalar,
        start_row: int = ...,
    ) -> Self: ...

    def transpose(self) -> Self: ...
    def antitranspose(self) -> Self: ...
    def conjugate_transpose(self) -> Self: ...
    T = transpose
    H = conjugate_transpose
    def submatrix(
        self,
        row: int = ...,
        col: int = ...,
        nrows: int | None = ...,
        ncols: int | None = ...,
    ) -> Self: ...
    def matrix_from_rows(self, rows: Sequence[int]) -> Self: ...
    def matrix_from_columns(self, columns: Sequence[int]) -> Self: ...
    def matrix_from_rows_and_columns(
        self,
        rows: Sequence[int],
        columns: Sequence[int],
    ) -> Self: ...
    def augment(self, right: Matrix[_Scalar] | Vector[_Scalar], subdivide: bool = ...) -> Self: ...
    def stack(self, bottom: Matrix[_Scalar] | Vector[_Scalar], subdivide: bool = ...) -> Self: ...
    def block_sum(self, other: Matrix[_Scalar]) -> Self: ...
    def tensor_product(self, other: Matrix[_Scalar], subdivide: bool = ...) -> Self: ...

    def apply_map(self, function: Callable[[_Scalar], _NewScalar]) -> Matrix[_NewScalar]: ...
    def map_coefficients(
        self,
        function: Callable[[_Scalar], _NewScalar],
        new_base_ring: Parent[_NewScalar] | None = ...,
    ) -> Matrix[_NewScalar]: ...
    def change_ring(self, ring: Parent[_NewScalar]) -> Matrix[_NewScalar]: ...

    def determinant(self, algorithm: str | None = ...) -> _Scalar: ...
    det = determinant
    def trace(self) -> _Scalar: ...
    def rank(self, algorithm: str | None = ...) -> int: ...
    def characteristic_polynomial(self, var: str = ..., algorithm: str | None = ...) -> Polynomial: ...
    charpoly = characteristic_polynomial
    def minimal_polynomial(self, var: str = ..., algorithm: str | None = ...) -> Polynomial: ...
    minpoly = minimal_polynomial
    def right_kernel(self, *args: object, **kwargs: object) -> FreeModule_generic[_Scalar]: ...
    def left_kernel(self, *args: object, **kwargs: object) -> FreeModule_generic[_Scalar]: ...
    def row_space(self, *args: object, **kwargs: object) -> FreeModule_generic[_Scalar]: ...
    def column_space(self, *args: object, **kwargs: object) -> FreeModule_generic[_Scalar]: ...
    def right_kernel_matrix(self, *args: object, **kwargs: object) -> Self: ...
    def left_kernel_matrix(self, *args: object, **kwargs: object) -> Self: ...

    @overload
    def solve_right(self, other: Matrix[_Scalar]) -> Self: ...
    @overload
    def solve_right(self, other: Vector[_Scalar]) -> FreeModuleElement[_Scalar]: ...
    @overload
    def solve_left(self, other: Matrix[_Scalar]) -> Self: ...
    @overload
    def solve_left(self, other: Vector[_Scalar]) -> FreeModuleElement[_Scalar]: ...

    def __neg__(self) -> Self: ...
    def __add__(self, other: Matrix[_Scalar]) -> Self: ...
    def __sub__(self, other: Matrix[_Scalar]) -> Self: ...
    @overload
    def __mul__(self, other: Matrix[_Scalar]) -> Self: ...
    @overload
    def __mul__(self, other: Vector[_Scalar]) -> FreeModuleElement[_Scalar]: ...
    @overload
    def __mul__(self, other: _Scalar | int | Integer) -> Self: ...
    def __rmul__(self, other: _Scalar | int | Integer) -> Self: ...
    def __truediv__(self, other: _Scalar | int | Integer) -> Matrix[RingElement]: ...
    def __pow__(self, exponent: int | Integer, modulus: object | None = ...) -> Self: ...
    def commutator(self, other: Matrix[_Scalar]) -> Self: ...
    def anticommutator(self, other: Matrix[_Scalar]) -> Self: ...

    def monomial_coefficients(self, copy: bool = ...) -> Mapping[MatrixEntryKey, _Scalar]: ...
