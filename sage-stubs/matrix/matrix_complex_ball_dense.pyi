from collections.abc import Sequence
from typing import Self

from sage.matrix.matrix_dense import Matrix_dense
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.complex_arb import ComplexBall
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.parent import ElementConstructorInput, Parent


class Matrix_complex_ball_dense(Matrix_dense[ComplexBall]):
    def __init__(
        self,
        parent: Parent[Self],
        entries: Sequence[ComplexBall | ElementConstructorInput] | ElementConstructorInput = ...,
        copy: bool = ...,
        coerce: bool = ...,
    ) -> None: ...
    def __copy__(self) -> Self: ...
    def list(self) -> list[ComplexBall]: ...
    def row(self, i: int, from_list: bool = ...) -> FreeModuleElement[ComplexBall]: ...
    def column(self, j: int, from_list: bool = ...) -> FreeModuleElement[ComplexBall]: ...
    def determinant(self, algorithm: str = ...) -> ComplexBall: ...
    det = determinant
    def trace(self) -> ComplexBall: ...
    def inverse(self) -> Self: ...
    __invert__ = inverse
    def solve_right(
        self,
        B: Self | FreeModuleElement[ComplexBall],
    ) -> Self | FreeModuleElement[ComplexBall]: ...
    def characteristic_polynomial(self, var: str = ...) -> Polynomial: ...
    charpoly = characteristic_polynomial
    def exp(self) -> Self: ...
    def eigenvalues(self) -> list[ComplexBall]: ...
