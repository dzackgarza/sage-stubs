from collections.abc import Sequence
from typing import Generic, Literal, Self, TypeVar, overload

from sage.matrix.matrix1 import Matrix as Matrix1
from sage.modules.free_module import FreeModule_generic
from sage.rings.ideal import Ideal_generic
from sage.rings.integer import Integer
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import RingElement

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)


class Matrix(Matrix1[_Scalar], Generic[_Scalar]):
    def determinant(self, algorithm: str | None = ..., proof: bool | None = ..., **kwds: object) -> _Scalar: ...
    det = determinant
    def permanent(self, algorithm: str = ...) -> _Scalar: ...
    def rank(self, algorithm: str | None = ..., **kwds: object) -> int: ...
    def nullity(self, algorithm: str | None = ...) -> int: ...
    def trace(self) -> _Scalar: ...

    def characteristic_polynomial(
        self,
        var: str = ...,
        algorithm: str | None = ...,
    ) -> Polynomial: ...
    charpoly = characteristic_polynomial
    def minimal_polynomial(
        self,
        var: str = ...,
        algorithm: str | None = ...,
    ) -> Polynomial: ...
    minpoly = minimal_polynomial
    def invariant_factors(self) -> list[Polynomial | _Scalar]: ...
    def elementary_divisors(self, algorithm: str | None = ...) -> Sequence[_Scalar]: ...

    @overload
    def smith_form(
        self,
        transformation: Literal[False] = ...,
        **kwds: object,
    ) -> Self: ...
    @overload
    def smith_form(
        self,
        transformation: Literal[True],
        **kwds: object,
    ) -> tuple[Self, Self, Self]: ...

    def frobenius_form(self, flag: int = ..., var: str = ...) -> Self | tuple[Self, Self]: ...
    def rational_form(self, format: str = ...) -> Self | tuple[Self, Self]: ...
    def jordan_form(
        self,
        base_ring: object | None = ...,
        transformation: bool = ...,
        subdivide: bool = ...,
        **kwds: object,
    ) -> Self | tuple[Self, Self]: ...

    def minors(self, k: int | Integer) -> list[_Scalar]: ...
    def minor(self, rows: Sequence[int], columns: Sequence[int]) -> _Scalar: ...
    def determinantal_ideal(self, k: int | Integer) -> Ideal_generic: ...
    def fitting_ideal(self, i: int | Integer) -> Ideal_generic: ...

    def right_kernel_matrix(
        self,
        algorithm: str = ...,
        basis: str = ...,
        **kwds: object,
    ) -> Self: ...
    def left_kernel_matrix(
        self,
        algorithm: str = ...,
        basis: str = ...,
        **kwds: object,
    ) -> Self: ...
    def right_kernel(self, *args: object, **kwds: object) -> FreeModule_generic[_Scalar]: ...
    def left_kernel(self, *args: object, **kwds: object) -> FreeModule_generic[_Scalar]: ...

    def exp(self) -> Self: ...
    def logarithm(self) -> Self: ...
    def polynomial(self, var: str = ...) -> Polynomial: ...
    def apply_morphism(self, phi: object) -> Self: ...
