import builtins
from collections.abc import Iterator, Sequence
from typing import overload

from sage.modules.free_module import FreeModule_generic
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.integer import Integer
from sage.structure.element import Element, Matrix as MatrixElement
from sage.structure.parent import Parent

type MatrixIndex = int | Integer | slice | tuple[int | Integer | slice, int | Integer | slice]

class Matrix(MatrixElement):
    def __add__(self, other: Matrix) -> Matrix: ...
    def __sub__(self, other: Matrix) -> Matrix: ...
    @overload
    def __mul__(self, other: Matrix) -> Matrix: ...
    @overload
    def __mul__(self, other: FreeModuleElement) -> FreeModuleElement: ...
    def __iter__(self) -> Iterator[FreeModuleElement]: ...
    def __getitem__(self, key: MatrixIndex) -> Element: ...
    def list(self) -> builtins.list[Element]: ...
    def base_ring(self) -> Parent: ...
    def determinant(self, algorithm: str | None = None) -> Element: ...
    def det(self, *args: str | None, **kwds: str | bool | None) -> Element: ...
    def elementary_divisors(self, algorithm: str | None = None) -> Sequence[Element]: ...
    def ncols(self) -> int: ...
    def nrows(self) -> int: ...
    def subdivisions(self) -> tuple[builtins.list[int], builtins.list[int]]: ...
    @overload
    def solve_right(self, B: FreeModuleElement, check: bool = ..., *, extend: bool = ...) -> FreeModuleElement: ...
    @overload
    def solve_right(self, B: Matrix, check: bool = ..., *, extend: bool = ...) -> Matrix: ...
    def right_kernel(self, algorithm: str = ..., basis: str = ...) -> FreeModule_generic: ...
    def left_kernel(self, algorithm: str = ..., basis: str = ...) -> FreeModule_generic: ...
    def column_space(self) -> FreeModule_generic: ...
