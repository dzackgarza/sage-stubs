from collections.abc import Callable, Iterator, Sequence
from typing import Generic, TypeVar

from sage.matrix.matrix import Matrix
from sage.rings.integer import Integer
from sage.structure.sage_object import SageObject

_Element = TypeVar("_Element")


class OperationTable(SageObject, Generic[_Element]):
    def __init__(
        self,
        structure: object,
        operation: Callable[[_Element, _Element], _Element],
        names: str | Sequence[str] = ...,
        elements: Sequence[_Element] | None = ...,
    ) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[list[_Element]]: ...
    def __getitem__(self, key: int | tuple[int, int]) -> list[_Element] | _Element: ...
    def table(self) -> list[list[_Element]]: ...
    def elements(self) -> tuple[_Element, ...]: ...
    def column_keys(self) -> tuple[_Element, ...]: ...
    def row_keys(self) -> tuple[_Element, ...]: ...
    def translation(self) -> dict[_Element, str]: ...
    def change_names(self, names: str | Sequence[str]) -> None: ...
    def matrix_of_variables(self) -> Matrix[Integer]: ...
    def color_table(self, element_names: bool = ...) -> object: ...
    def gray_table(self, element_names: bool = ...) -> object: ...
