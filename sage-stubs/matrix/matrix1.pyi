        nrows: int | None = None,
        ncols: int | None = None,
        entries: FreeModuleElement[_Scalar] | Sequence[_Scalar] = None,
        coerce: bool = True,
        copy: bool = True,
    ) -> Matrix[_Scalar]: ...
    def block_sum(self, other: ElementConstructorInput) -> ElementConstructorInput: ...
