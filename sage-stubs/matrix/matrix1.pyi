from collections.abc import Sequence
from typing import Generic, Literal, Self, TypeVar, overload

from sage.matrix.matrix0 import Matrix as Matrix0
from sage.modules.free_module import FreeModule_generic
from sage.modules.free_module_element import FreeModuleElement
from sage.rings.integer import Integer
from sage.structure.element import RingElement

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)


class Matrix(Matrix0[_Scalar], Generic[_Scalar]):
    def is_symmetric(self) -> bool: ...
    def is_skew_symmetric(self) -> bool: ...
    def is_hermitian(self) -> bool: ...
    def is_skew_hermitian(self) -> bool: ...
    def is_diagonal(self) -> bool: ...
    def is_scalar(self) -> bool: ...
    def is_upper_triangular(self) -> bool: ...
    def is_lower_triangular(self) -> bool: ...
    def is_invertible(self) -> bool: ...
    def is_singular(self) -> bool: ...

    def diagonal(self) -> list[_Scalar]: ...
    def diagonal_sum(self) -> _Scalar: ...
    def subdivisions(self) -> tuple[list[int], list[int]]: ...
    def subdivide(
        self,
        row_lines: Sequence[int] | None = ...,
        col_lines: Sequence[int] | None = ...,
    ) -> None: ...

    def delete_rows(self, rows: Sequence[int]) -> Self: ...
    def delete_columns(self, columns: Sequence[int]) -> Self: ...
    def insert_row(self, index: int, row: Sequence[_Scalar]) -> Self: ...
    def insert_column(self, index: int, column: Sequence[_Scalar]) -> Self: ...

    def echelonize(
        self,
        algorithm: str = ...,
        cutoff: int = ...,
        **kwds: object,
    ) -> None: ...
    def echelon_form(
        self,
        algorithm: str = ...,
        cutoff: int = ...,
        **kwds: object,
    ) -> Self: ...
    def pivots(self) -> tuple[int, ...]: ...
    def nonpivots(self) -> tuple[int, ...]: ...
    def pivot_rows(self) -> tuple[int, ...]: ...

    def adjugate(self) -> Self: ...
    def inverse(self) -> Self: ...
    def inverse_of_unit(self) -> Self: ...
    def multiplicative_order(self) -> Integer: ...

    @overload
    def hermite_form(
        self,
        include_zero_rows: bool = ...,
        transformation: Literal[False] = ...,
        **kwds: object,
    ) -> Self: ...
    @overload
    def hermite_form(
        self,
        include_zero_rows: bool,
        transformation: Literal[True],
        **kwds: object,
    ) -> tuple[Self, Self]: ...

    def right_eigenspaces(self, *args: object, **kwds: object) -> list[tuple[_Scalar, FreeModule_generic[_Scalar], int]]: ...
    def left_eigenspaces(self, *args: object, **kwds: object) -> list[tuple[_Scalar, FreeModule_generic[_Scalar], int]]: ...
    def eigenvalues(self, *args: object, **kwds: object) -> list[_Scalar]: ...
    def eigenvectors_right(self, *args: object, **kwds: object) -> list[tuple[_Scalar, list[FreeModuleElement[_Scalar]], int]]: ...
    def eigenvectors_left(self, *args: object, **kwds: object) -> list[tuple[_Scalar, list[FreeModuleElement[_Scalar]], int]]: ...
