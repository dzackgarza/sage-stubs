    def dense_matrix(self) -> Matrix[_Scalar]: ...
    def sparse_matrix(self) -> Matrix[_Scalar]: ...
    def matrix_space(
        self,
        nrows: int | None = None,
        ncols: int | None = None,
        sparse: bool | None = None,
    ) -> MatrixSpace: ...
    def new_matrix(
