_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

from sage.matrix.matrix_space import MatrixSpace

class Matrix(Matrix):
    def numpy(
        self, dtype: ElementConstructorInput = None, copy: bool = True
    ) -> ElementConstructorInput: ...
    def matrix_over_field(self) -> Matrix[_Scalar]: ...
    def lift(self) -> ElementConstructorInput: ...
    def lift_centered(self) -> ElementConstructorInput: ...
    def columns(self, copy: bool = True) -> tuple[FreeModuleElement[_Scalar], ...]: ...
    def rows(self, copy: bool = True) -> tuple[FreeModuleElement[_Scalar], ...]: ...
    def dense_columns(self, copy: bool = True) -> ElementConstructorInput: ...
    def dense_rows(self, copy: bool = True) -> ElementConstructorInput: ...
    def sparse_columns(self, copy: bool = True) -> ElementConstructorInput: ...
    def sparse_rows(self, copy: bool = True) -> ElementConstructorInput: ...
    def column(self, i: int, from_list: bool = False) -> FreeModuleElement[_Scalar]: ...
    def row(self, i: int, from_list: bool = False) -> FreeModuleElement[_Scalar]: ...
    def stack(
        self, bottom: ElementConstructorInput, subdivide: bool = False
    ) -> ElementConstructorInput: ...
    def augment(
        self, right: ElementConstructorInput, subdivide: bool = False
    ) -> ElementConstructorInput: ...
    def matrix_from_columns(
        self, columns: ElementConstructorInput
    ) -> Matrix[_Scalar]: ...
    def delete_columns(
        self, dcols: ElementConstructorInput, check: bool = True
    ) -> ElementConstructorInput: ...
    def matrix_from_rows(self, rows: ElementConstructorInput) -> Matrix[_Scalar]: ...
    def delete_rows(
        self, drows: ElementConstructorInput, check: bool = True
