type MatrixEntry = RingElement | SageElement | int | Integer
type MatrixData = Matrix | Sequence[MatrixEntry] | Sequence[Sequence[MatrixEntry]]
type MatrixIndexKeys = Iterable[SageElement | int | Integer | str] | AbstractFamily

class MatrixSpace(Parent):
    def __init__(
        self,
        base_ring: Ring,
        nrows: int | Integer,
        ncols: int | Integer,
        sparse: bool = ...,
        implementation: ElementConstructorInput = ...,
    ) -> None: ...
    @staticmethod
    def __classcall__(
        cls: type[MatrixSpace],
        base_ring: Ring,
        nrows_or_row_keys: int | Integer | MatrixIndexKeys | None = ...,
        ncols_or_column_keys: int | Integer | MatrixIndexKeys | None = ...,
        sparse: bool = ...,
        implementation: ElementConstructorInput = ...,
        *,
        nrows: int | Integer | None = ...,
        ncols: int | Integer | None = ...,
        row_keys: MatrixIndexKeys | None = ...,
        column_keys: MatrixIndexKeys | None = ...,
    ) -> MatrixSpace: ...
    def base_ring(self) -> Ring: ...
    def nrows(self) -> int: ...
    def ncols(self) -> int: ...
    def dims(self) -> tuple[int, int]: ...
    def is_finite(self) -> bool: ...
    def is_sparse(self) -> bool: ...
    def gen(self, i: int) -> FreeModuleElement[_Scalar]: ...
    def ngens(self) -> int: ...
    def random_element(
        self, *args: int | Integer, **kwargs: int | Integer | bool
    ) -> FreeModuleElement[_Scalar]: ...
    def some_elements(self) -> MatrixSpace: ...
    def zero_matrix(self) -> Matrix[_Scalar]: ...
    def identity_matrix(self) -> Matrix[_Scalar]: ...
    @property
    def Element(self) -> MatrixSpace: ...
    def cardinality(self) -> int: ...
    def characteristic(self) -> int: ...
    def is_exact(self) -> bool: ...
    @property
    def transposed(self) -> MatrixSpace: ...
    def change_ring(self, R: Ring) -> MatrixSpace: ...
    def base_extend(self, R: Ring) -> MatrixSpace: ...
    def construction(self) -> tuple[ConstructionFunctor, Ring]: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[FreeModuleElement[_Scalar]]: ...
    def __getitem__(
        self, x: int | Integer | str
    ) -> FreeModuleElement[_Scalar] | _Scalar: ...
    def basis(self) -> AbstractFamily: ...
    def dimension(self) -> int: ...
    def submodule(
        self,
        gens: ElementConstructorInput,
        check: bool = ...,
        already_echelonized: bool = ...,
        unitriangular: bool = ...,
        support_order: Sequence[int] | None = ...,
        category: ElementConstructorInput = ...,
    ) -> SubmoduleWithBasis: ...
    def diagonal_matrix(self, entries: Sequence[MatrixEntry]) -> Matrix[_Scalar]: ...
    def is_dense(self) -> bool: ...
    def zero(self) -> FreeModuleElement[_Scalar]: ...
    def one(self) -> FreeModuleElement[_Scalar]: ...
    def matrix(
        self, x: MatrixEntry | MatrixData = ..., **kwds: bool
    ) -> Matrix[_Scalar]: ...
    def matrix_space(
        self,
        nrows: int | Integer | None = ...,
        ncols: int | Integer | None = ...,
        sparse: bool = ...,
    ) -> MatrixSpace: ...
    def row_space(self) -> FreeModule_generic: ...
    def column_space(self) -> FreeModule_generic: ...
    def from_vector(
        self, vector: Sequence[MatrixEntry], order: str = ..., coerce: bool = ...
    ) -> MatrixSpace: ...
