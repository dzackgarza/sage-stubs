from sage.structure.element import Matrix as Matrix_element
from sage.rings.integer import Integer
from sage.rings.ring import CommutativeRing
from sage.structure.element import Element
from sage.modules.free_module import FreeModule_generic
from sage.modules.free_module_element import FreeModuleElement
from collections.abc import Iterator
from typing import overload

class Matrix(Matrix_element):
    def __add__(self, other: Matrix) -> Matrix: ...
    def __sub__(self, other: Matrix) -> Matrix: ...
    @overload
    def __mul__(self, other: Matrix) -> Matrix: ...
    @overload
    def __mul__(self, other: FreeModuleElement) -> FreeModuleElement: ...
    def __iter__(self) -> Iterator[FreeModuleElement]: ...
    def __getitem__(self, key: int | Integer | slice | tuple[int | Integer | slice, int | Integer | slice]) -> Element: ...
    def nrows(self) -> int: ...
    def ncols(self) -> int: ...
    def base_ring(self) -> CommutativeRing: ...
    def det(self, *args: str | None, **kwds: str | bool | None) -> Element: ...
    def rank(self) -> Integer: ...
    def trace(self) -> Element: ...
    def transpose(self) -> Matrix: ...
    def inverse(self) -> Matrix: ...
    def is_square(self) -> bool: ...
    def is_invertible(self) -> bool: ...
    def change_ring(self, ring: CommutativeRing) -> Matrix: ...
    def submatrix(self, row: int = 0, col: int = 0, nrows: int | None = None, ncols: int | None = None) -> Matrix: ...
    def augment(self, right: Matrix, subdivide: bool = False) -> Matrix: ...
    def stack(self, bottom: Matrix, subdivide: bool = False) -> Matrix: ...
    def list(self) -> list[Element]: ...
    @overload
    def solve_right(self, B: FreeModuleElement, check: bool = ..., *, extend: bool = ...) -> FreeModuleElement: ...
    @overload
    def solve_right(self, B: Matrix, check: bool = ..., *, extend: bool = ...) -> Matrix: ...
    def right_kernel(self, algorithm: str = ..., basis: str = ...) -> FreeModule_generic: ...
    def left_kernel(self, algorithm: str = ..., basis: str = ...) -> FreeModule_generic: ...
    def column_space(self) -> FreeModule_generic: ...

class Matrix_dense(Matrix):
    def __copy__(self) -> Matrix_dense: ...
    def transpose(self) -> Matrix_dense: ...
    def antitranspose(self) -> Matrix_dense: ...
