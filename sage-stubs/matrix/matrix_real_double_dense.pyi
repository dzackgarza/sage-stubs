    | RealDoubleElement
    | Sequence[float | RealDoubleElement | ElementConstructorInput]
    | Sequence[Sequence[float | RealDoubleElement | ElementConstructorInput]]
    | Mapping[tuple[int, int], float | RealDoubleElement | ElementConstructorInput]
    | Callable[[int, int], float | RealDoubleElement | ElementConstructorInput]
    | ElementConstructorInput
    | None
)


class Matrix_real_double_dense(Matrix_double_dense[RealDoubleElement]):
