    def eigenvectors_left(self, algorithm: str = ...) -> list[tuple[ComplexDoubleElement, list[FreeModuleElement[ComplexDoubleElement]], int]]: ...
    def singular_values(self, eps: float | None = ...) -> list[RealDoubleElement]: ...
    def SVD(self) -> tuple[Self, Self, Self]: ...
    def QR(self) -> tuple[Self, Self]: ...
    def schur(self) -> tuple[Matrix_complex_double_dense, Matrix_complex_double_dense]: ...
    def pseudoinverse(self, eps: float | None = ...) -> Self: ...
    def solve_right(self, B: Self | FreeModuleElement[RealDoubleElement]) -> Self | FreeModuleElement[RealDoubleElement]: ...
    def solve_left(self, B: Self | FreeModuleElement[RealDoubleElement]) -> Self | FreeModuleElement[RealDoubleElement]: ...
    def least_squares(self, B: Self | FreeModuleElement[RealDoubleElement]) -> Self | FreeModuleElement[RealDoubleElement]: ...
    def exp(self) -> Self: ...
