from typing import Generic, Self, TypeVar

from sage.libs.gap.element import GapElement
from sage.matrix.matrix import Matrix
from sage.matrix.matrix_dense import Matrix_dense
from sage.matrix.matrix_space import MatrixData, MatrixSpace
from sage.rings.polynomial.polynomial_element import Polynomial
from sage.structure.element import RingElement

_Scalar = TypeVar("_Scalar", bound=RingElement, default=RingElement)

type _GapMatrixEntries[_T: RingElement] = MatrixData[_T] | GapElement


class Matrix_gap(Matrix_dense[_Scalar], Generic[_Scalar]):
    def __init__(
        self,
        parent: MatrixSpace[_Scalar],
        entries: _GapMatrixEntries[_Scalar] = ...,
        copy: bool | None = ...,
        coerce: bool = ...,
    ) -> None: ...
    def __copy__(self) -> Self: ...
    def __reduce__(
        self,
    ) -> tuple[MatrixSpace[_Scalar], tuple[list[_Scalar]]]: ...
    def gap(self) -> GapElement: ...
    def _richcmp_(
        self,
        other: Self,
        op: int,
    ) -> bool: ...
    def __neg__(self) -> Self: ...
    def __invert__(self) -> Matrix[RingElement]: ...
    def _add_(self, right: Self) -> Self: ...
    def _sub_(self, right: Self) -> Self: ...
    def transpose(self) -> Self: ...
    def determinant(self) -> _Scalar: ...
    def trace(self) -> _Scalar: ...
    def rank(self) -> int: ...
    def minpoly(
        self,
        var: str = ...,
        **kwds: object,
    ) -> Polynomial: ...
    minimal_polynomial = minpoly
    def elementary_divisors(self) -> list[_Scalar]: ...
