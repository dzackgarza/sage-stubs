import builtins

class _SageObject: ...

def reproducible_repr(self) -> _SageObject: ...

class AttributeAccessTracerHelper:
    reads: builtins.bool
    prefix: builtins.str

    def __init__(
        self,
        delegate: builtins.object,
        prefix: builtins.str = ...,
        reads: builtins.bool = ...,
    ) -> None: ...
    def get(self, name: builtins.str) -> _SageObject: ...
    def set(self, name: builtins.str, val: builtins.object) -> _SageObject: ...

class AttributeAccessTracerProxy:
    def __init__(self, delegate: builtins.object, **kwds: builtins.object) -> None: ...
    def __getattribute__(self, name: builtins.str) -> _SageObject: ...
    def __setattr__(self, name: builtins.str, val: builtins.object) -> None: ...

def trace_method(
    self, meth: builtins.object, **kwds: builtins.object
) -> _SageObject: ...
