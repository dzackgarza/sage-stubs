from sage.structure.element import Element

class CircuitsMatroid(Matroid):
    def full_rank(self) -> Element: ...
    def _is_isomorphic(self, other: Element, certificate: Element | int | str | bool | None) -> Element: ...
    def _repr_(self) -> str: ...
    def relabel(self, mapping: Element | int | str | bool | None) -> Element: ...
    def bases_iterator(self) -> Element: ...
    def circuits_iterator(self, k: int) -> Element: ...
    def nonspanning_circuits_iterator(self) -> Element: ...
    def broken_circuit_complex(self, ordering: Element | int | str | bool | None, reduced: Element | int | str | bool | None) -> Element: ...
    def girth(self) -> Element: ...
    def is_valid(self, certificate: Element | int | str | bool | None) -> bool: ...

class Matroid: ...
