    def _minor(self, contractions: Element | int | str | bool | None, deletions: Element | int | str | bool | None) -> Element: ...
    def gammoid_extension(self, vertex: Element | int | str | bool | None, neighbors: Element | int | str | bool | None) -> Element: ...
